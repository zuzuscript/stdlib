=cut

function index ( String text, String needle, Number start? ) {
	let src := text;
	let find := needle;
	let at := start ≡ null ? 0: int(start);
	at := 0 if at < 0;

	if ( find ≡ "" ) {
		let max := length src;
		return at > max ? max: at;
	}

	let src_len := length src;
	let find_len := length find;
	if ( at > src_len - find_len ) {
		return -1;
	}

	let i := at;
	while ( i <= src_len - find_len ) {
		return i if substr( src, i, find_len ) ≡ find;
		i++;
	}

	return -1;
}

function contains ( String text, String needle ) {
	return index( text, needle ) >= 0;
}

function starts_with ( String text, String prefix ) {
	return index( text, prefix ) = 0;
}

function ends_with ( String text, String suffix ) {
	const suffix_length := length suffix;
	return true if suffix_length = 0;
	return false if suffix_length > length text;
	return substr( text, ( length text ) - suffix_length ) ≡ suffix;
}

function matches ( text, pattern, flags? ) {
	if ( flags ≡ null ) {
		return search( text, pattern ) ≢ null;
	}
	return search( text, pattern, flags ) ≢ null;
}
