					c- f="" canvas
					c- e="" width
					c- o="" "="
					c- s="" "200"
					c- e="" height
					c- o="" "="
					c- s="" "200"
					c- e="" style
					c- o="" "="
					c- s="" "width:100px;height:100px"
					c- p="" >
				}
			}
		}
