		div class=example {
			p "The following example is technically correct:"
			pre {
				code class=html {
					c- p="" <
					c- f="" section
					c- p="" >
					c- c="" "<!-- ... -->"
					c- p="" <
					c- f="" p
					c- p="" >
					- "Last modified: 2001-04-23"
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "Author: fred@example.com"
					c- p="" "</"
