				p {
					- "Switch the "
					a href="#insertion-mode" id=parsing-main-inhead:insertion-mode-3 "insertion mode"
					- " to \""
					a href="#parsing-main-inheadnoscript" id=parsing-main-inhead:parsing-main-inheadnoscript "in head noscript"
					- "\"."
				}
			}
			dt id=scriptTag "A start tag whose tag name is \"script\""
			dd {
				p "Run these steps:"
				ol {
					li {
						p {
							- "Let the "
							var "adjusted insertion location"
							- " be the "
							a href="#appropriate-place-for-inserting-a-node" id=parsing-main-inhead:appropriate-place-for-inserting-a-node "appropriate place for inserting a node"
							- .
						}
					}
					li {
						p {
							a href="#create-an-element-for-the-token" id=parsing-main-inhead:create-an-element-for-the-token "Create an element for the token"
							- " in the "
							a data-x-internal=html-namespace-2 href="https://infra.spec.whatwg.org/#html-namespace" id=parsing-main-inhead:html-namespace-2 "HTML namespace"
							- ", with the intended parent being the element in which the "
							var "adjusted insertion location"
							- " finds itself."
						}
					}
					li {
						p {
							- "Set the element's "
							a href="#parser-document" id=parsing-main-inhead:parser-document "parser document"
							- " to the "
							code id=parsing-main-inhead:document {
								a href="#document" Document
							}
							- ", and set the element's "
							a href="#script-force-async" id=parsing-main-inhead:script-force-async "force async"
							- " to false."
						}
						p class=note {
							- "This ensures that, if the script is external, any "
							code id=parsing-main-inhead:dom-document-write {
								a href="#dom-document-write" "document.write()"
							}
							- " calls in the script will execute in-line, instead of blowing the document away, as would happen in most other cases. It also prevents the script from executing until the end tag is seen."
						}
					}
					li {
						p {
							- "If the parser was created as part of the "
							a href="#html-fragment-parsing-algorithm" id=parsing-main-inhead:html-fragment-parsing-algorithm "HTML fragment parsing algorithm"
							- ", then set the "
							code id=parsing-main-inhead:the-script-element {
								a href="#the-script-element" script
							}
							- " element's "
							a href="#already-started" id=parsing-main-inhead:already-started "already started"
							- " to true. ("
							a href="#fragment-case" id=parsing-main-inhead:fragment-case "fragment case"
							- ")"
						}
					}
					li id=document-written-scripts-intervention {
						p {
							- "If the parser was invoked via the "
							code id=parsing-main-inhead:dom-document-write-2 {
								a href="#dom-document-write" "document.write()"
							}
							- " or "
							code id=parsing-main-inhead:dom-document-writeln {
								a href="#dom-document-writeln" "document.writeln()"
							}
							- " methods, then optionally set the "
							code id=parsing-main-inhead:the-script-element-2 {
								a href="#the-script-element" script
							}
							- " element's "
							a href="#already-started" id=parsing-main-inhead:already-started-2 "already started"
							- " to true. (For example, the user agent might use this clause to prevent execution of "
							a href="#concept-origin" id=parsing-main-inhead:concept-origin cross-origin
							- " scripts inserted via "
							code id=parsing-main-inhead:dom-document-write-3 {
								a href="#dom-document-write" "document.write()"
							}
							- " under slow network conditions, or when the page has already taken a long time to load.)"
						}
					}
					li {
						p {
							- "Insert the newly created element at the "
							var "adjusted insertion location"
							- .
						}
					}
					li {
						p {
							- "Push the element onto the "
							a href="#stack-of-open-elements" id=parsing-main-inhead:stack-of-open-elements-3 "stack of open elements"
							- " so that it is the new "
