				dt "Unicode and Encoding"
				dd {
					p {
						- "The Unicode character set is used to represent textual data, and "
						cite Encoding
						- " defines requirements around "
						a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=dependencies:encoding "character encodings"
						- ". "
						a href="#refsUNICODE" "[UNICODE]"
					}
					p class=note {
						- "This specification "
						a href="#encoding-terminology" "introduces terminology"
						- " based on the terms defined in those specifications, as described earlier."
					}
					p {
						- "The following terms are used as defined in "
						cite Encoding
						- ": "
						a href="#refsENCODING" "[ENCODING]"
					}
					ul class=brief {
						li {
							dfn id=getting-an-encoding {
								a href="https://encoding.spec.whatwg.org/#concept-encoding-get" "Getting an encoding"
							}
						}
						li {
							dfn id=get-an-output-encoding {
								a href="https://encoding.spec.whatwg.org/#get-an-output-encoding" "Get an output encoding"
							}
						}
						li {
							- "The generic "
							dfn id=decode {
								a href="https://encoding.spec.whatwg.org/#decode" decode
							}
							- " algorithm which takes a byte stream and an encoding and returns a character stream"
						}
						li {
							- "The "
							dfn id=utf-8-decode {
								a href="https://encoding.spec.whatwg.org/#utf-8-decode" "UTF-8 decode"
							}
							- " algorithm which takes a byte stream and returns a character stream, additionally stripping one leading UTF-8 Byte Order Mark (BOM), if any"
						}
						li {
							- "The "
							dfn id=utf-8-decode-without-bom {
								a href="https://encoding.spec.whatwg.org/#utf-8-decode-without-bom" "UTF-8 decode without BOM"
							}
							- " algorithm which is identical to "
							a data-x-internal=utf-8-decode href="https://encoding.spec.whatwg.org/#utf-8-decode" id=dependencies:utf-8-decode "UTF-8 decode"
							- " except that it does not strip one leading UTF-8 Byte Order Mark (BOM)"
						}
						li {
							- "The "
							dfn id=encode {
								a href="https://encoding.spec.whatwg.org/#encode" encode
							}
							- " algorithm which takes a character stream and an encoding and returns a byte stream"
						}
						li {
							- "The "
							dfn id=utf-8-encode {
								a href="https://encoding.spec.whatwg.org/#utf-8-encode" "UTF-8 encode"
							}
							- " algorithm which takes a character stream and returns a byte stream"
						}
						li {
							- "The "
							dfn id=bom-sniff {
								a href="https://encoding.spec.whatwg.org/#bom-sniff" "BOM sniff"
							}
							- " algorithm which takes a byte stream and returns an encoding or null."
						}
					}
				}
				dt "XML and related specifications"
				dd {
					p {
						- "Implementations that support "
						a href="#the-xhtml-syntax" id=dependencies:the-xhtml-syntax "the XML syntax"
						- " for HTML must support some version of XML, as well as its corresponding namespaces specification, because that syntax uses an XML serialization with namespaces. "
						a href="#refsXML" "[XML]"
						a href="#refsXMLNS" "[XMLNS]"
					}
					p "Data mining tools and other user agents that perform operations on content without running scripts, evaluating CSS or XPath expressions, or otherwise exposing the resulting DOM to arbitrary content, may \"support namespaces\" by just asserting that their DOM node analogues are in certain namespaces, without actually exposing the namespace strings."
					p class=note {
						- "In "
						a href="#syntax" id=dependencies:syntax "the HTML syntax"
						- ", namespace prefixes and namespace declarations do not have the same effect as in XML. For instance, the colon has no special meaning in HTML element names."
					}
					hr
					p {
						- "The attribute with the name "
						dfn id=attr-xml-space {
							a href="https://www.w3.org/TR/xml/#sec-white-space" {
								code space
							}
						}
						- " in the "
						a data-x-internal=xml-namespace href="https://infra.spec.whatwg.org/#xml-namespace" id=dependencies:xml-namespace "XML namespace"
						- " is defined by "
						cite "Extensible Markup Language"
						- " ("
						cite XML
						- "). "
						a href="#refsXML" "[XML]"
					}
					p {
						- "The "
						dfn id=xml-name {
							a href="https://www.w3.org/TR/xml/#NT-Name" {
								code Name
							}
						}
						- " production is defined in "
						cite XML
						- ". "
						a href="#refsXML" "[XML]"
					}
					p {
						- "This specification also references the "
						dfn id=xml-stylesheet {
							a href="https://www.w3.org/TR/xml-stylesheet/#the-xml-stylesheet-processing-instruction" {
								code <?xml-stylesheet?>
							}
						}
						- " processing instruction, defined in "
						cite "Associating Style Sheets with XML documents"
						- ". "
						a href="#refsXMLSSPI" "[XMLSSPI]"
					}
					p {
						- "This specification also non-normatively mentions the "
						dfn id=xsltprocessor {
							code XSLTProcessor
						}
						- " interface and its "
						dfn id=dom-xsltprocessor-transformtofragment {
							code "transformToFragment()"
						}
						- " and "
						dfn id=dom-xsltprocessor-transformtodocument {
							code "transformToDocument()"
						}
						- " methods. "
						a href="#refsXSLTP" "[XSLTP]"
					}
				}
