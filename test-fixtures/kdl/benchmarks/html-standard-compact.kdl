					}
				}
			}
		}
		p {
			- "The "
			a data-x-internal=remote-end-steps href="https://w3c.github.io/webdriver/#dfn-remote-end-steps" id=user-agent-automation:remote-end-steps "remote end steps"
			- " are:"
		}
		ol {
			li {
				p {
					- "If "
					var parameters
					- " is not a JSON Object, return a "
					a data-x-internal=webdriver-error href="https://w3c.github.io/webdriver/#dfn-errors" id=user-agent-automation:webdriver-error "WebDriver error"
					- " with "
					a data-x-internal=webdriver-error-code href="https://w3c.github.io/webdriver/#dfn-error-code" id=user-agent-automation:webdriver-error-code "WebDriver error code"
					a data-x-internal=invalid-argument href="https://w3c.github.io/webdriver/#dfn-invalid-argument" id=user-agent-automation:invalid-argument "invalid argument"
					- .
				}
			}
			li {
				p {
					- "Let "
					var mode
					- " be the result of "
					a data-x-internal=getting-a-property href="https://w3c.github.io/webdriver/#dfn-getting-properties" id=user-agent-automation:getting-a-property "getting a property"
					- " named \""
					code mode
					- "\" from "
					var parameters
					- .
				}
			}
			li {
				p {
					- "If "
					var mode
					- " is not \""
					code id=user-agent-automation:rph-automation-mode-auto-accept-2 {
						a href="#rph-automation-mode-auto-accept" autoAccept
					}
					- "\", \""
					code id=user-agent-automation:rph-automation-mode-auto-reject-2 {
						a href="#rph-automation-mode-auto-reject" autoReject
					}
					- "\", or \""
					code id=user-agent-automation:rph-automation-mode-none-2 {
						a href="#rph-automation-mode-none" none
					}
					- "\", return a "
					a data-x-internal=webdriver-error href="https://w3c.github.io/webdriver/#dfn-errors" id=user-agent-automation:webdriver-error-2 "WebDriver error"
					- " with "
					a data-x-internal=webdriver-error-code href="https://w3c.github.io/webdriver/#dfn-error-code" id=user-agent-automation:webdriver-error-code-2 "WebDriver error code"
					a data-x-internal=invalid-argument href="https://w3c.github.io/webdriver/#dfn-invalid-argument" id=user-agent-automation:invalid-argument-2 "invalid argument"
					- .
				}
			}
			li {
				p {
					- "Let "
					var document
					- " be the "
					a data-x-internal=webdriver-current-browsing-context href="https://w3c.github.io/webdriver/#dfn-current-browsing-context" id=user-agent-automation:webdriver-current-browsing-context "current browsing context"
					- "'s "
					a href="#active-document" id=user-agent-automation:active-document "active document"
					- .
				}
			}
			li {
