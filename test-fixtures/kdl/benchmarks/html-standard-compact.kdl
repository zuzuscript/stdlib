			}
			- ", "
			dfn id=iso-8859-8 {
				a href="https://encoding.spec.whatwg.org/#iso-8859-8" ISO-8859-8
			}
			- ", "
			dfn id=windows-874 {
				a href="https://encoding.spec.whatwg.org/#windows-874" windows-874
			}
			- ", "
			dfn id=windows-1250 {
				a href="https://encoding.spec.whatwg.org/#windows-1250" windows-1250
			}
			- ", "
			dfn id=windows-1251 {
				a href="https://encoding.spec.whatwg.org/#windows-1251" windows-1251
			}
			- ", "
			dfn id=windows-1252 {
				a href="https://encoding.spec.whatwg.org/#windows-1252" windows-1252
			}
			- ", "
			dfn id=windows-1254 {
				a href="https://encoding.spec.whatwg.org/#windows-1254" windows-1254
			}
			- ", "
			dfn id=windows-1255 {
				a href="https://encoding.spec.whatwg.org/#windows-1255" windows-1255
			}
			- ", "
			dfn id=windows-1256 {
				a href="https://encoding.spec.whatwg.org/#windows-1256" windows-1256
			}
			- ", "
			dfn id=windows-1257 {
				a href="https://encoding.spec.whatwg.org/#windows-1257" windows-1257
			}
			- ", "
			dfn id=windows-1258 {
				a href="https://encoding.spec.whatwg.org/#windows-1258" windows-1258
			}
			- ", "
			dfn id=gbk {
				a href="https://encoding.spec.whatwg.org/#gbk" GBK
			}
			- ", "
			dfn id=big5 {
				a href="https://encoding.spec.whatwg.org/#big5" Big5
			}
			- ", "
			dfn id=iso-2022-jp {
				a href="https://encoding.spec.whatwg.org/#iso-2022-jp" ISO-2022-JP
			}
			- ", "
			dfn id=shift_jis {
				a href="https://encoding.spec.whatwg.org/#shift_jis" Shift_JIS
			}
			- ", "
			dfn id=euc-kr {
				a href="https://encoding.spec.whatwg.org/#euc-kr" EUC-KR
			}
			- ", "
			dfn id=utf-16be {
				a href="https://encoding.spec.whatwg.org/#utf-16be" UTF-16BE
			}
			- ", "
			dfn id=utf-16le {
				a href="https://encoding.spec.whatwg.org/#utf-16le" UTF-16LE
			}
			- ", "
			dfn id=utf-16-encoding {
				a href="https://encoding.spec.whatwg.org/#utf-16be-le" "UTF-16BE/LE"
			}
			- ", and "
			dfn id=x-user-defined {
				a href="https://encoding.spec.whatwg.org/#x-user-defined" x-user-defined
			}
			- ". User agents must not support other encodings."
		}
		p class=note {
			- "The above prohibits supporting, for example, CESU-8, UTF-7, BOCU-1, SCSU, EBCDIC, and UTF-32. This specification does not make any attempt to support prohibited encodings in its algorithms; support and use of prohibited encodings would thus lead to unexpected behavior. "
			a href="#refsCESU8" "[CESU8]"
			a href="#refsUTF7" "[UTF7]"
			a href="#refsBOCU1" "[BOCU1]"
			a href="#refsSCSU" "[SCSU]"
		}
		h5 id=changing-the-encoding-while-parsing {
			span class=secno "13.2.3.4"
			- " Changing the encoding while parsing"
			a class=self-link href="#changing-the-encoding-while-parsing"
		}
		p {
			- "When the parser requires the user agent to "
			dfn id=change-the-encoding "change the encoding"
			- ", it must run the following steps. This might happen if the "
			a href="#encoding-sniffing-algorithm" id=changing-the-encoding-while-parsing:encoding-sniffing-algorithm "encoding sniffing algorithm"
			- " described above failed to find a character encoding, or if it found a character encoding that was not the actual encoding of the file."
		}
		ol {
			li {
				p {
					- "If the encoding that is already being used to interpret the input stream is "
					a data-x-internal=utf-16-encoding href="https://encoding.spec.whatwg.org/#utf-16be-le" id=changing-the-encoding-while-parsing:utf-16-encoding "UTF-16BE/LE"
					- ", then set the "
					a href="#concept-encoding-confidence" id=changing-the-encoding-while-parsing:concept-encoding-confidence confidence
					- " to "
					i certain
					- " and return. The new encoding is ignored; if it was anything but the same encoding, then it would be clearly incorrect."
				}
			}
			li {
				p {
					- "If the new encoding is "
					a data-x-internal=utf-16-encoding href="https://encoding.spec.whatwg.org/#utf-16be-le" id=changing-the-encoding-while-parsing:utf-16-encoding-2 "UTF-16BE/LE"
					- ", then change it to "
					a data-x-internal=utf-8 href="https://encoding.spec.whatwg.org/#utf-8" id=changing-the-encoding-while-parsing:utf-8 UTF-8
					- .
				}
			}
			li {
				p {
					- "If the new encoding is "
					a data-x-internal=x-user-defined href="https://encoding.spec.whatwg.org/#x-user-defined" id=changing-the-encoding-while-parsing:x-user-defined x-user-defined
					- ", then change it to "
					a data-x-internal=windows-1252 href="https://encoding.spec.whatwg.org/#windows-1252" id=changing-the-encoding-while-parsing:windows-1252 windows-1252
					- .
				}
			}
			li {
				p {
					- "If the new encoding is identical or equivalent to the encoding that is already being used to interpret the input stream, then set the "
					a href="#concept-encoding-confidence" id=changing-the-encoding-while-parsing:concept-encoding-confidence-2 confidence
					- " to "
					i certain
					- " and return. This happens when the encoding information found in the file matches what the "
					a href="#encoding-sniffing-algorithm" id=changing-the-encoding-while-parsing:encoding-sniffing-algorithm-2 "encoding sniffing algorithm"
					- " determined to be the encoding, and in the second pass through the parser if the first pass found that the encoding sniffing algorithm described in the earlier section failed to find the right encoding."
				}
			}
			li {
				p {
					- "If all the bytes up to the last byte converted by the current decoder have the same Unicode interpretations in both the current encoding and the new encoding, and if the user agent supports changing the converter on the fly, then the user agent may change to the new converter for the encoding on the fly. Set the "
					a data-x-internal=document's-character-encoding href="https://dom.spec.whatwg.org/#concept-document-encoding" id=changing-the-encoding-while-parsing:document's-character-encoding "document's character encoding"
					- " and the encoding used to convert the input stream to the new encoding, set the "
					a href="#concept-encoding-confidence" id=changing-the-encoding-while-parsing:concept-encoding-confidence-3 confidence
					- " to "
					i certain
					- ", and return."
				}
			}
			li {
				p {
					- "Otherwise, restart the "
					a href="#navigate" id=changing-the-encoding-while-parsing:navigate navigate
					- " algorithm, with "
					i id=changing-the-encoding-while-parsing:navigation-hh {
						a href="#navigation-hh" historyHandling
					}
					- " set to \""
					code id=changing-the-encoding-while-parsing:navigationhistorybehavior-replace {
						a href="#navigationhistorybehavior-replace" replace
					}
					- "\" and other inputs kept the same, but this time skip the "
					a href="#encoding-sniffing-algorithm" id=changing-the-encoding-while-parsing:encoding-sniffing-algorithm-3 "encoding sniffing algorithm"
					- " and instead just set the encoding to the new encoding and the "
					a href="#concept-encoding-confidence" id=changing-the-encoding-while-parsing:concept-encoding-confidence-4 confidence
					- " to "
					i certain
					- ". Whenever possible, this should be done without actually contacting the network layer (the bytes should be re-parsed from memory), even if, e.g., the document is marked as not being cacheable. If this is not possible and contacting the network layer would involve repeating a request that uses a method other than `"
					code GET
					- "`, then instead set the "
					a href="#concept-encoding-confidence" id=changing-the-encoding-while-parsing:concept-encoding-confidence-5 confidence
					- " to "
					i certain
					- " and ignore the new encoding. The resource will be misinterpreted. User agents may notify the user of the situation, to aid in application development."
				}
			}
		}
		p class=note {
			- "This algorithm is only invoked when a new encoding is found declared on a "
			code id=changing-the-encoding-while-parsing:the-meta-element {
				a href="#the-meta-element" meta
			}
			- " element."
		}
		h5 id=preprocessing-the-input-stream {
			span class=secno "13.2.3.5"
			- " Preprocessing the input stream"
			a class=self-link href="#preprocessing-the-input-stream"
		}
		p {
			- "The "
			dfn id=input-stream "input stream"
			- " consists of the characters pushed into it as the "
			a href="#the-input-byte-stream" id=preprocessing-the-input-stream:the-input-byte-stream "input byte stream"
			- " is decoded or from the various APIs that directly manipulate the input stream."
		}
		p {
			- "Any occurrences of "
			a data-x-internal=surrogate href="https://infra.spec.whatwg.org/#surrogate" id=preprocessing-the-input-stream:surrogate surrogates
			- " are "
			a href="#parse-error-surrogate-in-input-stream" id=preprocessing-the-input-stream:parse-error-surrogate-in-input-stream surrogate-in-input-stream
			a href="#parse-errors" id=preprocessing-the-input-stream:parse-errors "parse errors"
			- ". Any occurrences of "
			a data-x-internal=noncharacter href="https://infra.spec.whatwg.org/#noncharacter" id=preprocessing-the-input-stream:noncharacter noncharacters
			- " are "
			a href="#parse-error-noncharacter-in-input-stream" id=preprocessing-the-input-stream:parse-error-noncharacter-in-input-stream noncharacter-in-input-stream
			a href="#parse-errors" id=preprocessing-the-input-stream:parse-errors-2 "parse errors"
			- " and any occurrences of "
			a data-x-internal=control href="https://infra.spec.whatwg.org/#control" id=preprocessing-the-input-stream:control controls
			- " other than "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=preprocessing-the-input-stream:space-characters "ASCII whitespace"
			- " and U+0000 NULL characters are "
			a href="#parse-error-control-character-in-input-stream" id=preprocessing-the-input-stream:parse-error-control-character-in-input-stream control-character-in-input-stream
			a href="#parse-errors" id=preprocessing-the-input-stream:parse-errors-3 "parse errors"
			- .
		}
		p class=note "The handling of U+0000 NULL characters varies based on where the characters are found and happens at the later stages of the parsing. They are either ignored or, for security reasons, replaced with a U+FFFD REPLACEMENT CHARACTER. This handling is, by necessity, spread across both the tokenization stage and the tree construction stage."
		p {
			- "Before the "
			a href="#tokenization" id=preprocessing-the-input-stream:tokenization tokenization
			- " stage, the input stream must be preprocessed by "
			a data-x-internal=normalize-newlines href="https://infra.spec.whatwg.org/#normalize-newlines" id=preprocessing-the-input-stream:normalize-newlines "normalizing newlines"
			- ". Thus, newlines in HTML DOMs are represented by U+000A LF characters, and there are never any U+000D CR characters in the input to the "
			a href="#tokenization" id=preprocessing-the-input-stream:tokenization-2 tokenization
			- " stage."
		}
		p {
			- "The "
			dfn id=next-input-character "next input character"
			- " is the first character in the "
			a href="#input-stream" id=preprocessing-the-input-stream:input-stream "input stream"
			- " that has not yet been "
			dfn consumed
			- " or explicitly ignored by the requirements in this section. Initially, the "
			i id=preprocessing-the-input-stream:next-input-character {
				a href="#next-input-character" "next input character"
			}
			- " is the first character in the input. The "
			dfn id=current-input-character "current input character"
			- " is the last character to have been "
			i consumed
			- .
		}
		p {
			- "The "
			dfn id=insertion-point "insertion point"
			- " is the position (just before a character or just before the end of the input stream) where content inserted using "
			code id=preprocessing-the-input-stream:dom-document-write {
				a href="#dom-document-write" "document.write()"
			}
			- " is actually inserted. The insertion point is relative to the position of the character immediately after it, it is not an absolute offset into the input stream. Initially, the insertion point is undefined."
		}
		p {
			- "The \"EOF\" character in the tables below is a conceptual character representing the end of the "
			a href="#input-stream" id=preprocessing-the-input-stream:input-stream-2 "input stream"
			- ". If the parser is a "
			a href="#script-created-parser" id=preprocessing-the-input-stream:script-created-parser "script-created parser"
			- ", then the end of the "
			a href="#input-stream" id=preprocessing-the-input-stream:input-stream-3 "input stream"
			- " is reached when an "
			dfn id=explicit-eof-character "explicit \"EOF\" character"
			- " (inserted by the "
			code id=preprocessing-the-input-stream:dom-document-close {
				a href="#dom-document-close" "document.close()"
			}
			- " method) is consumed. Otherwise, the \"EOF\" character is not a real character in the stream, but rather the lack of any further characters."
		}
		h4 id=parse-state {
			span class=secno "13.2.4"
			- " Parse state"
			a class=self-link href="#parse-state"
		}
		h5 id=the-insertion-mode {
			span class=secno "13.2.4.1"
			- " The insertion mode"
			a class=self-link href="#the-insertion-mode"
		}
		p {
			- "The "
			dfn id=insertion-mode "insertion mode"
			- " is a state variable that controls the primary operation of the tree construction stage."
		}
		p {
			- "Initially, the "
			a href="#insertion-mode" id=the-insertion-mode:insertion-mode "insertion mode"
			- " is \""
			a href="#the-initial-insertion-mode" id=the-insertion-mode:the-initial-insertion-mode initial
			- "\". It can change to \""
			a href="#the-before-html-insertion-mode" id=the-insertion-mode:the-before-html-insertion-mode "before html"
			- "\", \""
			a href="#the-before-head-insertion-mode" id=the-insertion-mode:the-before-head-insertion-mode "before head"
			- "\", \""
			a href="#parsing-main-inhead" id=the-insertion-mode:parsing-main-inhead "in head"
			- "\", \""
			a href="#parsing-main-inheadnoscript" id=the-insertion-mode:parsing-main-inheadnoscript "in head noscript"
			- "\", \""
			a href="#the-after-head-insertion-mode" id=the-insertion-mode:the-after-head-insertion-mode "after head"
			- "\", \""
			a href="#parsing-main-inbody" id=the-insertion-mode:parsing-main-inbody "in body"
			- "\", \""
			a href="#parsing-main-incdata" id=the-insertion-mode:parsing-main-incdata text
			- "\", \""
			a href="#parsing-main-intable" id=the-insertion-mode:parsing-main-intable "in table"
			- "\", \""
			a href="#parsing-main-intabletext" id=the-insertion-mode:parsing-main-intabletext "in table text"
			- "\", \""
			a href="#parsing-main-incaption" id=the-insertion-mode:parsing-main-incaption "in caption"
			- "\", \""
			a href="#parsing-main-incolgroup" id=the-insertion-mode:parsing-main-incolgroup "in column group"
			- "\", \""
			a href="#parsing-main-intbody" id=the-insertion-mode:parsing-main-intbody "in table body"
			- "\", \""
			a href="#parsing-main-intr" id=the-insertion-mode:parsing-main-intr "in row"
			- "\", \""
			a href="#parsing-main-intd" id=the-insertion-mode:parsing-main-intd "in cell"
			- "\", \""
			a href="#parsing-main-inselect" id=the-insertion-mode:parsing-main-inselect "in select"
			- "\", \""
			a href="#parsing-main-inselectintable" id=the-insertion-mode:parsing-main-inselectintable "in select in table"
			- "\", \""
			a href="#parsing-main-intemplate" id=the-insertion-mode:parsing-main-intemplate "in template"
			- "\", \""
			a href="#parsing-main-afterbody" id=the-insertion-mode:parsing-main-afterbody "after body"
			- "\", \""
			a href="#parsing-main-inframeset" id=the-insertion-mode:parsing-main-inframeset "in frameset"
			- "\", \""
			a href="#parsing-main-afterframeset" id=the-insertion-mode:parsing-main-afterframeset "after frameset"
			- "\", \""
			a href="#the-after-after-body-insertion-mode" id=the-insertion-mode:the-after-after-body-insertion-mode "after after body"
			- "\", and \""
			a href="#the-after-after-frameset-insertion-mode" id=the-insertion-mode:the-after-after-frameset-insertion-mode "after after frameset"
			- "\" during the course of the parsing, as described in the "
			a href="#tree-construction" id=the-insertion-mode:tree-construction "tree construction"
			- " stage. The insertion mode affects how tokens are processed and whether CDATA sections are supported."
		}
		p {
			- "Several of these modes, namely \""
			a href="#parsing-main-inhead" id=the-insertion-mode:parsing-main-inhead-2 "in head"
			- "\", \""
			a href="#parsing-main-inbody" id=the-insertion-mode:parsing-main-inbody-2 "in body"
			- "\", \""
			a href="#parsing-main-intable" id=the-insertion-mode:parsing-main-intable-2 "in table"
			- "\", and \""
			a href="#parsing-main-inselect" id=the-insertion-mode:parsing-main-inselect-2 "in select"
			- "\", are special, in that the other modes defer to them at various times. When the algorithm below says that the user agent is to do something \""
			dfn id=using-the-rules-for "using the rules for"
			- " the "
			var m
			- " insertion mode\", where "
			var m
			- " is one of these modes, the user agent must use the rules described under the "
			var m
			a href="#insertion-mode" id=the-insertion-mode:insertion-mode-2 "insertion mode"
			- "'s section, but must leave the "
			a href="#insertion-mode" id=the-insertion-mode:insertion-mode-3 "insertion mode"
			- " unchanged unless the rules in "
			var m
			- " themselves switch the "
			a href="#insertion-mode" id=the-insertion-mode:insertion-mode-4 "insertion mode"
			- " to a new value."
		}
		p {
			- "When the insertion mode is switched to \""
			a href="#parsing-main-incdata" id=the-insertion-mode:parsing-main-incdata-2 text
			- "\" or \""
			a href="#parsing-main-intabletext" id=the-insertion-mode:parsing-main-intabletext-2 "in table text"
			- "\", the "
			dfn id=original-insertion-mode "original insertion mode"
			- " is also set. This is the insertion mode to which the tree construction stage will return."
		}
		p {
			- "Similarly, to parse nested "
			code id=the-insertion-mode:the-template-element {
				a href="#the-template-element" template
			}
			- " elements, a "
			dfn id=stack-of-template-insertion-modes "stack of template insertion modes"
			- " is used. It is initially empty. The "
			dfn id=current-template-insertion-mode "current template insertion mode"
			- " is the insertion mode that was most recently added to the "
			a href="#stack-of-template-insertion-modes" id=the-insertion-mode:stack-of-template-insertion-modes "stack of template insertion modes"
			- ". The algorithms in the sections below will "
			i push
			- " insertion modes onto this stack, meaning that the specified insertion mode is to be added to the stack, and "
			i pop
			- " insertion modes from the stack, which means that the most recently added insertion mode must be removed from the stack."
		}
		hr
		p {
			- "When the steps below require the UA to "
			dfn id=reset-the-insertion-mode-appropriately "reset the insertion mode appropriately"
			- ", it means the UA must follow these steps:"
		}
		ol {
			li {
				p {
					- "Let "
					var last
					- " be false."
				}
			}
			li {
				p {
					- "Let "
					var node
					- " be the last node in the "
					a href="#stack-of-open-elements" id=the-insertion-mode:stack-of-open-elements "stack of open elements"
					- .
				}
			}
			li {
				p {
					i Loop
					- ": If "
					var node
					- " is the first node in the stack of open elements, then set "
					var last
					- " to true, and, if the parser was created as part of the "
					a href="#html-fragment-parsing-algorithm" id=the-insertion-mode:html-fragment-parsing-algorithm "HTML fragment parsing algorithm"
					- " ("
					a href="#fragment-case" id=the-insertion-mode:fragment-case "fragment case"
					- "), set "
					var node
					- " to the "
					var id=the-insertion-mode:concept-frag-parse-context {
						a href="#concept-frag-parse-context" context
					}
					- " element passed to that algorithm."
				}
			}
			li {
				p {
					- "If "
					var node
					- " is a "
					code id=the-insertion-mode:the-select-element {
						a href="#the-select-element" select
					}
					- " element, run these substeps:"
				}
				ol {
					li {
						p {
							- "If "
							var last
							- " is true, jump to the step below labeled "
							i done
							- .
						}
					}
					li {
						p {
							- "Let "
							var ancestor
							- " be "
							var node
							- .
						}
					}
					li {
						p {
							i Loop
							- ": If "
							var ancestor
							- " is the first node in the "
							a href="#stack-of-open-elements" id=the-insertion-mode:stack-of-open-elements-2 "stack of open elements"
							- ", jump to the step below labeled "
							i done
							- .
						}
					}
					li {
						p {
							- "Let "
							var ancestor
							- " be the node before "
							var ancestor
							- " in the "
							a href="#stack-of-open-elements" id=the-insertion-mode:stack-of-open-elements-3 "stack of open elements"
							- .
						}
					}
					li {
						p {
							- "If "
							var ancestor
							- " is a "
							code id=the-insertion-mode:the-template-element-2 {
								a href="#the-template-element" template
							}
							- " node, jump to the step below labeled "
							i done
							- .
						}
					}
					li {
						p {
							- "If "
							var ancestor
							- " is a "
							code id=the-insertion-mode:the-table-element {
								a href="#the-table-element" table
							}
							- " node, switch the "
							a href="#insertion-mode" id=the-insertion-mode:insertion-mode-5 "insertion mode"
							- " to \""
							a href="#parsing-main-inselectintable" id=the-insertion-mode:parsing-main-inselectintable-2 "in select in table"
							- "\" and return."
						}
					}
					li {
						p {
							- "Jump back to the step labeled "
							i loop
							- .
						}
					}
					li {
						p {
							i Done
							- ": Switch the "
							a href="#insertion-mode" id=the-insertion-mode:insertion-mode-6 "insertion mode"
							- " to \""
