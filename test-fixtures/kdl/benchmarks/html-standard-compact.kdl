							}
							- .
						}
					}
					li {
						p {
							- "For same-document navigations created by using the "
							code id=navigation-api-initiating-navigations:dom-navigateevent-intercept-2 {
								a href="#dom-navigateevent-intercept" "navigateEvent.intercept()"
							}
							- " method, "
							code id=navigation-api-initiating-navigations:dom-navigationresult-committed-3 {
								a href="#dom-navigationresult-committed" committed
							}
							- " will fulfill immediately, and "
							code id=navigation-api-initiating-navigations:dom-navigationresult-finished-3 {
								a href="#dom-navigationresult-finished" finished
							}
							- " will fulfill or reject according to any promsies returned by handlers passed to "
							code id=navigation-api-initiating-navigations:dom-navigateevent-intercept-3 {
								a href="#dom-navigateevent-intercept" "intercept()"
							}
							- .
						}
					}
					li {
						p {
							- "For other same-document navigations (e.g., non-intercepted "
							a href="#navigate-fragid" id=navigation-api-initiating-navigations:navigate-fragid "fragment navigations"
							- "), both promises will fulfill immediately."
						}
