				a href="#before-attribute-name-state" id="after-attribute-value-(quoted)-state:before-attribute-name-state" "before attribute name state"
				- .
			}
			dt "U+002F SOLIDUS (/)"
			dd {
				- "Switch to the "
				a href="#self-closing-start-tag-state" id="after-attribute-value-(quoted)-state:self-closing-start-tag-state" "self-closing start tag state"
				- .
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
