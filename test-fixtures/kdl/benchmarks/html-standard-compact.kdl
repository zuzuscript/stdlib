						a href="#dom-media-seeking" seeking
					}
					- " IDL attribute to true."
				}
			}
			li {
				p {
					- "If the seek was in response to a DOM method call or setting of an IDL attribute, then continue the script. The remainder of these steps must be run "
					a href="#in-parallel" id=seeking:in-parallel "in parallel"
					- ". With the exception of the steps marked with ⌛, they could be aborted at any time by another instance of this algorithm being invoked."
				}
			}
			li {
				p {
					- "If the "
					var "new playback position"
					- " is later than the end of the "
					a href="#media-resource" id=seeking:media-resource-3 "media resource"
					- ", then let it be the end of the "
					a href="#media-resource" id=seeking:media-resource-4 "media resource"
					- " instead."
				}
			}
			li {
				p {
					- "If the "
					var "new playback position"
					- " is less than the "
					a href="#earliest-possible-position" id=seeking:earliest-possible-position "earliest possible position"
					- ", let it be that position instead."
				}
			}
			li {
				p {
					- "If the (possibly now changed) "
					var "new playback position"
					- " is not in one of the ranges given in the "
					code id=seeking:dom-media-seekable {
						a href="#dom-media-seekable" seekable
					}
					- " attribute, then let it be the position in one of the ranges given in the "
					code id=seeking:dom-media-seekable-2 {
						a href="#dom-media-seekable" seekable
					}
					- " attribute that is the nearest to the "
					var "new playback position"
					- ". If two positions both satisfy that constraint (i.e. the "
					var "new playback position"
					- " is exactly in the middle between two ranges in the "
					code id=seeking:dom-media-seekable-3 {
						a href="#dom-media-seekable" seekable
					}
					- " attribute) then use the position that is closest to the "
					a href="#current-playback-position" id=seeking:current-playback-position "current playback position"
					- ". If there are no ranges given in the "
					code id=seeking:dom-media-seekable-4 {
						a href="#dom-media-seekable" seekable
					}
					- " attribute then set the "
					code id=seeking:dom-media-seeking-3 {
						a href="#dom-media-seeking" seeking
					}
					- " IDL attribute to false and return."
				}
			}
			li {
				p {
					- "If the "
					i approximate-for-speed
					- " flag is set, adjust the "
					var "new playback position"
					- " to a value that will allow for playback to resume promptly. If "
					var "new playback position"
					- " before this step is before "
					a href="#current-playback-position" id=seeking:current-playback-position-2 "current playback position"
					- ", then the adjusted "
					var "new playback position"
					- " must also be before the "
					a href="#current-playback-position" id=seeking:current-playback-position-3 "current playback position"
					- ". Similarly, if the "
					var "new playback position"
					- " before this step is after "
					a href="#current-playback-position" id=seeking:current-playback-position-4 "current playback position"
					- ", then the adjusted "
					var "new playback position"
					- " must also be after the "
					a href="#current-playback-position" id=seeking:current-playback-position-5 "current playback position"
					- .
				}
				p class=example "For example, the user agent could snap to a nearby key frame, so that it doesn't have to spend time decoding then discarding intermediate frames before resuming playback."
			}
			li {
				p {
					a href="#queue-a-media-element-task" id=seeking:queue-a-media-element-task "Queue a media element task"
					- " given the "
					a href="#media-element" id=seeking:media-element-3 "media element"
					- " to "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=seeking:concept-event-fire "fire an event"
					- " named "
					code id=seeking:event-media-seeking {
						a href="#event-media-seeking" seeking
					}
					- " at the element."
				}
			}
			li {
				p {
					- "Set the "
					a href="#current-playback-position" id=seeking:current-playback-position-6 "current playback position"
					- " to the "
					var "new playback position"
					- .
				}
				p class=note {
					- "If the "
					a href="#media-element" id=seeking:media-element-4 "media element"
					- " was "
					a href="#potentially-playing" id=seeking:potentially-playing "potentially playing"
					- " immediately before it started seeking, but seeking caused its "
					code id=seeking:dom-media-readystate-2 {
						a href="#dom-media-readystate" readyState
					}
					- " attribute to change to a value lower than "
					code id=seeking:dom-media-have_future_data {
						a href="#dom-media-have_future_data" HAVE_FUTURE_DATA
					}
					- ", then a "
