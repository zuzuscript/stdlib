						dfn id=attr-area-shape-keyword-rectangle {
							code rectangle
						}
					}
					td class=no "No "
				}
			}
		}
		p {
			- "The attribute's "
			i id=the-area-element:missing-value-default {
				a href="#missing-value-default" "missing value default"
			}
			- " and "
			i id=the-area-element:invalid-value-default {
				a href="#invalid-value-default" "invalid value default"
			}
			- " are both the "
			a href="#attr-area-shape-rect" id=the-area-element:attr-area-shape-rect-2 rectangle
			- " state."
		}
		p {
			- "The "
			dfn data-dfn-for=area data-dfn-type=element-attr id=attr-area-coords {
				code coords
			}
			- " attribute must, if specified, contain a "
			a href="#valid-list-of-floating-point-numbers" id=the-area-element:valid-list-of-floating-point-numbers "valid list of floating-point numbers"
			- ". This attribute gives the coordinates for the shape described by the "
			code id=the-area-element:attr-area-shape-3 {
				a href="#attr-area-shape" shape
			}
			- " attribute. The processing for this attribute is described as part of the "
			a href="#image-map" id=the-area-element:image-map-6 "image map"
			- " processing model."
		}
		p {
			- "In the "
			dfn data-dfn-for="area/shape" data-dfn-type=attr-value id=attr-area-shape-circle "circle state"
			- ", "
			code id=the-area-element:the-area-element-7 {
				a href="#the-area-element" area
			}
			- " elements must have a "
			code id=the-area-element:attr-area-coords-7 {
				a href="#attr-area-coords" coords
			}
			- " attribute present, with three integers, the last of which must be non-negative. The first integer must be the distance in "
			a data-x-internal='px' href="https://drafts.csswg.org/css-values/#px" id=the-area-element:'px' "CSS pixels"
			- " from the left edge of the image to the center of the circle, the second integer must be the distance in "
			a data-x-internal='px' href="https://drafts.csswg.org/css-values/#px" id=the-area-element:'px'-2 "CSS pixels"
			- " from the top edge of the image to the center of the circle, and the third integer must be the radius of the circle, again in "
			a data-x-internal='px' href="https://drafts.csswg.org/css-values/#px" id=the-area-element:'px'-3 "CSS pixels"
			- .
		}
		p {
			- "In the "
			dfn data-dfn-for="area/shape" data-dfn-type=attr-value id=attr-area-shape-default "default state"
			- ", "
			code id=the-area-element:the-area-element-8 {
				a href="#the-area-element" area
			}
			- " elements must not have a "
			code id=the-area-element:attr-area-coords-8 {
				a href="#attr-area-coords" coords
			}
			- " attribute. (The area is the whole image.)"
		}
		p {
			- "In the "
			dfn data-dfn-for="area/shape" data-dfn-type=attr-value id=attr-area-shape-poly "polygon state"
			- ", "
			code id=the-area-element:the-area-element-9 {
				a href="#the-area-element" area
			}
			- " elements must have a "
			code id=the-area-element:attr-area-coords-9 {
				a href="#attr-area-coords" coords
			}
			- " attribute with at least six integers, and the number of integers must be even. Each pair of integers must represent a coordinate given as the distances from the left and the top of the image in "
			a data-x-internal='px' href="https://drafts.csswg.org/css-values/#px" id=the-area-element:'px'-4 "CSS pixels"
			- " respectively, and all the coordinates together must represent the points of the polygon, in order."
		}
		p {
			- "In the "
			dfn data-dfn-for="area/shape" data-dfn-type=attr-value id=attr-area-shape-rect "rectangle state"
			- ", "
			code id=the-area-element:the-area-element-10 {
				a href="#the-area-element" area
			}
			- " elements must have a "
			code id=the-area-element:attr-area-coords-10 {
				a href="#attr-area-coords" coords
			}
			- " attribute with exactly four integers, the first of which must be less than the third, and the second of which must be less than the fourth. The four points must represent, respectively, the distance from the left edge of the image to the left side of the rectangle, the distance from the top edge to the top side, the distance from the left edge to the right side, and the distance from the top edge to the bottom side, all in "
			a data-x-internal='px' href="https://drafts.csswg.org/css-values/#px" id=the-area-element:'px'-5 "CSS pixels"
			- .
		}
		p {
			- "When user agents allow users to "
			a href="#following-hyperlinks-2" id=the-area-element:following-hyperlinks-2 "follow hyperlinks"
			- " or "
			a href="#downloading-hyperlinks" id=the-area-element:downloading-hyperlinks "download hyperlinks"
			- " created using the "
			code id=the-area-element:the-area-element-11 {
				a href="#the-area-element" area
			}
			- " element, the "
			code id=the-area-element:attr-hyperlink-href-5 {
				a href="#attr-hyperlink-href" href
			}
			- ", "
			code id=the-area-element:attr-hyperlink-target-2 {
				a href="#attr-hyperlink-target" target
			}
			- ", "
			code id=the-area-element:attr-hyperlink-download-2 {
				a href="#attr-hyperlink-download" download
			}
			- ", and "
			code id=the-area-element:ping-2 {
				a href="#ping" ping
			}
			- " attributes decide how the link is followed. The "
			code id=the-area-element:attr-hyperlink-rel-2 {
				a href="#attr-hyperlink-rel" rel
			}
			- " attribute may be used to indicate to the user the likely nature of the target resource before the user follows the link."
		}
		p {
			- "The "
			code id=the-area-element:attr-hyperlink-target-3 {
				a href="#attr-hyperlink-target" target
			}
			- ", "
			code id=the-area-element:attr-hyperlink-download-3 {
				a href="#attr-hyperlink-download" download
			}
			- ", "
			code id=the-area-element:ping-3 {
				a href="#ping" ping
			}
			- ", "
			code id=the-area-element:attr-hyperlink-rel-3 {
				a href="#attr-hyperlink-rel" rel
			}
			- ", and "
			code id=the-area-element:attr-hyperlink-referrerpolicy-2 {
				a href="#attr-hyperlink-referrerpolicy" referrerpolicy
			}
			- " attributes must be omitted if the "
			code id=the-area-element:attr-hyperlink-href-6 {
				a href="#attr-hyperlink-href" href
			}
			- " attribute is not present."
		}
		p {
			- "If the "
			code id=the-area-element:names:-the-itemprop-attribute {
				a href="#names:-the-itemprop-attribute" itemprop
			}
			- " attribute is specified on an "
