				a href="#handler-onerror" onerror
			}
			a href="#event-handler-content-attributes" id=the-body-element:event-handler-content-attributes-3 "event handler content attribute"
			- " on the "
			code id=the-body-element:the-body-element-12 {
				a href="#the-body-element" body
			}
			- " element. This is because the event would bubble from the target, to the "
			code id=the-body-element:the-body-element-13 {
				a href="#the-body-element" body
			}
			- ", to the "
			code id=the-body-element:the-html-element-3 {
				a href="#the-html-element" html
			}
			- ", to the "
			code id=the-body-element:document-2 {
				a href="#document" Document
			}
			- ", to the "
			code id=the-body-element:window-3 {
				a href="#window" Window
			}
			- ", and the "
			a href="#event-handlers" id=the-body-element:event-handlers-4 "event handler"
			- " on the "
			code id=the-body-element:the-body-element-14 {
				a href="#the-body-element" body
			}
			- " is watching the "
			code id=the-body-element:window-4 {
				a href="#window" Window
			}
			- " not the "
			code id=the-body-element:the-body-element-15 {
				a href="#the-body-element" body
			}
			- ". A regular event listener attached to the "
			code id=the-body-element:the-body-element-16 {
				a href="#the-body-element" body
			}
			- " using "
			code "addEventListener()"
