				tr {
					td class=non-rectangular-cell-indentation rowspan="5" {					}
					td colspan="3" {
						- "\""
						dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" data-dfn-type=attr-value id=attr-fe-autocomplete-honorific-prefix {
							code honorific-prefix
						}
						- "\" "
					}
					td {
						- "Prefix or title (e.g. \"Mr.\", \"Ms.\", \"Dr.\", \""
						span lang=fr {
							- M
