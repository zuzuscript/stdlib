									- " and "
									a data-x-internal=ascii-digits href="https://infra.spec.whatwg.org/#ascii-digit" id=lists-of-dimensions:ascii-digits-3 "ASCII digits"
									- " from "
									var input
									- " given "
									var position
									- ". Let "
									var s
									- " be the resulting sequence."
								}
							}
							li {
								p {
