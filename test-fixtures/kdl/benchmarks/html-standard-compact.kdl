					}
					dt Otherwise:
					dd {
						p {
							- "While the "
							a href="#pending-parsing-blocking-script" id=parsing-main-incdata:pending-parsing-blocking-script-2 "pending parsing-blocking script"
							- " is not null:"
						}
						ol {
							li {
								p {
									- "Let "
									var "the script"
									- " be the "
									a href="#pending-parsing-blocking-script" id=parsing-main-incdata:pending-parsing-blocking-script-3 "pending parsing-blocking script"
									- .
								}
							}
							li {
								p {
									- "Set the "
									a href="#pending-parsing-blocking-script" id=parsing-main-incdata:pending-parsing-blocking-script-4 "pending parsing-blocking script"
									- " to null."
								}
							}
							li {
								p {
									a href="#start-the-speculative-html-parser" id=parsing-main-incdata:start-the-speculative-html-parser "Start the speculative HTML parser"
									- " for this instance of the HTML parser."
								}
							}
							li {
								p {
									- "Block the "
									a href="#tokenization" id=parsing-main-incdata:tokenization tokenizer
									- " for this instance of the "
									a href="#html-parser" id=parsing-main-incdata:html-parser "HTML parser"
									- ", such that the "
									a href="#event-loop" id=parsing-main-incdata:event-loop "event loop"
									- " will not run "
									a href="#concept-task" id=parsing-main-incdata:concept-task tasks
									- " that invoke the "
									a href="#tokenization" id=parsing-main-incdata:tokenization-2 tokenizer
									- .
								}
							}
							li {
								p {
									- "If the parser's "
									code id=parsing-main-incdata:document {
										a href="#document" Document
									}
									a href="#has-a-style-sheet-that-is-blocking-scripts" id=parsing-main-incdata:has-a-style-sheet-that-is-blocking-scripts "has a style sheet that is blocking scripts"
									- " or "
									var "the script"
									- "'s "
									a href="#ready-to-be-parser-executed" id=parsing-main-incdata:ready-to-be-parser-executed "ready to be parser-executed"
									- " is false: "
									a href="#spin-the-event-loop" id=parsing-main-incdata:spin-the-event-loop "spin the event loop"
									- " until the parser's "
									code id=parsing-main-incdata:document-2 {
										a href="#document" Document
									}
									a href="#has-no-style-sheet-that-is-blocking-scripts" id=parsing-main-incdata:has-no-style-sheet-that-is-blocking-scripts "has no style sheet that is blocking scripts"
									- " and "
									var "the script"
									- "'s "
									a href="#ready-to-be-parser-executed" id=parsing-main-incdata:ready-to-be-parser-executed-2 "ready to be parser-executed"
									- " becomes true."
								}
							}
							li {
								p {
									- "If this "
									a href="#abort-a-parser" id=parsing-main-incdata:abort-a-parser "parser has been aborted"
