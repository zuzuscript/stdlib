			- "An "
			code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-18 {
				a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
			}
			- " object also has an "
			dfn id=offscreencontext2d-alpha alpha
			- " flag, which can be set to true or false. Initially, when the context is created, its alpha flag must be set to true. When an "
			code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-19 {
				a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
			}
			- " object has its "
			a href="#offscreencontext2d-alpha" id=the-offscreen-2d-rendering-context:offscreencontext2d-alpha alpha
			- " flag set to false, then its alpha channel must be fixed to 1.0 (fully opaque) for all pixels, and attempts to change the alpha component of any pixel must be silently ignored."
		}
		p {
			- "An "
			code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-20 {
				a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
			}
			- " object also has a "
			dfn id=offscreencontext2d-color-space "color space"
			- " setting of type "
			code id=the-offscreen-2d-rendering-context:predefinedcolorspace {
				a href="#predefinedcolorspace" PredefinedColorSpace
			}
			- ". The color space for the context's "
			a href="#offscreencontext2d-bitmap" id=the-offscreen-2d-rendering-context:offscreencontext2d-bitmap-2 bitmap
			- " is set to the context's "
			a href="#offscreencontext2d-color-space" id=the-offscreen-2d-rendering-context:offscreencontext2d-color-space "color space"
			- .
		}
		p {
			- "An "
			code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-21 {
				a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
			}
			- " object has an "
			dfn id=associated-offscreencanvas-object {
				- "associated "
				code OffscreenCanvas
				- " object"
			}
			- ", which is the "
			code id=the-offscreen-2d-rendering-context:offscreencanvas-4 {
				a href="#offscreencanvas" OffscreenCanvas
			}
			- " object from which the "
			code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-22 {
				a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
			}
			- " object was created. "
		}
		dl class=domintro {
			dt {
				code {
					var offscreenCanvas
					- " = "
					var offscreenCanvasRenderingContext2D
					- .
					a href="#offscreencontext2d-canvas" id=offscreencontext2d-canvas-dev canvas
				}
			}
			dd {
				p {
					- "Returns the "
					a href="#associated-offscreencanvas-object" id=the-offscreen-2d-rendering-context:associated-offscreencanvas-object {
						- "associated "
						code OffscreenCanvas
						- " object"
					}
					- .
				}
			}
		}
		p {
			- "The "
			dfn id=offscreen-2d-context-creation-algorithm "offscreen 2D context creation algorithm"
			- ", which is passed a "
			var target
			- " (an "
			code id=the-offscreen-2d-rendering-context:offscreencanvas-5 {
				a href="#offscreencanvas" OffscreenCanvas
			}
			- " object) and optionally some arguments, consists of running the following steps:"
		}
		ol {
			li {
				p {
					- "If the algorithm was passed some arguments, let "
					var arg
					- " be the first such argument. Otherwise, let "
					var arg
					- " be undefined."
				}
			}
			li {
				p {
					- "Let "
					var settings
					- " be the result of "
					a data-x-internal=concept-idl-convert href="https://webidl.spec.whatwg.org/#es-type-mapping" id=the-offscreen-2d-rendering-context:concept-idl-convert converting
					var arg
					- " to the dictionary type "
					code id=the-offscreen-2d-rendering-context:canvasrenderingcontext2dsettings {
						a href="#canvasrenderingcontext2dsettings" CanvasRenderingContext2DSettings
					}
					- ". (This can throw an exception.)."
				}
			}
			li {
				p {
					- "Let "
					var context
					- " be a new "
					code id=the-offscreen-2d-rendering-context:offscreencanvasrenderingcontext2d-23 {
						a href="#offscreencanvasrenderingcontext2d" OffscreenCanvasRenderingContext2D
					}
					- " object."
				}
			}
			li {
				p {
					- "Set "
					var context
					- "'s "
					a href="#associated-offscreencanvas-object" id=the-offscreen-2d-rendering-context:associated-offscreencanvas-object-2 {
						- "associated "
						code OffscreenCanvas
						- " object"
					}
					- " to "
					var target
					- .
				}
			}
			li {
				p {
					- "If "
					var settings
					- "[\""
					code id=the-offscreen-2d-rendering-context:dom-canvasrenderingcontext2dsettings-alpha {
						a href="#dom-canvasrenderingcontext2dsettings-alpha" alpha
					}
					- "\"] is false, then set "
					var context
					- "'s "
					a href="#offscreencontext2d-alpha" id=the-offscreen-2d-rendering-context:offscreencontext2d-alpha-2 alpha
					- " flag to false."
				}
			}
			li {
				p {
					- "Set "
					var context
					- "'s "
					a href="#offscreencontext2d-color-space" id=the-offscreen-2d-rendering-context:offscreencontext2d-color-space-2 "color space"
					- " to "
					var settings
					- "[\""
					code id=the-offscreen-2d-rendering-context:dom-canvasrenderingcontext2dsettings-colorspace {
						a href="#dom-canvasrenderingcontext2dsettings-colorspace" colorSpace
					}
					- "\"]."
				}
			}
			li {
				p {
					- "Set "
					var context
					- "'s "
					a href="#offscreencontext2d-bitmap" id=the-offscreen-2d-rendering-context:offscreencontext2d-bitmap-3 bitmap
					- " to a newly created bitmap with the dimensions specified by the "
					code id=the-offscreen-2d-rendering-context:dom-offscreencanvas-width {
						a href="#dom-offscreencanvas-width" width
					}
					- " and "
					code id=the-offscreen-2d-rendering-context:dom-offscreencanvas-height {
						a href="#dom-offscreencanvas-height" height
