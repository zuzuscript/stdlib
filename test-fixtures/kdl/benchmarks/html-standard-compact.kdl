		p {
			- "All "
			a href="#html-elements" id=the-draggable-attribute:html-elements "HTML elements"
			- " may have the "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-draggable {
				code draggable
			}
			- " content attribute set. The "
			code id=the-draggable-attribute:attr-draggable-2 {
				a href="#attr-draggable" draggable
			}
			- " attribute is an "
			a href="#enumerated-attribute" id=the-draggable-attribute:enumerated-attribute "enumerated attribute"
			- " with the following keywords and states:"
		}
		table {
			thead {
