								a href="#attr-area-shape-poly" id=image-map-processing-model:attr-area-shape-poly "Polygon state"
							}
							td "6 "
						}
						tr {
							td {
								a href="#attr-area-shape-rect" id=image-map-processing-model:attr-area-shape-rect "Rectangle state"
							}
