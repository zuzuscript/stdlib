		p {
			- "The "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=attribute id=dom-media-seeking {
				code seeking
			}
			- " attribute must initially have the value false."
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=method id=dom-media-fastseek {
				code {
					- "fastSeek("
					var time
					- ")"
				}
			}
			- " method must "
			a href="#dom-media-seek" id=seeking:dom-media-seek seek
			- " to the time given by "
			var time
			- ", with the "
			i approximate-for-speed
			- " flag set."
		}
		p {
			- "When the user agent is required to "
			dfn id=dom-media-seek seek
			- " to a particular "
			var "new playback position"
			- " in the "
			a href="#media-resource" id=seeking:media-resource-2 "media resource"
			- ", optionally with the "
			i approximate-for-speed
			- " flag set, it means that the user agent must run the following steps. This algorithm interacts closely with the "
			a href="#event-loop" id=seeking:event-loop "event loop"
			- " mechanism; in particular, it has a "
			a href="#synchronous-section" id=seeking:synchronous-section "synchronous section"
			- " (which is triggered as part of the "
			a href="#event-loop" id=seeking:event-loop-2 "event loop"
			- " algorithm). Steps in that section are marked with ⌛."
		}
		ol {
			li {
				p {
					- "Set the "
					a href="#media-element" id=seeking:media-element "media element"
					- "'s "
					a href="#show-poster-flag" id=seeking:show-poster-flag "show poster flag"
					- " to false."
				}
			}
			li {
				p {
					- "If the "
					a href="#media-element" id=seeking:media-element-2 "media element"
					- "'s "
					code id=seeking:dom-media-readystate {
						a href="#dom-media-readystate" readyState
					}
					- " is "
