				}
				c- p="" "</"
				c- f="" form
				c- p="" >
			}
		}
		p {
			- "Finally, to make the form submittable we use the "
			code id=writing-a-form's-user-interface:the-button-element {
				a href="#the-button-element" button
			}
			- " element:"
		}
