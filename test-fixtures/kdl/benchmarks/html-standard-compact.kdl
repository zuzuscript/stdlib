						dfn id=concept-autocorrection-on on
					}
					td rowspan="2" "The user agent is permitted to automatically correct spelling errors while the user types. Whether spelling is automatically corrected while typing left is for the user agent to decide, and may depend on the element as well as the user's preferences. "
				}
				tr {
					td "(the empty string) "
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocorrect" data-dfn-type=attr-value id=attr-autocorrect-off {
							code off
						}
					}
					td {
						dfn id=concept-autocorrection-off off
					}
					td "The user agent is not allowed to automatically correct spelling while the user types. "
				}
			}
		}
		p {
			- "The attribute's "
			i id=autocorrection:invalid-value-default {
				a href="#invalid-value-default" "invalid value default"
			}
			- " and "
			i id=autocorrection:missing-value-default {
				a href="#missing-value-default" "missing value default"
			}
			- " are both the "
