			- " consists of a specific "
			a href="#proleptic-gregorian-date" id=local-dates-and-times:proleptic-gregorian-date "proleptic-Gregorian date"
			- ", consisting of a year, a month, and a day, and a time, consisting of an hour, a minute, a second, and a fraction of a second, but expressed without a time zone. "
			a href="#refsGREGORIAN" "[GREGORIAN]"
		}
		p {
			- "A string is a "
