					- " for the token."
				}
			}
			dt "An end tag whose tag name is \"frameset\""
			dd {
				p {
					- "If the "
					a href="#current-node" id=parsing-main-inframeset:current-node "current node"
					- " is the root "
					code id=parsing-main-inframeset:the-html-element {
						a href="#the-html-element" html
					}
					- " element, then this is a "
					a href="#parse-errors" id=parsing-main-inframeset:parse-errors-2 "parse error"
					- "; ignore the token. ("
					a href="#fragment-case" id=parsing-main-inframeset:fragment-case "fragment case"
					- ")"
				}
				p {
					- "Otherwise, pop the "
					a href="#current-node" id=parsing-main-inframeset:current-node-2 "current node"
					- " from the "
					a href="#stack-of-open-elements" id=parsing-main-inframeset:stack-of-open-elements "stack of open elements"
					- .
				}
				p {
					- "If the parser was not created as part of the "
					a href="#html-fragment-parsing-algorithm" id=parsing-main-inframeset:html-fragment-parsing-algorithm "HTML fragment parsing algorithm"
					- " ("
					a href="#fragment-case" id=parsing-main-inframeset:fragment-case-2 "fragment case"
					- "), and the "
					a href="#current-node" id=parsing-main-inframeset:current-node-3 "current node"
					- " is no longer a "
					code id=parsing-main-inframeset:frameset {
						a href="#frameset" frameset
					}
					- " element, then switch the "
					a href="#insertion-mode" id=parsing-main-inframeset:insertion-mode-3 "insertion mode"
					- " to \""
					a href="#parsing-main-afterframeset" id=parsing-main-inframeset:parsing-main-afterframeset "after frameset"
					- "\"."
				}
			}
			dt "A start tag whose tag name is \"frame\""
			dd {
				p {
					a href="#insert-an-html-element" id=parsing-main-inframeset:insert-an-html-element-2 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inframeset:current-node-4 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inframeset:stack-of-open-elements-2 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inframeset:acknowledge-self-closing-flag {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
			}
			dt "A start tag whose tag name is \"noframes\""
			dd {
				p {
					- "Process the token "
					a href="#using-the-rules-for" id=parsing-main-inframeset:using-the-rules-for-2 "using the rules for"
					- " the \""
					a href="#parsing-main-inhead" id=parsing-main-inframeset:parsing-main-inhead "in head"
					- "\" "
					a href="#insertion-mode" id=parsing-main-inframeset:insertion-mode-4 "insertion mode"
					- .
				}
			}
			dt "An end-of-file token"
			dd {
				p {
					- "If the "
					a href="#current-node" id=parsing-main-inframeset:current-node-5 "current node"
					- " is not the root "
					code id=parsing-main-inframeset:the-html-element-2 {
						a href="#the-html-element" html
					}
					- " element, then this is a "
					a href="#parse-errors" id=parsing-main-inframeset:parse-errors-3 "parse error"
					- .
				}
				p class=note {
					- "The "
					a href="#current-node" id=parsing-main-inframeset:current-node-6 "current node"
					- " can only be the root "
					code id=parsing-main-inframeset:the-html-element-3 {
						a href="#the-html-element" html
					}
					- " element in the "
					a href="#fragment-case" id=parsing-main-inframeset:fragment-case-3 "fragment case"
					- .
				}
				p {
					a href="#stop-parsing" id=parsing-main-inframeset:stop-parsing "Stop parsing"
					- .
				}
			}
			dt "Anything else"
			dd {
				p {
					a href="#parse-errors" id=parsing-main-inframeset:parse-errors-4 "Parse error"
					- ". Ignore the token."
				}
			}
		}
