			li {
				p "If that returned null, then return. The image is not associated with an image map after all."
			}
			li {
				p {
					- "Otherwise, the user agent must collect all the "
					code id=image-map-processing-model:the-area-element {
						a href="#the-area-element" area
					}
					- " elements that are descendants of the "
					var map
