					c- f="" h2
					c- p="" >
					- Fluffy
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "Fluffy is my favorite."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" img
					c- e="" src
					c- o="" "="
					c- s="" "\"fluffy.jpg\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"She likes playing with a ball of yarn.\""
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "She's just too cute."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- Miles
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "My other cat, Miles just eats and sleeps."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" article
					c- p="" >
				}
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" article
					c- p="" >
					c- p="" <
					c- f="" h1
					c- p="" >
					- Photography
					c- p="" "</"
					c- f="" h1
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "Shooting moving targets indoors"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "The trick here is to know how to anticipate; to know at what speed and what distance the subject will pass by."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" img
					c- e="" src
					c- o="" "="
					c- s="" "\"fluffy.jpg\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"A cat flying by, chasing a ball of yarn, can be"
					c- s="" " photographed quite nicely using this technique.\""
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "Nature by night"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "To achieve this, you'll need either an extremely sensitive film, or immense flash lights."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" article
					c- p="" >
				}
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" article
					c- p="" >
					c- p="" <
					c- f="" h1
					c- p="" >
					- "About me"
					c- p="" "</"
					c- f="" h1
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "My pets"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
