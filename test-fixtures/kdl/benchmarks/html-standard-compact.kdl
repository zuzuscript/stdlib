					c- p="" "("
					- e
					c- p="" .
					- "origin "
					c- o="" "=="
					c- t="" "'https://example.com'"
					c- p="" ")"
					c- p="" "{"
					c- k="" if
					c- p="" "("
					- e
					c- p="" .
					- "data "
					c- o="" "=="
					c- t="" "'Hello world'"
					c- p="" ")"
					c- p="" "{"
					- " e"
