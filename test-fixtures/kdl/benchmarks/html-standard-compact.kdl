					- postMessage
					c- p="" "("
					c- t="" 'Hello'
					c- p="" ,
					- " e"
					c- p="" .
					- origin
					c- p="" ");"
					c- p="" "}"
					c- k="" else
					c- p="" "{"
					- " alert"
					c- p="" "("
					- e
					c- p="" .
