			}
			- " element "
			a href="#represents" id=the-textarea-element:represents represents
			- " a multiline plain text edit control for the element's "
			dfn id=concept-textarea-raw-value "raw value"
			- ". The contents of the control represent the control's default value."
		}
		p {
			- "The "
			a href="#concept-textarea-raw-value" id=the-textarea-element:concept-textarea-raw-value "raw value"
			- " of a "
			code id=the-textarea-element:the-textarea-element-2 {
				a href="#the-textarea-element" textarea
			}
			- " control must be initially the empty string."
		}
		p class=note {
			- "This element "
			a href="#bidireq" "has rendering requirements involving the bidirectional algorithm"
			- .
		}
		p {
			- "The "
			dfn data-dfn-for=textarea data-dfn-type=element-attr id=attr-textarea-readonly {
				code readonly
			}
			- " attribute is a "
			a href="#boolean-attribute" id=the-textarea-element:boolean-attribute "boolean attribute"
			- " used to control whether the text can be edited by the user or not."
		}
		div class=example {
			p "In this example, a text control is marked read-only because it represents a read-only file:"
			pre {
				code class=html {
					- "Filename: "
					c- p="" <
					c- f="" code
					c- p="" >
					- "/etc/bash.bashrc"
					c- p="" "</"
					c- f="" code
					c- p="" >
					c- p="" <
					c- f="" textarea
					c- e="" name
					c- o="" "="
					c- s="" "\"buffer\""
					c- e="" readonly
					c- p="" >
					- " # System-wide .bashrc file for interactive bash(1) shells. # To enable the settings / commands in this file for login shells as well, # this file has to be sourced in /etc/profile. # If not running interactively, don't do anything [ -z \"$PS1\" ] "
					c- ni="" "&amp;&amp;"
					- " return ..."
					c- p="" "</"
					c- f="" textarea
					c- p="" >
				}
			}
		}
		p {
