				- " set; otherwise true"
			}
			dt {
				a href="#source-snapshot-params-client" id=navigation-supporting-concepts:source-snapshot-params-client "fetch client"
			}
			dd {
				var sourceDocument
				- "'s "
				a href="#relevant-settings-object" id=navigation-supporting-concepts:relevant-settings-object "relevant settings object"
			}
			dt {
				a href="#source-snapshot-params-policy-container" id=navigation-supporting-concepts:source-snapshot-params-policy-container "source policy container"
			}
			dd {
				var sourceDocument
				- "'s "
				a href="#concept-document-policy-container" id=navigation-supporting-concepts:concept-document-policy-container "policy container"
			}
		}
		hr
		p {
			- "The "
			dfn id=target-snapshot-params "target snapshot params"
			a data-x-internal=struct href="https://infra.spec.whatwg.org/#struct" id=navigation-supporting-concepts:struct-2 struct
			- " is used to capture data from a "
			a href="#navigable" id=navigation-supporting-concepts:navigable navigable
			- " being navigated. Like "
			a href="#source-snapshot-params" id=navigation-supporting-concepts:source-snapshot-params-2 "source snapshot params"
			- ", it is snapshotted at the beginning of a navigation and used throughout the navigation's lifetime. It has the following "
			a data-x-internal=struct-item href="https://infra.spec.whatwg.org/#struct-item" id=navigation-supporting-concepts:struct-item-2 items
			- :
		}
		dl {
			dt {
				dfn id=target-snapshot-params-sandbox "sandboxing flags"
			}
			dd {
				- "a "
				a href="#sandboxing-flag-set" id=navigation-supporting-concepts:sandboxing-flag-set-2 "sandboxing flag set"
			}
		}
		p {
			- "To "
			dfn id=snapshotting-target-snapshot-params "snapshot target snapshot params"
			- " given a "
			a href="#navigable" id=navigation-supporting-concepts:navigable-2 navigable
			var targetNavigable
			- ", return a new "
			a href="#target-snapshot-params" id=navigation-supporting-concepts:target-snapshot-params "target snapshot params"
			- " with "
			a href="#target-snapshot-params-sandbox" id=navigation-supporting-concepts:target-snapshot-params-sandbox "sandboxing flags"
			- " set to the result of "
			a href="#determining-the-creation-sandboxing-flags" id=navigation-supporting-concepts:determining-the-creation-sandboxing-flags "determining the creation sandboxing flags"
			- " given "
			var targetNavigable
			- "'s "
			a href="#nav-bc" id=navigation-supporting-concepts:nav-bc "active browsing context"
			- " and "
			var targetNavigable
			- "'s "
			a href="#nav-container" id=navigation-supporting-concepts:nav-container container
			- .
		}
		hr
		p {
			- "Much of the navigation process is concerned with determining how to create a new "
			code id=navigation-supporting-concepts:document-3 {
				a href="#document" Document
			}
			- ", which ultimately happens in the "
			a href="#initialise-the-document-object" id=navigation-supporting-concepts:initialise-the-document-object {
				- "create and initialize a "
				code Document
				- " object"
			}
			- " algorithm. The parameters to that algorithm are tracked via a "
			dfn id=navigation-params "navigation params"
			a data-x-internal=struct href="https://infra.spec.whatwg.org/#struct" id=navigation-supporting-concepts:struct-3 struct
			- ", which has the following "
			a data-x-internal=struct-item href="https://infra.spec.whatwg.org/#struct-item" id=navigation-supporting-concepts:struct-item-3 items
			- :
		}
		dl {
			dt {
				dfn id=navigation-params-id id
			}
			dd {
				- "null or a "
				a href="#navigation-id" id=navigation-supporting-concepts:navigation-id "navigation ID"
			}
			dt {
				dfn id=navigation-params-navigable navigable
			}
			dd {
				- "the "
				a href="#navigable" id=navigation-supporting-concepts:navigable-3 navigable
				- " to be navigated"
			}
			dt {
				dfn id=navigation-params-request request
			}
			dd {
				- "null or a "
				a data-x-internal=concept-request href="https://fetch.spec.whatwg.org/#concept-request" id=navigation-supporting-concepts:concept-request request
				- " that started the navigation"
			}
			dt {
				dfn id=navigation-params-response response
			}
			dd {
				- "a "
				a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=navigation-supporting-concepts:concept-response response
				- " that ultimately was navigated to (potentially a "
				a data-x-internal=network-error href="https://fetch.spec.whatwg.org/#concept-network-error" id=navigation-supporting-concepts:network-error "network error"
				- ")"
			}
			dt {
				dfn id=navigation-params-fetch-controller "fetch controller"
			}
			dd {
				- "null or a "
