			}
		}
		p {
			- "You can again also use the "
			code id=communicating-with-a-dedicated-worker:dom-eventtarget-addeventlistener-2 {
				a data-x-internal=dom-eventtarget-addeventlistener href="https://dom.spec.whatwg.org/#dom-eventtarget-addeventlistener" "addEventListener()"
			}
			- " method."
		}
		p {
			- "In either case, the data is provided in the event object's "
