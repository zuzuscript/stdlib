			}
			dt "An end-of-file token"
			dd {
				p {
					a href="#parse-errors" id=parsing-main-incdata:parse-errors "Parse error"
					- .
				}
				p {
					- "If the "
					a href="#current-node" id=parsing-main-incdata:current-node "current node"
					- " is a "
					code id=parsing-main-incdata:the-script-element {
						a href="#the-script-element" script
					}
					- " element, then set its "
					a href="#already-started" id=parsing-main-incdata:already-started "already started"
					- " to true."
				}
				p {
					- "Pop the "
					a href="#current-node" id=parsing-main-incdata:current-node-2 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-incdata:stack-of-open-elements "stack of open elements"
					- .
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=parsing-main-incdata:insertion-mode-2 "insertion mode"
					- " to the "
					a href="#original-insertion-mode" id=parsing-main-incdata:original-insertion-mode "original insertion mode"
					- " and reprocess the token."
				}
			}
			dt id=scriptEndTag "An end tag whose tag name is \"script\""
			dd {
				p {
					- "If the "
					a href="#active-speculative-html-parser" id=parsing-main-incdata:active-speculative-html-parser "active speculative HTML parser"
					- " is null and the "
					a data-x-internal=javascript-execution-context-stack href="https://tc39.es/ecma262/#execution-context-stack" id=parsing-main-incdata:javascript-execution-context-stack "JavaScript execution context stack"
					- " is empty, then "
					a href="#perform-a-microtask-checkpoint" id=parsing-main-incdata:perform-a-microtask-checkpoint "perform a microtask checkpoint"
					- .
				}
				p {
					- "Let "
					var script
					- " be the "
					a href="#current-node" id=parsing-main-incdata:current-node-3 "current node"
					- " (which will be a "
					code id=parsing-main-incdata:the-script-element-2 {
						a href="#the-script-element" script
					}
					- " element)."
				}
				p {
					- "Pop the "
					a href="#current-node" id=parsing-main-incdata:current-node-4 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-incdata:stack-of-open-elements-2 "stack of open elements"
					- .
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=parsing-main-incdata:insertion-mode-3 "insertion mode"
					- " to the "
					a href="#original-insertion-mode" id=parsing-main-incdata:original-insertion-mode-2 "original insertion mode"
					- .
				}
				p {
					- "Let the "
					var "old insertion point"
					- " have the same value as the current "
					a href="#insertion-point" id=parsing-main-incdata:insertion-point "insertion point"
					- ". Let the "
					a href="#insertion-point" id=parsing-main-incdata:insertion-point-2 "insertion point"
					- " be just before the "
					a href="#next-input-character" id=parsing-main-incdata:next-input-character "next input character"
					- .
				}
				p {
					- "Increment the parser's "
					a href="#script-nesting-level" id=parsing-main-incdata:script-nesting-level "script nesting level"
					- " by one."
				}
				p {
					- "If the "
					a href="#active-speculative-html-parser" id=parsing-main-incdata:active-speculative-html-parser-2 "active speculative HTML parser"
					- " is null, then "
					a href="#prepare-the-script-element" id=parsing-main-incdata:prepare-the-script-element "prepare the script element"
					var script
					- ". This might cause some script to execute, which might cause "
					a href="#dom-document-write" id=parsing-main-incdata:dom-document-write "new characters to be inserted into the tokenizer"
					- ", and might cause the tokenizer to output more tokens, resulting in a "
					a href="#nestedParsing" "reentrant invocation of the parser"
					- .
				}
				p {
					- "Decrement the parser's "
					a href="#script-nesting-level" id=parsing-main-incdata:script-nesting-level-2 "script nesting level"
					- " by one. If the parser's "
					a href="#script-nesting-level" id=parsing-main-incdata:script-nesting-level-3 "script nesting level"
					- " is zero, then set the "
					a href="#parser-pause-flag" id=parsing-main-incdata:parser-pause-flag "parser pause flag"
					- " to false."
