			- " follow the normal requirements for attributes, based on the elements they extend. To add custom attribute-based behavior, use "
			code id=custom-elements-core-concepts:attr-data-* {
				a href="#attr-data-*" data-*
			}
			- " attributes."
		}
		hr
		p {
			- "An "
			a href="#autonomous-custom-element" id=custom-elements-core-concepts:autonomous-custom-element-5 "autonomous custom element"
			- " is called a "
			dfn data-export="" id=form-associated-custom-element "form-associated custom element"
