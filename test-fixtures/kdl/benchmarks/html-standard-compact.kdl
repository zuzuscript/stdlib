			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-dir {
				code dir
			}
			- " attribute is an "
			a href="#enumerated-attribute" id=the-dir-attribute:enumerated-attribute "enumerated attribute"
			- " with the following keywords and states:"
		}
		table {
			thead {
				tr {
					th "Keyword "
					th "State "
					th "Brief description "
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/dir" data-dfn-type=attr-value id=attr-dir-ltr {
							code ltr
						}
					}
					td {
						dfn id=attr-dir-ltr-state ltr
					}
