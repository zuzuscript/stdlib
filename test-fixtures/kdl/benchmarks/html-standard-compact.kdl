							- "Let "
							var inputURLString
							- " be the "
							a data-x-internal=concept-url-serializer href="https://url.spec.whatwg.org/#concept-url-serializer" id=custom-handlers:concept-url-serializer serialization
							- " of "
							var inputURL
							- .
						}
					}
					li {
