							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p "Returns the current state of network activity for the element, from the codes in the list below."
			}
		}
		p {
			- "As "
			a href="#media-element" id=network-states:media-element "media elements"
			- " interact with the network, their current network activity is represented by the "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=attribute id=dom-media-networkstate {
				code networkState
			}
			- " attribute. On getting, it must return the current network state of the element, which must be one of the following values:"
		}
		dl {
			dt {
				dfn data-dfn-for=HTMLMediaElement data-dfn-type=const id=dom-media-network_empty {
					code NETWORK_EMPTY
				}
				- " (numeric value 0)"
			}
			dd "The element has not yet been initialized. All attributes are in their initial states."
			dt {
				dfn data-dfn-for=HTMLMediaElement data-dfn-type=const id=dom-media-network_idle {
					code NETWORK_IDLE
				}
				- " (numeric value 1)"
			}
			dd {
				- "The element's "
				a href="#concept-media-load-algorithm" id=network-states:concept-media-load-algorithm "resource selection algorithm"
				- " is active and has selected a "
				a href="#media-resource" id=network-states:media-resource resource
				- ", but it is not actually using the network at this time."
			}
			dt {
				dfn data-dfn-for=HTMLMediaElement data-dfn-type=const id=dom-media-network_loading {
					code NETWORK_LOADING
				}
				- " (numeric value 2)"
			}
			dd "The user agent is actively trying to download data."
			dt {
				dfn data-dfn-for=HTMLMediaElement data-dfn-type=const id=dom-media-network_no_source {
					code NETWORK_NO_SOURCE
				}
				- " (numeric value 3)"
			}
			dd {
				- "The element's "
				a href="#concept-media-load-algorithm" id=network-states:concept-media-load-algorithm-2 "resource selection algorithm"
				- " is active, but it has not yet found a "
				a href="#media-resource" id=network-states:media-resource-2 resource
				- " to use."
			}
		}
		p {
			- "The "
			a href="#concept-media-load-algorithm" id=network-states:concept-media-load-algorithm-3 "resource selection algorithm"
			- " defined below describes exactly when the "
			code id=network-states:dom-media-networkstate {
				a href="#dom-media-networkstate" networkState
			}
			- " attribute changes value and what events fire to indicate changes in this state."
		}
		h5 id=loading-the-media-resource {
			span class=secno "4.8.11.5"
