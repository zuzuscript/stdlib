				p {
					a href="#reload" id=navigation-api-initiating-navigations:reload Reloads
					- " the current page. "
					var options
					- " can contain "
					code id=navigation-api-initiating-navigations:dom-navigationoptions-info {
						a href="#dom-navigationoptions-info" info
					}
					- " and "
					code id=dom-navigationreloadoptions-state-dev {
						a href="#dom-navigationreloadoptions-state" state
					}
					- ", which behave as described above."
