					- "Pop elements from the "
					a href="#stack-of-open-elements" id=parsing-main-intemplate:stack-of-open-elements-2 "stack of open elements"
					- " until a "
					code id=parsing-main-intemplate:the-template-element-2 {
						a href="#the-template-element" template
					}
					- " element has been popped from the stack."
