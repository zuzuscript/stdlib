					a data-x-internal=concept-element-attributes-change href="https://dom.spec.whatwg.org/#concept-element-attributes-change" id=custom-element-reactions:concept-element-attributes-change changed
					- ", "
					a data-x-internal=concept-element-attributes-append href="https://dom.spec.whatwg.org/#concept-element-attributes-append" id=custom-element-reactions:concept-element-attributes-append appended
					- ", "
					a data-x-internal=concept-element-attributes-remove href="https://dom.spec.whatwg.org/#concept-element-attributes-remove" id=custom-element-reactions:concept-element-attributes-remove removed
					- ", or "
					a data-x-internal=concept-element-attributes-replace href="https://dom.spec.whatwg.org/#concept-element-attributes-replace" id=custom-element-reactions:concept-element-attributes-replace replaced
					- ", its "
					code attributeChangedCallback
					- " is called, given the attribute's local name, old value, new value, and namespace as arguments. (An attribute's old or new value is considered to be null when the attribute is added or removed, respectively.)"
				}
			}
			li {
				p {
					- "When the user agent "
					a href="#reset-the-form-owner" id=custom-element-reactions:reset-the-form-owner "resets the form owner"
					- " of a "
					a href="#form-associated-custom-element" id=custom-element-reactions:form-associated-custom-element "form-associated custom element"
					- " and doing so changes the form owner, its "
					code formAssociatedCallback
					- " is called, given the new form owner (or null if no owner) as an argument."
				}
			}
			li {
				p {
					- "When the form owner of a "
					a href="#form-associated-custom-element" id=custom-element-reactions:form-associated-custom-element-2 "form-associated custom element"
					- " is "
					a href="#concept-form-reset" id=custom-element-reactions:concept-form-reset reset
					- ", its "
					code formResetCallback
					- " is called."
				}
			}
			li {
				p {
					- "When the "
					a href="#concept-fe-disabled" id=custom-element-reactions:concept-fe-disabled disabled
					- " state of a "
					a href="#form-associated-custom-element" id=custom-element-reactions:form-associated-custom-element-3 "form-associated custom element"
					- " is changed, its "
					code formDisabledCallback
					- " is called, given the new state as an argument."
