					c- f="" img
					c- e="" src
					c- o="" "="
					c- s="" "\"fluffy.jpg\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"Fluffy, my cat, tends to keep itself busy.\""
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
