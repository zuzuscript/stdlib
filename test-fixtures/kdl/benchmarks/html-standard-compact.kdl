			- .
		}
		p {
			- "The "
			code id=the-output-element:attr-fae-form-2 {
				a href="#attr-fae-form" form
			}
			- " attribute is used to explicitly associate the "
			code id=the-output-element:the-output-element-2 {
				a href="#the-output-element" output
			}
			- " element with its "
			a href="#form-owner" id=the-output-element:form-owner "form owner"
			- ". The "
			code id=the-output-element:attr-fe-name-2 {
				a href="#attr-fe-name" name
			}
			- " attribute represents the element's name. The "
			code id=the-output-element:the-output-element-3 {
				a href="#the-output-element" output
			}
			- " element is associated with a form so that it can be easily "
			a href="#referenced" id=the-output-element:referenced referenced
			- " from the event handlers of form controls; the element's value itself is not submitted when the form is submitted."
		}
