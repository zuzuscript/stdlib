					c- u="" "\"./foo2.mjs\""
					c- a="" with
					c- p="" "{"
					- " type"
					c- o="" :
					c- u="" "\"js\""
					c- p="" "};"
					c- k="" import
					- " foo3 "
					c- k="" from
					c- u="" "\"./foo3.mjs\""
					c- a="" with
					c- p="" "{"
					- " type"
					c- o="" :
					c- u="" "\"\""
					c- p="" "};"
					c- k="" await
