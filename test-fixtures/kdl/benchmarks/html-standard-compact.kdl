							var languages
							- ", append it to "
							var languages
							- .
						}
					}
					li {
						p {
							- "Let "
							var "winning language"
							- " be the first language in "
							var languages
							- " for which there is a "
							code id=standard-metadata-names:the-meta-element-3 {
								a href="#the-meta-element" meta
							}
							- " element in the "
							code id=standard-metadata-names:document-2 {
								a href="#document" Document
							}
							- " where the "
							code id=standard-metadata-names:attr-meta-name-3 {
