					c- p="" >
					- " fetch"
					c- p="" "("
					c- t="" "'/api/data'"
					c- p="" ");"
					c- c1="" "// not fetched with <script>'s referrer policy"
					c- k="" import
					c- p="" "("
					c- t="" "'./utils.mjs'"
					c- p="" ");"
					c- c1="" "// is fetched with <script>'s referrer policy (\"origin\" in this case)"
					c- p="" "</"
					c- f="" script
					c- p="" >
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=script data-dfn-type=element-attr id=attr-script-blocking {
				code blocking
			}
			- " attribute is a "
			a href="#blocking-attribute" id=the-script-element:blocking-attribute "blocking attribute"
			- .
		}
		p {
			- "The "
			dfn data-dfn-for=script data-dfn-type=element-attr id=attr-script-fetchpriority {
				code fetchpriority
			}
			- " attribute is a "
			a href="#fetch-priority-attribute" id=the-script-element:fetch-priority-attribute "fetch priority attribute"
			- ". Its purpose is to set the "
			a data-x-internal=concept-request-priority href="https://fetch.spec.whatwg.org/#request-priority" id=the-script-element:concept-request-priority-2 priority
			- " used when "
			a data-x-internal=concept-fetch href="https://fetch.spec.whatwg.org/#concept-fetch" id=the-script-element:concept-fetch-4 fetching
			- " the script."
		}
		p {
			- "Changing the "
			code id=the-script-element:attr-script-src-12 {
				a href="#attr-script-src" src
			}
			- ", "
			code id=the-script-element:attr-script-type-7 {
				a href="#attr-script-type" type
			}
			- ", "
			code id=the-script-element:attr-script-nomodule-5 {
				a href="#attr-script-nomodule" nomodule
			}
			- ", "
			code id=the-script-element:attr-script-async-13 {
				a href="#attr-script-async" async
			}
			- ", "
			code id=the-script-element:attr-script-defer-13 {
				a href="#attr-script-defer" defer
			}
			- ", "
			code id=the-script-element:attr-script-crossorigin-4 {
				a href="#attr-script-crossorigin" crossorigin
