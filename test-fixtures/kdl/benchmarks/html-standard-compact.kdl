		p {
			- "All "
			a href="#html-elements" id=the-popover-attribute:html-elements "HTML elements"
			- " may have the "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-popover {
				code popover
			}
			- " content attribute set. When specified, the element won't be rendered until it becomes shown, at which point it will be rendered on top of other page content."
		}
		div class=example {
			p {
				- "The "
