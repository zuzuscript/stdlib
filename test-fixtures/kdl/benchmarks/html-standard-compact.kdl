			}
			dd "The user agent has obtained some of the image data and at least the image dimensions are available."
			dt {
				dfn id=img-all "Completely available"
			}
			dd "The user agent has obtained all of the image data and at least the image dimensions are available."
			dt {
				dfn id=img-error Broken
			}
