				c- p="" >
			}
		}
		h5 id=exposing-custom-element-states {
			span class=secno "4.13.1.7"
			- " Exposing custom element states"
			a class=self-link href="#exposing-custom-element-states"
		}
		p {
			- "Built-in elements provided by user agents have certain states that can change over time depending on user interaction and other factors, and are exposed to web authors through "
			a data-x-internal=pseudo-class href="https://drafts.csswg.org/selectors/#pseudo-class" id=exposing-custom-element-states:pseudo-class pseudo-classes
			- ". For example, some form controls have the \"invalid\" state, which is exposed through the "
			code id=exposing-custom-element-states:selector-invalid {
				a href="#selector-invalid" :invalid
			}
			a data-x-internal=pseudo-class href="https://drafts.csswg.org/selectors/#pseudo-class" id=exposing-custom-element-states:pseudo-class-2 pseudo-class
			- .
		}
		p {
			- "Like built-in elements, "
			a href="#custom-element" id=exposing-custom-element-states:custom-element "custom elements"
			- " can have various states to be in too, and "
			a href="#custom-element" id=exposing-custom-element-states:custom-element-2 "custom element"
			- " authors want to expose these states in a similar fashion as the built-in elements."
		}
		p {
			- "This is done via the "
			code id=exposing-custom-element-states:selector-custom {
				a href="#selector-custom" ":state()"
			}
			- " pseudo-class. A custom element author can use the "
			code id=exposing-custom-element-states:dom-elementinternals-states {
				a href="#dom-elementinternals-states" states
			}
			- " property of "
			code id=exposing-custom-element-states:elementinternals {
				a href="#elementinternals" ElementInternals
			}
			- " to add and remove such custom states, which are then exposed as arguments to the "
			code id=exposing-custom-element-states:selector-custom-2 {
				a href="#selector-custom" ":state()"
			}
			- " pseudo-class. "
		}
		div class=example {
			p {
				- "The following shows how "
				code id=exposing-custom-element-states:selector-custom-3 {
					a href="#selector-custom" ":state()"
				}
				- " can be used to style a custom checkbox element. Assume that "
				code LabeledCheckbox
				- " doesn't expose its \"checked\" state via a content attribute."
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" script
					c- p="" >
					c- a="" class
					- " LabeledCheckbox "
					c- k="" extends
					- " HTMLElement "
					c- p="" "{"
					- " constructor"
					c- p="" "()"
					c- p="" "{"
					c- k="" super
					c- p="" "();"
					c- k="" this
					c- p="" .
					- "_internals "
					c- o="" "="
					c- k="" this
					c- p="" .
					- attachInternals
					c- p="" "();"
					c- k="" this
					c- p="" .
					- addEventListener
					c- p="" "("
					c- t="" 'click'
					c- p="" ,
					c- k="" this
					c- p="" .
					- _onClick
					c- p="" .
					- bind
					c- p="" "("
					c- k="" this
					c- p="" "));"
					c- a="" const
					- " shadowRoot "
					c- o="" "="
					c- k="" this
					c- p="" .
					- attachShadow
					c- p="" "({"
					- mode
