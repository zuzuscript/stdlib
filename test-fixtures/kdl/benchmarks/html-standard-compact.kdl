		p {
			- "The "
			code id=the-area-element:the-area-element {
				a href="#the-area-element" area
			}
			- " element "
			a href="#represents" id=the-area-element:represents represents
			- " either a hyperlink with some text and a corresponding area on an "
			a href="#image-map" id=the-area-element:image-map-3 "image map"
			- ", or a dead area on an image map."
		}
		p {
			- "An "
			code id=the-area-element:the-area-element-2 {
				a href="#the-area-element" area
			}
			- " element with a parent node must have a "
			code id=the-area-element:the-map-element-2 {
				a href="#the-map-element" map
			}
			- " element ancestor."
		}
		p {
			- "If the "
			code id=the-area-element:the-area-element-3 {
				a href="#the-area-element" area
			}
			- " element has an "
			code id=the-area-element:attr-hyperlink-href-3 {
				a href="#attr-hyperlink-href" href
			}
			- " attribute, then the "
			code id=the-area-element:the-area-element-4 {
				a href="#the-area-element" area
			}
			- " element represents a "
			a href="#hyperlink" id=the-area-element:hyperlink-4 hyperlink
			- ". In this case, the "
			dfn data-dfn-for=area data-dfn-type=element-attr id=attr-area-alt {
				code alt
			}
			- " attribute must be present. It specifies the text of the hyperlink. Its value must be text that, when presented with the texts specified for the other hyperlinks of the "
			a href="#image-map" id=the-area-element:image-map-4 "image map"
			- ", and with the alternative text of the image, but without the image itself, provides the user with the same kind of choice as the hyperlink would when used without its text but with its shape applied to the image. The "
			code id=the-area-element:attr-area-alt-2 {
				a href="#attr-area-alt" alt
			}
			- " attribute may be left blank if there is another "
			code id=the-area-element:the-area-element-5 {
				a href="#the-area-element" area
			}
			- " element in the same "
			a href="#image-map" id=the-area-element:image-map-5 "image map"
			- " that points to the same resource and has a non-blank "
			code id=the-area-element:attr-area-alt-3 {
				a href="#attr-area-alt" alt
			}
			- " attribute."
		}
		p {
			- "If the "
			code id=the-area-element:the-area-element-6 {
				a href="#the-area-element" area
			}
			- " element has no "
			code id=the-area-element:attr-hyperlink-href-4 {
				a href="#attr-hyperlink-href" href
			}
			- " attribute, then the area represented by the element cannot be selected, and the "
			code id=the-area-element:attr-area-alt-4 {
				a href="#attr-area-alt" alt
			}
			- " attribute must be omitted."
		}
		p {
			- "In both cases, the "
			code id=the-area-element:attr-area-shape-2 {
				a href="#attr-area-shape" shape
			}
			- " and "
			code id=the-area-element:attr-area-coords-2 {
				a href="#attr-area-coords" coords
			}
			- " attributes specify the area."
		}
		p {
			- "The "
			dfn data-dfn-for=area data-dfn-type=element-attr id=attr-area-shape {
				code shape
			}
			- " attribute is an "
			a href="#enumerated-attribute" id=the-area-element:enumerated-attribute "enumerated attribute"
			- " with the following keywords and states:"
		}
		table class=yesno {
			thead {
				tr {
					th "Keyword "
					th "Conforming "
					th "State "
					th "Brief description "
				}
			}
			tbody {
				tr {
					td {
						dfn id=attr-area-shape-keyword-circle {
							code circle
						}
					}
					td {					}
