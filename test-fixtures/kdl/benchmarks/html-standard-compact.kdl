			}
			- " element, the element is "
			a href="#barred-from-constraint-validation" id=the-textarea-element:barred-from-constraint-validation "barred from constraint validation"
			- .
		}
		p {
			- "A "
			code id=the-textarea-element:the-textarea-element-4 {
				a href="#the-textarea-element" textarea
			}
			- " element is "
			a href="#concept-fe-mutable" id=the-textarea-element:concept-fe-mutable mutable
			- " if it is neither "
			a href="#concept-fe-disabled" id=the-textarea-element:concept-fe-disabled disabled
			- " nor has a "
			code id=the-textarea-element:attr-textarea-readonly-3 {
				a href="#attr-textarea-readonly" readonly
			}
			- " attribute specified."
		}
		p {
			- "When a "
			code id=the-textarea-element:the-textarea-element-5 {
				a href="#the-textarea-element" textarea
			}
			- " is "
			a href="#concept-fe-mutable" id=the-textarea-element:concept-fe-mutable-2 mutable
			- ", its "
			a href="#concept-textarea-raw-value" id=the-textarea-element:concept-textarea-raw-value-2 "raw value"
			- " should be editable by the user: the user agent should allow the user to edit, insert, and remove text, and to insert and remove line breaks in the form of U+000A LINE FEED (LF) characters. Any time the user causes the element's "
			a href="#concept-textarea-raw-value" id=the-textarea-element:concept-textarea-raw-value-3 "raw value"
			- " to change, the user agent must "
			a href="#queue-an-element-task" id=the-textarea-element:queue-an-element-task "queue an element task"
			- " on the "
			a href="#user-interaction-task-source" id=the-textarea-element:user-interaction-task-source "user interaction task source"
			- " given the "
			code id=the-textarea-element:the-textarea-element-6 {
				a href="#the-textarea-element" textarea
			}
			- " element to "
			a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=the-textarea-element:concept-event-fire "fire an event"
			- " named "
			code id=the-textarea-element:event-input {
				a data-x-internal=event-input href="https://w3c.github.io/uievents/#event-type-input" input
			}
			- " at the "
