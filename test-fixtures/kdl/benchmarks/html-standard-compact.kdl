					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "After our walks, having emptied my mind, I like listening to Bach."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" article
					c- p="" >
				}
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" article
					c- p="" >
					c- p="" <
					c- f="" h1
					c- p="" >
					- "Fluffy and the Yarn"
					c- p="" "</"
					c- f="" h1
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "Fluffy was a cat who liked to play with yarn. She also liked to jump."
					c- p="" "</"
					c- f="" p
					c- p="" >
