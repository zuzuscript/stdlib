							}
						}
						li {
							dfn id=immutable-prototype-exotic-object {
								a href="https://tc39.es/ecma262/#immutable-prototype-exotic-object" "immutable prototype exotic object"
							}
						}
						li {
							dfn id=well-known-symbols {
								a href="https://tc39.es/ecma262/#sec-well-known-symbols" "Well-Known Symbols"
							}
							- ", including "
							dfn id=symbol.hasinstance %Symbol.hasInstance%
							- ", "
							dfn id=symbol.isconcatspreadable %Symbol.isConcatSpreadable%
							- ", "
							dfn id=symbol.toprimitive %Symbol.toPrimitive%
							- ", and "
							dfn id=symbol.tostringtag %Symbol.toStringTag%
						}
						li {
							dfn id=well-known-intrinsic-objects {
								a href="https://tc39.es/ecma262/#sec-well-known-intrinsic-objects" "Well-Known Intrinsic Objects"
							}
							- ", including "
							dfn id=array.prototype {
								a href="https://tc39.es/ecma262/#sec-properties-of-the-array-prototype-object" %Array.prototype%
							}
							- ", "
							dfn id=error.prototype {
								a href="https://tc39.es/ecma262/#sec-properties-of-the-error-prototype-object" %Error.prototype%
							}
							- ", "
							dfn id=evalerror.prototype %EvalError.prototype%
							- ", "
							dfn id=function.prototype {
								a href="https://tc39.es/ecma262/#sec-properties-of-the-function-prototype-object" %Function.prototype%
							}
							- ", "
							dfn id=json.parse {
								a href="https://tc39.es/ecma262/#sec-json.parse" %JSON.parse%
							}
							- ", "
							dfn id=object.prototype {
								a href="https://tc39.es/ecma262/#sec-properties-of-the-object-prototype-object" %Object.prototype%
							}
							- ", "
							dfn id=object.prototype.valueof {
								a href="https://tc39.es/ecma262/#sec-object.prototype.valueof" %Object.prototype.valueOf%
							}
							- ", "
							dfn id=rangeerror.prototype %RangeError.prototype%
							- ", "
							dfn id=referenceerror.prototype %ReferenceError.prototype%
							- ", "
							dfn id=syntaxerror.prototype %SyntaxError.prototype%
							- ", "
							dfn id=typeerror.prototype %TypeError.prototype%
							- ", and "
							dfn id=urierror.prototype %URIError.prototype%
						}
						li {
