									a data-x-internal=concept-attach-a-shadow-root href="https://dom.spec.whatwg.org/#concept-attach-a-shadow-root" id=parsing-main-inhead:concept-attach-a-shadow-root "Attach a shadow root"
									- " with "
									var "declarative shadow host element"
									- ", "
									var mode
									- ", "
									var clonable
									- ", "
									var serializable
									- ", "
									var delegatesFocus
									- ", and \""
									code named
									- "\"."
								}
								p "If an exception is thrown, then catch it and:"
								ol {
