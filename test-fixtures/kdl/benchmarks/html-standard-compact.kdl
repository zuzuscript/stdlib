				- ". ("
				a href="https://creativecommons.org/licenses/by/2.0/" itemprop=license "CC BY 2.0"
				- ") "
			}
		}
		div itemscope="" itemtype="http://n.whatwg.org/work" {
			p {
				- "The image of the wolf in the embedded content introduction is based on "
				a href="https://commons.wikimedia.org/wiki/File:WolfRunningInSnow.jpg" itemprop=work "a photo"
				- " by "
