				- .
			}
			p {
				- "When the "
				a href="#concept-task" id=incumbent:concept-task task
				- " posted by "
				code id=incumbent:dom-settimeout-2 {
					a href="#dom-settimeout" "setTimeout()"
				}
				- " executes, the algorithm for that task uses Web IDL to "
				a data-x-internal=es-invoking-callback-functions href="https://webidl.spec.whatwg.org/#invoke-a-callback-function" id=incumbent:es-invoking-callback-functions-3 invoke
				- " the stored callback value. Web IDL in turn calls the above "
				a href="#prepare-to-run-a-callback" id=incumbent:prepare-to-run-a-callback-4 "prepare to run a callback"
				- " algorithm. This pushes the stored "
				a data-x-internal=callback-context href="https://webidl.spec.whatwg.org/#dfn-callback-context" id=incumbent:callback-context-2 "callback context"
				- " onto the "
				a href="#backup-incumbent-settings-object-stack" id=incumbent:backup-incumbent-settings-object-stack-6 "backup incumbent settings object stack"
				- ". At this time (inside the timer task) there is no author code on the stack, so the "
				a href="#topmost-script-having-execution-context" id=incumbent:topmost-script-having-execution-context-6 "topmost script-having execution context"
				- " is null, and nothing gets its "
				a href="#skip-when-determining-incumbent-counter" id=incumbent:skip-when-determining-incumbent-counter-5 "skip-when-determining-incumbent counter"
				- " incremented."
			}
			p {
				- "Invoking the callback then calls "
				code bound
				- ", which in turn calls the "
				code id=incumbent:dom-window-postmessage-3 {
					a href="#dom-window-postmessage" "postMessage()"
				}
				- " method of "
				code "frames[0]"
				- ". When the "
				code id=incumbent:dom-window-postmessage-4 {
					a href="#dom-window-postmessage" "postMessage()"
				}
				- " algorithm looks up the "
				a href="#incumbent-settings-object" id=incumbent:incumbent-settings-object-12 "incumbent settings object"
