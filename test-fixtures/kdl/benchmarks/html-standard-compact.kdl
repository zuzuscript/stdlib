			a data-x-internal=viewport href="https://drafts.csswg.org/css2/#viewport" id=images-processing-model:viewport viewport
			- ", it must be interpreted relative to the "
			code id=images-processing-model:the-img-element-10 {
				a href="#the-img-element" img
			}
			- " element's "
