						- ", such as that for the \"/\" and \".\" characters and for quick input of strings commonly found in domain names such as \"www.\" or \".com\". "
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" data-dfn-type=attr-value id=attr-inputmode-keyword-email {
							code email
						}
					}
