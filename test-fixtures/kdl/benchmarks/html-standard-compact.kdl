									- "'s "
									a data-x-internal=public-suffix href="https://url.spec.whatwg.org/#host-public-suffix" id=relaxing-the-same-origin-restriction:public-suffix "public suffix"
									- "; or"
								}
							}
							li {
								p {
									var hostSuffix
									- ", prefixed by U+002E (.), matches the end of "
									var originalHost
									- "'s "
									a data-x-internal=public-suffix href="https://url.spec.whatwg.org/#host-public-suffix" id=relaxing-the-same-origin-restriction:public-suffix-2 "public suffix"
									- ,
								}
							}
						}
						p {
							- "then return false. "
							a href="#refsURL" "[URL]"
						}
					}
					li {
						p {
							a data-x-internal=assert href="https://infra.spec.whatwg.org/#assert" id=relaxing-the-same-origin-restriction:assert Assert
							- ": "
							var originalHost
							- "'s "
							a data-x-internal=public-suffix href="https://url.spec.whatwg.org/#host-public-suffix" id=relaxing-the-same-origin-restriction:public-suffix-3 "public suffix"
							- ", prefixed by U+002E (.), matches the end of "
							var hostSuffix
							- .
						}
					}
				}
			}
			li {
				p "Return true."
			}
		}
