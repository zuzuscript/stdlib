				p {
					- "Let the "
					var "adjusted insertion location"
					- " be the "
					a href="#appropriate-place-for-inserting-a-node" id=parsing-main-inhead:appropriate-place-for-inserting-a-node-2 "appropriate place for inserting a node"
					- .
				}
				p {
					- "Let "
					var "intended parent"
					- " be the element in which the "
					var "adjusted insertion location"
					- " finds itself."
				}
				p {
					- "Let "
					var document
					- " be "
					var "intended parent"
