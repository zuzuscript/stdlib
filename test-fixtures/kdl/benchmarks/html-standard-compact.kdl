				}
			}
			li {
				p {
					- "Prefix every U+003B SEMICOLON character (;) in "
					var value
					- " with a U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Replace every U+000D CARRIAGE RETURN U+000A LINE FEED character pair (CRLF) in "
