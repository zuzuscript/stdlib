					- .
				}
				p "Reprocess the token."
			}
		}
		h6 id=parsing-main-afterbody {
			span class=secno "13.2.6.4.19"
			- " The \""
			dfn "after body"
			- "\" insertion mode"
			a class=self-link href="#parsing-main-afterbody"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-afterbody" id=parsing-main-afterbody:parsing-main-afterbody "after body"
			- "\" "
			a href="#insertion-mode" id=parsing-main-afterbody:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
			dd {
				p {
					- "Process the token "
					a href="#using-the-rules-for" id=parsing-main-afterbody:using-the-rules-for "using the rules for"
					- " the \""
					a href="#parsing-main-inbody" id=parsing-main-afterbody:parsing-main-inbody "in body"
					- "\" "
					a href="#insertion-mode" id=parsing-main-afterbody:insertion-mode-2 "insertion mode"
					- .
				}
			}
			dt "A comment token"
			dd {
				p {
					a href="#insert-a-comment" id=parsing-main-afterbody:insert-a-comment "Insert a comment"
					- " as the last child of the first element in the "
					a href="#stack-of-open-elements" id=parsing-main-afterbody:stack-of-open-elements "stack of open elements"
					- " (the "
					code id=parsing-main-afterbody:the-html-element {
						a href="#the-html-element" html
					}
					- " element)."
				}
			}
			dt "A DOCTYPE token"
			dd {
				p {
					a href="#parse-errors" id=parsing-main-afterbody:parse-errors "Parse error"
					- ". Ignore the token."
				}
			}
			dt "A start tag whose tag name is \"html\""
			dd {
				p {
					- "Process the token "
					a href="#using-the-rules-for" id=parsing-main-afterbody:using-the-rules-for-2 "using the rules for"
					- " the \""
					a href="#parsing-main-inbody" id=parsing-main-afterbody:parsing-main-inbody-2 "in body"
					- "\" "
					a href="#insertion-mode" id=parsing-main-afterbody:insertion-mode-3 "insertion mode"
					- .
				}
			}
			dt "An end tag whose tag name is \"html\""
			dd {
				p {
					- "If the parser was created as part of the "
					a href="#html-fragment-parsing-algorithm" id=parsing-main-afterbody:html-fragment-parsing-algorithm "HTML fragment parsing algorithm"
					- ", this is a "
					a href="#parse-errors" id=parsing-main-afterbody:parse-errors-2 "parse error"
					- "; ignore the token. ("
					a href="#fragment-case" id=parsing-main-afterbody:fragment-case "fragment case"
					- ")"
				}
				p {
					- "Otherwise, switch the "
					a href="#insertion-mode" id=parsing-main-afterbody:insertion-mode-4 "insertion mode"
					- " to \""
					a href="#the-after-after-body-insertion-mode" id=parsing-main-afterbody:the-after-after-body-insertion-mode "after after body"
					- "\"."
				}
			}
			dt "An end-of-file token"
			dd {
				p {
					a href="#stop-parsing" id=parsing-main-afterbody:stop-parsing "Stop parsing"
					- .
				}
			}
			dt "Anything else"
			dd {
				p {
					a href="#parse-errors" id=parsing-main-afterbody:parse-errors-3 "Parse error"
					- ". Switch the "
					a href="#insertion-mode" id=parsing-main-afterbody:insertion-mode-5 "insertion mode"
					- " to \""
					a href="#parsing-main-inbody" id=parsing-main-afterbody:parsing-main-inbody-3 "in body"
					- "\" and reprocess the token."
				}
			}
		}
		h6 id=parsing-main-inframeset {
