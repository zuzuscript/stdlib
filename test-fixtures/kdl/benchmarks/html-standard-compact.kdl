					a href="#parse-errors" id=parsing-main-inhead:parse-errors-4 "Parse error"
					- ". Ignore the token."
				}
			}
			dt "Anything else"
			dd {
				p {
					- "Pop the "
					a href="#current-node" id=parsing-main-inhead:current-node-6 "current node"
					- " (which will be the "
					code id=parsing-main-inhead:the-head-element-2 {
						a href="#the-head-element" head
					}
					- " element) off the "
					a href="#stack-of-open-elements" id=parsing-main-inhead:stack-of-open-elements-8 "stack of open elements"
					- .
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=parsing-main-inhead:insertion-mode-8 "insertion mode"
					- " to \""
					a href="#the-after-head-insertion-mode" id=parsing-main-inhead:the-after-head-insertion-mode-2 "after head"
					- "\"."
				}
				p "Reprocess the token."
			}
		}
		h6 id=parsing-main-inheadnoscript {
