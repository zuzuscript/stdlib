		h5 id=exposing-outlines-to-users {
			span class=secno "4.3.11.2"
			- " Exposing outlines to users"
			a class=self-link href="#exposing-outlines-to-users"
		}
		p {
			- "User agents are encouraged to expose page "
			a href="#outline" id=exposing-outlines-to-users:outline outlines
			- " to users to aid in navigation. This is especially true for non-visual media, e.g. screen readers."
		}
		div class=example {
			p "For instance, a user agent could map the arrow keys as follows:"
			dl {
				dt {
					kbd {
						kbd Shift
						- " + "
						kbd "← Left"
					}
				}
				dd "Go to previous heading"
				dt {
					kbd {
						kbd Shift
						- " + "
						kbd "→ Right"
					}
				}
				dd "Go to next heading"
				dt {
					kbd {
						kbd Shift
						- " + "
						kbd "↑ Up"
					}
				}
				dd {
					- "Go to next heading whose "
					a href="#heading-level" id=exposing-outlines-to-users:heading-level level
					- " is one less than the current heading's level"
				}
				dt {
					kbd {
						kbd Shift
						- " + "
						kbd "↓ Down"
					}
				}
				dd {
					- "Go to next heading whose "
					a href="#heading-level" id=exposing-outlines-to-users:heading-level-2 level
					- " is the same as the current heading's level"
				}
			}
		}
