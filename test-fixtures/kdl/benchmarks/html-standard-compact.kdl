						span Edge
						span "79+"
					}
					hr
					span class="edge yes" {
						span "Edge (Legacy)"
						span "12+"
					}
					span class="ie yes" {
						span "Internet Explorer"
						span "8+"
					}
					hr
					span class="firefox_android yes" {
						span "Firefox Android"
						span Yes
					}
					span class="safari_ios yes" {
						span "Safari iOS"
						span Yes
					}
					span class="chrome_android yes" {
						span "Chrome Android"
						span Yes
					}
					span class="webview_android unknown" {
						span "WebView Android"
						span ?
					}
					span class="samsunginternet_android unknown" {
						span "Samsung Internet"
						span ?
					}
					span class="opera_android unknown" {
						span "Opera Android"
						span ?
					}
				}
			}
		}
		p {
			- "The `"
			dfn data-dfn-type=http-header id=x-frame-options {
				code X-Frame-Options
			}
			- "` HTTP response header is a legacy way of controlling whether and how a "
			code id=the-x-frame-options-header:document {
				a href="#document" Document
			}
			- " may be loaded inside of a "
			a href="#child-navigable" id=the-x-frame-options-header:child-navigable "child navigable"
			- ". It is obsoleted by the "
			code id=the-x-frame-options-header:frame-ancestors-directive {
				a data-x-internal=frame-ancestors-directive href="https://w3c.github.io/webappsec-csp/#frame-ancestors" frame-ancestors
			}
			- " CSP directive, which provides more granular control over the same situations. It was originally defined in "
			cite "HTTP Header Field X-Frame-Options"
			- ", but the definition and processing model here supersedes that document. "
			a href="#refsCSP" "[CSP]"
			a href="#refsRFC7034" "[RFC7034]"
		}
		p class=note {
			- "In particular, "
			cite "HTTP Header Field X-Frame-Options"
			- " specified an `"
			code ALLOW-FROM
			- "` variant of the header, but that is not to be implemented."
		}
		p class=note {
			- "Per the below processing model, if both a CSP "
			code id=the-x-frame-options-header:frame-ancestors-directive-2 {
				a data-x-internal=frame-ancestors-directive href="https://w3c.github.io/webappsec-csp/#frame-ancestors" frame-ancestors
			}
			- " directive and an `"
			code id=the-x-frame-options-header:x-frame-options-2 {
				a href="#x-frame-options" X-Frame-Options
			}
			- "` header are used in the same "
			a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=the-x-frame-options-header:concept-response response
			- ", then `"
			code id=the-x-frame-options-header:x-frame-options-3 {
				a href="#x-frame-options" X-Frame-Options
			}
			- "` is ignored."
		}
		p {
			- "For web developers and conformance checkers, its value "
			a data-x-internal=header-abnf href="https://fetch.spec.whatwg.org/#abnf" id=the-x-frame-options-header:header-abnf ABNF
			- " is:"
		}
		pre {
			code class=abnf {
				c- nc="" X-Frame-Options
				c- o="" "="
				c- l="" "\"DENY\""
				c- o="" "/"
				c- l="" "\"SAMEORIGIN\""
			}
		}
		p {
			- "To "
			dfn id=check-a-navigation-response's-adherence-to-x-frame-options {
				- "check a navigation response's adherence to `"
				code X-Frame-Options
				- `
			}
			- ", given a "
			a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=the-x-frame-options-header:concept-response-2 response
			var response
			- ", a "
			a href="#navigable" id=the-x-frame-options-header:navigable navigable
			var navigable
			- ", a "
			a data-x-internal=concept-csp-list href="https://w3c.github.io/webappsec-csp/#csp-list" id=the-x-frame-options-header:concept-csp-list "CSP list"
			var cspList
			- ", and an "
			a href="#concept-origin" id=the-x-frame-options-header:concept-origin origin
			var destinationOrigin
			- :
		}
		ol {
			li {
				p {
					- "If "
					var navigable
					- " is not a "
					a href="#child-navigable" id=the-x-frame-options-header:child-navigable-2 "child navigable"
					- ", then return true."
				}
			}
			li {
				p {
					a data-x-internal=list-iterate href="https://infra.spec.whatwg.org/#list-iterate" id=the-x-frame-options-header:list-iterate "For each"
					var policy
					- " of "
					var cspList
					- :
				}
				ol {
					li {
						p {
							- "If "
							var policy
							- "'s "
							a data-x-internal=csp-disposition href="https://w3c.github.io/webappsec-csp/#policy-disposition" id=the-x-frame-options-header:csp-disposition disposition
							- " is not \""
							code enforce
							- "\", then "
							a data-x-internal=continue href="https://infra.spec.whatwg.org/#iteration-continue" id=the-x-frame-options-header:continue continue
							- .
						}
					}
					li {
						p {
							- "If "
							var policy
							- "'s "
							a data-x-internal=csp-directive-set href="https://w3c.github.io/webappsec-csp/#policy-directive-set" id=the-x-frame-options-header:csp-directive-set "directive set"
							a data-x-internal=list-contains href="https://infra.spec.whatwg.org/#list-contain" id=the-x-frame-options-header:list-contains contains
							- " a "
							code id=the-x-frame-options-header:frame-ancestors-directive-3 {
								a data-x-internal=frame-ancestors-directive href="https://w3c.github.io/webappsec-csp/#frame-ancestors" frame-ancestors
							}
							- " directive, then return true."
						}
					}
				}
			}
			li {
				p {
					- "Let "
					var rawXFrameOptions
					- " be the result of "
					a data-x-internal=concept-header-list-get-decode-split href="https://fetch.spec.whatwg.org/#concept-header-list-get-decode-split" id=the-x-frame-options-header:concept-header-list-get-decode-split "getting, decoding, and splitting"
					- " `"
					code id=the-x-frame-options-header:x-frame-options-4 {
						a href="#x-frame-options" X-Frame-Options
					}
					- "` from "
					var response
					- "'s "
					a data-x-internal=concept-response-header-list href="https://fetch.spec.whatwg.org/#concept-response-header-list" id=the-x-frame-options-header:concept-response-header-list "header list"
					- .
				}
			}
			li {
				p {
					- "Let "
					var xFrameOptions
					- " be a new "
					a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=the-x-frame-options-header:set set
					- .
				}
			}
			li {
				p {
					a data-x-internal=list-iterate href="https://infra.spec.whatwg.org/#list-iterate" id=the-x-frame-options-header:list-iterate-2 "For each"
					var value
					- " of "
					var rawXFrameOptions
					- ", "
					a data-x-internal=set-append href="https://infra.spec.whatwg.org/#set-append" id=the-x-frame-options-header:set-append append
					var value
					- ", "
					a data-x-internal=converted-to-ascii-lowercase href="https://infra.spec.whatwg.org/#ascii-lowercase" id=the-x-frame-options-header:converted-to-ascii-lowercase "converted to ASCII lowercase"
					- ", to "
					var xFrameOptions
					- .
				}
			}
			li {
				p {
					- "If "
					var xFrameOptions
					- "'s "
					a data-x-internal=list-size href="https://infra.spec.whatwg.org/#list-size" id=the-x-frame-options-header:list-size size
					- " is greater than 1, and "
					var xFrameOptions
					a data-x-internal=list-contains href="https://infra.spec.whatwg.org/#list-contain" id=the-x-frame-options-header:list-contains-2 contains
					- " any of \""
					code deny
					- "\", \""
					code allowall
					- "\", or \""
					code sameorigin
					- "\", then return false."
				}
				p class=note {
					- "The intention here is to block any attempts at applying `"
					code id=the-x-frame-options-header:x-frame-options-5 {
						a href="#x-frame-options" X-Frame-Options
					}
					- "` which were trying to do something valid, but appear confused."
				}
				p class=note {
					- "This is the only impact of the legacy `"
					code ALLOWALL
					- "` value on the processing model."
				}
			}
			li {
				p {
					- "If "
					var xFrameOptions
					- "'s "
					a data-x-internal=list-size href="https://infra.spec.whatwg.org/#list-size" id=the-x-frame-options-header:list-size-2 size
					- " is greater than 1, then return true."
				}
				p class=note "This means it contains multiple invalid values, which we treat the same way as if the header was omitted entirely."
			}
			li {
				p {
					- "If "
					var xFrameOptions
					- "[0] is \""
					code deny
					- "\", then return false."
				}
			}
			li {
				p {
					- "If "
					var xFrameOptions
					- "[0] is \""
					code sameorigin
					- "\", then:"
				}
				ol {
					li {
						p {
							- "Let "
							var containerDocument
							- " be "
							var navigable
							- "'s "
							a href="#nav-container-document" id=the-x-frame-options-header:nav-container-document "container document"
							- .
						}
					}
					li {
						p {
							a data-x-internal=while href="https://infra.spec.whatwg.org/#iteration-while" id=the-x-frame-options-header:while While
							var containerDocument
							- " is not null:"
						}
						ol {
							li {
								p {
									- "If "
									var containerDocument
									- "'s "
									a data-x-internal=concept-document-origin href="https://dom.spec.whatwg.org/#concept-document-origin" id=the-x-frame-options-header:concept-document-origin origin
									- " is not "
									a href="#same-origin" id=the-x-frame-options-header:same-origin "same origin"
									- " with "
									var destinationOrigin
									- ", then return false."
								}
							}
							li {
								p {
									- "Set "
									var containerDocument
									- " to "
									var containerDocument
									- "'s "
									a href="#doc-container-document" id=the-x-frame-options-header:doc-container-document "container document"
									- .
								}
							}
						}
					}
				}
			}
			li {
				p "Return true."
				p class=note {
					- "If we've reached this point then we have a lone invalid value (which could potentially be one the legacy `"
					code ALLOWALL
					- "` or `"
					code ALLOW-FROM
					- "` forms). These are treated as if the header were omitted entirely."
				}
			}
		}
		hr
		div class=example {
			p "The following table illustrates the processing of various values for the header, including non-conformant ones:"
			table class=data {
				thead {
					tr {
						th {
							- `
							code id=the-x-frame-options-header:x-frame-options-6 {
								a href="#x-frame-options" X-Frame-Options
							}
							- `
						}
						th Valid
						th Result
					}
				}
				tbody {
					tr {
						td {
							- `
							code DENY
							- `
						}
						td ✅
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code SAMEORIGIN
							- `
						}
						td ✅
						td "same-origin embedding allowed"
					}
					tr {
						td {
							- `
							code INVALID
							- `
						}
						td ❌
						td "embedding allowed"
					}
					tr {
						td {
							- `
							code ALLOWALL
							- `
						}
						td ❌
						td "embedding allowed"
					}
					tr {
						td {
							- `
							code "ALLOW-FROM=https://example.com/"
							- `
						}
						td ❌
						td "embedding allowed (from anywhere)"
					}
				}
			}
		}
		div class=example {
			p "The following table illustrates how various non-conformant cases involving multiple values are processed:"
			table class=data {
				thead {
					tr {
						th {
							- `
							code id=the-x-frame-options-header:x-frame-options-7 {
								a href="#x-frame-options" X-Frame-Options
							}
							- `
						}
						th Result
					}
				}
				tbody {
					tr {
						td {
							- `
							code "SAMEORIGIN, SAMEORIGIN"
							- `
						}
						td "same-origin embedding allowed"
					}
					tr {
						td {
							- `
							code "SAMEORIGIN, DENY"
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code SAMEORIGIN,
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code "SAMEORIGIN, ALLOWALL"
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code "SAMEORIGIN, INVALID"
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code "ALLOWALL, INVALID"
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code ALLOWALL,
							- `
						}
						td "embedding disallowed"
					}
					tr {
						td {
							- `
							code "INVALID, INVALID"
							- `
						}
						td "embedding allowed"
					}
				}
			}
			p "The same results are obtained whether the values are delivered in a single header whose value is comma-delimited, or in multiple headers."
		}
		h3 id=the-refresh-header {
			span class=secno "7.7"
			- " The `"
			code id=the-refresh-header:refresh {
				a href="#refresh" Refresh
			}
			- "` header"
			a class=self-link href="#the-refresh-header"
		}
		p {
			- "The `"
			dfn data-dfn-type=http-header id=refresh {
				code Refresh
			}
			- "` HTTP response header is the HTTP-equivalent to a "
			code id=the-refresh-header:the-meta-element {
				a href="#the-meta-element" meta
			}
			- " element with an "
			code id=the-refresh-header:attr-meta-http-equiv {
				a href="#attr-meta-http-equiv" http-equiv
			}
			- " attribute in the "
			a href="#attr-meta-http-equiv-refresh" id=the-refresh-header:attr-meta-http-equiv-refresh "Refresh state"
			- ". It takes "
			a href="#conformance-attr-meta-http-equiv-refresh" "the same value"
			- " and works largely the same. Its processing model is detailed in "
			a href="#initialise-the-document-object" id=the-refresh-header:initialise-the-document-object {
				- "create and initialize a "
				code Document
				- " object"
			}
			- .
		}
		h3 id=nav-traversal-ui {
			span class=secno "7.8"
			span id=history-notes
			- "Browser user interface considerations"
			a class=self-link href="#nav-traversal-ui"
		}
		p {
			- "Browser user agents should provide the ability to "
			a href="#navigate" id=nav-traversal-ui:navigate navigate
			- ", "
			a href="#reload" id=nav-traversal-ui:reload reload
			- ", and "
			a href="#nav-stop" id=nav-traversal-ui:nav-stop "stop loading"
			- " any "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable "top-level traversable"
			- " in their "
			a href="#top-level-traversable-set" id=nav-traversal-ui:top-level-traversable-set "top-level traversable set"
			- .
		}
		p class=example "For example, via a location bar and reload/stop button UI."
		p {
			- "Browser user agents should provide the ability to "
			a href="#traverse-the-history-by-a-delta" id=nav-traversal-ui:traverse-the-history-by-a-delta "traverse by a delta"
			- " any "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-2 "top-level traversable"
			- " in their "
			a href="#top-level-traversable-set" id=nav-traversal-ui:top-level-traversable-set-2 "top-level traversable set"
			- .
		}
		p class=example "For example, via back and forward buttons, possibly including long-press abilities to change the delta."
		p {
			- "It is suggested that such user agents allow traversal by deltas greater than one, to avoid letting a page \"trap\" the user by stuffing the session history with spurious entries. (For example, via repeated calls to "
			code id=nav-traversal-ui:dom-history-pushstate {
				a href="#dom-history-pushstate" "history.pushState()"
			}
			- " or "
			a href="#navigate-fragid" id=nav-traversal-ui:navigate-fragid "fragment navigations"
			- ".)"
		}
		p class=note {
			- "Some user agents have heuristics for translating a single \"back\" or \"forward\" button press into a larger delta, specifically to overcome such abuses. We are contemplating specifying these heuristics in "
			a href="https://github.com/whatwg/html/issues/7832" "issue #7832"
			- .
		}
		p {
			- "Browser user agents should offer users the ability to "
			a href="#create-a-fresh-top-level-traversable" id=nav-traversal-ui:create-a-fresh-top-level-traversable "create a fresh top-level traversable"
			- ", given a user-provided or user agent-determined initial "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=nav-traversal-ui:url URL
			- .
		}
		p class=example "For example, via a \"new tab\" or \"new window\" button."
		p {
			- "Browser user agents should offer users the ability to arbitrarily "
			a href="#close-a-top-level-traversable" id=nav-traversal-ui:close-a-top-level-traversable close
			- " any "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-3 "top-level traversable"
			- " in their "
			a href="#top-level-traversable-set" id=nav-traversal-ui:top-level-traversable-set-3 "top-level traversable set"
			- .
		}
		p class=example "For example, by clicking a \"close tab\" button."
		hr
		p {
			- "Browser user agents may provide ways for the user to explicitly cause any "
			a href="#navigable" id=nav-traversal-ui:navigable navigable
			- " (not just a "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-4 "top-level traversable"
			- ") to "
			a href="#navigate" id=nav-traversal-ui:navigate-2 navigate
			- ", "
			a href="#reload" id=nav-traversal-ui:reload-2 reload
			- ", or "
			a href="#nav-stop" id=nav-traversal-ui:nav-stop-2 "stop loading"
			- .
		}
		p class=example "For example, via a context menu."
		p {
			- "Browser user agents may provide the ability for users to "
			a href="#destroy-a-top-level-traversable" id=nav-traversal-ui:destroy-a-top-level-traversable "destroy a top-level traversable"
			- .
		}
		p class=example {
			- "For example, by force-closing a window containing one or more such "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-5 "top-level traversables"
			- .
		}
		hr
		p {
			- "When a user requests a "
			a href="#reload" id=nav-traversal-ui:reload-3 reload
			- " of a "
			a href="#navigable" id=nav-traversal-ui:navigable-2 navigable
			- " whose "
			a href="#nav-active-history-entry" id=nav-traversal-ui:nav-active-history-entry "active session history entry"
			- "'s "
			a href="#she-document-state" id=nav-traversal-ui:she-document-state "document state"
			- "'s "
			a href="#document-state-resource" id=nav-traversal-ui:document-state-resource resource
			- " is a "
			a href="#post-resource" id=nav-traversal-ui:post-resource "POST resource"
			- ", the user agent should prompt the user to confirm the operation first, since otherwise transactions (e.g., purchases or database modifications) could be repeated."
		}
		p {
			- "When a user requests a "
			a href="#reload" id=nav-traversal-ui:reload-4 reload
			- " of a "
			a href="#navigable" id=nav-traversal-ui:navigable-3 navigable
			- ", user agents may provide a mechanism for ignoring any caches when reloading."
		}
		hr
		p {
			- "All calls to "
			a href="#navigate" id=nav-traversal-ui:navigate-3 navigate
			- " initiated by the mechanisms mentioned above must have the "
			i id=nav-traversal-ui:navigation-user-involvement {
				a href="#navigation-user-involvement" userInvolvement
			}
			- " argument set to \""
			code id=nav-traversal-ui:uni-browser-ui {
				a href="#uni-browser-ui" "browser UI"
			}
			- "\"."
		}
		p {
			- "All calls to "
			a href="#reload" id=nav-traversal-ui:reload-5 reload
			- " initiated by the mechanisms mentioned above must have the "
			i id=nav-traversal-ui:reload-user-involvement {
				a href="#reload-user-involvement" userInvolvement
			}
			- " argument set to \""
			code id=nav-traversal-ui:uni-browser-ui-2 {
				a href="#uni-browser-ui" "browser UI"
			}
			- "\"."
		}
		p {
			- "All calls to "
			a href="#traverse-the-history-by-a-delta" id=nav-traversal-ui:traverse-the-history-by-a-delta-2 "traverse the history by a delta"
			- " initiated by the mechanisms mentioned above must not pass a value for the "
			i id=nav-traversal-ui:traverse-sourcedocument {
				a href="#traverse-sourcedocument" sourceDocument
			}
			- " argument."
		}
		hr
		p "The above recommendations, and the data structures in this specification, are not meant to place restrictions on how user agents represent the session history to the user."
		p {
			- "For example, although a "
			a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-6 "top-level traversable"
			- "'s "
			a href="#tn-session-history-entries" id=nav-traversal-ui:tn-session-history-entries "session history entries"
			- " are stored and maintained as a list, and the user agent is recommended to give an interface for "
			a href="#traverse-the-history-by-a-delta" id=nav-traversal-ui:traverse-the-history-by-a-delta-3 "traversing that list by a delta"
			- ", a novel user agent could instead or in addition present a tree-like view, with each page having multiple \"forward\" pages that the user can choose between."
		}
		p {
			- "Similarly, although session history for all descendant "
			a href="#navigable" id=nav-traversal-ui:navigable-4 navigables
			- " is stored in their "
			a href="#traversable-navigable" id=nav-traversal-ui:traversable-navigable "traversable navigable"
			- ", user agents could present the user with a more nuanced per-"
			a href="#navigable" id=nav-traversal-ui:navigable-5 navigable
			- " view of the session history."
		}
		hr
		p {
			- "Browser user agents may use a "
			a href="#top-level-browsing-context" id=nav-traversal-ui:top-level-browsing-context "top-level browsing context"
			- "'s "
			a href="#is-popup" id=nav-traversal-ui:is-popup "is popup"
			- " boolean for the following purposes: "
		}
		ul {
			li {
				p {
					- "Deciding whether or not to provide a minimal web browser user interface for the corresponding "
					a href="#top-level-traversable" id=nav-traversal-ui:top-level-traversable-7 "top-level traversable"
					- .
				}
			}
			li {
				p {
					- "Performing the optional steps in "
					a data-x-internal=set-up-browsing-context-features href="https://drafts.csswg.org/cssom-view/#set-up-browsing-context-features" id=nav-traversal-ui:set-up-browsing-context-features "set up browsing context features"
					- .
				}
			}
		}
		p "In both cases user agents might additionally incorporate user preferences, or present a choice as to whether to go down the popup route."
		p "User agents that provides a minimal user interface for such popups are encouraged to not hide the browser's location bar."
		h2 id=webappapis {
			span class=secno "8"
			- " Web application APIs"
			a class=self-link href="#webappapis"
		}
		h3 id=scripting {
