					- "'s "
					a data-x-internal=concept-url-origin href="https://url.spec.whatwg.org/#concept-url-origin" id=custom-handlers:concept-url-origin origin
					- " is not "
					a href="#same-origin" id=custom-handlers:same-origin "same origin"
					- " with "
					var environment
					- "'s "
					a href="#concept-settings-object-origin" id=custom-handlers:concept-settings-object-origin origin
					- ", then throw a "
					a data-x-internal=securityerror href="https://webidl.spec.whatwg.org/#securityerror" id=custom-handlers:securityerror-4 {
						- "\""
						code SecurityError
						- "\""
					}
					code id=custom-handlers:domexception-8 {
