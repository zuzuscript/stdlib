			li {
				p {
					- "Let "
					var line
					- " be an empty string. "
				}
			}
			li {
				p {
					- "Append "
					var type
					- ", "
					a data-x-internal=converted-to-ascii-uppercase href="https://infra.spec.whatwg.org/#ascii-uppercase" id=conversion-to-vcard:converted-to-ascii-uppercase "converted to ASCII uppercase"
					- ", to "
					var line
					- .
				}
			}
			li {
				p "If there are any parameters, then for each parameter, in the order that they were added, run these substeps:"
				ol {
					li {
						p {
							- "Append a U+003B SEMICOLON character (;) to "
							var line
							- .
						}
					}
					li {
						p {
							- "Append the parameter's name to "
							var line
							- .
						}
					}
					li {
						p {
							- "Append a U+003D EQUALS SIGN character (=) to "
							var line
							- .
						}
					}
					li {
						p {
							- "Append the parameter's value to "
							var line
							- .
						}
					}
				}
			}
			li {
				p {
					- "Append a U+003A COLON character (:) to "
					var line
					- .
				}
			}
			li {
				p {
					- "Append "
					var value
					- " to "
					var line
					- .
				}
			}
