			a href="#pending-request" id=images-processing-model:pending-request "pending request"
			- " is initially set to null."
		}
		p {
			- "An "
			dfn data-export="" id=image-request "image request"
			- " has a "
			dfn data-dfn-for="image request" data-export="" id=img-req-state state
			- ", "
			dfn data-dfn-for="image request" data-export="" id=img-req-url "current URL"
			- ", and "
			dfn data-dfn-for="image request" data-export="" id=img-req-data "image data"
			- .
		}
		p {
			- "An "
			a href="#image-request" id=images-processing-model:image-request-2 "image request"
			- "'s "
