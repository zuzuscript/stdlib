					code id=integration-with-the-javascript-agent-formalism:dom-document-domain {
						a href="#dom-document-domain" document.domain
					}
					- .
				}
				p {
					- "If the encompassing "
					a data-x-internal=agent-cluster href="https://tc39.es/ecma262/#sec-agent-clusters" id=integration-with-the-javascript-agent-formalism:agent-cluster "agent cluster"
