			p {
				- "We could then define "
				code Person
				- " instances to be "
				a href="#serializable-objects" id=serializable-objects:serializable-objects-5 "serializable objects"
				- " by annotating the "
				code Person
				- " interface with the "
				code id=serializable-objects:serializable-3 {
					a href="#serializable" "[Serializable]"
				}
				a data-x-internal=extended-attribute href="https://webidl.spec.whatwg.org/#dfn-extended-attribute" id=serializable-objects:extended-attribute-2 "extended attribute"
				- ", and defining the following accompanying algorithms:"
