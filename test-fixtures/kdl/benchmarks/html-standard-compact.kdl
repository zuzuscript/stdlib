			- ", and optionally either a "
			a href="#pixel-density-descriptor" id=images-processing-model:pixel-density-descriptor "pixel density descriptor"
			- ", or a "
			a href="#width-descriptor" id=images-processing-model:width-descriptor "width descriptor"
			- .
		}
		p {
			- "A "
