			}
			li {
				p {
					- "If "
					var url
					- " does not contain \""
					code %s
					- "\", then throw a "
					a data-x-internal=syntaxerror href="https://webidl.spec.whatwg.org/#syntaxerror" id=custom-handlers:syntaxerror-3 {
