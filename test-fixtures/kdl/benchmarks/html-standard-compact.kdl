		ol {
			li {
				p {
					- "If there are no properties named "
					var subname
					- " in "
					var subitem
					- ", then return the empty string."
				}
			}
			li {
				p {
					- "If the "
					a href="#concept-property-value" id=conversion-to-vcard:concept-property-value-23 value
					- " of the first property named "
					var subname
					- " in "
					var subitem
					- " is an "
