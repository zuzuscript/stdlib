				c- p="" >
				c- a="" var
				- " worker "
				c- o="" "="
				c- k="" new
				- " SharedWorker"
				c- p="" "("
				c- t="" 'test.js'
				c- p="" ");"
				c- a="" var
				- " log "
				c- o="" "="
				- " document"
				c- p="" .
				- getElementById
				c- p="" "("
				c- t="" 'log'
				c- p="" ");"
				- " worker"
				c- p="" .
				- port
				c- p="" .
				- "onmessage "
				c- o="" "="
				c- a="" function
				c- p="" "("
				- e
				c- p="" ")"
				c- p="" "{"
				c- c1="" "// note: not worker.onmessage!"
				- " log"
