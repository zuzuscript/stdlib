		}
		p {
			- "Every XML and HTML document in an HTML UA is represented by a "
			code id=documents:document {
				a href="#document" Document
			}
			- " object. "
			a href="#refsDOM" "[DOM]"
		}
		p {
			- "The "
			code id=documents:document-2 {
				a href="#document" Document
			}
			- " object's "
			dfn data-x-for=Document id=the-document's-address {
				a href="https://dom.spec.whatwg.org/#concept-document-url" URL
			}
			- " is defined in "
			cite DOM
			- ". It is initially set when the "
			code id=documents:document-3 {
				a href="#document" Document
			}
			- " object is created, but can change during the lifetime of the "
			code id=documents:document-4 {
				a href="#document" Document
			}
			- " object; for example, it changes when the user "
			a href="#navigate" id=documents:navigate navigates
			- " to a "
			a href="#navigate-fragid" id=documents:navigate-fragid fragment
			- " on the page and when the "
			code id=documents:dom-history-pushstate {
				a href="#dom-history-pushstate" "pushState()"
			}
			- " method is called with a new "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=documents:url URL
			- ". "
			a href="#refsDOM" "[DOM]"
		}
		p class=warning {
			- "Interactive user agents typically expose the "
