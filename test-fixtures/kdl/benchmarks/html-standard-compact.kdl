		h6 id=building-paths {
			span class=secno "4.12.5.1.5"
			- " Building paths"
			a class=self-link href="#building-paths"
		}
		p {
			- "Objects that implement the "
			code id=building-paths:canvaspath {
				a href="#canvaspath" CanvasPath
			}
			- " interface have a "
			a href="#concept-path" id=building-paths:concept-path path
			- ". A "
			dfn id=concept-path path
			- " has a list of zero or more subpaths. Each subpath consists of a list of one or more points, connected by straight or curved "
			dfn id=line-segments "line segments"
			- ", and a flag indicating whether the subpath is closed or not. A closed subpath is one where the last point of the subpath is connected to the first point of the subpath by a straight line. Subpaths with only one point are ignored when painting the path."
		}
		p {
			a href="#concept-path" id=building-paths:concept-path-2 Paths
			- " have a "
			dfn id=need-new-subpath "need new subpath"
			- " flag. When this flag is set, certain APIs create a new subpath rather than extending the previous one. When a "
			a href="#concept-path" id=building-paths:concept-path-3 path
			- " is created, its "
			a href="#need-new-subpath" id=building-paths:need-new-subpath "need new subpath"
			- " flag must be set."
		}
		p {
			- "When an object implementing the "
			code id=building-paths:canvaspath-2 {
				a href="#canvaspath" CanvasPath
			}
			- " interface is created, its "
			a href="#concept-path" id=building-paths:concept-path-4 path
			- " must be initialized to zero subpaths."
		}
		dl class=domintro {
			dt {
				code {
					var context
					- .
					a href="#dom-context-2d-moveto" id=dom-context-2d-moveto-dev moveTo
					- "("
					var x
					- ", "
					var y
					- ")"
				}
				div class="mdn-anno wrapped before" {
					button class=mdn-anno-btn onclick="toggleStatus(this)" {
						b class=all-engines-flag title="Support in all current engines." ✔
						span MDN
					}
					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/moveTo" title="The CanvasRenderingContext2D.moveTo() method of the Canvas 2D API begins a new sub-path at the point specified by the given (x, y) coordinates." "CanvasRenderingContext2D/moveTo"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "1.5+"
							}
							span class="safari yes" {
								span Safari
								span "2+"
							}
							span class="chrome yes" {
								span Chrome
								span "1+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "11.6+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios unknown" {
								span "Safari iOS"
								span ?
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android unknown" {
								span "WebView Android"
								span ?
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12+"
							}
						}
					}
				}
			}
			dt {
