			dl {
				dt {
					a href="#serialization-steps" id=serializable-objects:serialization-steps-2 "serialization steps"
				}
				dd {
					ol {
						li {
							p {
								- "Set "
								var serialized
								- ".[[Name]] to "
								var value
								- "'s associated name value."
							}
						}
						li {
							p {
								- "Let "
								var serializedBestFriend
								- " be the "
								a href="#sub-serialization" id=serializable-objects:sub-serialization-2 sub-serialization
								- " of "
								var value
								- "'s associated best friend value."
							}
						}
						li {
							p {
								- "Set "
								var serialized
								- ".[[BestFriend]] to "
								var serializedBestFriend
								- .
							}
						}
					}
				}
				dt {
					a href="#deserialization-steps" id=serializable-objects:deserialization-steps-2 "deserialization steps"
				}
				dd {
					ol {
						li {
							p {
								- "Set "
								var value
								- "'s associated name value to "
								var serialized
								- ".[[Name]]."
							}
						}
						li {
							p {
								- "Let "
								var deserializedBestFriend
								- " be the "
								a href="#sub-deserialization" id=serializable-objects:sub-deserialization-2 sub-deserialization
								- " of "
								var serialized
								- ".[[BestFriend]]."
							}
						}
						li {
							p {
								- "Set "
								var value
								- "'s associated best friend value to "
								var deserializedBestFriend
								- .
							}
