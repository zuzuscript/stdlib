					c- s="" "\"work\""
					c- e="" src
					c- o="" "="
					c- s="" "\"images/house.jpeg\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"A white house, boarded up, sits in a forest.\""
					c- p="" >
					c- p="" <
					c- f="" figcaption
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"title\""
					c- p="" >
					- "The house I found."
					c- p="" "</"
					c- f="" figcaption
					c- p="" >
					c- p="" "</"
					c- f="" figure
					c- p="" >
					c- p="" <
					c- f="" figure
					c- e="" itemscope
					c- e="" itemtype
					c- o="" "="
					c- s="" "\"http://n.whatwg.org/work\""
					c- e="" itemref
					c- o="" "="
					c- s="" "\"licenses\""
					c- p="" >
					c- p="" <
					c- f="" img
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"work\""
					c- e="" src
					c- o="" "="
					c- s="" "\"images/mailbox.jpeg\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"Outside the house is a mailbox. It has a leaflet inside.\""
					c- p="" >
					c- p="" <
					c- f="" figcaption
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"title\""
					c- p="" >
					- "The mailbox."
					c- p="" "</"
					c- f="" figcaption
					c- p="" >
					c- p="" "</"
					c- f="" figure
					c- p="" >
					c- p="" <
					c- f="" footer
					c- p="" >
					c- p="" <
					c- f="" p
					c- e="" id
					c- o="" "="
					c- s="" "\"licenses\""
					c- p="" >
					- "All images licensed under the "
					c- p="" <
					c- f="" a
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"license\""
					c- e="" href
					c- o="" "="
					c- s="" "\"http://www.opensource.org/licenses/mit-license.php\""
					c- p="" >
					- "MIT license"
					c- p="" "</"
