							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p "Returns the empty string (a negative response), \"maybe\", or \"probably\" based on how confident the user agent is that it can play media resources of the given type."
			}
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=method id=dom-navigator-canplaytype {
				code {
					- "canPlayType("
					var type
					- ")"
				}
			}
			- " method must return "
			dfn id=dom-canplaytyperesult-nil "the empty string"
			- " if "
			var type
			- " is "
			a href="#a-type-that-the-user-agent-knows-it-cannot-render" id=mime-types:a-type-that-the-user-agent-knows-it-cannot-render-2 "a type that the user agent knows it cannot render"
			- " or is the type \""
			code id="mime-types:application/octet-stream-3" {
				a data-x-internal="application/octet-stream" href="https://www.rfc-editor.org/rfc/rfc2046#section-4.5.1" "application/octet-stream"
			}
			- "\"; it must return \""
			dfn data-dfn-for=CanPlayTypeResult data-dfn-type=enum-value id=dom-canplaytyperesult-probably {
				code probably
			}
			- "\" if the user agent is confident that the type represents a "
			a href="#media-resource" id=mime-types:media-resource-3 "media resource"
			- " that it can render if used in with this "
			code id=mime-types:the-audio-element {
				a href="#the-audio-element" audio
			}
			- " or "
			code id=mime-types:the-video-element {
				a href="#the-video-element" video
			}
			- " element; and it must return \""
			dfn data-dfn-for=CanPlayTypeResult data-dfn-type=enum-value id=dom-canplaytyperesult-maybe {
				code maybe
			}
			- "\" otherwise. Implementers are encouraged to return \""
			code id=mime-types:dom-canplaytyperesult-maybe {
				a href="#dom-canplaytyperesult-maybe" maybe
			}
			- "\" unless the type can be confidently established as being supported or not. Generally, a user agent should never return \""
			code id=mime-types:dom-canplaytyperesult-probably {
				a href="#dom-canplaytyperesult-probably" probably
			}
			- "\" for a type that allows the "
			code codecs
			- " parameter if that parameter is not present."
		}
		div class=example {
			p {
				- "This script tests to see if the user agent supports a (fictional) new format to dynamically decide whether to use a "
				code id=mime-types:the-video-element-2 {
					a href="#the-video-element" video
				}
				- " element:"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" section
					c- e="" id
					c- o="" "="
					c- s="" "\"video\""
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" ><
					c- f="" a
					c- e="" href
					c- o="" "="
					c- s="" "\"playing-cats.nfv\""
					c- p="" >
					- "Download video"
					c- p="" "</"
					c- f="" a
					c- p="" "></"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" section
					c- p="" >
					c- p="" <
					c- f="" script
					c- p="" >
					c- a="" const
					- " videoSection "
					c- o="" "="
					- " document"
					c- p="" .
					- getElementById
					c- p="" "("
					c- t="" 'video'
					c- p="" ");"
					c- a="" const
					- " videoElement "
					c- o="" "="
					- " document"
					c- p="" .
					- createElement
					c- p="" "("
					c- t="" 'video'
					c- p="" ");"
					c- a="" const
					- " support "
					c- o="" "="
					- " videoElement"
					c- p="" .
					- canPlayType
					c- p="" "("
					c- t="" "'video/x-new-fictional-format;codecs=\"kittens,bunnies\"'"
					c- p="" ");"
					c- k="" if
					c- p="" "("
					- "support "
					c- o="" "==="
