				i id=after-doctype-system-keyword-state:force-quirks-flag-3 {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". "
				a href="#reconsume" id=after-doctype-system-keyword-state:reconsume Reconsume
				- " in the "
				a href="#bogus-doctype-state" id=after-doctype-system-keyword-state:bogus-doctype-state "bogus DOCTYPE state"
				- .
			}
		}
		h5 id=before-doctype-system-identifier-state {
			span class=secno "13.2.5.64"
			dfn "Before DOCTYPE system identifier state"
			a class=self-link href="#before-doctype-system-identifier-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=before-doctype-system-identifier-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+0009 CHARACTER TABULATION (tab)"
			dt "U+000A LINE FEED (LF)"
			dt "U+000C FORM FEED (FF)"
			dt "U+0020 SPACE"
			dd "Ignore the character."
			dt "U+0022 QUOTATION MARK (\")"
			dd {
				- "Set the current DOCTYPE token's system identifier to the empty string (not missing), then switch to the "
				a href="#doctype-system-identifier-(double-quoted)-state" id="before-doctype-system-identifier-state:doctype-system-identifier-(double-quoted)-state" "DOCTYPE system identifier (double-quoted) state"
				- .
			}
			dt "U+0027 APOSTROPHE (')"
			dd {
				- "Set the current DOCTYPE token's system identifier to the empty string (not missing), then switch to the "
				a href="#doctype-system-identifier-(single-quoted)-state" id="before-doctype-system-identifier-state:doctype-system-identifier-(single-quoted)-state" "DOCTYPE system identifier (single-quoted) state"
				- .
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is a "
				a href="#parse-error-missing-doctype-system-identifier" id=before-doctype-system-identifier-state:parse-error-missing-doctype-system-identifier missing-doctype-system-identifier
				a href="#parse-errors" id=before-doctype-system-identifier-state:parse-errors "parse error"
				- ". Set the current DOCTYPE token's "
				i id=before-doctype-system-identifier-state:force-quirks-flag {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Switch to the "
				a href="#data-state" id=before-doctype-system-identifier-state:data-state "data state"
				- ". Emit the current DOCTYPE token."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-doctype" id=before-doctype-system-identifier-state:parse-error-eof-in-doctype eof-in-doctype
				a href="#parse-errors" id=before-doctype-system-identifier-state:parse-errors-2 "parse error"
				- ". Set the current DOCTYPE token's "
				i id=before-doctype-system-identifier-state:force-quirks-flag-2 {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Emit the current DOCTYPE token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "This is a "
				a href="#parse-error-missing-quote-before-doctype-system-identifier" id=before-doctype-system-identifier-state:parse-error-missing-quote-before-doctype-system-identifier missing-quote-before-doctype-system-identifier
				a href="#parse-errors" id=before-doctype-system-identifier-state:parse-errors-3 "parse error"
				- ". Set the current DOCTYPE token's "
				i id=before-doctype-system-identifier-state:force-quirks-flag-3 {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". "
				a href="#reconsume" id=before-doctype-system-identifier-state:reconsume Reconsume
				- " in the "
				a href="#bogus-doctype-state" id=before-doctype-system-identifier-state:bogus-doctype-state "bogus DOCTYPE state"
				- .
			}
		}
		h5 id="doctype-system-identifier-(double-quoted)-state" {
			span class=secno "13.2.5.65"
			dfn "DOCTYPE system identifier (double-quoted) state"
			a class=self-link href="#doctype-system-identifier-(double-quoted)-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id="doctype-system-identifier-(double-quoted)-state:next-input-character" "next input character"
			- :
		}
		dl class=switch {
			dt "U+0022 QUOTATION MARK (\")"
			dd {
				- "Switch to the "
				a href="#after-doctype-system-identifier-state" id="doctype-system-identifier-(double-quoted)-state:after-doctype-system-identifier-state" "after DOCTYPE system identifier state"
				- .
			}
			dt "U+0000 NULL"
			dd {
				- "This is an "
				a href="#parse-error-unexpected-null-character" id="doctype-system-identifier-(double-quoted)-state:parse-error-unexpected-null-character" unexpected-null-character
				a href="#parse-errors" id="doctype-system-identifier-(double-quoted)-state:parse-errors" "parse error"
				- ". Append a U+FFFD REPLACEMENT CHARACTER character to the current DOCTYPE token's system identifier."
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is an "
				a href="#parse-error-abrupt-doctype-system-identifier" id="doctype-system-identifier-(double-quoted)-state:parse-error-abrupt-doctype-system-identifier" abrupt-doctype-system-identifier
				a href="#parse-errors" id="doctype-system-identifier-(double-quoted)-state:parse-errors-2" "parse error"
				- ". Set the current DOCTYPE token's "
				i id="doctype-system-identifier-(double-quoted)-state:force-quirks-flag" {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Switch to the "
				a href="#data-state" id="doctype-system-identifier-(double-quoted)-state:data-state" "data state"
				- ". Emit the current DOCTYPE token."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-doctype" id="doctype-system-identifier-(double-quoted)-state:parse-error-eof-in-doctype" eof-in-doctype
				a href="#parse-errors" id="doctype-system-identifier-(double-quoted)-state:parse-errors-3" "parse error"
				- ". Set the current DOCTYPE token's "
				i id="doctype-system-identifier-(double-quoted)-state:force-quirks-flag-2" {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Emit the current DOCTYPE token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "Append the "
				a href="#current-input-character" id="doctype-system-identifier-(double-quoted)-state:current-input-character" "current input character"
				- " to the current DOCTYPE token's system identifier."
			}
		}
		h5 id="doctype-system-identifier-(single-quoted)-state" {
			span class=secno "13.2.5.66"
			dfn "DOCTYPE system identifier (single-quoted) state"
			a class=self-link href="#doctype-system-identifier-(single-quoted)-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id="doctype-system-identifier-(single-quoted)-state:next-input-character" "next input character"
			- :
		}
		dl class=switch {
			dt "U+0027 APOSTROPHE (')"
			dd {
				- "Switch to the "
				a href="#after-doctype-system-identifier-state" id="doctype-system-identifier-(single-quoted)-state:after-doctype-system-identifier-state" "after DOCTYPE system identifier state"
				- .
			}
			dt "U+0000 NULL"
			dd {
				- "This is an "
				a href="#parse-error-unexpected-null-character" id="doctype-system-identifier-(single-quoted)-state:parse-error-unexpected-null-character" unexpected-null-character
				a href="#parse-errors" id="doctype-system-identifier-(single-quoted)-state:parse-errors" "parse error"
				- ". Append a U+FFFD REPLACEMENT CHARACTER character to the current DOCTYPE token's system identifier."
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is an "
				a href="#parse-error-abrupt-doctype-system-identifier" id="doctype-system-identifier-(single-quoted)-state:parse-error-abrupt-doctype-system-identifier" abrupt-doctype-system-identifier
				a href="#parse-errors" id="doctype-system-identifier-(single-quoted)-state:parse-errors-2" "parse error"
				- ". Set the current DOCTYPE token's "
				i id="doctype-system-identifier-(single-quoted)-state:force-quirks-flag" {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Switch to the "
				a href="#data-state" id="doctype-system-identifier-(single-quoted)-state:data-state" "data state"
				- ". Emit the current DOCTYPE token."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-doctype" id="doctype-system-identifier-(single-quoted)-state:parse-error-eof-in-doctype" eof-in-doctype
				a href="#parse-errors" id="doctype-system-identifier-(single-quoted)-state:parse-errors-3" "parse error"
				- ". Set the current DOCTYPE token's "
				i id="doctype-system-identifier-(single-quoted)-state:force-quirks-flag-2" {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Emit the current DOCTYPE token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "Append the "
				a href="#current-input-character" id="doctype-system-identifier-(single-quoted)-state:current-input-character" "current input character"
				- " to the current DOCTYPE token's system identifier."
			}
		}
		h5 id=after-doctype-system-identifier-state {
			span class=secno "13.2.5.67"
			dfn "After DOCTYPE system identifier state"
			a class=self-link href="#after-doctype-system-identifier-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=after-doctype-system-identifier-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+0009 CHARACTER TABULATION (tab)"
			dt "U+000A LINE FEED (LF)"
			dt "U+000C FORM FEED (FF)"
			dt "U+0020 SPACE"
			dd "Ignore the character."
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "Switch to the "
				a href="#data-state" id=after-doctype-system-identifier-state:data-state "data state"
				- ". Emit the current DOCTYPE token."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-doctype" id=after-doctype-system-identifier-state:parse-error-eof-in-doctype eof-in-doctype
				a href="#parse-errors" id=after-doctype-system-identifier-state:parse-errors "parse error"
				- ". Set the current DOCTYPE token's "
				i id=after-doctype-system-identifier-state:force-quirks-flag {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ". Emit the current DOCTYPE token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "This is an "
				a href="#parse-error-unexpected-character-after-doctype-system-identifier" id=after-doctype-system-identifier-state:parse-error-unexpected-character-after-doctype-system-identifier unexpected-character-after-doctype-system-identifier
				a href="#parse-errors" id=after-doctype-system-identifier-state:parse-errors-2 "parse error"
				- ". "
				a href="#reconsume" id=after-doctype-system-identifier-state:reconsume Reconsume
				- " in the "
				a href="#bogus-doctype-state" id=after-doctype-system-identifier-state:bogus-doctype-state "bogus DOCTYPE state"
				- ". (This does "
				em not
				- " set the current DOCTYPE token's "
				i id=after-doctype-system-identifier-state:force-quirks-flag-2 {
					a href="#force-quirks-flag" "force-quirks flag"
				}
				- " to "
				i on
				- ".)"
			}
		}
		h5 id=bogus-doctype-state {
			span class=secno "13.2.5.68"
			dfn "Bogus DOCTYPE state"
			a class=self-link href="#bogus-doctype-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=bogus-doctype-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "Switch to the "
				a href="#data-state" id=bogus-doctype-state:data-state "data state"
				- ". Emit the DOCTYPE token."
			}
			dt "U+0000 NULL"
			dd {
				- "This is an "
				a href="#parse-error-unexpected-null-character" id=bogus-doctype-state:parse-error-unexpected-null-character unexpected-null-character
				a href="#parse-errors" id=bogus-doctype-state:parse-errors "parse error"
				- ". Ignore the character."
			}
			dt EOF
			dd "Emit the DOCTYPE token. Emit an end-of-file token."
			dt "Anything else"
			dd "Ignore the character."
		}
		h5 id=cdata-section-state {
			span class=secno "13.2.5.69"
			dfn "CDATA section state"
			a class=self-link href="#cdata-section-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=cdata-section-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+005D RIGHT SQUARE BRACKET (])"
			dd {
				- "Switch to the "
				a href="#cdata-section-bracket-state" id=cdata-section-state:cdata-section-bracket-state "CDATA section bracket state"
				- .
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-cdata" id=cdata-section-state:parse-error-eof-in-cdata eof-in-cdata
				a href="#parse-errors" id=cdata-section-state:parse-errors "parse error"
				- ". Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "Emit the "
				a href="#current-input-character" id=cdata-section-state:current-input-character "current input character"
				- " as a character token."
			}
		}
		p class=note {
			- "U+0000 NULL characters are handled in the tree construction stage, as part of the "
			a href="#parsing-main-inforeign" id=cdata-section-state:parsing-main-inforeign "in foreign content"
			- " insertion mode, which is the only place where CDATA sections can appear."
		}
		h5 id=cdata-section-bracket-state {
			span class=secno "13.2.5.70"
			dfn "CDATA section bracket state"
			a class=self-link href="#cdata-section-bracket-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=cdata-section-bracket-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+005D RIGHT SQUARE BRACKET (])"
			dd {
				- "Switch to the "
				a href="#cdata-section-end-state" id=cdata-section-bracket-state:cdata-section-end-state "CDATA section end state"
				- .
			}
			dt "Anything else"
			dd {
				- "Emit a U+005D RIGHT SQUARE BRACKET character token. "
				a href="#reconsume" id=cdata-section-bracket-state:reconsume Reconsume
				- " in the "
				a href="#cdata-section-state" id=cdata-section-bracket-state:cdata-section-state "CDATA section state"
				- .
			}
		}
		h5 id=cdata-section-end-state {
			span class=secno "13.2.5.71"
			dfn "CDATA section end state"
			a class=self-link href="#cdata-section-end-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=cdata-section-end-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+005D RIGHT SQUARE BRACKET (])"
			dd "Emit a U+005D RIGHT SQUARE BRACKET character token."
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "Switch to the "
				a href="#data-state" id=cdata-section-end-state:data-state "data state"
				- .
			}
			dt "Anything else"
			dd {
				- "Emit two U+005D RIGHT SQUARE BRACKET character tokens. "
				a href="#reconsume" id=cdata-section-end-state:reconsume Reconsume
				- " in the "
				a href="#cdata-section-state" id=cdata-section-end-state:cdata-section-state "CDATA section state"
				- .
			}
		}
		h5 id=character-reference-state {
			span class=secno "13.2.5.72"
			dfn "Character reference state"
			a class=self-link href="#character-reference-state"
		}
		p {
			- "Set the "
			var id=character-reference-state:temporary-buffer {
				a href="#temporary-buffer" "temporary buffer"
			}
			- " to the empty string. Append a U+0026 AMPERSAND (&) character to the "
			var id=character-reference-state:temporary-buffer-2 {
				a href="#temporary-buffer" "temporary buffer"
			}
			- ". Consume the "
			a href="#next-input-character" id=character-reference-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt {
				a data-x-internal=alphanumeric-ascii-characters href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id=character-reference-state:alphanumeric-ascii-characters "ASCII alphanumeric"
			}
			dd {
				a href="#reconsume" id=character-reference-state:reconsume Reconsume
				- " in the "
				a href="#named-character-reference-state" id=character-reference-state:named-character-reference-state "named character reference state"
				- .
			}
			dt "U+0023 NUMBER SIGN (#)"
			dd {
				- "Append the "
				a href="#current-input-character" id=character-reference-state:current-input-character "current input character"
				- " to the "
				var id=character-reference-state:temporary-buffer-3 {
					a href="#temporary-buffer" "temporary buffer"
				}
				- ". Switch to the "
				a href="#numeric-character-reference-state" id=character-reference-state:numeric-character-reference-state "numeric character reference state"
				- .
			}
			dt "Anything else"
			dd {
				a href="#flush-code-points-consumed-as-a-character-reference" id=character-reference-state:flush-code-points-consumed-as-a-character-reference "Flush code points consumed as a character reference"
				- ". "
				a href="#reconsume" id=character-reference-state:reconsume-2 Reconsume
				- " in the "
				var id=character-reference-state:return-state {
					a href="#return-state" "return state"
				}
				- .
			}
		}
		h5 id=named-character-reference-state {
			span class=secno "13.2.5.73"
			dfn "Named character reference state"
			a class=self-link href="#named-character-reference-state"
		}
		p {
			- "Consume the maximum number of characters possible, where the consumed characters are one of the identifiers in the first column of the "
			a href="#named-character-references" id=named-character-reference-state:named-character-references "named character references"
			- " table. Append each character to the "
			var id=named-character-reference-state:temporary-buffer {
				a href="#temporary-buffer" "temporary buffer"
			}
			- " when it's consumed."
		}
		dl class=switch {
			dt "If there is a match"
			dd {
				p {
					- "If the character reference was "
					a href="#charref-in-attribute" id=named-character-reference-state:charref-in-attribute "consumed as part of an attribute"
					- ", and the last character matched is not a U+003B SEMICOLON character (;), and the "
					a href="#next-input-character" id=named-character-reference-state:next-input-character "next input character"
					- " is either a U+003D EQUALS SIGN character (=) or an "
					a data-x-internal=alphanumeric-ascii-characters href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id=named-character-reference-state:alphanumeric-ascii-characters "ASCII alphanumeric"
					- ", then, for historical reasons, "
					a href="#flush-code-points-consumed-as-a-character-reference" id=named-character-reference-state:flush-code-points-consumed-as-a-character-reference "flush code points consumed as a character reference"
					- " and switch to the "
					var id=named-character-reference-state:return-state {
						a href="#return-state" "return state"
					}
					- ". "
				}
				p Otherwise:
				ol {
					li {
						p {
							- "If the last character matched is not a U+003B SEMICOLON character (;), then this is a "
							a href="#parse-error-missing-semicolon-after-character-reference" id=named-character-reference-state:parse-error-missing-semicolon-after-character-reference missing-semicolon-after-character-reference
							a href="#parse-errors" id=named-character-reference-state:parse-errors "parse error"
							- .
						}
					}
					li {
						p {
							- "Set the "
							var id=named-character-reference-state:temporary-buffer-2 {
								a href="#temporary-buffer" "temporary buffer"
							}
							- " to the empty string. Append one or two characters corresponding to the character reference name (as given by the second column of the "
							a href="#named-character-references" id=named-character-reference-state:named-character-references-2 "named character references"
							- " table) to the "
							var id=named-character-reference-state:temporary-buffer-3 {
								a href="#temporary-buffer" "temporary buffer"
							}
							- .
						}
					}
					li {
						a href="#flush-code-points-consumed-as-a-character-reference" id=named-character-reference-state:flush-code-points-consumed-as-a-character-reference-2 "Flush code points consumed as a character reference"
						- ". Switch to the "
						var id=named-character-reference-state:return-state-2 {
							a href="#return-state" "return state"
						}
						- .
					}
				}
			}
			dt Otherwise
			dd {
				a href="#flush-code-points-consumed-as-a-character-reference" id=named-character-reference-state:flush-code-points-consumed-as-a-character-reference-3 "Flush code points consumed as a character reference"
				- ". Switch to the "
				a href="#ambiguous-ampersand-state" id=named-character-reference-state:ambiguous-ampersand-state "ambiguous ampersand state"
				- .
			}
		}
		div class=example {
			p {
				- "If the markup contains (not in an attribute) the string "
				code "I'm &notit; I tell you"
				- ", the character reference is parsed as \"not\", as in, "
				code "I'm ¬it; I tell you"
				- " (and this is a parse error). But if the markup was "
				code "I'm &notin; I tell you"
				- ", the character reference would be parsed as \"notin;\", resulting in "
				code "I'm ∉ I tell you"
				- " (and no parse error)."
			}
			p {
				- "However, if the markup contains the string "
				code "I'm &notit; I tell you"
				- " in an attribute, no character reference is parsed and string remains intact (and there is no parse error)."
			}
		}
		h5 id=ambiguous-ampersand-state {
			span class=secno "13.2.5.74"
			dfn "Ambiguous ampersand state"
			a class=self-link href="#ambiguous-ampersand-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=ambiguous-ampersand-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt {
				a data-x-internal=alphanumeric-ascii-characters href="https://infra.spec.whatwg.org/#ascii-alphanumeric" id=ambiguous-ampersand-state:alphanumeric-ascii-characters "ASCII alphanumeric"
			}
			dd {
				- "If the character reference was "
				a href="#charref-in-attribute" id=ambiguous-ampersand-state:charref-in-attribute "consumed as part of an attribute"
				- ", then append the "
				a href="#current-input-character" id=ambiguous-ampersand-state:current-input-character "current input character"
				- " to the current attribute's value. Otherwise, emit the "
				a href="#current-input-character" id=ambiguous-ampersand-state:current-input-character-2 "current input character"
				- " as a character token."
			}
			dt "U+003B SEMICOLON (;)"
			dd {
				- "This is an "
				a href="#parse-error-unknown-named-character-reference" id=ambiguous-ampersand-state:parse-error-unknown-named-character-reference unknown-named-character-reference
				a href="#parse-errors" id=ambiguous-ampersand-state:parse-errors "parse error"
				- ". "
				a href="#reconsume" id=ambiguous-ampersand-state:reconsume Reconsume
				- " in the "
				var id=ambiguous-ampersand-state:return-state {
					a href="#return-state" "return state"
				}
				- ". "
			}
			dt "Anything else"
			dd {
				a href="#reconsume" id=ambiguous-ampersand-state:reconsume-2 Reconsume
				- " in the "
				var id=ambiguous-ampersand-state:return-state-2 {
					a href="#return-state" "return state"
				}
				- .
			}
		}
		h5 id=numeric-character-reference-state {
			span class=secno "13.2.5.75"
			dfn "Numeric character reference state"
			a class=self-link href="#numeric-character-reference-state"
		}
