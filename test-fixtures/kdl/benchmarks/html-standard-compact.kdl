			}
			li {
				p {
					- "When user agent updates a "
					a href="#form-associated-custom-element" id=custom-element-reactions:form-associated-custom-element-4 "form-associated custom element"
					- "'s value on behalf of a user or "
					a href="#restore-persisted-state" id=custom-element-reactions:restore-persisted-state "as part of navigation"
					- ", its "
					code formStateRestoreCallback
