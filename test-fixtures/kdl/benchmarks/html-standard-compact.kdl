		}
		pre {
			code class=css {
				c- n="" @namespace
				c- s="" "\"http://www.w3.org/1999/xhtml\""
				c- p="" ";"
				c- f="" "input, select, button, textarea "
				c- p="" "{"
				c- k="" letter-spacing
				c- p="" :
				- " initial"
				c- p="" ";"
				c- k="" word-spacing
				c- p="" :
				- " initial"
				c- p="" ";"
				c- k="" line-height
				c- p="" :
				- " initial"
				c- p="" ";"
				c- k="" text-transform
				c- p="" :
				- " initial"
				c- p="" ";"
