		p {
			- "A "
			dfn data-dfn-for=input,textarea data-dfn-type=element-attr data-lt=minlength id=attr-fe-minlength {
				- "form control "
				code minlength
				- " attribute"
			}
			- ", controlled by the "
			a href="#concept-fe-dirty" id=setting-minimum-input-length-requirements:-the-minlength-attribute:concept-fe-dirty "dirty value flag"
			- ", declares a lower bound on the number of characters a user can input. The \"number of characters\" is measured using "
			a data-x-internal=length href="https://infra.spec.whatwg.org/#string-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:length length
			- " and, in the case of "
			code id=setting-minimum-input-length-requirements:-the-minlength-attribute:the-textarea-element {
				a href="#the-textarea-element" textarea
			}
			- " elements, with all newlines normalized to a single character (as opposed to CRLF pairs)."
		}
		p class=note {
			- "The "
			code id=setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-2 {
				a href="#attr-fe-minlength" minlength
			}
			- " attribute does not imply the "
			code required
			- " attribute. If the form control has no "
			code required
			- " attribute, then the value can still be omitted; the "
			code id=setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-3 {
				a href="#attr-fe-minlength" minlength
			}
			- " attribute only kicks in once the user has entered a value at all. If the empty string is not allowed, then the "
			code required
			- " attribute also needs to be set."
		}
		p {
			- "If an element has its "
			a href="#attr-fe-minlength" id=setting-minimum-input-length-requirements:-the-minlength-attribute:attr-fe-minlength-4 {
				- "form control "
				code minlength
				- " attribute"
			}
			- " specified, the attribute's value must be a "
			a href="#valid-non-negative-integer" id=setting-minimum-input-length-requirements:-the-minlength-attribute:valid-non-negative-integer "valid non-negative integer"
			- ". If the attribute is specified and applying the "
			a href="#rules-for-parsing-non-negative-integers" id=setting-minimum-input-length-requirements:-the-minlength-attribute:rules-for-parsing-non-negative-integers "rules for parsing non-negative integers"
			- " to its value results in a number, then that number is the element's "
			dfn id=minimum-allowed-value-length "minimum allowed value length"
			- ". If the attribute is omitted or parsing its value results in an error, then there is no "
			a href="#minimum-allowed-value-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length "minimum allowed value length"
			- .
		}
		p {
			- "If an element has both a "
			a href="#maximum-allowed-value-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:maximum-allowed-value-length "maximum allowed value length"
			- " and a "
			a href="#minimum-allowed-value-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-2 "minimum allowed value length"
			- ", the "
			a href="#minimum-allowed-value-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:minimum-allowed-value-length-3 "minimum allowed value length"
			- " must be smaller than or equal to the "
			a href="#maximum-allowed-value-length" id=setting-minimum-input-length-requirements:-the-minlength-attribute:maximum-allowed-value-length-2 "maximum allowed value length"
			- .
		}
		p {
