				c- p="" ");"
				c- c1="" "// After element definition, the in-document element was upgraded:"
				- " console"
				c- p="" .
				- assert
				c- p="" "("
				- "inDocument "
				c- k="" instanceof
				- " ExampleElement"
				c- p="" ");"
				- " console"
				c- p="" .
				- assert
				c- p="" "("
