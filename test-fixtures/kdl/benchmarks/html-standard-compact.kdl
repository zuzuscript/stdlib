		h4 id=javascript-specification-host-hooks {
			span class=secno "8.1.6"
			- " JavaScript specification host hooks"
			a class=self-link href="#javascript-specification-host-hooks"
		}
		p {
			- "The JavaScript specification contains a number of "
			a data-x-internal=implementation-defined href="https://infra.spec.whatwg.org/#implementation-defined" id=javascript-specification-host-hooks:implementation-defined implementation-defined
			- " abstract operations, that vary depending on the host environment. This section defines them for user agent hosts."
		}
		h5 id=the-hostensurecanaddprivateelement-implementation {
			span class=secno "8.1.6.1"
			dfn HostEnsureCanAddPrivateElement
			- "("
			var O
			- ")"
			a class=self-link href="#the-hostensurecanaddprivateelement-implementation"
		}
		p {
			- "JavaScript contains an "
			a data-x-internal=implementation-defined href="https://infra.spec.whatwg.org/#implementation-defined" id=the-hostensurecanaddprivateelement-implementation:implementation-defined implementation-defined
			a data-x-internal=js-hostensurecanaddprivateelement href="https://tc39.es/ecma262/#sec-hostensurecanaddprivateelement" id=the-hostensurecanaddprivateelement-implementation:js-hostensurecanaddprivateelement HostEnsureCanAddPrivateElement
			- "("
			var O
			- ") abstract operation. User agents must use the following implementation: "
			a href="#refsJAVASCRIPT" "[JAVASCRIPT]"
		}
		ol {
			li {
				p {
					- "If "
					var O
					- " is a "
					code id=the-hostensurecanaddprivateelement-implementation:windowproxy {
						a href="#windowproxy" WindowProxy
					}
					- " object, or "
					a data-x-internal=implements href="https://webidl.spec.whatwg.org/#implements" id=the-hostensurecanaddprivateelement-implementation:implements implements
					code id=the-hostensurecanaddprivateelement-implementation:location {
						a href="#location" Location
					}
					- ", then return Completion { [[Type]]: throw, [[Value]]: a new "
					code id=the-hostensurecanaddprivateelement-implementation:typeerror {
						a data-x-internal=typeerror href="https://tc39.es/ecma262/#sec-native-error-types-used-in-this-standard-typeerror" TypeError
					}
					- " }."
				}
			}
			li {
				p {
					- "Return "
					a data-x-internal=normalcompletion href="https://tc39.es/ecma262/#sec-normalcompletion" id=the-hostensurecanaddprivateelement-implementation:normalcompletion NormalCompletion
					- "(unused)."
				}
			}
		}
		p class=note {
			- "JavaScript private fields can be applied to arbitrary objects. Since this can dramatically complicate implementation for particularly-exotic host objects, the JavaScript language specification provides this hook to allow hosts to reject private fields on objects meeting a host-defined criteria. In the case of HTML, "
			code id=the-hostensurecanaddprivateelement-implementation:windowproxy-2 {
				a href="#windowproxy" WindowProxy
			}
			- " and "
			code id=the-hostensurecanaddprivateelement-implementation:location-2 {
				a href="#location" Location
			}
			- " have complicated semantics — particularly around navigation and security — that make implementation of private field semantics challenging, so our implementation simply rejects those objects."
		}
