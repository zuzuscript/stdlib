			a href="#custom-element-definition" id=custom-elements-core-concepts:custom-element-definition "custom element definition"
			- " whose "
			a href="#concept-custom-element-definition-form-associated" id=custom-elements-core-concepts:concept-custom-element-definition-form-associated form-associated
			- " field is set to true."
		}
		p {
			- "The "
			code id=custom-elements-core-concepts:attr-fe-name-2 {
				a href="#attr-fe-name" name
			}
			- " attribute represents the "
			a href="#form-associated-custom-element" id=custom-elements-core-concepts:form-associated-custom-element-7 "form-associated custom element"
