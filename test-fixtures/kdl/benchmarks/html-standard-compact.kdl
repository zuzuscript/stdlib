					}
					span class="opera_android no" {
						span "Opera Android"
						span "11–14"
					}
				}
			}
		}
		p {
			i "This section is non-normative."
		}
		p "Shared workers are identified by the URL of the script used to create it, optionally with an explicit name. The name allows multiple instances of a particular shared worker to be started."
		p {
			- "Shared workers are scoped by "
			a href="#concept-origin" id=shared-workers:concept-origin origin
			- ". Two different sites using the same names will not collide. However, if a page tries to use the same shared worker name as another page on the same site, but with a different script URL, it will fail."
		}
		p {
			- "Creating shared workers is done using the "
			code id=shared-workers:dom-sharedworker {
				a href="#dom-sharedworker" "SharedWorker()"
			}
			- " constructor. This constructor takes the URL to the script to use for its first argument, and the name of the worker, if any, as the second argument."
		}
		pre {
			code class=js {
				c- a="" var
				- " worker "
				c- o="" "="
				c- k="" new
				- " SharedWorker"
				c- p="" "("
				c- t="" 'service.js'
				c- p="" ");"
			}
		}
		p {
			- "Communicating with shared workers is done with explicit "
			code id=shared-workers:messageport {
				a href="#messageport" MessagePort
			}
			- " objects. The object returned by the "
			code id=shared-workers:dom-sharedworker-2 {
				a href="#dom-sharedworker" "SharedWorker()"
			}
			- " constructor holds a reference to the port on its "
			code id=shared-workers:dom-sharedworker-port {
				a href="#dom-sharedworker-port" port
			}
			- " attribute."
		}
		pre {
			code class=js {
				- worker
				c- p="" .
				- port
				c- p="" .
				- "onmessage "
				c- o="" "="
				c- a="" function
				c- p="" "("
				- event
				c- p="" ")"
				c- p="" "{"
				c- p="" ...
				c- p="" "};"
				- " worker"
				c- p="" .
				- port
				c- p="" .
				- postMessage
				c- p="" "("
				c- t="" "'some message'"
				c- p="" ");"
				- " worker"
				c- p="" .
				- port
				c- p="" .
				- postMessage
				c- p="" "({"
				- " foo"
				c- o="" :
				c- t="" 'structured'
				c- p="" ,
				- " bar"
				c- o="" :
				c- p="" "["
				c- t="" 'data'
				c- p="" ,
				c- t="" 'also'
				c- p="" ,
				c- t="" 'possible'
				c- p="" "]});"
			}
		}
		p {
			- "Inside the shared worker, new clients of the worker are announced using the "
			code id=shared-workers:event-workerglobalscope-connect {
				a href="#event-workerglobalscope-connect" connect
			}
			- " event. The port for the new client is given by the event object's "
			code id=shared-workers:dom-messageevent-source {
				a href="#dom-messageevent-source" source
			}
			- " attribute."
		}
		pre {
			code class=js {
				- "onconnect "
				c- o="" "="
				c- a="" function
				c- p="" "("
				- event
				c- p="" ")"
				c- p="" "{"
				c- a="" var
				- " newPort "
				c- o="" "="
				- " event"
				c- p="" .
				- source
				c- p="" ";"
				c- c1="" "// set up a listener"
				- " newPort"
				c- p="" .
				- "onmessage "
				c- o="" "="
				c- a="" function
				c- p="" "("
				- event
				c- p="" ")"
				c- p="" "{"
				c- p="" ...
				c- p="" "};"
				c- c1="" "// send a message back to the port"
				- " newPort"
				c- p="" .
				- postMessage
				c- p="" "("
				c- t="" 'ready!'
				c- p="" ");"
				c- c1="" "// can also send structured data, of course"
				c- p="" "};"
			}
		}
		h3 id=infrastructure-2 {
			span class=secno "10.2"
			- " Infrastructure"
			a class=self-link href="#infrastructure-2"
		}
		p {
			- "This standard defines two kinds of workers: dedicated workers, and shared workers. Dedicated workers, once created, are linked to their creator, but message ports can be used to communicate from a dedicated worker to multiple other browsing contexts or workers. Shared workers, on the other hand, are named, and once created any script running in the same "
			a href="#concept-origin" id=infrastructure-2:concept-origin origin
			- " can obtain a reference to that worker and communicate with it. "
			cite "Service Workers"
			- " defines a third kind. "
			a href="#refsSW" "[SW]"
		}
		h4 id=the-global-scope {
			span class=secno "10.2.1"
			- " The global scope"
			a class=self-link href="#the-global-scope"
		}
		p "The global scope is the \"inside\" of a worker."
		h5 id=the-workerglobalscope-common-interface {
			span class=secno "10.2.1.1"
			- " The "
			code id=workerglobalscope-dev {
