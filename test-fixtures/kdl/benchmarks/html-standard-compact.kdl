		h3 class=no-num id=mime-types-2 {
			- "MIME types"
			a class=self-link href="#mime-types-2"
		}
		p {
			i "This section is non-normative."
		}
		p "The following MIME types are mentioned in this specification:"
		dl {
			dt {
				dfn id="application/atom+xml" {
					code "application/atom+xml"
				}
			}
			dd {
				- "Atom "
				a href="#refsATOM" "[ATOM]"
			}
			dt {
				dfn id="application/json" {
					code "application/json"
				}
			}
			dd {
				- "JSON "
				a href="#refsJSON" "[JSON]"
			}
			dt {
				dfn id="application/octet-stream" {
					a href="https://www.rfc-editor.org/rfc/rfc2046#section-4.5.1" {
						code "application/octet-stream"
					}
				}
			}
			dd {
				- "Generic binary data "
				a href="#refsRFC2046" "[RFC2046]"
			}
			dt {
				code id="mime-types-2:application/microdata+json" {
					a href="#application/microdata+json" "application/microdata+json"
				}
			}
			dd "Microdata as JSON "
			dt {
				dfn id="application/rss+xml" {
					code "application/rss+xml"
				}
			}
			dd "RSS "
			dt {
				dfn id="application/wasm" {
					code "application/wasm"
				}
			}
			dd {
				- "WebAssembly "
				a href="#refsWASM" "[WASM]"
			}
			dt {
				code id="mime-types-2:application/x-www-form-urlencoded" {
					a data-x-internal="application/x-www-form-urlencoded" href="https://url.spec.whatwg.org/#concept-urlencoded" "application/x-www-form-urlencoded"
				}
			}
			dd "Form submission"
			dt {
				code id="mime-types-2:application/xhtml+xml" {
					a href="#application/xhtml+xml" "application/xhtml+xml"
				}
			}
			dd HTML
			dt {
				dfn id="application/xml" {
					code "application/xml"
				}
			}
			dd {
				- "XML "
				a href="#refsXML" "[XML]"
				a href="#refsRFC7303" "[RFC7303]"
			}
			dt {
				dfn id="image/gif" {
					code "image/gif"
				}
			}
			dd {
				- "GIF images "
				a href="#refsGIF" "[GIF]"
			}
			dt {
				dfn id="image/jpeg" {
					code "image/jpeg"
				}
			}
			dd {
				- "JPEG images "
