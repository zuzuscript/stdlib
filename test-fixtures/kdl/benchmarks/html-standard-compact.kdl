		h6 id="number-state-(type=number)" {
			span class=secno "4.10.5.1.12"
			dfn data-dfn-for=input data-dfn-type=element-state id=number-state Number
			- " state ("
			code "type=number"
			- ")"
			a class=self-link href="#number-state-(type=number)"
		}
		div class="mdn-anno wrapped" {
			button class=mdn-anno-btn onclick="toggleStatus(this)" {
				b class=all-engines-flag title="Support in all current engines." ✔
