					a href="#attr-input-type" type
				}
				- " attribute in the "
				a href="#email-state-(type=email)" id="autofill-processing-model:email-state-(type=email)" Email
				- " state and with the "
				code id=autofill-processing-model:attr-input-multiple {
					a href="#attr-input-multiple" multiple
				}
				- " attribute specified"
			}
			dd {
				- "The element's "
				a href="#concept-fe-values" id=autofill-processing-model:concept-fe-values {
					- value
					em s
				}
				- .
			}
			dt {
				- "Any other "
				code id=autofill-processing-model:the-input-element-3 {
					a href="#the-input-element" input
				}
				- " element"
			}
			dt {
				- "A "
				code id=autofill-processing-model:the-textarea-element-2 {
					a href="#the-textarea-element" textarea
				}
				- " element"
			}
			dd {
				- "The element's "
				a href="#concept-fe-value" id=autofill-processing-model:concept-fe-value value
				- .
			}
			dt {
				- "A "
				code id=autofill-processing-model:the-select-element-2 {
					a href="#the-select-element" select
				}
				- " element with its "
				code id=autofill-processing-model:attr-select-multiple {
					a href="#attr-select-multiple" multiple
				}
				- " attribute specified"
			}
			dd {
				- "The "
				code id=autofill-processing-model:the-option-element {
					a href="#the-option-element" option
				}
				- " elements in the "
				code id=autofill-processing-model:the-select-element-3 {
					a href="#the-select-element" select
				}
				- " element's "
				a href="#concept-select-option-list" id=autofill-processing-model:concept-select-option-list "list of options"
				- " that have their "
				a href="#concept-option-selectedness" id=autofill-processing-model:concept-option-selectedness selectedness
				- " set to true."
			}
			dt {
				- "Any other "
				code id=autofill-processing-model:the-select-element-4 {
					a href="#the-select-element" select
				}
				- " element"
			}
			dd {
				- "The "
				code id=autofill-processing-model:the-option-element-2 {
					a href="#the-option-element" option
				}
				- " element in the "
				code id=autofill-processing-model:the-select-element-5 {
					a href="#the-select-element" select
				}
				- " element's "
				a href="#concept-select-option-list" id=autofill-processing-model:concept-select-option-list-2 "list of options"
				- " that has its "
				a href="#concept-option-selectedness" id=autofill-processing-model:concept-option-selectedness-2 selectedness
				- " set to true."
			}
		}
		hr
		p {
			- "How to process the "
			a href="#autofill-hint-set" id=autofill-processing-model:autofill-hint-set-7 "autofill hint set"
			- ", "
			a href="#autofill-scope" id=autofill-processing-model:autofill-scope-4 "autofill scope"
			- ", and "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-8 "autofill field name"
			- " depends on the mantle that the "
			code id=autofill-processing-model:attr-fe-autocomplete-5 {
				a href="#attr-fe-autocomplete" autocomplete
			}
			- " attribute is wearing."
		}
		dl class=switch {
			dt {
				- "When wearing the "
				a href="#autofill-expectation-mantle" id=autofill-processing-model:autofill-expectation-mantle "autofill expectation mantle"
				- "... "
			}
			dd {
				p {
					- "When an element's "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-9 "autofill field name"
					- " is \""
					code id=autofill-processing-model:attr-fe-autocomplete-off-3 {
						a href="#attr-fe-autocomplete-off" off
					}
					- "\", the user agent should not remember the "
					a href="#control's-data" id=autofill-processing-model:control's-data "control's data"
					- ", and should not offer past values to the user."
				}
				p class=note {
					- "In addition, when an element's "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-10 "autofill field name"
					- " is \""
					code id=autofill-processing-model:attr-fe-autocomplete-off-4 {
						a href="#attr-fe-autocomplete-off" off
					}
					- "\", "
					a href="#history-autocomplete" "values are reset"
					- " when "
					a href="#reactivate-a-document" id=autofill-processing-model:reactivate-a-document "reactivating a document"
					- .
				}
				div class=example {
					p "Banks frequently do not want UAs to prefill login information:"
					pre {
						code class=html {
							c- p="" <
							c- f="" p
							c- p="" ><
							c- f="" label
							c- p="" >
							- "Account: "
							c- p="" <
							c- f="" input
							c- e="" type
							c- o="" "="
							c- s="" "\"text\""
							c- e="" name
							c- o="" "="
							c- s="" "\"ac\""
							c- e="" autocomplete
							c- o="" "="
							c- s="" "\"off\""
							c- p="" "></"
							c- f="" label
							c- p="" "></"
							c- f="" p
							c- p="" >
							c- p="" <
							c- f="" p
							c- p="" ><
							c- f="" label
							c- p="" >
							- "PIN: "
							c- p="" <
							c- f="" input
							c- e="" type
							c- o="" "="
							c- s="" "\"password\""
							c- e="" name
							c- o="" "="
							c- s="" "\"pin\""
							c- e="" autocomplete
							c- o="" "="
							c- s="" "\"off\""
							c- p="" "></"
							c- f="" label
							c- p="" "></"
							c- f="" p
							c- p="" >
						}
					}
				}
				p {
					- "When an element's "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-11 "autofill field name"
					- " is "
					em not
					- " \""
					code id=autofill-processing-model:attr-fe-autocomplete-off-5 {
						a href="#attr-fe-autocomplete-off" off
					}
					- "\", the user agent may store the "
					a href="#control's-data" id=autofill-processing-model:control's-data-2 "control's data"
					- ", and may offer previously stored values to the user."
				}
				div class=example {
					p "For example, suppose a user visits a page with this control:"
					pre {
						code class=html {
							c- p="" <
							c- f="" select
							c- e="" name
							c- o="" "="
							c- s="" "\"country\""
							c- p="" >
							c- p="" <
							c- f="" option
							c- p="" >
							- "Afghanistan "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Albania "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Algeria "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Andorra "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Angola "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Antigua and Barbuda "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Argentina "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Armenia "
							c- c="" "<!-- "
							em {
								c- c="" ...
							}
							c- c="" " -->"
							c- p="" <
							c- f="" option
							c- p="" >
							- "Yemen "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Zambia "
							c- p="" <
							c- f="" option
							c- p="" >
							- "Zimbabwe "
							c- p="" "</"
							c- f="" select
							c- p="" >
						}
					}
					p "This might render as follows:"
					p {
						img alt="A drop-down control with a long alphabetical list of countries." src="/images/select-country-1.png"
					}
					p "Suppose that on the first visit to this page, the user selects \"Zambia\". On the second visit, the user agent could duplicate the entry for Zambia at the top of the list, so that the interface instead looks like this:"
					p {
						img alt="The same drop-down control with the alphabetical list of countries, but with Zambia as an entry at the top." src="/images/select-country-2.png"
					}
				}
				p {
					- "When the "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-12 "autofill field name"
					- " is \""
					code id=autofill-processing-model:attr-fe-autocomplete-on-3 {
						a href="#attr-fe-autocomplete-on" on
					}
					- "\", the user agent should attempt to use heuristics to determine the most appropriate values to offer the user, e.g. based on the element's "
					code id=autofill-processing-model:attr-fe-name {
						a href="#attr-fe-name" name
					}
					- " value, the position of the element in its "
					a data-x-internal=tree href="https://dom.spec.whatwg.org/#concept-tree" id=autofill-processing-model:tree tree
					- ", what other fields exist in the form, and so forth."
				}
				p {
					- "When the "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-13 "autofill field name"
					- " is one of the names of the "
					a href="#autofill-field" id=autofill-processing-model:autofill-field-2 "autofill fields"
					- " described above, the user agent should provide suggestions that match the meaning of the field name as given in the table earlier in this section. The "
					a href="#autofill-hint-set" id=autofill-processing-model:autofill-hint-set-8 "autofill hint set"
					- " should be used to select amongst multiple possible suggestions."
				}
				p class=example {
					- "For example, if a user once entered one address into fields that used the \""
					code id=autofill-processing-model:attr-fe-autocomplete-shipping-3 {
						a href="#attr-fe-autocomplete-shipping" shipping
					}
					- "\" keyword, and another address into fields that used the \""
					code id=autofill-processing-model:attr-fe-autocomplete-billing-3 {
						a href="#attr-fe-autocomplete-billing" billing
					}
					- "\" keyword, then in subsequent forms only the first address would be suggested for form controls whose "
					a href="#autofill-hint-set" id=autofill-processing-model:autofill-hint-set-9 "autofill hint set"
					- " contains the keyword \""
					code id=autofill-processing-model:attr-fe-autocomplete-shipping-4 {
						a href="#attr-fe-autocomplete-shipping" shipping
					}
					- "\". Both addresses might be suggested, however, for address-related form controls whose "
					a href="#autofill-hint-set" id=autofill-processing-model:autofill-hint-set-10 "autofill hint set"
					- " does not contain either keyword."
				}
			}
			dt {
				- "When wearing the "
				a href="#autofill-anchor-mantle" id=autofill-processing-model:autofill-anchor-mantle-3 "autofill anchor mantle"
				- "... "
			}
			dd {
				p {
					- "When the "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-14 "autofill field name"
					- " is not the empty string, then the user agent must act as if the user had specified the "
					a href="#control's-data" id=autofill-processing-model:control's-data-3 "control's data"
					- " for the given "
					a href="#autofill-hint-set" id=autofill-processing-model:autofill-hint-set-11 "autofill hint set"
					- ", "
					a href="#autofill-scope" id=autofill-processing-model:autofill-scope-5 "autofill scope"
					- ", and "
					a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-15 "autofill field name"
					- " combination."
				}
			}
		}
		p {
			- "When the user agent "
			dfn id=concept-fe-autofill "autofills form controls"
			- ", elements with the same "
			a href="#form-owner" id=autofill-processing-model:form-owner-2 "form owner"
			- " and the same "
			a href="#autofill-scope" id=autofill-processing-model:autofill-scope-6 "autofill scope"
			- " must use data relating to the same person, address, payment instrument, and contact details. "
			span id=autofill-country {
				- "When a user agent autofills \""
				code id=autofill-processing-model:attr-fe-autocomplete-country-2 {
					a href="#attr-fe-autocomplete-country" country
				}
				- "\" and \""
				code id=autofill-processing-model:attr-fe-autocomplete-country-name-2 {
					a href="#attr-fe-autocomplete-country-name" country-name
				}
				- "\" fields with the same "
				a href="#form-owner" id=autofill-processing-model:form-owner-3 "form owner"
				- " and "
				a href="#autofill-scope" id=autofill-processing-model:autofill-scope-7 "autofill scope"
				- ", and the user agent has a value for the "
				code id=autofill-processing-model:attr-fe-autocomplete-country-3 {
					a href="#attr-fe-autocomplete-country" country
				}
				- "\" field(s), then the \""
				code id=autofill-processing-model:attr-fe-autocomplete-country-name-3 {
					a href="#attr-fe-autocomplete-country-name" country-name
				}
				- "\" field(s) must be filled using a human-readable name for the same country."
			}
			- " When a user agent fills in multiple fields at once, all fields with the same "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-16 "autofill field name"
			- ", "
			a href="#form-owner" id=autofill-processing-model:form-owner-4 "form owner"
			- ", and "
			a href="#autofill-scope" id=autofill-processing-model:autofill-scope-8 "autofill scope"
			- " must be filled with the same value."
		}
		p class=example {
			- "Suppose a user agent knows of two phone numbers, +1 555 123 1234 and +1 555 666 7777. It would not be conforming for the user agent to fill a field with "
			code "autocomplete=\"shipping tel-local-prefix\""
			- " with the value \"123\" and another field in the same form with "
			code "autocomplete=\"shipping tel-local-suffix\""
			- " with the value \"7777\". The only valid prefilled values given the aforementioned information would be \"123\" and \"1234\", or \"666\" and \"7777\", respectively."
		}
		p class=example {
			- "Similarly, if a form for some reason contained both a \""
			code id=autofill-processing-model:attr-fe-autocomplete-cc-exp-3 {
				a href="#attr-fe-autocomplete-cc-exp" cc-exp
			}
			- "\" field and a \""
			code id=autofill-processing-model:attr-fe-autocomplete-cc-exp-month-2 {
				a href="#attr-fe-autocomplete-cc-exp-month" cc-exp-month
			}
			- "\" field, and the user agent prefilled the form, then the month component of the former would have to match the latter."
		}
		div class=example {
			p {
				- "This requirement interacts with the "
				a href="#autofill-anchor-mantle" id=autofill-processing-model:autofill-anchor-mantle-4 "autofill anchor mantle"
				- " also. Consider the following markup snippet:"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" form
					c- p="" >
					c- p="" <
					c- f="" input
					c- e="" type
					c- o="" "="
					c- s="" hidden
					c- e="" autocomplete
					c- o="" "="
					c- s="" "\"nickname\""
					c- e="" value
					c- o="" "="
					c- s="" "\"TreePlate\""
					c- p="" >
					c- p="" <
					c- f="" input
					c- e="" type
					c- o="" "="
					c- s="" text
					c- e="" autocomplete
					c- o="" "="
					c- s="" "\"nickname\""
					c- p="" >
					c- p="" "</"
					c- f="" form
					c- p="" >
				}
			}
			p {
				- "The only value that a conforming user agent could suggest in the text control is \"TreePlate\", the value given by the hidden "
				code id=autofill-processing-model:the-input-element-4 {
					a href="#the-input-element" input
				}
				- " element."
			}
		}
		p {
			- "The \""
			code section-*
			- "\" tokens in the "
			a href="#autofill-scope" id=autofill-processing-model:autofill-scope-9 "autofill scope"
			- " are opaque; user agents must not attempt to derive meaning from the precise values of these tokens."
		}
		p class=example {
			- "For example, it would not be conforming if the user agent decided that it should offer the address it knows to be the user's daughter's address for \""
			code section-child
			- "\" and the addresses it knows to be the user's spouses' addresses for \""
			code section-spouse
			- "\"."
		}
		p {
			- "The autocompletion mechanism must be implemented by the user agent acting as if the user had modified the "
			a href="#control's-data" id=autofill-processing-model:control's-data-4 "control's data"
			- ", and must be done at a time where the element is "
			i id=autofill-processing-model:concept-fe-mutable {
				a href="#concept-fe-mutable" mutable
			}
			- " (e.g. just after the element has been inserted into the document, or when the user agent "
			a href="#stop-parsing" id=autofill-processing-model:stop-parsing "stops parsing"
			- "). User agents must only prefill controls using values that the user could have entered."
		}
		p class=example {
			- "For example, if a "
			code id=autofill-processing-model:the-select-element-6 {
				a href="#the-select-element" select
			}
			- " element only has "
			code id=autofill-processing-model:the-option-element-3 {
				a href="#the-option-element" option
			}
			- " elements with values \"Steve\" and \"Rebecca\", \"Jay\", and \"Bob\", and has an "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-17 "autofill field name"
			- " \""
			code id=autofill-processing-model:attr-fe-autocomplete-given-name-2 {
				a href="#attr-fe-autocomplete-given-name" given-name
			}
			- "\", but the user agent's only idea for what to prefill the field with is \"Evan\", then the user agent cannot prefill the field. It would not be conforming to somehow set the "
			code id=autofill-processing-model:the-select-element-7 {
				a href="#the-select-element" select
			}
			- " element to the value \"Evan\", since the user could not have done so themselves."
		}
		p {
			- "A user agent prefilling a form control must not discriminate between form controls that are "
			a data-x-internal=in-a-document-tree href="https://dom.spec.whatwg.org/#in-a-document-tree" id=autofill-processing-model:in-a-document-tree "in a document tree"
			- " and those that are "
			a data-x-internal=connected href="https://dom.spec.whatwg.org/#connected" id=autofill-processing-model:connected connected
			- "; that is, it is not conforming to make the decision on whether or not to autofill based on whether the element's "
			a data-x-internal=root href="https://dom.spec.whatwg.org/#concept-tree-root" id=autofill-processing-model:root root
			- " is a "
			a data-x-internal=shadow-root href="https://dom.spec.whatwg.org/#concept-shadow-root" id=autofill-processing-model:shadow-root "shadow root"
			- " versus a "
			code id=autofill-processing-model:document {
				a href="#document" Document
			}
			- .
		}
		p {
			- "A user agent prefilling a form control's "
			a href="#concept-fe-value" id=autofill-processing-model:concept-fe-value-2 value
			- " must not cause that control to "
			a href="#suffering-from-a-type-mismatch" id=autofill-processing-model:suffering-from-a-type-mismatch "suffer from a type mismatch"
			- ", "
			a href="#suffering-from-being-too-long" id=autofill-processing-model:suffering-from-being-too-long "suffer from being too long"
			- ", "
			a href="#suffering-from-being-too-short" id=autofill-processing-model:suffering-from-being-too-short "suffer from being too short"
			- ", "
			a href="#suffering-from-an-underflow" id=autofill-processing-model:suffering-from-an-underflow "suffer from an underflow"
			- ", "
			a href="#suffering-from-an-overflow" id=autofill-processing-model:suffering-from-an-overflow "suffer from an overflow"
			- ", or "
			a href="#suffering-from-a-step-mismatch" id=autofill-processing-model:suffering-from-a-step-mismatch "suffer from a step mismatch"
			- ". A user agent prefilling a form control's "
			a href="#concept-fe-value" id=autofill-processing-model:concept-fe-value-3 value
			- " must not cause that control to "
			a href="#suffering-from-a-pattern-mismatch" id=autofill-processing-model:suffering-from-a-pattern-mismatch "suffer from a pattern mismatch"
			- " either. Where possible given the control's constraints, user agents must use the format given as canonical in the aforementioned table. Where it's not possible for the canonical format to be used, user agents should use heuristics to attempt to convert values so that they can be used."
		}
		div class=example {
			p "For example, if the user agent knows that the user's middle name is \"Ines\", and attempts to prefill a form control that looks like this:"
			pre {
				code class=html {
					c- p="" <
					c- f="" input
					c- e="" name
					c- o="" "="
					c- s="" middle-initial
					c- e="" maxlength
					c- o="" "="
					c- s="" "1"
					c- e="" autocomplete
					c- o="" "="
					c- s="" "\"additional-name\""
					c- p="" >
				}
			}
			p "...then the user agent could convert \"Ines\" to \"I\" and prefill it that way."
		}
		div class=example {
			p "A more elaborate example would be with month values. If the user agent knows that the user's birthday is the 27th of July 2012, then it might try to prefill all of the following controls with slightly different values, all driven from this information:"
			table {
				tbody {
					tr {
						td {
							pre {
								code class=html {
									c- p="" <
									c- f="" input
									c- e="" name
									c- o="" "="
									c- s="" b
									c- e="" type
									c- o="" "="
									c- s="" month
									c- e="" autocomplete
									c- o="" "="
									c- s="" "\"bday\""
									c- p="" >
								}
							}
						}
						td " 2012-07 "
						td {
							- " The day is dropped since the "
							a href="#month-state-(type=month)" id="autofill-processing-model:month-state-(type=month)" Month
							- " state only accepts a month/year combination. (Note that this example is non-conforming, because the "
							a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-18 "autofill field name"
							code id=autofill-processing-model:attr-fe-autocomplete-bday-2 {
								a href="#attr-fe-autocomplete-bday" bday
							}
							- " is not allowed with the "
							a href="#month-state-(type=month)" id="autofill-processing-model:month-state-(type=month)-2" Month
							- " state.) "
						}
					}
					tr {
						td {
							pre {
								code class=html {
									c- p="" <
									c- f="" select
									c- e="" name
									c- o="" "="
									c- s="" c
									c- e="" autocomplete
									c- o="" "="
									c- s="" "\"bday\""
									c- p="" >
									c- p="" <
									c- f="" option
									c- p="" >
									- "Jan "
									c- p="" <
									c- f="" option
									c- p="" >
									- "Feb "
									em ...
									c- p="" <
									c- f="" option
									c- p="" >
									- "Jul "
									c- p="" <
									c- f="" option
									c- p="" >
									- "Aug "
									em ...
									c- p="" "</"
									c- f="" select
									c- p="" >
								}
							}
						}
						td " July "
						td " The user agent picks the month from the listed options, either by noticing there are twelve options and picking the 7th, or by recognizing that one of the strings (three characters \"Jul\" followed by a newline and a space) is a close match for the name of the month (July) in one of the user agent's supported languages, or through some other similar mechanism. "
					}
					tr {
						td {
							pre {
								code class=html {
									c- p="" <
									c- f="" input
									c- e="" name
									c- o="" "="
									c- s="" a
									c- e="" type
									c- o="" "="
									c- s="" number
									c- e="" min
									c- o="" "="
									c- s="" "1"
									c- e="" max
									c- o="" "="
									c- s="" "12"
									c- e="" autocomplete
									c- o="" "="
									c- s="" "\"bday-month\""
									c- p="" >
								}
							}
						}
						td " 7 "
						td " User agent converts \"July\" to a month number in the range 1..12, like the field. "
					}
					tr {
						td {
							pre {
								code class=html {
									c- p="" <
									c- f="" input
									c- e="" name
									c- o="" "="
									c- s="" a
									c- e="" type
									c- o="" "="
									c- s="" number
									c- e="" min
									c- o="" "="
									c- s="" "0"
									c- e="" max
									c- o="" "="
									c- s="" "11"
									c- e="" autocomplete
									c- o="" "="
									c- s="" "\"bday-month\""
									c- p="" >
								}
							}
						}
						td " 6 "
						td " User agent converts \"July\" to a month number in the range 0..11, like the field. "
					}
					tr {
						td {
							pre {
								code class=html {
									c- p="" <
									c- f="" input
									c- e="" name
									c- o="" "="
									c- s="" a
									c- e="" type
									c- o="" "="
									c- s="" number
									c- e="" min
									c- o="" "="
									c- s="" "1"
									c- e="" max
									c- o="" "="
									c- s="" "11"
									c- e="" autocomplete
									c- o="" "="
									c- s="" "\"bday-month\""
									c- p="" >
								}
							}
						}
						td {						}
						td " User agent doesn't fill in the field, since it can't make a good guess as to what the form expects. "
					}
				}
			}
		}
		p {
			- "A user agent may allow the user to override an element's "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-19 "autofill field name"
			- ", e.g. to change it from \""
			code id=autofill-processing-model:attr-fe-autocomplete-off-6 {
				a href="#attr-fe-autocomplete-off" off
			}
			- "\" to \""
			code id=autofill-processing-model:attr-fe-autocomplete-on-4 {
				a href="#attr-fe-autocomplete-on" on
			}
			- "\" to allow values to be remembered and prefilled despite the page author's objections, or to always \""
			code id=autofill-processing-model:attr-fe-autocomplete-off-7 {
				a href="#attr-fe-autocomplete-off" off
			}
			- "\", never remembering values."
		}
		p {
			- "More specifically, user agents may in particular consider replacing the "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-20 "autofill field name"
			- " of form controls that match the description given in the first column of the following table, when their "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-21 "autofill field name"
			- " is either \""
			code id=autofill-processing-model:attr-fe-autocomplete-on-5 {
				a href="#attr-fe-autocomplete-on" on
			}
			- "\" or \""
			code id=autofill-processing-model:attr-fe-autocomplete-off-8 {
				a href="#attr-fe-autocomplete-off" off
			}
			- "\", with the value given in the second cell of that row. If this table is used, the replacements must be done in "
			a data-x-internal=tree-order href="https://dom.spec.whatwg.org/#concept-tree-order" id=autofill-processing-model:tree-order "tree order"
			- ", since all but the first row references the "
			a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-22 "autofill field name"
			- " of earlier elements. When the descriptions below refer to form controls being preceded or followed by others, they mean in the list of "
			a href="#category-listed" id=autofill-processing-model:category-listed "listed elements"
			- " that share the same "
			a href="#form-owner" id=autofill-processing-model:form-owner-5 "form owner"
			- .
		}
		table {
			thead {
				tr {
					th "Form control "
					th {
						- "New "
						a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-23 "autofill field name"
					}
				}
			}
			tbody {
				tr {
					td {
						- " an "
						code id=autofill-processing-model:the-input-element-5 {
							a href="#the-input-element" input
						}
						- " element whose "
						code id=autofill-processing-model:attr-input-type-2 {
							a href="#attr-input-type" type
						}
						- " attribute is in the "
						a href="#text-(type=text)-state-and-search-state-(type=search)" id="autofill-processing-model:text-(type=text)-state-and-search-state-(type=search)" Text
						- " state that is followed by an "
						code id=autofill-processing-model:the-input-element-6 {
							a href="#the-input-element" input
						}
						- " element whose "
						code id=autofill-processing-model:attr-input-type-3 {
							a href="#attr-input-type" type
						}
						- " attribute is in the "
						a href="#password-state-(type=password)" id="autofill-processing-model:password-state-(type=password)" Password
						- " state "
					}
					td {
						- " \""
						code id=autofill-processing-model:attr-fe-autocomplete-username-2 {
							a href="#attr-fe-autocomplete-username" username
						}
						- "\" "
					}
				}
				tr {
					td {
						- " an "
						code id=autofill-processing-model:the-input-element-7 {
							a href="#the-input-element" input
						}
						- " element whose "
						code id=autofill-processing-model:attr-input-type-4 {
							a href="#attr-input-type" type
						}
						- " attribute is in the "
						a href="#password-state-(type=password)" id="autofill-processing-model:password-state-(type=password)-2" Password
						- " state that is preceded by an "
						code id=autofill-processing-model:the-input-element-8 {
							a href="#the-input-element" input
						}
						- " element whose "
						a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-24 "autofill field name"
						- " is \""
						code id=autofill-processing-model:attr-fe-autocomplete-username-3 {
							a href="#attr-fe-autocomplete-username" username
						}
						- "\" "
					}
					td {
						- " \""
						code id=autofill-processing-model:attr-fe-autocomplete-current-password-2 {
							a href="#attr-fe-autocomplete-current-password" current-password
						}
						- "\" "
					}
				}
				tr {
					td {
						- " an "
						code id=autofill-processing-model:the-input-element-9 {
							a href="#the-input-element" input
						}
						- " element whose "
						code id=autofill-processing-model:attr-input-type-5 {
							a href="#attr-input-type" type
						}
						- " attribute is in the "
						a href="#password-state-(type=password)" id="autofill-processing-model:password-state-(type=password)-3" Password
						- " state that is preceded by an "
						code id=autofill-processing-model:the-input-element-10 {
							a href="#the-input-element" input
						}
						- " element whose "
						a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-25 "autofill field name"
						- " is \""
						code id=autofill-processing-model:attr-fe-autocomplete-current-password-3 {
							a href="#attr-fe-autocomplete-current-password" current-password
						}
						- "\" "
					}
					td {
						- " \""
						code id=autofill-processing-model:attr-fe-autocomplete-new-password-2 {
							a href="#attr-fe-autocomplete-new-password" new-password
						}
						- "\" "
					}
				}
				tr {
					td {
						- " an "
						code id=autofill-processing-model:the-input-element-11 {
							a href="#the-input-element" input
						}
						- " element whose "
						code id=autofill-processing-model:attr-input-type-6 {
							a href="#attr-input-type" type
						}
						- " attribute is in the "
						a href="#password-state-(type=password)" id="autofill-processing-model:password-state-(type=password)-4" Password
						- " state that is preceded by an "
						code id=autofill-processing-model:the-input-element-12 {
							a href="#the-input-element" input
						}
						- " element whose "
						a href="#autofill-field-name" id=autofill-processing-model:autofill-field-name-26 "autofill field name"
						- " is \""
						code id=autofill-processing-model:attr-fe-autocomplete-new-password-3 {
							a href="#attr-fe-autocomplete-new-password" new-password
						}
						- "\" "
					}
					td {
						- " \""
						code id=autofill-processing-model:attr-fe-autocomplete-new-password-4 {
							a href="#attr-fe-autocomplete-new-password" new-password
						}
						- "\" "
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLInputElement,HTMLSelectElement,HTMLTextAreaElement data-dfn-type=attribute id=dom-fe-autocomplete {
				code autocomplete
			}
			- " IDL attribute, on getting, must return the element's "
			a href="#idl-exposed-autofill-value" id=autofill-processing-model:idl-exposed-autofill-value-5 "IDL-exposed autofill value"
			- ", and on setting, must "
			a href="#reflect" id=autofill-processing-model:reflect reflect
			- " the content attribute of the same name."
		}
		h4 id=textFieldSelection {
			span class=secno "4.10.19"
			- " APIs for the text control selections"
			a class=self-link href="#textFieldSelection"
		}
		p {
			- "The "
			code id=textFieldSelection:the-input-element {
				a href="#the-input-element" input
			}
			- " and "
			code id=textFieldSelection:the-textarea-element {
				a href="#the-textarea-element" textarea
			}
			- " elements define several attributes and methods for handling their selection. Their shared algorithms are defined here."
		}
		dl class=domintro {
			dt {
				code {
					var element
					- .
					a href="#dom-textarea/input-select" id="dom-textarea/input-select-dev" select
					- "()"
				}
			}
			dd {
				p "Selects everything in the text control."
			}
			dt {
				code {
					var element
					- .
					a href="#dom-textarea/input-selectionstart" id="dom-textarea/input-selectionstart-dev" selectionStart
					- " [ = "
					var value
					- " ]"
				}
			}
			dd {
				p "Returns the offset to the start of the selection."
				p "Can be set, to change the start of the selection."
			}
			dt {
				code {
					var element
					- .
					a href="#dom-textarea/input-selectionend" id="dom-textarea/input-selectionend-dev" selectionEnd
					- " [ = "
					var value
					- " ]"
				}
			}
			dd {
				p "Returns the offset to the end of the selection."
				p "Can be set, to change the end of the selection."
			}
			dt {
				code {
					var element
					- .
					a href="#dom-textarea/input-selectiondirection" id="dom-textarea/input-selectiondirection-dev" selectionDirection
					- " [ = "
					var value
					- " ]"
				}
			}
			dd {
				p "Returns the current direction of the selection."
				p "Can be set, to change the direction of the selection."
				p {
					- "The possible values are \""
					code forward
					- "\", \""
					code backward
					- "\", and \""
					code none
					- "\"."
				}
			}
			dt {
				code {
					var element
					- .
					a href="#dom-textarea/input-setselectionrange" id="dom-textarea/input-setselectionrange-dev" setSelectionRange
					- "("
					var start
					- ", "
					var end
					- " [, "
					var direction
					- "])"
				}
				div class="mdn-anno wrapped before" {
					button class=mdn-anno-btn onclick="toggleStatus(this)" {
						b class=all-engines-flag title="Support in all current engines." ✔
						span MDN
					}
					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLInputElement/setSelectionRange" title="The HTMLInputElement.setSelectionRange() method sets the start and end positions of the current text selection in an <input> or <textarea> element." "HTMLInputElement/setSelectionRange"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "1+"
							}
							span class="safari yes" {
								span Safari
								span "3+"
							}
							span class="chrome yes" {
								span Chrome
								span "1+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "8+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "1+"
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android unknown" {
								span "WebView Android"
								span ?
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "10.1+"
							}
						}
					}
				}
			}
			dd {
				p "Changes the selection to cover the given substring in the given direction. If the direction is omitted, it will be reset to be the platform default (none or forward)."
			}
			dt {
