						a href="#attr-hyperlink-href" href
					}
					- " attribute and with a non-empty "
					code id=image-map-processing-model:attr-area-alt-3 {
						a href="#attr-area-alt" alt
					}
					- " attribute."
				}
			}
			li {
				p {
					- "Each remaining "
					code id=image-map-processing-model:the-area-element-6 {
						a href="#the-area-element" area
					}
					- " element in "
					var areas
					- " represents a "
					a href="#hyperlink" id=image-map-processing-model:hyperlink hyperlink
					- ". Those hyperlinks should all be made available to the user in a manner associated with the text of the "
					code id=image-map-processing-model:the-img-element-3 {
						a href="#the-img-element" img
					}
					- .
				}
				p {
					- "In this context, user agents may represent "
					code id=image-map-processing-model:the-area-element-7 {
						a href="#the-area-element" area
					}
					- " and "
					code id=image-map-processing-model:the-img-element-4 {
						a href="#the-img-element" img
					}
					- " elements with no specified "
					code alt
					- " attributes, or whose "
