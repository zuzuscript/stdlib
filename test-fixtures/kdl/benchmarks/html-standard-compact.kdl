							- " whose tag name is one of \"h1\", \"h2\", \"h3\", \"h4\", \"h5\", or \"h6\" has been popped from the stack."
						}
					}
				}
			}
			dt "An end tag whose tag name is \"sarcasm\""
			dd {
				p "Take a deep breath, then act as described in the \"any other end tag\" entry below."
			}
			dt "A start tag whose tag name is \"a\""
			dd {
				p {
					- "If the "
					a href="#list-of-active-formatting-elements" id=parsing-main-inbody:list-of-active-formatting-elements "list of active formatting elements"
					- " contains an "
					code id=parsing-main-inbody:the-a-element {
						a href="#the-a-element" a
					}
					- " element between the end of the list and the last "
					a href="#concept-parser-marker" id=parsing-main-inbody:concept-parser-marker marker
					- " on the list (or the start of the list if there is no "
					a href="#concept-parser-marker" id=parsing-main-inbody:concept-parser-marker-2 marker
					- " on the list), then this is a "
					a href="#parse-errors" id=parsing-main-inbody:parse-errors-30 "parse error"
					- "; run the "
					a href="#adoption-agency-algorithm" id=parsing-main-inbody:adoption-agency-algorithm "adoption agency algorithm"
					- " for the token, then remove that element from the "
					a href="#list-of-active-formatting-elements" id=parsing-main-inbody:list-of-active-formatting-elements-2 "list of active formatting elements"
					- " and the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-48 "stack of open elements"
					- " if the "
					a href="#adoption-agency-algorithm" id=parsing-main-inbody:adoption-agency-algorithm-2 "adoption agency algorithm"
					- " didn't already remove it (it might not have if the element is not "
					a href="#has-an-element-in-table-scope" id=parsing-main-inbody:has-an-element-in-table-scope "in table scope"
					- ")."
				}
				p class=example {
					- "In the non-conforming stream "
					code "<a href=\"a\">a<table><a href=\"b\">b</table>x"
					- ", the first "
					code id=parsing-main-inbody:the-a-element-2 {
						a href="#the-a-element" a
					}
					- " element would be closed upon seeing the second one, and the \"x\" character would be inside a link to \"b\", not to \"a\". This is despite the fact that the outer "
					code id=parsing-main-inbody:the-a-element-3 {
						a href="#the-a-element" a
					}
					- " element is not in table scope (meaning that a regular "
					code "</a>"
					- " end tag at the start of the table wouldn't close the outer "
					code id=parsing-main-inbody:the-a-element-4 {
						a href="#the-a-element" a
					}
					- " element). The result is that the two "
					code id=parsing-main-inbody:the-a-element-5 {
						a href="#the-a-element" a
					}
					- " elements are indirectly nested inside each other — non-conforming markup will often result in non-conforming DOMs when parsed."
				}
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-5 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-11 "Insert an HTML element"
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id=parsing-main-inbody:push-onto-the-list-of-active-formatting-elements "Push onto the list of active formatting elements"
					- " that element."
				}
			}
			dt "A start tag whose tag name is one of: \"b\", \"big\", \"code\", \"em\", \"font\", \"i\", \"s\", \"small\", \"strike\", \"strong\", \"tt\", \"u\""
			dd {
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-6 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-12 "Insert an HTML element"
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id=parsing-main-inbody:push-onto-the-list-of-active-formatting-elements-2 "Push onto the list of active formatting elements"
					- " that element."
				}
			}
			dt "A start tag whose tag name is \"nobr\""
			dd {
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-7 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					- "If the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-49 "stack of open elements"
					a href="#has-an-element-in-scope" id=parsing-main-inbody:has-an-element-in-scope-9 {
						- "has a "
						code nobr
						- " element in scope"
					}
					- ", then this is a "
					a href="#parse-errors" id=parsing-main-inbody:parse-errors-31 "parse error"
					- "; run the "
					a href="#adoption-agency-algorithm" id=parsing-main-inbody:adoption-agency-algorithm-3 "adoption agency algorithm"
					- " for the token, then once again "
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-8 "reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-13 "Insert an HTML element"
					- " for the token. "
					a href="#push-onto-the-list-of-active-formatting-elements" id=parsing-main-inbody:push-onto-the-list-of-active-formatting-elements-3 "Push onto the list of active formatting elements"
					- " that element."
				}
			}
			dt "An end tag whose tag name is one of: \"a\", \"b\", \"big\", \"code\", \"em\", \"font\", \"i\", \"nobr\", \"s\", \"small\", \"strike\", \"strong\", \"tt\", \"u\""
			dd {
				p {
					- "Run the "
					a href="#adoption-agency-algorithm" id=parsing-main-inbody:adoption-agency-algorithm-4 "adoption agency algorithm"
					- " for the token."
				}
			}
			dt "A start tag whose tag name is one of: \"applet\", \"marquee\", \"object\""
			dd {
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-9 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-14 "Insert an HTML element"
					- " for the token."
				}
				p {
					- "Insert a "
					a href="#concept-parser-marker" id=parsing-main-inbody:concept-parser-marker-3 marker
					- " at the end of the "
					a href="#list-of-active-formatting-elements" id=parsing-main-inbody:list-of-active-formatting-elements-3 "list of active formatting elements"
					- .
				}
				p {
					- "Set the "
					a href="#frameset-ok-flag" id=parsing-main-inbody:frameset-ok-flag-8 "frameset-ok flag"
					- " to \"not ok\"."
				}
			}
			dt "An end tag token whose tag name is one of: \"applet\", \"marquee\", \"object\""
			dd {
				p {
					- "If the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-50 "stack of open elements"
					- " does not "
					a href="#has-an-element-in-scope" id=parsing-main-inbody:has-an-element-in-scope-10 "have an element in scope"
					- " that is an "
					a href="#html-elements" id=parsing-main-inbody:html-elements-12 "HTML element"
					- " with the same tag name as that of the token, then this is a "
					a href="#parse-errors" id=parsing-main-inbody:parse-errors-32 "parse error"
					- "; ignore the token."
				}
				p "Otherwise, run these steps:"
				ol {
					li {
						p {
							a href="#generate-implied-end-tags" id=parsing-main-inbody:generate-implied-end-tags-11 "Generate implied end tags"
							- .
						}
					}
					li {
						p {
							- "If the "
							a href="#current-node" id=parsing-main-inbody:current-node-15 "current node"
							- " is not an "
							a href="#html-elements" id=parsing-main-inbody:html-elements-13 "HTML element"
							- " with the same tag name as that of the token, then this is a "
							a href="#parse-errors" id=parsing-main-inbody:parse-errors-33 "parse error"
							- .
						}
					}
					li {
						p {
							- "Pop elements from the "
							a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-51 "stack of open elements"
							- " until an "
							a href="#html-elements" id=parsing-main-inbody:html-elements-14 "HTML element"
							- " with the same tag name as the token has been popped from the stack."
						}
					}
					li {
						a href="#clear-the-list-of-active-formatting-elements-up-to-the-last-marker" id=parsing-main-inbody:clear-the-list-of-active-formatting-elements-up-to-the-last-marker "Clear the list of active formatting elements up to the last marker"
						- .
					}
				}
			}
			dt "A start tag whose tag name is \"table\""
			dd {
				p {
					- "If the "
					code id=parsing-main-inbody:document {
						a href="#document" Document
					}
					- " is "
					em not
					- " set to "
					a data-x-internal=quirks-mode href="https://dom.spec.whatwg.org/#concept-document-quirks" id=parsing-main-inbody:quirks-mode "quirks mode"
					- ", and the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-52 "stack of open elements"
					a href="#has-an-element-in-button-scope" id=parsing-main-inbody:has-an-element-in-button-scope-9 {
						- "has a "
						code p
						- " element in button scope"
					}
					- ", then "
					a href="#close-a-p-element" id=parsing-main-inbody:close-a-p-element-9 {
						- "close a "
						code p
						- " element"
					}
					- .
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-15 "Insert an HTML element"
					- " for the token."
				}
				p {
					- "Set the "
					a href="#frameset-ok-flag" id=parsing-main-inbody:frameset-ok-flag-9 "frameset-ok flag"
					- " to \"not ok\"."
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=parsing-main-inbody:insertion-mode-7 "insertion mode"
					- " to \""
					a href="#parsing-main-intable" id=parsing-main-inbody:parsing-main-intable "in table"
					- "\"."
				}
			}
			dt "An end tag whose tag name is \"br\""
			dd {
				p {
					a href="#parse-errors" id=parsing-main-inbody:parse-errors-34 "Parse error"
					- ". Drop the attributes from the token, and act as described in the next entry; i.e. act as if this was a \"br\" start tag token with no attributes, rather than the end tag token that it actually is."
				}
			}
			dt "A start tag whose tag name is one of: \"area\", \"br\", \"embed\", \"img\", \"keygen\", \"wbr\""
			dd {
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-10 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-16 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inbody:current-node-16 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-53 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inbody:acknowledge-self-closing-flag {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
				p {
					- "Set the "
					a href="#frameset-ok-flag" id=parsing-main-inbody:frameset-ok-flag-10 "frameset-ok flag"
					- " to \"not ok\"."
				}
			}
			dt "A start tag whose tag name is \"input\""
			dd {
				p {
					a href="#reconstruct-the-active-formatting-elements" id=parsing-main-inbody:reconstruct-the-active-formatting-elements-11 "Reconstruct the active formatting elements"
					- ", if any."
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-17 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inbody:current-node-17 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-54 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inbody:acknowledge-self-closing-flag-2 {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
				p {
					- "If the token does not have an attribute with the name \"type\", or if it does, but that attribute's value is not an "
					a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=parsing-main-inbody:ascii-case-insensitive "ASCII case-insensitive"
					- " match for the string \""
					code hidden
					- "\", then: set the "
					a href="#frameset-ok-flag" id=parsing-main-inbody:frameset-ok-flag-11 "frameset-ok flag"
					- " to \"not ok\"."
				}
			}
			dt "A start tag whose tag name is one of: \"param\", \"source\", \"track\""
			dd {
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-18 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inbody:current-node-18 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-55 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inbody:acknowledge-self-closing-flag-3 {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
			}
			dt "A start tag whose tag name is \"hr\""
			dd {
				p {
					- "If the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-56 "stack of open elements"
					a href="#has-an-element-in-button-scope" id=parsing-main-inbody:has-an-element-in-button-scope-10 {
						- "has a "
						code p
						- " element in button scope"
					}
					- ", then "
					a href="#close-a-p-element" id=parsing-main-inbody:close-a-p-element-10 {
						- "close a "
						code p
						- " element"
					}
					- .
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-19 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inbody:current-node-19 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-57 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inbody:acknowledge-self-closing-flag-4 {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
				p {
					- "Set the "
					a href="#frameset-ok-flag" id=parsing-main-inbody:frameset-ok-flag-12 "frameset-ok flag"
					- " to \"not ok\"."
				}
			}
			dt "A start tag whose tag name is \"image\""
			dd {
				p {
					a href="#parse-errors" id=parsing-main-inbody:parse-errors-35 "Parse error"
					- ". Change the token's tag name to \"img\" and reprocess it. (Don't ask.)"
				}
			}
			dt "A start tag whose tag name is \"textarea\""
			dd {
				p "Run these steps:"
				ol {
					li {
						p {
							a href="#insert-an-html-element" id=parsing-main-inbody:insert-an-html-element-20 "Insert an HTML element"
							- " for the token."
						}
					}
					li {
						p {
							- "If the "
							a href="#next-token" id=parsing-main-inbody:next-token-2 "next token"
							- " is a U+000A LINE FEED (LF) character token, then ignore that token and move on to the next one. (Newlines at the start of "
							code id=parsing-main-inbody:the-textarea-element {
								a href="#the-textarea-element" textarea
							}
							- " elements are ignored as an authoring convenience.)"
						}
