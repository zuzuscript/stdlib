			}
			dt "A DOCTYPE token"
			dd {
				p {
					a href="#parse-errors" id=the-before-head-insertion-mode:parse-errors "Parse error"
					- ". Ignore the token."
				}
			}
			dt "A start tag whose tag name is \"html\""
			dd {
				p {
					- "Process the token "
					a href="#using-the-rules-for" id=the-before-head-insertion-mode:using-the-rules-for "using the rules for"
					- " the \""
					a href="#parsing-main-inbody" id=the-before-head-insertion-mode:parsing-main-inbody "in body"
					- "\" "
					a href="#insertion-mode" id=the-before-head-insertion-mode:insertion-mode-2 "insertion mode"
					- .
				}
			}
			dt "A start tag whose tag name is \"head\""
			dd {
				p {
					a href="#insert-an-html-element" id=the-before-head-insertion-mode:insert-an-html-element "Insert an HTML element"
					- " for the token."
				}
				p {
					- "Set the "
					a href="#head-element-pointer" id=the-before-head-insertion-mode:head-element-pointer {
						code head
						- " element pointer"
					}
					- " to the newly created "
					code id=the-before-head-insertion-mode:the-head-element {
						a href="#the-head-element" head
					}
					- " element."
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=the-before-head-insertion-mode:insertion-mode-3 "insertion mode"
					- " to \""
					a href="#parsing-main-inhead" id=the-before-head-insertion-mode:parsing-main-inhead "in head"
					- "\"."
				}
			}
			dt "An end tag whose tag name is one of: \"head\", \"body\", \"html\", \"br\""
			dd {
				p "Act as described in the \"anything else\" entry below."
			}
			dt "Any other end tag"
			dd {
				p {
					a href="#parse-errors" id=the-before-head-insertion-mode:parse-errors-2 "Parse error"
					- ". Ignore the token."
				}
			}
