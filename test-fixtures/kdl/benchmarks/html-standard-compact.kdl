			- " to an "
			code id=common-input-element-attributes:the-input-element-2 {
				a href="#the-input-element" input
			}
			- " element if its "
			code id=common-input-element-attributes:attr-input-type {
				a href="#attr-input-type" type
			}
			- " attribute is in a state whose definition declares that the attribute "
			a href="#concept-input-apply" id=common-input-element-attributes:concept-input-apply-2 applies
			- ". When an attribute "
			a href="#do-not-apply" id=common-input-element-attributes:do-not-apply "doesn't apply"
			- " to an "
			code id=common-input-element-attributes:the-input-element-3 {
				a href="#the-input-element" input
			}
			- " element, user agents must "
			a href="#ignore" id=common-input-element-attributes:ignore ignore
			- " the attribute, regardless of the requirements and definitions below."
		}
