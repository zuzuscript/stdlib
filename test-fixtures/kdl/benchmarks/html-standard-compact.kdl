		div class=example id=example-incumbent-1 {
			p "Consider the following starter example:"
			pre {
				code class=html {
					c- cp="" "<!DOCTYPE html>"
					c- p="" <
					c- f="" iframe
					c- p="" "></"
					c- f="" iframe
