			- " and whose "
			a data-x-internal=map-value href="https://infra.spec.whatwg.org/#map-value" id=import-map-processing-model:map-value values
			- " are either "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=import-map-processing-model:url-2 URLs
			- " or nulls."
		}
		p {
			- "A "
			dfn id=module-integrity-map "module integrity map"
			- " is an "
			a data-x-internal=ordered-map href="https://infra.spec.whatwg.org/#ordered-map" id=import-map-processing-model:ordered-map-3 "ordered map"
			- " whose "
			a data-x-internal=map-key href="https://infra.spec.whatwg.org/#map-key" id=import-map-processing-model:map-key-2 keys
			- " are "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=import-map-processing-model:url-3 URLs
			- " and whose "
			a data-x-internal=map-value href="https://infra.spec.whatwg.org/#map-value" id=import-map-processing-model:map-value-2 values
			- " are "
