					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" blockquote
					c- p="" >
				}
			}
		}
		p {
			- "Attribution for the quotation, if any, must be placed outside the "
			code id=the-blockquote-element:the-blockquote-element-4 {
