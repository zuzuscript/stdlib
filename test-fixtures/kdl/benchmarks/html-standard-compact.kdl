				a href="#the-h1,-h2,-h3,-h4,-h5,-and-h6-elements" h3
			}
			- " for a sub-subsection, and so on."
		}
		div class=example {
			p "As far as their respective document outlines (their heading and section structures) are concerned, these two snippets are semantically equivalent:"
			pre {
				code class=html {
					c- p="" <
					c- f="" body
					c- p="" >
					c- p="" <
					c- f="" h1
					c- p="" >
					- "Let's call it a draw(ing surface)"
					c- p="" "</"
					c- f="" h1
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "Diving in"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "Simple shapes"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- "Canvas coordinates"
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" <
					c- f="" h3
					c- p="" >
					- "Canvas coordinates diagram"
					c- p="" "</"
					c- f="" h3
					c- p="" >
					c- p="" <
					c- f="" h2
					c- p="" >
					- Paths
					c- p="" "</"
					c- f="" h2
					c- p="" >
					c- p="" "</"
					c- f="" body
					c- p="" >
				}
			}
			pre {
				code class=html {
