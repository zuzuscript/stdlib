					c- s="" "\"given-name\""
					c- p="" >
					- Jack
					c- p="" "</"
					c- f="" span
					c- p="" >
					c- p="" <
					c- f="" span
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"family-name\""
					c- p="" >
					- Bauer
					c- p="" "</"
					c- f="" span
					c- p="" >
					c- p="" "</"
					c- f="" span
					c- p="" >
					c- p="" "</"
					c- f="" h1
					c- p="" >
					c- p="" <
					c- f="" img
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"photo\""
					c- e="" alt
					c- o="" "="
					c- s="" "\"\""
