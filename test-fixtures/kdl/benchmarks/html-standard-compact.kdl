				a href="#parse-errors" id=comment-state:parse-errors "parse error"
				- ". Append a U+FFFD REPLACEMENT CHARACTER character to the comment token's data."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-comment" id=comment-state:parse-error-eof-in-comment eof-in-comment
				a href="#parse-errors" id=comment-state:parse-errors-2 "parse error"
				- ". Emit the current comment token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "Append the "
