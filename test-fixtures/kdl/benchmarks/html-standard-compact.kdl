		h5 id=creating-a-dedicated-worker {
			span class=secno "10.1.3.1"
			- " Creating a dedicated worker"
			a class=self-link href="#creating-a-dedicated-worker"
		}
		p {
			i "This section is non-normative."
		}
		p {
			- "Creating a worker requires a URL to a JavaScript file. The "
			code id=creating-a-dedicated-worker:dom-worker {
				a href="#dom-worker" "Worker()"
			}
			- " constructor is invoked with the URL to that file as its only argument; a worker is then created and returned:"
		}
		pre {
			code class=js {
				c- a="" var
				- " worker "
				c- o="" "="
				c- k="" new
				- " Worker"
				c- p="" "("
				c- t="" 'helper.js'
				c- p="" ");"
			}
		}
		p {
			- "If you want your worker script to be interpreted as a "
			a href="#module-script" id=creating-a-dedicated-worker:module-script "module script"
			- " instead of the default "
			a href="#classic-script" id=creating-a-dedicated-worker:classic-script "classic script"
			- ", you need to use a slightly different signature:"
		}
		pre {
