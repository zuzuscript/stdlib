			- "When the above algorithm says that the user agent is to "
			dfn id=add-a-vcard-line "add a vCard line"
			- " consisting of a type "
			var type
			- ", optionally some parameters, and a value "
			var value
			- " to a string "
			var output
			- ", it must run the following steps:"
		}
