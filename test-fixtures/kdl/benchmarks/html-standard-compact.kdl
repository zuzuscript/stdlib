							- ", and the "
							a href="#concept-encoding-confidence" id=parsing-main-inhead:concept-encoding-confidence-2 confidence
							- " is currently "
							i tentative
							- ", then "
							a href="#change-the-encoding" id=parsing-main-inhead:change-the-encoding-2 "change the encoding"
							- " to the extracted encoding."
						}
					}
				}
				p class=note {
					- "The "
