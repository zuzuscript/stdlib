			- " width."
		}
		h5 id=images-processing-model {
			span class=secno "4.8.4.3"
			- " Processing model"
			a class=self-link href="#images-processing-model"
		}
		hr
		p {
			- "An "
			code id=images-processing-model:the-img-element {
				a href="#the-img-element" img
			}
			- " element has a "
