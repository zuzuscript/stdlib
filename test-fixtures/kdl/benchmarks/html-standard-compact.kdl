				a href="#document" Document
			}
			- " object's "
			a data-x-internal=the-document's-address href="https://dom.spec.whatwg.org/#concept-document-url" id=documents:the-document's-address URL
			- " in their user interface. This is the primary mechanism by which a user can tell if a site is attempting to impersonate another."
		}
		p {
			- "The "
			code id=documents:document-6 {
				a href="#document" Document
			}
			- " object's "
			dfn data-x-for=Document id=concept-document-origin {
				a href="https://dom.spec.whatwg.org/#concept-document-origin" origin
			}
			- " is defined in "
			cite DOM
			- ". It is initially set when the "
			code id=documents:document-7 {
				a href="#document" Document
			}
			- " object is created, and can change during the lifetime of the "
			code id=documents:document-8 {
				a href="#document" Document
			}
			- " only upon setting "
			code id=documents:dom-document-domain {
				a href="#dom-document-domain" document.domain
			}
			- ". A "
			code id=documents:document-9 {
				a href="#document" Document
			}
			- "'s "
			a data-x-internal=concept-document-origin href="https://dom.spec.whatwg.org/#concept-document-origin" id=documents:concept-document-origin origin
			- " can differ from the "
			a data-x-internal=concept-url-origin href="https://url.spec.whatwg.org/#concept-url-origin" id=documents:concept-url-origin origin
			- " of its "
			a data-x-internal=the-document's-address href="https://dom.spec.whatwg.org/#concept-document-url" id=documents:the-document's-address-2 URL
			- "; for example when a "
			a href="#child-navigable" id=documents:child-navigable "child navigable"
			- " is "
			a href="#create-a-new-child-navigable" id=documents:create-a-new-child-navigable created
			- ", its "
			a href="#nav-document" id=documents:nav-document "active document"
			- "'s "
			a data-x-internal=concept-document-origin href="https://dom.spec.whatwg.org/#concept-document-origin" id=documents:concept-document-origin-2 origin
			- " is inherited from its "
			a href="#nav-parent" id=documents:nav-parent parent
			- "'s "
			a href="#nav-document" id=documents:nav-document-2 "active document"
			- "'s "
			a data-x-internal=concept-document-origin href="https://dom.spec.whatwg.org/#concept-document-origin" id=documents:concept-document-origin-3 origin
			- ", even though its "
			a href="#nav-document" id=documents:nav-document-3 "active document"
			- "'s "
			a data-x-internal=the-document's-address href="https://dom.spec.whatwg.org/#concept-document-url" id=documents:the-document's-address-3 URL
			- " is "
			code id=documents:about:blank {
				a href="#about:blank" about:blank
			}
			- ". "
			a href="#refsDOM" "[DOM]"
		}
		p {
			- "When a "
			code id=documents:document-10 {
				a href="#document" Document
			}
			- " is created by a "
			a href="#concept-script" id=documents:concept-script script
			- " using the "
