					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLElement/isContentEditable" title="The HTMLElement.isContentEditable read-only property returns a boolean value that is true if the contents of the element are editable; otherwise it returns false." "HTMLElement/isContentEditable"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "4+"
							}
							span class="safari yes" {
								span Safari
								span "3+"
							}
							span class="chrome yes" {
								span Chrome
								span "1+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "12.1+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "5.5+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "1+"
							}
							span class="chrome_android unknown" {
