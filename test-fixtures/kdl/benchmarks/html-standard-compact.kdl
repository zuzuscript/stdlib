					c- o="" "="
					c- p="" "()"
					c- p="" "=>"
					c- p="" "{"
					c- c1="" "// These will be grouped together, and both will close in response to a single close request."
					c- p="" "("
					c- k="" new
					- " CloseWatcher"
					c- p="" "())."
					- "onclose "
					c- o="" "="
					c- p="" "()"
					c- p="" "=>"
					c- p="" "{"
					c- d="" "/* ... */"
					c- p="" "};"
					c- p="" "("
