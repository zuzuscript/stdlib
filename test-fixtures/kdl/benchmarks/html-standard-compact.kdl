					- " of the "
					code id=vcard:md-vcard-n-3 {
						a href="#md-vcard-n" n
					}
					- " property of an "
					a href="#concept-item" id=vcard:concept-item-6 item
					- " with the type "
					code id=vcard:md-vcard-4 {
						a href="#md-vcard" "http://microformats.org/profile/hcard"
					}
					- .
				}
			}
			dt {
