							a data-x-internal=html-namespace-2 href="https://infra.spec.whatwg.org/#html-namespace" id=parsing-main-inbody:html-namespace-2-2 "HTML namespace"
							- ", with "
							var furthestBlock
							- " as the intended parent."
						}
					}
					li {
						p {
							- "Take all of the child nodes of "
							var furthestBlock
							- " and append them to the element created in the last step."
						}
					}
					li {
						p {
							- "Append that new element to "
							var furthestBlock
							- .
						}
					}
					li {
						p {
							- "Remove "
							var formattingElement
							- " from the "
							a href="#list-of-active-formatting-elements" id=parsing-main-inbody:list-of-active-formatting-elements-13 "list of active formatting elements"
							- ", and insert the new element into the "
							a href="#list-of-active-formatting-elements" id=parsing-main-inbody:list-of-active-formatting-elements-14 "list of active formatting elements"
							- " at the position of the aforementioned bookmark."
						}
					}
					li {
						p {
							- "Remove "
							var formattingElement
							- " from the "
							a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-77 "stack of open elements"
							- ", and insert the new element into the "
							a href="#stack-of-open-elements" id=parsing-main-inbody:stack-of-open-elements-78 "stack of open elements"
							- " immediately below the position of "
							var furthestBlock
							- " in that stack."
						}
					}
				}
			}
		}
		p class=note {
			- "This algorithm's name, the \"adoption agency algorithm\", comes from the way it causes elements to change parents, and is in contrast with "
			a href="https://ln.hixie.ch/?start=1037910467&count=1" "other possible algorithms"
			- " for dealing with misnested content."
		}
		h6 id=parsing-main-incdata {
			span class=secno "13.2.6.4.8"
			- " The \""
			dfn text
			- "\" insertion mode"
			a class=self-link href="#parsing-main-incdata"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-incdata" id=parsing-main-incdata:parsing-main-incdata text
			- "\" "
			a href="#insertion-mode" id=parsing-main-incdata:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt "A character token"
			dd {
				p {
					a href="#insert-a-character" id=parsing-main-incdata:insert-a-character "Insert the token's character"
					- .
