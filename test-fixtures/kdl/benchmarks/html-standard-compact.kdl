		h3 id=selectors {
			span class=secno "4.16"
			- " Matching HTML elements using selectors and CSS"
			a class=self-link href="#selectors"
		}
		h4 id="case-sensitivity-of-the-css-'attr()'-function" {
			span class=secno "4.16.1"
			- " Case-sensitivity of the CSS "
			a data-x-internal="'attr()'" href="https://drafts.csswg.org/css-values/#funcdef-attr" id="case-sensitivity-of-the-css-'attr()'-function:'attr()'" "'attr()'"
			- " function"
			a class=self-link href="#case-sensitivity-of-the-css-'attr()'-function"
		}
		p {
			cite "CSS Values and Units"
			- " leaves the case-sensitivity of attribute names for the purpose of the "
			a data-x-internal="'attr()'" href="https://drafts.csswg.org/css-values/#funcdef-attr" id="case-sensitivity-of-the-css-'attr()'-function:'attr()'-2" "'attr()'"
			- " function to be defined by the host language. "
			a href="#refsCSSVALUES" "[CSSVALUES]"
		}
		p {
			- "When comparing the attribute name part of a CSS "
			a data-x-internal="'attr()'" href="https://drafts.csswg.org/css-values/#funcdef-attr" id="case-sensitivity-of-the-css-'attr()'-function:'attr()'-3" "'attr()'"
			- " function to the names of namespace-less attributes on "
			a href="#html-elements" id="case-sensitivity-of-the-css-'attr()'-function:html-elements" "HTML elements"
			- " in "
