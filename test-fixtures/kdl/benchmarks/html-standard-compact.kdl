								p class=note {
									- "The "
									code id=loading-the-media-resource:attr-media-preload-2 {
										a href="#attr-media-preload" preload
									}
									- " attribute provides a hint regarding how much buffering the author thinks is advisable, even in the absence of the "
									code id=loading-the-media-resource:attr-media-autoplay {
										a href="#attr-media-autoplay" autoplay
									}
									- " attribute."
								}
								p {
									- "When a user agent decides to completely suspend a download, e.g., if it is waiting until the user starts playback before downloading any further content, the user agent must "
									a href="#queue-a-media-element-task" id=loading-the-media-resource:queue-a-media-element-task-15 "queue a media element task"
									- " given the "
									a href="#media-element" id=loading-the-media-resource:media-element-50 "media element"
