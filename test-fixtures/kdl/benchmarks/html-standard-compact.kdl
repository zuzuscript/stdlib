			}
			- " and "
			code id=a-form-control's-value:attr-fe-minlength {
				a href="#attr-fe-minlength" minlength
			}
			- " attributes, as well as other APIs specific to the "
			code id=a-form-control's-value:the-textarea-element-3 {
				a href="#the-textarea-element" textarea
			}
			- " element, all form control with a "
			a href="#concept-fe-value" id=a-form-control's-value:concept-fe-value-6 value
			- " also have an algorithm for obtaining an "
			span id=concept-textarea-api-value
			dfn id=concept-fe-api-value "API value"
			- ". By default this algorithm is to simply return the control's "
			a href="#concept-fe-value" id=a-form-control's-value:concept-fe-value-7 value
			- .
		}
		p {
			- "The "
			code id=a-form-control's-value:the-select-element-2 {
				a href="#the-select-element" select
