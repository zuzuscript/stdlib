				c- f="" body
				c- p="" >
				c- p="" "</"
				c- f="" html
				c- p="" >
			}
		}
		p "The worker itself is as follows:"
		pre {
			code class=js {
				c- c1="" "// settings"
				c- a="" var
				- " num_workers "
				c- o="" "="
				c- mf="" "10"
				c- p="" ";"
				c- a="" var
				- " items_per_worker "
				c- o="" "="
				c- mf="" "1000000"
				c- p="" ";"
				c- c1="" "// start the workers"
				c- a="" var
				- " result "
				c- o="" "="
				c- mf="" "0"
				c- p="" ";"
				c- a="" var
				- " pending_workers "
				c- o="" "="
				- " num_workers"
				c- p="" ";"
