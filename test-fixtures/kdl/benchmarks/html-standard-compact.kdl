					- .
				}
				p {
					- "In any case, switch the "
					a href="#insertion-mode" id=the-initial-insertion-mode:insertion-mode-3 "insertion mode"
					- " to \""
					a href="#the-before-html-insertion-mode" id=the-initial-insertion-mode:the-before-html-insertion-mode-2 "before html"
					- "\", then reprocess the token."
				}
			}
