		h5 id=attributes-common-to-source-and-img-elements {
			span class=secno "4.8.4.2"
			- " Attributes common to "
			code id=attributes-common-to-source-and-img-elements:the-source-element {
				a href="#the-source-element" source
			}
			- ", "
			code id=attributes-common-to-source-and-img-elements:the-img-element {
				a href="#the-img-element" img
			}
			- ", and "
			code id=attributes-common-to-source-and-img-elements:the-link-element {
				a href="#the-link-element" link
			}
			- " elements"
			a class=self-link href="#attributes-common-to-source-and-img-elements"
		}
		h6 id=srcset-attributes {
			span class=secno "4.8.4.2.1"
			- " Srcset attributes"
			a class=self-link href="#srcset-attributes"
		}
		p {
			- "A "
			dfn id=srcset-attribute "srcset attribute"
			- " is an attribute with requirements defined in this section."
		}
		p {
			- "If present, its value must consist of one or more "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string "image candidate strings"
			- ", each separated from the next by a U+002C COMMA character (,). If an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-2 "image candidate string"
			- " contains no descriptors and no "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters "ASCII whitespace"
			- " after the URL, the following "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-3 "image candidate string"
			- ", if there is one, must begin with one or more "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-2 "ASCII whitespace"
			- .
		}
		p {
			- "An "
			dfn id=image-candidate-string "image candidate string"
			- " consists of the following components, in order, with the further restrictions described below this list:"
		}
		ol {
			li {
				p {
					- "Zero or more "
					a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-3 "ASCII whitespace"
					- .
				}
			}
			li {
				p {
					- "A "
					a href="#valid-non-empty-url" id=srcset-attributes:valid-non-empty-url "valid non-empty URL"
					- " that does not start or end with a U+002C COMMA character (,), referencing a non-interactive, optionally animated, image resource that is neither paged nor scripted."
				}
			}
			li {
				p {
					- "Zero or more "
					a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-4 "ASCII whitespace"
					- .
				}
			}
			li {
				p "Zero or one of the following:"
				ul {
					li {
						p {
							- "A "
							dfn id=width-descriptor "width descriptor"
							- ", consisting of: "
							a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-5 "ASCII whitespace"
							- ", a "
							a href="#valid-non-negative-integer" id=srcset-attributes:valid-non-negative-integer "valid non-negative integer"
							- " giving a number greater than zero representing the "
							dfn id=width-descriptor-value "width descriptor value"
							- ", and a U+0077 LATIN SMALL LETTER W character."
						}
					}
					li {
						p {
							- "A "
							dfn id=pixel-density-descriptor "pixel density descriptor"
							- ", consisting of: "
							a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-6 "ASCII whitespace"
							- ", a "
							a href="#valid-floating-point-number" id=srcset-attributes:valid-floating-point-number "valid floating-point number"
							- " giving a number greater than zero representing the "
							dfn id=pixel-density-descriptor-value "pixel density descriptor value"
							- ", and a U+0078 LATIN SMALL LETTER X character."
						}
					}
				}
			}
			li {
				p {
					- "Zero or more "
					a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=srcset-attributes:space-characters-7 "ASCII whitespace"
					- .
				}
			}
		}
		p {
			- "There must not be an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-4 "image candidate string"
			- " for an element that has the same "
			a href="#width-descriptor-value" id=srcset-attributes:width-descriptor-value "width descriptor value"
			- " as another "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-5 "image candidate string"
			- "'s "
			a href="#width-descriptor-value" id=srcset-attributes:width-descriptor-value-2 "width descriptor value"
			- " for the same element."
		}
		p {
			- "There must not be an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-6 "image candidate string"
			- " for an element that has the same "
			a href="#pixel-density-descriptor-value" id=srcset-attributes:pixel-density-descriptor-value "pixel density descriptor value"
			- " as another "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-7 "image candidate string"
			- "'s "
			a href="#pixel-density-descriptor-value" id=srcset-attributes:pixel-density-descriptor-value-2 "pixel density descriptor value"
			- " for the same element. For the purpose of this requirement, an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-8 "image candidate string"
			- " with no descriptors is equivalent to an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-9 "image candidate string"
			- " with a "
			code "1x"
			- " descriptor."
		}
		p {
			- "If an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-10 "image candidate string"
			- " for an element has the "
			a href="#width-descriptor" id=srcset-attributes:width-descriptor "width descriptor"
			- " specified, all other "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-11 "image candidate strings"
			- " for that element must also have the "
			a href="#width-descriptor" id=srcset-attributes:width-descriptor-2 "width descriptor"
			- " specified."
		}
		p {
			- "The specified width in an "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-12 "image candidate string"
			- "'s "
			a href="#width-descriptor" id=srcset-attributes:width-descriptor-3 "width descriptor"
			- " must match the "
			a data-x-internal=natural-width href="https://drafts.csswg.org/css-images/#natural-width" id=srcset-attributes:natural-width "natural width"
			- " in the resource given by the "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-13 "image candidate string"
			- "'s URL, if it has a "
			a data-x-internal=natural-width href="https://drafts.csswg.org/css-images/#natural-width" id=srcset-attributes:natural-width-2 "natural width"
			- .
		}
		p {
			- "If an element has a "
			a href="#sizes-attribute" id=srcset-attributes:sizes-attribute "sizes attribute"
			- " present, all "
			a href="#image-candidate-string" id=srcset-attributes:image-candidate-string-14 "image candidate strings"
			- " for that element must have the "
			a href="#width-descriptor" id=srcset-attributes:width-descriptor-4 "width descriptor"
			- " specified."
		}
		h6 id=sizes-attributes {
			span class=secno "4.8.4.2.2"
			- " Sizes attributes"
			a class=self-link href="#sizes-attributes"
		}
		p {
			- "A "
			dfn id=sizes-attribute "sizes attribute"
			- " is an attribute with requirements defined in this section."
		}
		p {
			- "If present, the value must be a "
			a href="#valid-source-size-list" id=sizes-attributes:valid-source-size-list "valid source size list"
			- .
		}
		p {
			- "A "
			dfn id=valid-source-size-list "valid source size list"
			- " is a string that matches the following grammar: "
			a href="#refsCSSVALUES" "[CSSVALUES]"
			a href="#refsMQ" "[MQ]"
		}
		pre {
			code class=html {
				dfn data-dfn-type=type id=source-size-list {
					c- p="" <
					c- f="" source-size-list
					c- p="" >
				}
				- " = "
				a href="#source-size" id=sizes-attributes:source-size {
					c- p="" <
					c- f="" source-size
					c- p="" >
				}
				- "#? , "
				a href="#source-size-value" id=sizes-attributes:source-size-value {
					c- p="" <
					c- f="" source-size-value
					c- p="" >
				}
				dfn data-dfn-type=type id=source-size {
					c- p="" <
					c- f="" source-size
					c- p="" >
				}
				- " = "
				a data-x-internal=media-condition href="https://drafts.csswg.org/mediaqueries/#typedef-media-condition" id=sizes-attributes:media-condition {
					c- p="" <
					c- f="" media-condition
					c- p="" >
				}
				a href="#source-size-value" id=sizes-attributes:source-size-value-2 {
					c- p="" <
					c- f="" source-size-value
					c- p="" >
				}
				- " | "
				a href="#valdef-sizes-auto" id=sizes-attributes:valdef-sizes-auto auto
				dfn data-dfn-type=type id=source-size-value {
					c- p="" <
					c- f="" source-size-value
					c- p="" >
				}
				- " = "
				a data-x-internal=length-2 href="https://drafts.csswg.org/css-values/#lengths" id=sizes-attributes:length-2 {
					c- p="" <
					c- f="" length
					c- p="" >
				}
				- " | "
				a href="#valdef-sizes-auto" id=sizes-attributes:valdef-sizes-auto-2 auto
			}
		}
		p {
			- "A "
			a href="#source-size-value" id=sizes-attributes:source-size-value-3 <source-size-value>
			- " that is a "
			a data-x-internal=length-2 href="https://drafts.csswg.org/css-values/#lengths" id=sizes-attributes:length-2-2 <length>
			- " must not be negative, and must not use CSS functions other than the "
			a data-x-internal=math-functions href="https://drafts.csswg.org/css-values/#math-function" id=sizes-attributes:math-functions "math functions"
			- .
		}
		p {
			- "The keyword "
			dfn id=valdef-sizes-auto {
				code auto
			}
