			- " is a string (representing a "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=documents:url-2 URL
			- ") that can be set when the "
			code id=documents:document-12 {
				a href="#document" Document
			}
			- " is created. If it is not explicitly set, then its value is the empty string."
		}
