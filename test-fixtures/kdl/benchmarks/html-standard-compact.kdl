					c- p="" >
					c- p="" <
					c- f="" h3
					c- p="" >
					- "Canvas coordinates diagram"
					c- p="" "</"
					c- f="" h3
					c- p="" >
					c- p="" "</"
					c- f="" section
					c- p="" >
					c- p="" "</"
					c- f="" section
