		h3 id=converting-html-to-other-formats {
			span class=secno "5.4"
			- " Converting HTML to other formats"
			a class=self-link href="#converting-html-to-other-formats"
		}
		h4 id=json {
			span class=secno "5.4.1"
			- " JSON"
			a class=self-link href="#json"
		}
		p {
			- "Given a list of nodes "
			var nodes
			- " in a "
			code id=json:document {
				a href="#document" Document
			}
			- ", a user agent must run the following algorithm to "
			dfn id=extracting-json "extract the microdata from those nodes into a JSON form"
			- :
		}
		ol {
			li {
				p {
					- "Let "
					var result
					- " be an empty object."
				}
			}
			li {
				p {
					- "Let "
					var items
					- " be an empty array."
				}
			}
			li {
				p {
					- "For each "
					var node
					- " in "
					var nodes
					- ", check if the element is a "
					a href="#top-level-microdata-items" id=json:top-level-microdata-items "top-level microdata item"
					- ", and if it is then "
					a href="#get-the-object" id=json:get-the-object "get the object"
					- " for that element and add it to "
					var items
					- .
				}
			}
			li {
				p {
					- "Add an entry to "
					var result
					- " called \""
					code items
					- "\" whose value is the array "
					var items
					- .
				}
			}
			li {
				p {
					- "Return the result of serializing "
					var result
					- " to JSON in the shortest possible way (meaning no whitespace between tokens, no unnecessary zero digits in numbers, and only using Unicode escapes in strings for characters that do not have a dedicated escape sequence), and with a lowercase \""
					code e
					- "\" used, when appropriate, in the representation of any numbers. "
					a href="#refsJSON" "[JSON]"
				}
			}
		}
		p class=note "This algorithm returns an object with a single property that is an array, instead of just returning an array, so that it is possible to extend the algorithm in the future if necessary."
		p {
			- "When the user agent is to "
			dfn id=get-the-object "get the object"
			- " for an item "
			var item
			- ", optionally with a list of elements "
			var memory
			- ", it must run the following substeps:"
		}
		ol {
			li {
				p {
					- "Let "
					var result
					- " be an empty object."
				}
			}
			li {
				p {
					- "If no "
					var memory
					- " was passed to the algorithm, let "
					var memory
					- " be an empty list."
				}
			}
			li {
				p {
					- "Add "
					var item
					- " to "
					var memory
					- .
				}
			}
			li {
				p {
					- "If the "
					var item
					- " has any "
					a href="#item-types" id=json:item-types "item types"
					- ", add an entry to "
					var result
					- " called \""
					code type
					- "\" whose value is an array listing the "
					a href="#item-types" id=json:item-types-2 "item types"
					- " of "
					var item
					- ", in the order they were specified on the "
					code id=json:attr-itemtype {
						a href="#attr-itemtype" itemtype
					}
					- " attribute."
				}
			}
			li {
				p {
					- "If the "
					var item
					- " has a "
					a href="#global-identifier" id=json:global-identifier "global identifier"
					- ", add an entry to "
					var result
					- " called \""
					code id
					- "\" whose value is the "
					a href="#global-identifier" id=json:global-identifier-2 "global identifier"
					- " of "
					var item
					- .
				}
			}
			li {
				p {
					- "Let "
					var properties
					- " be an empty object."
				}
			}
			li {
				p {
					- "For each element "
					var element
					- " that has one or more "
					a href="#property-names" id=json:property-names "property names"
					- " and is one of "
					a href="#the-properties-of-an-item" id=json:the-properties-of-an-item "the properties of the item"
					var item
					- ", in the order those elements are given by the algorithm that returns "
					a href="#the-properties-of-an-item" id=json:the-properties-of-an-item-2 "the properties of an item"
					- ", run the following substeps:"
				}
				ol {
					li {
						p {
							- "Let "
							var value
							- " be the "
							a href="#concept-property-value" id=json:concept-property-value "property value"
							- " of "
							var element
							- .
						}
					}
					li {
						p {
							- "If "
							var value
							- " is an "
							a href="#concept-item" id=json:concept-item item
							- ", then: If "
							var value
							- " is in "
							var memory
							- ", then let "
							var value
							- " be the string \""
							code ERROR
							- "\". Otherwise, "
							a href="#get-the-object" id=json:get-the-object-2 "get the object"
							- " for "
							var value
							- ", passing a copy of "
							var memory
							- ", and then replace "
							var value
							- " with the object returned from those steps."
						}
					}
					li {
						p {
							- "For each name "
							var name
							- " in "
							var element
							- "'s "
							a href="#property-names" id=json:property-names-2 "property names"
							- ", run the following substeps:"
						}
						ol {
							li {
								p {
									- "If there is no entry named "
									var name
									- " in "
									var properties
									- ", then add an entry named "
									var name
									- " to "
									var properties
									- " whose value is an empty array."
								}
							}
							li {
								p {
									- "Append "
									var value
									- " to the entry named "
									var name
									- " in "
									var properties
									- .
								}
							}
						}
					}
				}
			}
			li {
				p {
					- "Add an entry to "
					var result
					- " called \""
					code properties
					- "\" whose value is the object "
					var properties
					- .
				}
			}
			li {
				p {
					- "Return "
					var result
					- .
				}
			}
		}
