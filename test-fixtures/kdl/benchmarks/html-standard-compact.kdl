			code id=the-footer-element:the-footer-element-6 {
				a href="#the-footer-element" footer
			}
			- " element is not itself "
			a href="#sectioning-content-2" id=the-footer-element:sectioning-content-2-4 "sectioning content"
			- "; it doesn't introduce a new section."
		}
