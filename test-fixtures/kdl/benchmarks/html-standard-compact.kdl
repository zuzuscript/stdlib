							}
							- " attribute value is an "
							a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=standard-metadata-names:ascii-case-insensitive-3 "ASCII case-insensitive"
							- " match for "
							code id=standard-metadata-names:meta-application-name-3 {
								a href="#meta-application-name" application-name
							}
							- " and whose "
							a href="#language" id=standard-metadata-names:language-3 language
							- " is the language in question."
						}
						p {
							- "If none of the languages have such a "
							code id=standard-metadata-names:the-meta-element-4 {
								a href="#the-meta-element" meta
							}
							- " element, then return; there's no given application name."
						}
					}
					li {
						p {
							- "Return the value of the "
							code id=standard-metadata-names:attr-meta-content {
								a href="#attr-meta-content" content
							}
							- " attribute of the first "
							code id=standard-metadata-names:the-meta-element-5 {
								a href="#the-meta-element" meta
							}
							- " element in the "
							code id=standard-metadata-names:document-3 {
								a href="#document" Document
							}
							- " in "
							a data-x-internal=tree-order href="https://dom.spec.whatwg.org/#concept-tree-order" id=standard-metadata-names:tree-order "tree order"
							- " where the "
							code id=standard-metadata-names:attr-meta-name-4 {
