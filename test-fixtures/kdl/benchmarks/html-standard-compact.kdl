		p {
			i "This section is non-normative."
		}
		p {
			- "The following table lists events fired by this document, excluding those already defined in "
			a href="#mediaevents" "media element events"
			- " and "
			a href="#dndevents" "drag-and-drop events"
			- .
		}
		table {
			caption "List of events"
