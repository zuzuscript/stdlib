		ol {
			li {
				p {
					- "Let "
					var "raw input"
					- " be the string being parsed."
				}
			}
			li {
				p {
					- "If the last character in "
					var "raw input"
					- " is a U+002C COMMA character (,), then remove that character from "
					var "raw input"
