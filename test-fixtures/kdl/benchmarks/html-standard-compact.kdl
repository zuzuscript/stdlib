				a href="#attr-itemtype" itemtype
			}
			- " attribute that references a vocabulary that is defined to "
			dfn id=support-global-identifiers-for-items "support global identifiers for items"
			- " may also have an "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-itemid {
				code itemid
			}
			- " attribute specified, to give a global identifier for the "
			a href="#concept-item" id=items:concept-item-8 item
			- ", so that it can be related to other "
			a href="#concept-item" id=items:concept-item-9 items
			- " on pages elsewhere on the web."
		}
		p {
			- "The "
			code id=items:attr-itemid {
				a href="#attr-itemid" itemid
			}
			- " attribute, if specified, must have a value that is a "
			a href="#valid-url-potentially-surrounded-by-spaces" id=items:valid-url-potentially-surrounded-by-spaces "valid URL potentially surrounded by spaces"
			- .
		}
		p {
			- "The "
			dfn id=global-identifier "global identifier"
			- " of an "
			a href="#concept-item" id=items:concept-item-10 item
			- " is the value of its element's "
			code id=items:attr-itemid-2 {
				a href="#attr-itemid" itemid
			}
			- " attribute, if it has one, "
			a href="#encoding-parsing-a-url" id=items:encoding-parsing-a-url parsed
			- " relative to the "
			a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=items:node-document "node document"
			- " of the element on which the attribute is specified. If the "
			code id=items:attr-itemid-3 {
				a href="#attr-itemid" itemid
			}
			- " attribute is missing or if parsing it returns failure, it is said to have no "
			a href="#global-identifier" id=items:global-identifier "global identifier"
			- .
		}
		p {
			- "The "
			code id=items:attr-itemid-4 {
				a href="#attr-itemid" itemid
			}
			- " attribute must not be specified on elements that do not have both an "
			code id=items:attr-itemscope-6 {
