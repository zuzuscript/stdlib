		p {
			- "A string is a "
			dfn id=valid-vevent-duration-string "valid vevent duration string"
			- " if it matches the following pattern:"
		}
		ol {
			li {
				p "A U+0050 LATIN CAPITAL LETTER P character (P)."
			}
			li {
				p "One of the following:"
				ul {
					li {
						p {
							- "A "
							a href="#valid-non-negative-integer" id=vevent:valid-non-negative-integer-2 "valid non-negative integer"
							- " followed by a U+0057 LATIN CAPITAL LETTER W character (W). The integer represents a duration of that number of weeks."
						}
					}
					li {
						p "At least one, and possible both in this order, of the following:"
						ol {
							li {
								p {
									- "A "
									a href="#valid-non-negative-integer" id=vevent:valid-non-negative-integer-3 "valid non-negative integer"
									- " followed by a U+0044 LATIN CAPITAL LETTER D character (D). The integer represents a duration of that number of days."
								}
							}
							li {
								p "A U+0054 LATIN CAPITAL LETTER T character (T) followed by any one of the following, or the first and second of the following in that order, or the second and third of the following in that order, or all three of the following in this order:"
								ol {
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id=vevent:valid-non-negative-integer-4 "valid non-negative integer"
											- " followed by a U+0048 LATIN CAPITAL LETTER H character (H). The integer represents a duration of that number of hours."
										}
									}
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id=vevent:valid-non-negative-integer-5 "valid non-negative integer"
											- " followed by a U+004D LATIN CAPITAL LETTER M character (M). The integer represents a duration of that number of minutes."
										}
									}
									li {
										p {
											- "A "
											a href="#valid-non-negative-integer" id=vevent:valid-non-negative-integer-6 "valid non-negative integer"
											- " followed by a U+0053 LATIN CAPITAL LETTER S character (S). The integer represents a duration of that number of seconds."
										}
									}
								}
							}
						}
					}
				}
			}
		}
		h5 id=conversion-to-icalendar {
			span class=secno "5.3.2.1"
			- " Conversion to iCalendar"
			a class=self-link href="#conversion-to-icalendar"
		}
		p {
			- "Given a list of nodes "
			var nodes
			- " in a "
			code id=conversion-to-icalendar:document {
				a href="#document" Document
			}
			- ", a user agent must run the following algorithm to "
			dfn id=extracting-vevent-data "extract any vEvent data represented by those nodes"
			- :
		}
		ol {
			li {
				p {
					- "If none of the nodes in "
					var nodes
					- " are "
					a href="#concept-item" id=conversion-to-icalendar:concept-item items
					- " with the type "
					code id=conversion-to-icalendar:md-vevent {
						a href="#md-vevent" "http://microformats.org/profile/hcalendar#vevent"
					}
					- ", then there is no vEvent data. Abort the algorithm, returning nothing."
				}
			}
			li {
				p {
					- "Let "
					var output
					- " be an empty string."
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line "Add an iCalendar line"
					- " with the type \""
					code BEGIN
					- "\" and the value \""
					code VCALENDAR
					- "\" to "
					var output
					- .
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-2 "Add an iCalendar line"
					- " with the type \""
					code PRODID
					- "\" and the value equal to a user-agent-specific string representing the user agent to "
					var output
					- .
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-3 "Add an iCalendar line"
					- " with the type \""
					code VERSION
					- "\" and the value \""
					code "2.0"
					- "\" to "
					var output
					- .
				}
			}
			li {
				p {
					- "For each node "
					var node
					- " in "
					var nodes
					- " that is an "
					a href="#concept-item" id=conversion-to-icalendar:concept-item-2 item
					- " with the type "
					code id=conversion-to-icalendar:md-vevent-2 {
						a href="#md-vevent" "http://microformats.org/profile/hcalendar#vevent"
					}
					- ", run the following steps:"
				}
				ol {
					li {
						p {
							a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-4 "Add an iCalendar line"
							- " with the type \""
							code BEGIN
							- "\" and the value \""
							code VEVENT
							- "\" to "
							var output
							- .
						}
					}
					li {
						p {
							a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-5 "Add an iCalendar line"
							- " with the type \""
							code DTSTAMP
							- "\" and a value consisting of an iCalendar DATE-TIME string representing the current date and time, with the annotation \""
							code "VALUE=DATE-TIME"
							- "\", to "
							var output
							- ". "
							a href="#refsRFC5545" "[RFC5545]"
						}
					}
					li {
						p {
							- "For each element "
							var element
							- " that is "
							a href="#the-properties-of-an-item" id=conversion-to-icalendar:the-properties-of-an-item "a property of the item"
							var node
							- ": for each name "
							var name
							- " in "
							var element
							- "'s "
							a href="#property-names" id=conversion-to-icalendar:property-names "property names"
							- ", run the appropriate set of substeps from the following list:"
						}
						dl {
							dt {
								- "If the property's "
								a href="#concept-property-value" id=conversion-to-icalendar:concept-property-value value
								- " is an "
								a href="#concept-item" id=conversion-to-icalendar:concept-item-3 item
							}
							dd {
								p "Skip the property."
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-dtend {
									a href="#md-vevent-dtend" dtend
								}
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-dtstart {
									a href="#md-vevent-dtstart" dtstart
								}
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-exdate {
									a href="#md-vevent-exdate" exdate
								}
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-rdate {
									a href="#md-vevent-rdate" rdate
								}
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-created {
									a href="#md-vevent-created" created
								}
							}
							dt {
								- "If the property is "
								code id=conversion-to-icalendar:md-vevent-last-modified {
									a href="#md-vevent-last-modified" last-modified
								}
							}
							dd {
								p {
									- "Let "
									var value
									- " be the result of stripping all U+002D HYPHEN-MINUS (-) and U+003A COLON (:) characters from the property's "
									a href="#concept-property-value" id=conversion-to-icalendar:concept-property-value-2 value
									- .
								}
								p {
									- "If the property's "
									a href="#concept-property-value" id=conversion-to-icalendar:concept-property-value-3 value
									- " is a "
									a href="#valid-date-string" id=conversion-to-icalendar:valid-date-string "valid date string"
									- " then "
									a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-6 "add an iCalendar line"
									- " with the type "
									var name
									- " and the value "
									var value
									- " to "
									var output
									- ", with the annotation \""
									code "VALUE=DATE"
									- "\"."
								}
								p {
									- "Otherwise, if the property's "
									a href="#concept-property-value" id=conversion-to-icalendar:concept-property-value-4 value
									- " is a "
									a href="#valid-global-date-and-time-string" id=conversion-to-icalendar:valid-global-date-and-time-string "valid global date and time string"
									- " then "
									a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-7 "add an iCalendar line"
									- " with the type "
									var name
									- " and the value "
									var value
									- " to "
									var output
									- ", with the annotation \""
									code "VALUE=DATE-TIME"
									- "\"."
								}
								p "Otherwise, skip the property."
							}
							dt Otherwise
							dd {
								p {
									a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-8 "Add an iCalendar line"
									- " with the type "
									var name
									- " and the property's "
									a href="#concept-property-value" id=conversion-to-icalendar:concept-property-value-5 value
									- " to "
									var output
									- .
								}
							}
						}
					}
					li {
						p {
							a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-9 "Add an iCalendar line"
							- " with the type \""
							code END
							- "\" and the value \""
							code VEVENT
							- "\" to "
							var output
							- .
						}
					}
				}
			}
			li {
				p {
					a href="#add-an-icalendar-line" id=conversion-to-icalendar:add-an-icalendar-line-10 "Add an iCalendar line"
					- " with the type \""
					code END
					- "\" and the value \""
					code VCALENDAR
					- "\" to "
					var output
					- .
				}
			}
		}
		p {
			- "When the above algorithm says that the user agent is to "
			dfn id=add-an-icalendar-line "add an iCalendar line"
			- " consisting of a type "
			var type
			- ", a value "
			var value
			- ", and optionally an annotation, to a string "
			var output
			- ", it must run the following steps:"
		}
		ol {
			li {
				p {
					- "Let "
					var line
					- " be an empty string."
				}
			}
			li {
				p {
					- "Append "
					var type
					- ", "
					a data-x-internal=converted-to-ascii-uppercase href="https://infra.spec.whatwg.org/#ascii-uppercase" id=conversion-to-icalendar:converted-to-ascii-uppercase "converted to ASCII uppercase"
					- ", to "
					var line
					- .
				}
			}
			li {
				p "If there is an annotation:"
				ol {
					li {
						p {
							- "Append a U+003B SEMICOLON character (;) to "
							var line
							- .
						}
					}
					li {
						p {
							- "Append the annotation to "
							var line
							- .
						}
					}
				}
			}
			li {
				p {
					- "Append a U+003A COLON character (:) to "
					var line
					- .
				}
			}
			li {
				p {
					- "Prefix every U+005C REVERSE SOLIDUS character (\\) in "
					var value
					- " with another U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+002C COMMA character (,) in "
					var value
					- " with a U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Prefix every U+003B SEMICOLON character (;) in "
					var value
					- " with a U+005C REVERSE SOLIDUS character (\\)."
				}
			}
			li {
				p {
					- "Replace every U+000D CARRIAGE RETURN U+000A LINE FEED character pair (CRLF) in "
					var value
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN SMALL LETTER N character (n)."
				}
			}
			li {
				p {
					- "Replace every remaining U+000D CARRIAGE RETURN (CR) or U+000A LINE FEED (LF) character in "
					var value
					- " with a U+005C REVERSE SOLIDUS character (\\) followed by a U+006E LATIN SMALL LETTER N character (n)."
				}
			}
			li {
				p {
					- "Append "
					var value
					- " to "
					var line
					- .
				}
			}
			li {
				p {
					- "Let "
					var "maximum length"
					- " be 75."
				}
			}
			li {
				p {
					- "While "
					var line
					- "'s "
					a data-x-internal=code-point-length href="https://infra.spec.whatwg.org/#string-code-point-length" id=conversion-to-icalendar:code-point-length "code point length"
					- " is greater than "
					var "maximum length"
					- :
				}
				ol {
					li {
						p {
							- "Append the first "
							var "maximum length"
							- " code points of "
							var line
							- " to "
							var output
							- .
						}
					}
					li {
						p {
							- "Remove the first "
							var "maximum length"
							- " code points from "
							var line
							- .
						}
					}
					li {
						p {
							- "Append a U+000D CARRIAGE RETURN character (CR) to "
							var output
							- .
						}
					}
					li {
						p {
							- "Append a U+000A LINE FEED character (LF) to "
							var output
							- .
						}
					}
					li {
						p {
							- "Append a U+0020 SPACE character to "
							var output
							- .
						}
					}
					li {
						p {
							- "Let "
							var "maximum length"
							- " be 74."
						}
					}
				}
			}
			li {
				p {
					- "Append (what remains of) "
					var line
					- " to "
					var output
					- .
				}
			}
			li {
				p {
					- "Append a U+000D CARRIAGE RETURN character (CR) to "
					var output
					- .
				}
			}
			li {
				p {
					- "Append a U+000A LINE FEED character (LF) to "
					var output
					- .
				}
			}
		}
		p class=note {
			- "This algorithm can generate invalid iCalendar output, if the input does not conform to the rules described for the "
			code id=conversion-to-icalendar:md-vevent-3 {
				a href="#md-vevent" "http://microformats.org/profile/hcalendar#vevent"
			}
			a href="#item-types" id=conversion-to-icalendar:item-types "item type"
			- " and "
			a href="#defined-property-name" id=conversion-to-icalendar:defined-property-name "defined property names"
			- .
		}
		h5 id=examples-3 {
			span class=secno "5.3.2.2"
			- " Examples"
			a class=self-link href="#examples-3"
		}
		p {
			i "This section is non-normative."
		}
		div class=example {
			p "Here is an example of a page that uses the vEvent vocabulary to mark up an event:"
			pre {
				code class=html {
					c- p="" <
					c- f="" body
					c- e="" itemscope
					c- e="" itemtype
					c- o="" "="
					c- s="" "\"http://microformats.org/profile/hcalendar#vevent\""
					c- p="" >
					- " ... "
					c- p="" <
					c- f="" h1
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"summary\""
					c- p="" >
					- "Bluesday Tuesday: Money Road"
					c- p="" "</"
					c- f="" h1
					c- p="" >
					- " ... "
					c- p="" <
					c- f="" time
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"dtstart\""
					c- e="" datetime
					c- o="" "="
					c- s="" "\"2009-05-05T19:00:00Z\""
					c- p="" >
					- "May 5th @ 7pm"
					c- p="" "</"
					c- f="" time
					c- p="" >
					- " (until "
					c- p="" <
					c- f="" time
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"dtend\""
					c- e="" datetime
					c- o="" "="
					c- s="" "\"2009-05-05T21:00:00Z\""
					c- p="" >
					- "9pm"
					c- p="" "</"
					c- f="" time
					c- p="" >
					- ") ... "
					c- p="" <
					c- f="" a
					c- e="" href
					c- o="" "="
					c- s="" "\"http://livebrum.co.uk/2009/05/05/bluesday-tuesday-money-road\""
					c- e="" rel
					c- o="" "="
					c- s="" "\"bookmark\""
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"url\""
					c- p="" >
					- "Link to this page"
					c- p="" "</"
					c- f="" a
					c- p="" >
					- " ... "
					c- p="" <
					c- f="" p
					c- p="" >
					- "Location: "
					c- p="" <
					c- f="" span
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"location\""
					c- p="" >
					- "The RoadHouse"
					c- p="" "</"
					c- f="" span
					c- p="" "></"
					c- f="" p
					c- p="" >
					- " ... "
					c- p="" <
					c- f="" p
					c- p="" ><
					c- f="" input
					c- e="" type
					c- o="" "="
					c- s="" button
					c- e="" value
					c- o="" "="
					c- s="" "\"Add to Calendar\""
					c- e="" onclick
					c- o="" "="
					c- s="" "\"location = getCalendar(this)\""
					c- p="" "></"
					c- f="" p
					c- p="" >
					- " ... "
					c- p="" <
					c- f="" meta
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"description\""
					c- e="" content
					c- o="" "="
					c- s="" "\"via livebrum.co.uk\""
					c- p="" >
					c- p="" "</"
					c- f="" body
					c- p="" >
				}
			}
			p {
				- "The "
				code "getCalendar()"
				- " function is left as an exercise for the reader."
			}
			p "The same page could offer some markup, such as the following, for copy-and-pasting into blogs:"
			pre {
				code class=html {
					c- p="" <
					c- f="" div
					c- e="" itemscope
					c- e="" itemtype
					c- o="" "="
					c- s="" "\"http://microformats.org/profile/hcalendar#vevent\""
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "I'm going to "
					c- p="" <
					c- f="" strong
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"summary\""
					c- p="" >
					- "Bluesday Tuesday: Money Road"
					c- p="" "</"
					c- f="" strong
					c- p="" >
					- ", "
					c- p="" <
					c- f="" time
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"dtstart\""
					c- e="" datetime
					c- o="" "="
					c- s="" "\"2009-05-05T19:00:00Z\""
					c- p="" >
					- "May 5th at 7pm"
					c- p="" "</"
					c- f="" time
					c- p="" >
					- " to "
					c- p="" <
					c- f="" time
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"dtend\""
					c- e="" datetime
					c- o="" "="
					c- s="" "\"2009-05-05T21:00:00Z\""
					c- p="" >
					- "9pm"
					c- p="" "</"
					c- f="" time
					c- p="" >
					- ", at "
					c- p="" <
					c- f="" span
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"location\""
					c- p="" >
					- "The RoadHouse"
					c- p="" "</"
					c- f="" span
					c- p="" >
					- !
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" ><
					c- f="" a
					c- e="" href
					c- o="" "="
					c- s="" "\"http://livebrum.co.uk/2009/05/05/bluesday-tuesday-money-road\""
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"url\""
					c- p="" >
					- "See this event on livebrum.co.uk"
					c- p="" "</"
					c- f="" a
					c- p="" >
					- .
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" meta
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"description\""
					c- e="" content
					c- o="" "="
					c- s="" "\"via livebrum.co.uk\""
					c- p="" >
					c- p="" "</"
					c- f="" div
					c- p="" >
				}
			}
		}
		h4 id=licensing-works {
			span class=secno "5.3.3"
			- " Licensing works"
			a class=self-link href="#licensing-works"
		}
		p {
			- "An item with the "
			a href="#item-types" id=licensing-works:item-types "item type"
			dfn id=md-work {
				code "http://n.whatwg.org/work"
			}
			- " represents a work (e.g. an article, an image, a video, a song, etc.). This type is primarily intended to allow authors to include licensing information for works."
		}
		p {
			- "The following are the type's "
			a href="#defined-property-name" id=licensing-works:defined-property-name "defined property names"
			- .
		}
		dl {
			dt {
				dfn id=md-work-work {
					code work
				}
			}
			dd {
				p "Identifies the work being described."
				p {
					- "The "
					a href="#concept-property-value" id=licensing-works:concept-property-value value
					- " must be an "
					a data-x-internal=absolute-url href="https://url.spec.whatwg.org/#syntax-url-absolute" id=licensing-works:absolute-url "absolute URL"
					- .
				}
				p {
					- "Exactly one property with the name "
					code id=licensing-works:md-work-work {
						a href="#md-work-work" work
					}
					- " must be present within each "
					a href="#concept-item" id=licensing-works:concept-item item
					- " with the type "
					code id=licensing-works:md-work {
						a href="#md-work" "http://n.whatwg.org/work"
					}
					- .
				}
			}
			dt {
				dfn id=md-work-title {
					code title
				}
			}
			dd {
				p "Gives the name of the work."
				p {
					- "A single property with the name "
					code id=licensing-works:md-work-title {
						a href="#md-work-title" title
					}
					- " may be present within each "
					a href="#concept-item" id=licensing-works:concept-item-2 item
					- " with the type "
					code id=licensing-works:md-work-2 {
						a href="#md-work" "http://n.whatwg.org/work"
					}
					- .
				}
			}
			dt {
				dfn id=md-work-author {
					code author
				}
			}
			dd {
				p "Gives the name or contact information of one of the authors or creators of the work."
				p {
					- "The "
					a href="#concept-property-value" id=licensing-works:concept-property-value-2 value
					- " must be either an "
					a href="#concept-item" id=licensing-works:concept-item-3 item
					- " with the type "
					code id=licensing-works:md-vcard {
						a href="#md-vcard" "http://microformats.org/profile/hcard"
					}
					- ", or text."
				}
				p {
					- "Any number of properties with the name "
					code id=licensing-works:md-work-author {
						a href="#md-work-author" author
					}
					- " may be present within each "
					a href="#concept-item" id=licensing-works:concept-item-4 item
					- " with the type "
					code id=licensing-works:md-work-3 {
						a href="#md-work" "http://n.whatwg.org/work"
					}
					- .
				}
			}
			dt {
				dfn id=md-work-license {
					code license
				}
			}
			dd {
				p "Identifies one of the licenses under which the work is available."
				p {
					- "The "
					a href="#concept-property-value" id=licensing-works:concept-property-value-3 value
					- " must be an "
					a data-x-internal=absolute-url href="https://url.spec.whatwg.org/#syntax-url-absolute" id=licensing-works:absolute-url-2 "absolute URL"
					- .
				}
				p {
					- "Any number of properties with the name "
					code id=licensing-works:md-work-license {
						a href="#md-work-license" license
					}
					- " may be present within each "
					a href="#concept-item" id=licensing-works:concept-item-5 item
					- " with the type "
					code id=licensing-works:md-work-4 {
						a href="#md-work" "http://n.whatwg.org/work"
					}
					- .
				}
