		p {
			- "The "
			dfn data-dfn-for=input data-dfn-type=element-attr id=attr-input-type {
				code type
			}
			- " attribute controls the data type (and associated control) of the element. It is an "
			a href="#enumerated-attribute" id=the-input-element:enumerated-attribute "enumerated attribute"
			- " with the following keywords and states:"
		}
