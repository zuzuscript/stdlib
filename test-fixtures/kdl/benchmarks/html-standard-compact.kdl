					c- e="" src
					c- o="" "="
					c- s="" "\"tgif.vid\""
					c- e="" autoplay
					c- e="" controls
					c- e="" onerror
					c- o="" "="
					c- s="" "\"failed(event)\""
					c- p="" "></"
					c- f="" video
					c- p="" "></"
					c- f="" p
					c- p="" >
					c- p="" <
