			}
			dt {
				dfn id="image/png" {
					code "image/png"
				}
			}
			dd {
				- "PNG images "
				a href="#refsPNG" "[PNG]"
			}
			dt {
				dfn id="image/svg+xml" {
					code "image/svg+xml"
				}
			}
			dd {
				- "SVG images "
				a href="#refsSVG" "[SVG]"
			}
			dt {
				dfn id="multipart/form-data" {
					code "multipart/form-data"
				}
			}
			dd {
				- "Form submission "
				a href="#refsRFC7578" "[RFC7578]"
			}
			dt {
				dfn id="multipart/mixed" {
					code "multipart/mixed"
				}
			}
			dd {
				- "Generic mixed content "
				a href="#refsRFC2046" "[RFC2046]"
			}
			dt {
				code id="mime-types-2:multipart/x-mixed-replace" {
					a href="#multipart/x-mixed-replace" "multipart/x-mixed-replace"
				}
			}
			dd "Streaming server push"
			dt {
				dfn id="text/css" {
					code "text/css"
				}
			}
			dd {
				- "CSS "
				a href="#refsCSS" "[CSS]"
			}
			dt {
				code id="mime-types-2:text/event-stream" {
					a href="#text/event-stream" "text/event-stream"
				}
			}
			dd "Server-sent event streams"
			dt {
				dfn id="text/javascript" {
					code "text/javascript"
				}
			}
			dd {
				- "JavaScript "
				a href="#refsJAVASCRIPT" "[JAVASCRIPT]"
				a href="#refsRFC9239" "[RFC9239]"
			}
			dt {
				dfn id="text/json" {
					code "text/json"
				}
			}
			dd "JSON (legacy type)"
			dt {
				dfn id="text/plain" {
					a href="https://www.rfc-editor.org/rfc/rfc2046#section-4.1.3" {
						code "text/plain"
					}
				}
			}
			dd {
