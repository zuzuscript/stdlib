		}
		ul class=domTree {
			li class=t1 {
				code id="misnested-tags:-b-p-/b-/p:the-b-element-9" {
					a href="#the-b-element" b
				}
				ul {
					li class=t3 {
						code id="misnested-tags:-b-p-/b-/p:text-6" {
							a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" "#text"
						}
						- ": "
						span "2"
					}
				}
			}
		}
		p {
			- "Finally, the new "
			code id="misnested-tags:-b-p-/b-/p:the-b-element-10" {
				a href="#the-b-element" b
			}
			- " element is appended to the "
			code id="misnested-tags:-b-p-/b-/p:the-p-element-8" {
				a href="#the-p-element" p
			}
			- " element, so that the DOM looks like:"
		}
		ul class=domTree {
			li class=t1 {
				code id="misnested-tags:-b-p-/b-/p:the-html-element-5" {
					a href="#the-html-element" html
				}
				ul {
					li class=t1 {
						code id="misnested-tags:-b-p-/b-/p:the-head-element-4" {
							a href="#the-head-element" head
						}
