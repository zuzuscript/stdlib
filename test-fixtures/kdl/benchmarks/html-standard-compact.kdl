					c- mf="" "0"
					c- p="" "];"
					- " o"
					c- p="" .
					- contentWindow
					c- p="" .
					- postMessage
					c- p="" "("
					c- t="" "'Hello world'"
					c- p="" ,
					c- t="" "'https://b.example.org/'"
					c- p="" ");"
				}
			}
			p {
				- "To register an event handler for incoming events, the script would use "
				code "addEventListener()"
				- " (or similar mechanisms). For example, the script in document B might look like:"
			}
			pre {
				code class=js {
					- window
					c- p="" .
					- addEventListener
					c- p="" "("
					c- t="" 'message'
					c- p="" ,
					- " receiver"
