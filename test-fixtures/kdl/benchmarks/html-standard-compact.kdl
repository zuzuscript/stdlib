							- ", so that a user can more easily navigate lists."
						}
						p class=example {
							- "Similarly, a user agent could make all elements with "
							code id=data-model:attr-title {
								a href="#attr-title" title
							}
							- " attributes "
							a href="#sequentially-focusable" id=data-model:sequentially-focusable-2 "sequentially focusable"
							- ", so that their advisory information can be accessed."
						}
					}
				}
