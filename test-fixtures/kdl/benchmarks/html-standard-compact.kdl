		h6 id=the-before-html-insertion-mode {
			span class=secno "13.2.6.4.2"
			- " The \""
			dfn "before html"
			- "\" insertion mode"
			a class=self-link href="#the-before-html-insertion-mode"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#the-before-html-insertion-mode" id=the-before-html-insertion-mode:the-before-html-insertion-mode "before html"
			- "\" "
			a href="#insertion-mode" id=the-before-html-insertion-mode:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt "A DOCTYPE token"
			dd {
				p {
					a href="#parse-errors" id=the-before-html-insertion-mode:parse-errors "Parse error"
					- ". Ignore the token."
				}
			}
			dt "A comment token"
			dd {
				p {
					a href="#insert-a-comment" id=the-before-html-insertion-mode:insert-a-comment "Insert a comment"
					- " as the last child of the "
					code id=the-before-html-insertion-mode:document {
						a href="#document" Document
					}
					- " object."
				}
			}
			dt "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
			dd {
				p "Ignore the token."
			}
			dt "A start tag whose tag name is \"html\""
			dd {
				p {
					a href="#create-an-element-for-the-token" id=the-before-html-insertion-mode:create-an-element-for-the-token "Create an element for the token"
					- " in the "
					a data-x-internal=html-namespace-2 href="https://infra.spec.whatwg.org/#html-namespace" id=the-before-html-insertion-mode:html-namespace-2 "HTML namespace"
					- ", with the "
					code id=the-before-html-insertion-mode:document-2 {
						a href="#document" Document
					}
					- " as the intended parent. Append it to the "
					code id=the-before-html-insertion-mode:document-3 {
						a href="#document" Document
					}
					- " object. Put this element in the "
					a href="#stack-of-open-elements" id=the-before-html-insertion-mode:stack-of-open-elements "stack of open elements"
					- .
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=the-before-html-insertion-mode:insertion-mode-2 "insertion mode"
					- " to \""
					a href="#the-before-head-insertion-mode" id=the-before-html-insertion-mode:the-before-head-insertion-mode "before head"
					- "\"."
				}
			}
			dt "An end tag whose tag name is one of: \"head\", \"body\", \"html\", \"br\""
			dd {
				p "Act as described in the \"anything else\" entry below."
			}
			dt "Any other end tag"
			dd {
				p {
					a href="#parse-errors" id=the-before-html-insertion-mode:parse-errors-2 "Parse error"
					- ". Ignore the token."
				}
			}
			dt "Anything else"
			dd {
				p {
					- "Create an "
					code id=the-before-html-insertion-mode:the-html-element {
						a href="#the-html-element" html
					}
					- " element whose "
					a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=the-before-html-insertion-mode:node-document "node document"
					- " is the "
					code id=the-before-html-insertion-mode:document-4 {
						a href="#document" Document
					}
					- " object. Append it to the "
					code id=the-before-html-insertion-mode:document-5 {
						a href="#document" Document
					}
					- " object. Put this element in the "
					a href="#stack-of-open-elements" id=the-before-html-insertion-mode:stack-of-open-elements-2 "stack of open elements"
					- .
				}
				p {
					- "Switch the "
					a href="#insertion-mode" id=the-before-html-insertion-mode:insertion-mode-3 "insertion mode"
					- " to \""
					a href="#the-before-head-insertion-mode" id=the-before-html-insertion-mode:the-before-head-insertion-mode-2 "before head"
					- "\", then reprocess the token."
				}
			}
		}
		p {
			- "The "
			a data-x-internal=document-element href="https://dom.spec.whatwg.org/#document-element" id=the-before-html-insertion-mode:document-element "document element"
			- " can end up being removed from the "
			code id=the-before-html-insertion-mode:document-6 {
				a href="#document" Document
			}
			- " object, e.g. by scripts; nothing in particular happens in such cases, content continues being appended to the nodes as described in the next section."
		}
		h6 id=the-before-head-insertion-mode {
			span class=secno "13.2.6.4.3"
			- " The \""
			dfn "before head"
			- "\" insertion mode"
			a class=self-link href="#the-before-head-insertion-mode"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#the-before-head-insertion-mode" id=the-before-head-insertion-mode:the-before-head-insertion-mode "before head"
			- "\" "
			a href="#insertion-mode" id=the-before-head-insertion-mode:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
			dd {
				p "Ignore the token."
			}
			dt "A comment token"
			dd {
				p {
					a href="#insert-a-comment" id=the-before-head-insertion-mode:insert-a-comment "Insert a comment"
					- .
