		}
		p {
			- "When a document's "
			a href="#document-base-url" id=dynamic-changes-to-base-urls:document-base-url "document base URL"
			- " changes, all elements in that document are "
			a href="#affected-by-a-base-url-change" id=dynamic-changes-to-base-urls:affected-by-a-base-url-change "affected by a base URL change"
			- .
		}
		p {
			- "The following are "
			a href="#base-url-change-steps" id=dynamic-changes-to-base-urls:base-url-change-steps "base URL change steps"
			- ", which run when an element is "
			a href="#affected-by-a-base-url-change" id=dynamic-changes-to-base-urls:affected-by-a-base-url-change-2 "affected by a base URL change"
			- " (as defined by "
			cite DOM
			- "):"
		}
		dl class=switch {
			dt {
				- "If the element creates a "
				a href="#hyperlink" id=dynamic-changes-to-base-urls:hyperlink hyperlink
			}
			dd {
				p {
					- "If the "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=dynamic-changes-to-base-urls:url URL
					- " identified by the hyperlink is being shown to the user, or if any data derived from that "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=dynamic-changes-to-base-urls:url-2 URL
					- " is affecting the display, then the "
					code id=dynamic-changes-to-base-urls:attr-hyperlink-href {
						a href="#attr-hyperlink-href" href
					}
					- " attribute's value should be "
					a href="#encoding-parsing-a-url" id=dynamic-changes-to-base-urls:encoding-parsing-a-url reparsed
					- ", relative to the element's "
					a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=dynamic-changes-to-base-urls:node-document "node document"
					- " and the UI updated appropriately."
				}
				p class=example {
					- "For example, the CSS "
					code id=dynamic-changes-to-base-urls:selector-link {
						a href="#selector-link" :link
					}
					- "/"
					code id=dynamic-changes-to-base-urls:selector-visited {
						a href="#selector-visited" :visited
					}
					a data-x-internal=pseudo-class href="https://drafts.csswg.org/selectors/#pseudo-class" id=dynamic-changes-to-base-urls:pseudo-class pseudo-classes
					- " might have been affected."
				}
				p {
					- "If the hyperlink has a "
					code id=dynamic-changes-to-base-urls:ping {
						a href="#ping" ping
					}
					- " attribute and its "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=dynamic-changes-to-base-urls:url-3 "URL(s)"
					- " are being shown to the user, then the "
					code id=dynamic-changes-to-base-urls:ping-2 {
						a href="#ping" ping
					}
					- " attribute's tokens should be "
					a href="#encoding-parsing-a-url" id=dynamic-changes-to-base-urls:encoding-parsing-a-url-2 reparsed
					- ", relative to the element's "
					a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=dynamic-changes-to-base-urls:node-document-2 "node document"
					- " and the UI updated appropriately."
				}
			}
			dt {
				- "If the element is a "
				code id=dynamic-changes-to-base-urls:the-q-element {
					a href="#the-q-element" q
				}
				- ", "
				code id=dynamic-changes-to-base-urls:the-blockquote-element {
					a href="#the-blockquote-element" blockquote
				}
				- ", "
				code id=dynamic-changes-to-base-urls:the-ins-element {
					a href="#the-ins-element" ins
				}
				- ", or "
				code id=dynamic-changes-to-base-urls:the-del-element {
					a href="#the-del-element" del
				}
				- " element with a "
				code cite
				- " attribute"
			}
			dd {
				p {
					- "If the "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=dynamic-changes-to-base-urls:url-4 URL
					- " identified by the "
					code cite
					- " attribute is being shown to the user, or if any data derived from that "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=dynamic-changes-to-base-urls:url-5 URL
					- " is affecting the display, then the "
					code cite
					- " attribute's value should be "
					a href="#encoding-parsing-a-url" id=dynamic-changes-to-base-urls:encoding-parsing-a-url-3 reparsed
					- ", relative to the element's "
					a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=dynamic-changes-to-base-urls:node-document-3 "node document"
					- " and the UI updated appropriately."
				}
			}
			dt Otherwise
			dd {
				p "The element is not directly affected."
				p class=example {
					- "For instance, changing the base URL doesn't affect the image displayed by "
					code id=dynamic-changes-to-base-urls:the-img-element {
						a href="#the-img-element" img
					}
					- " elements, although subsequent accesses of the "
					code id=dynamic-changes-to-base-urls:dom-img-src {
						a href="#dom-img-src" src
					}
					- " IDL attribute from script will return a new "
					a data-x-internal=absolute-url href="https://url.spec.whatwg.org/#syntax-url-absolute" id=dynamic-changes-to-base-urls:absolute-url "absolute URL"
					- " that might no longer correspond to the image being shown."
				}
			}
		}
