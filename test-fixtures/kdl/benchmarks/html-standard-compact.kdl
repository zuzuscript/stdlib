			}
		}
		p {
			- "The "
			code id=the-ruby-element:the-ruby-element {
				a href="#the-ruby-element" ruby
			}
			- " element allows one or more spans of phrasing content to be marked with ruby annotations. Ruby annotations are short runs of text presented alongside base text, primarily used in East Asian typography as a guide for pronunciation or to include other annotations. In Japanese, this form of typography is also known as "
			i furigana
			- .
		}
		p {
			- "The content model of "
			code id=the-ruby-element:the-ruby-element-2 {
				a href="#the-ruby-element" ruby
			}
			- " elements consists of one or more of the following sequences:"
		}
		ol {
			li {
				p "One or the other of the following:"
				ul {
					li {
						p {
							a href="#phrasing-content-2" id=the-ruby-element:phrasing-content-2-3 "Phrasing content"
							- ", but with no "
							code id=the-ruby-element:the-ruby-element-3 {
								a href="#the-ruby-element" ruby
							}
							- " elements and with no "
							code id=the-ruby-element:the-ruby-element-4 {
								a href="#the-ruby-element" ruby
							}
							- " element descendants"
						}
					}
					li {
						p {
							- "A single "
							code id=the-ruby-element:the-ruby-element-5 {
								a href="#the-ruby-element" ruby
							}
							- " element that itself has no "
							code id=the-ruby-element:the-ruby-element-6 {
								a href="#the-ruby-element" ruby
							}
							- " element descendants"
						}
					}
				}
			}
			li {
				p "One or the other of the following:"
				ul {
					li {
						p {
							- "One or more "
							code id=the-ruby-element:the-rt-element {
								a href="#the-rt-element" rt
							}
							- " elements"
						}
					}
					li {
						p {
							- "An "
							code id=the-ruby-element:the-rp-element {
								a href="#the-rp-element" rp
							}
							- " element followed by one or more "
							code id=the-ruby-element:the-rt-element-2 {
								a href="#the-rt-element" rt
							}
							- " elements, each of which is itself followed by an "
							code id=the-ruby-element:the-rp-element-2 {
								a href="#the-rp-element" rp
							}
							- " element"
						}
					}
				}
			}
		}
		p {
			- "The "
			code id=the-ruby-element:the-ruby-element-7 {
				a href="#the-ruby-element" ruby
			}
			- " and "
			code id=the-ruby-element:the-rt-element-3 {
				a href="#the-rt-element" rt
			}
			- " elements can be used for a variety of kinds of annotations, including in particular (though by no means limited to) those described below. For more details on Japanese Ruby in particular, and how to render Ruby for Japanese, see "
			cite "Requirements for Japanese Text Layout"
			- ". "
			a href="#refsJLREQ" "[JLREQ]"
		}
		p class=note {
			- "At the time of writing, CSS does not yet provide a way to fully control the rendering of the HTML "
			code id=the-ruby-element:the-ruby-element-8 {
				a href="#the-ruby-element" ruby
			}
			- " element. It is hoped that CSS will be extended to support the styles described below in due course."
		}
		dl {
			dt "Mono-ruby for individual base characters in Japanese "
			dd {
				p "One or more hiragana or katakana characters (the ruby annotation) are placed with each ideographic character (the base text). This is used to provide readings of kanji characters. "
				div class=example {
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- B
							c- p="" <
							c- f="" rt
							c- p="" >
							- annotation
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
				}
				div class=example {
					p "In this example, notice how each annotation corresponds to a single base character. "
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 君
							c- p="" <
							c- f="" rt
							c- p="" >
							- くん
							c- p="" "</"
							c- f="" ruby
							c- p="" ><
							c- f="" ruby
							c- p="" >
							- 子
							c- p="" <
							c- f="" rt
							c- p="" >
							- し
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- は
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 和
							c- p="" <
							c- f="" rt
							c- p="" >
							- わ
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- して
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 同
							c- p="" <
							c- f="" rt
							c- p="" >
							- どう
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- ぜず。
						}
					}
					p lang=ja {
						ruby {
							- 君
							rt くん
						}
						ruby {
							- 子
							rt し
						}
						- は
						ruby {
							- 和
							rt わ
						}
						- して
						ruby {
							- 同
							rt どう
						}
						- "ぜず。 "
					}
					p {
						- "This example can also be written as follows, using one "
						code id=the-ruby-element:the-ruby-element-9 {
							a href="#the-ruby-element" ruby
						}
						- " element with two segments of base text and two annotations (one for each) rather than two back-to-back "
						code id=the-ruby-element:the-ruby-element-10 {
							a href="#the-ruby-element" ruby
						}
						- " elements each with one base text segment and annotation (as in the markup above): "
					}
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 君
							c- p="" <
							c- f="" rt
							c- p="" >
							- くん
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 子
							c- p="" <
							c- f="" rt
							c- p="" >
							- し
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- は
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 和
							c- p="" <
							c- f="" rt
							c- p="" >
							- わ
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- して
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 同
							c- p="" <
							c- f="" rt
							c- p="" >
							- どう
							c- p="" "</"
							c- f="" ruby
							c- p="" >
							- ぜず。
						}
					}
				}
			}
			dt "Mono-ruby for compound words (jukugo) "
			dd {
				p "This is similar to the previous case: each ideographic character in the compound word (the base text) has its reading given in hiragana or katakana characters (the ruby annotation). The difference is that the base text segments form a compound word rather than being separate from each other. "
				div class=example {
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- B
							c- p="" <
							c- f="" rt
							c- p="" >
							- annotation
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- B
							c- p="" <
							c- f="" rt
							c- p="" >
							- annotation
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
				}
				div class=example {
					p {
						- "In this example, notice again how each annotation corresponds to a single base character. In this example, each compound word (jukugo) corresponds to a single "
						code id=the-ruby-element:the-ruby-element-11 {
							a href="#the-ruby-element" ruby
						}
						- " element."
					}
					p "The rendering here is expected to be that each annotation be placed over (or next to, in vertical text) the corresponding base character, with the annotations not overhanging any of the adjacent characters."
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 鬼
							c- p="" <
							c- f="" rt
							c- p="" >
							- き
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 門
							c- p="" <
							c- f="" rt
							c- p="" >
							- もん
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- の
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 方
							c- p="" <
							c- f="" rt
							c- p="" >
							- ほう
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 角
							c- p="" <
							c- f="" rt
							c- p="" >
							- がく
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- を
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 凝
							c- p="" <
							c- f="" rt
							c- p="" >
							- ぎょう
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 視
							c- p="" <
							c- f="" rt
							c- p="" >
							- し
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- する
						}
					}
					p lang=ja {
						ruby {
							- 鬼
							rt き
							- 門
							rt もん
						}
						- の
						ruby {
							- 方
							rt ほう
							- 角
							rt がく
						}
						- を
						ruby {
							- 凝
							rt ぎょう
							- 視
							rt し
						}
						- "する "
					}
				}
			}
			dt "Jukugo-ruby "
			dd {
				p "This is semantically identical to the previous case (each individual ideographic character in the base compound word has its reading given in an annotation in hiragana or katakana characters), but the rendering is the more complicated Jukugo Ruby rendering. "
				div class=example {
					p "This is the same example as above for mono-ruby for compound words. The different rendering is expected to be achieved using different styling (e.g. in CSS), and is not shown here."
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 鬼
							c- p="" <
							c- f="" rt
							c- p="" >
							- き
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 門
							c- p="" <
							c- f="" rt
							c- p="" >
							- もん
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- の
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 方
							c- p="" <
							c- f="" rt
							c- p="" >
							- ほう
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 角
							c- p="" <
							c- f="" rt
							c- p="" >
							- がく
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- を
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 凝
							c- p="" <
							c- f="" rt
							c- p="" >
							- ぎょう
							c- p="" "</"
							c- f="" rt
							c- p="" >
							- 視
							c- p="" <
							c- f="" rt
							c- p="" >
							- し
							c- p="" "</"
							c- f="" rt
							c- p="" "></"
							c- f="" ruby
							c- p="" >
							- する
						}
					}
				}
				p class=note {
					- "For more details on "
					a href="https://www.w3.org/TR/jlreq/#positioning_of_jukugoruby" "Jukugo Ruby rendering"
					- ", see Appendix F in the "
					cite "Requirements for Japanese Text Layout"
					- ". "
					a href="#refsJLREQ" "[JLREQ]"
				}
			}
			dt "Group ruby for describing meanings "
			dd {
				p "The annotation describes the meaning of the base text, rather than (or in addition to) the pronunciation. As such, both the base text and the annotation can be multiple characters long. "
				div class=example {
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- BASE
							c- p="" <
							c- f="" rt
							c- p="" >
							- annotation
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
				}
				div class=example {
					p "Here a compound ideographic word has its corresponding katakana given as an annotation. "
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 境界面
							c- p="" <
							c- f="" rt
							c- p="" >
							- インターフェース
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
					p lang=ja {
						ruby {
							- 境界面
							rt インターフェース
						}
					}
				}
				div class=example {
					p "Here a compound ideographic word has its translation in English provided as an annotation. "
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- e="" lang
							c- o="" "="
							c- s="" "\"ja\""
							c- p="" >
							- 編集者
							c- p="" <
							c- f="" rt
							c- e="" lang
							c- o="" "="
							c- s="" "\"en\""
							c- p="" >
							- editor
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
					p {
						ruby lang=ja {
							- 編集者
							rt lang=en editor
						}
					}
				}
			}
			dt "Group ruby for Jukuji readings "
			dd {
				p "A phonetic reading that corresponds to multiple base characters, because a one-to-one mapping would be difficult. (In English, the words \"Colonel\" and \"Lieutenant\" are examples of words where a direct mapping of pronunciation to individual letters is, in some dialects, rather unclear.) "
				div class=example {
					p "In this example, the name of a species of flowers has a phonetic reading provided using group ruby: "
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- 紫陽花
							c- p="" <
							c- f="" rt
							c- p="" >
							- あじさい
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
					p lang=ja {
						ruby {
							- 紫陽花
							rt あじさい
						}
					}
				}
			}
			dt "Text with both phonetic and semantic annotations (double-sided ruby) "
			dd {
				p "Sometimes, ruby styles described above are combined. "
				p "If this results in two annotations covering the same single base segment, then the annotations can just be placed back to back. "
				div class=example {
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- BASE
							c- p="" <
							c- f="" rt
							c- p="" >
							- "annotation 1"
							c- p="" <
							c- f="" rt
							c- p="" >
							- "annotation 2"
							c- p="" "</"
							c- f="" ruby
							c- p="" >
						}
					}
				}
				div class=example {
					pre {
						code class=html {
							c- p="" <
							c- f="" ruby
							c- p="" >
							- B
							c- p="" <
							c- f="" rt
							c- p="" >
							- a
