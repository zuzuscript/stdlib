					}
					li {
						p {
							- "Switch the "
							a href="#insertion-mode" id=parsing-main-inhead:insertion-mode-5 "insertion mode"
							- " to \""
							a href="#parsing-main-incdata" id=parsing-main-inhead:parsing-main-incdata text
							- "\"."
						}
					}
				}
			}
			dt "An end tag whose tag name is \"head\""
			dd {
				p {
					- "Pop the "
					a href="#current-node" id=parsing-main-inhead:current-node-4 "current node"
					- " (which will be the "
					code id=parsing-main-inhead:the-head-element {
						a href="#the-head-element" head
					}
					- " element) off the "
