/* Besides this comment, this document is *identical* to html-standard.kdl,
   except it uses a more compact encoding allowed by XiK:
   whitespace caused by linebreaks in the original HTML is compacted to a single space,
   and single child text nodes are pulled up into a final string attribute.

   It should hopefully be useful as a large-document comparison point,
   being about 3/4 the filesize of html-standard.kdl
*/
html lang=en-US-x-hixie {
	head {
		meta charset=utf-8
		meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name=viewport
		title "HTML Standard"
		meta content="#3c790a" name=theme-color
		meta content="light dark" name=color-scheme
		link crossorigin="" href="https://resources.whatwg.org/standard-shared-with-dev.css" rel=stylesheet
		link crossorigin="" href="https://resources.whatwg.org/standard.css" rel=stylesheet
		link crossorigin="" href="https://resources.whatwg.org/spec.css" rel=stylesheet
		link crossorigin="" href="https://resources.whatwg.org/logo.svg" rel=icon
		link crossorigin="" href="/styles.css" rel=stylesheet
		script " function toggleStatus(div) { div.parentNode.classList.toggle('wrapped'); } function setLinkFragment(link) { link.hash = location.hash; } "
	}
	body class=dfnEnabled {
		script crossorigin="" defer="" src="/html-dfn.js"
		script crossorigin="" defer="" src="https://resources.whatwg.org/commit-snapshot-shortcut-key.js"
		header class="head with-buttons" id=head {
			a class=logo href="https://whatwg.org/" {
				img alt=WHATWG class=darkmode-aware crossorigin="" height="100" src="https://resources.whatwg.org/logo.svg" width="100"
			}
			hgroup {
				h1 class=allcaps HTML
				p id=living-standard {
					- "Living Standard — Last Updated "
					span class=pubdate "17 January 2025"
				}
			}
			nav {
				div {
					a href="/" {
						span {
							strong "One-Page Version"
							code html.spec.whatwg.org
						}
					}
					a href="/multipage/" id=multipage-link onclick="setLinkFragment(this);" {
						span {
							strong "Multipage Version"
							code "/multipage"
						}
					}
					a href="/dev/" onclick="setLinkFragment(this);" {
						span {
							strong "Version for Web Devs"
							code "/dev"
						}
					}
					a href="/print.pdf" {
						span {
							strong "PDF Version"
							code "/print.pdf"
						}
					}
					a href="https://github.com/whatwg/html/wiki/Translations" {
						span {
							strong Translations
							code "日本語 • 简体中文"
						}
					}
				}
				div {
					a class=misc href="https://github.com/whatwg/html/blob/main/FAQ.md" {
						span {
							strong FAQ
							code "on GitHub"
						}
					}
					a class=comms href="https://whatwg.org/chat" {
						span {
							strong Chat
							code "on Matrix"
						}
					}
				}
				div {
					a class=changes href="https://github.com/whatwg/html" {
						span {
							strong "Contribute on GitHub"
							code "whatwg/html repository"
						}
					}
					a class=changes href="https://github.com/whatwg/html/commits" {
						span {
							strong Commits
							code "on GitHub"
						}
					}
					a class=changes href="/commit-snapshots/90720ff35cbb975be4d591d4ecd2b89d2bd8fc68/" id=commit-snapshot-link title="You can also press the 'y' key" {
						span {
							strong Snapshot
							code "as of this commit"
						}
					}
					a class=changes href="https://twitter.com/htmlstandard" {
						span {
							strong "Twitter Updates"
							code @htmlstandard
						}
					}
				}
				div {
					a class=feedback href="https://github.com/whatwg/html/issues" {
						span {
							strong "Open Issues"
							code "filed on GitHub"
						}
					}
					a class=feedback href="https://whatwg.org/newbug" {
						span {
							strong "Open an Issue"
							code "whatwg.org/newbug"
						}
					}
					a class=feedback href="https://github.com/web-platform-tests/wpt/tree/master/html" {
						span {
							strong Tests
							code "web-platform-tests html/"
						}
					}
					a class=feedback href="https://github.com/web-platform-tests/wpt/labels/html" {
						span {
							strong "Issues for Tests"
							code "ongoing work"
						}
					}
				}
			}
		}
