					- "\", "
					a data-x-internal=concept-request-initiator-type href="https://fetch.spec.whatwg.org/#request-initiator-type" id=the-video-element:concept-request-initiator-type "initiator type"
					- " is \""
					code video
					- "\", "
					a data-x-internal=concept-request-credentials-mode href="https://fetch.spec.whatwg.org/#concept-request-credentials-mode" id=the-video-element:concept-request-credentials-mode "credentials mode"
					- " is \""
