					}
				}
				tr {
					td colspan="4" {
						- "\""
						dfn data-dfn-for="button/autocomplete,fieldset/autocomplete,input/autocomplete,object/autocomplete,output/autocomplete,select/autocomplete,textarea/autocomplete" data-dfn-type=attr-value id=attr-fe-autocomplete-new-password {
							code new-password
						}
						- "\" "
					}
					td "A new password (e.g. when creating an account or changing a password) "
					td "Free-form text, no newlines "
