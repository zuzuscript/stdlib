					- "'s "
					a href="#navigation-entry-list" id=the-history-entry-list:navigation-entry-list-2 "entry list"
					- "'s "
					a data-x-internal=list-size href="https://infra.spec.whatwg.org/#list-size" id=the-history-entry-list:list-size size
					- " − 1, then return false."
				}
			}
			li {
				p "Return true."
			}
		}
		h5 id=navigation-api-initiating-navigations {
