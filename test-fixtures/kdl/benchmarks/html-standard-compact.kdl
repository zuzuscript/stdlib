					- "\", and reprocess the token."
				}
			}
			dt "A start tag whose tag name is one of: \"td\", \"th\""
			dd {
				p {
					- "Pop the "
					a href="#current-template-insertion-mode" id=parsing-main-intemplate:current-template-insertion-mode-7 "current template insertion mode"
