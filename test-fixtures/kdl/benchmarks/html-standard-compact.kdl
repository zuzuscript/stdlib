			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=space-separated-tokens:space-characters "ASCII whitespace"
			- ", where words consist of any string of one or more characters, none of which are "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=space-separated-tokens:space-characters-2 "ASCII whitespace"
			- .
		}
		p {
			- "A string containing a "
			a href="#set-of-space-separated-tokens" id=space-separated-tokens:set-of-space-separated-tokens "set of space-separated tokens"
			- " may have leading or trailing "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=space-separated-tokens:space-characters-3 "ASCII whitespace"
			- .
		}
		p {
			- "An "
			dfn data-export="" id=unordered-set-of-unique-space-separated-tokens "unordered set of unique space-separated tokens"
			- " is a "
			a href="#set-of-space-separated-tokens" id=space-separated-tokens:set-of-space-separated-tokens-2 "set of space-separated tokens"
			- " where none of the tokens are duplicated."
