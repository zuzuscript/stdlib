						span "5+"
					}
					span class="chrome_android unknown" {
						span "Chrome Android"
						span ?
					}
					span class="webview_android unknown" {
						span "WebView Android"
						span ?
					}
					span class="samsunginternet_android unknown" {
						span "Samsung Internet"
						span ?
					}
					span class="opera_android unknown" {
						span "Opera Android"
						span ?
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-autocapitalize {
				code autocapitalize
			}
			- " attribute is an "
			a href="#enumerated-attribute" id=autocapitalization:enumerated-attribute "enumerated attribute"
			- " whose states are the possible "
			a href="#autocapitalization-hint" id=autocapitalization:autocapitalization-hint "autocapitalization hints"
			- ". The "
			a href="#autocapitalization-hint" id=autocapitalization:autocapitalization-hint-2 "autocapitalization hint"
			- " specified by the attribute's state combines with other considerations to form the "
			a href="#used-autocapitalization-hint" id=autocapitalization:used-autocapitalization-hint-2 "used autocapitalization hint"
			- ", which informs the behavior of the user agent. The keywords for this attribute and their state mappings are as follows:"
		}
		table {
			thead {
				tr {
					th " Keyword "
					th " State "
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-off {
							code off
						}
					}
					td rowspan="2" {
						a href="#autocap-hint-none" id=autocapitalization:autocap-hint-none none
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-none {
							code none
						}
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-on {
							code on
						}
					}
					td rowspan="2" {
						a href="#autocap-hint-sentences" id=autocapitalization:autocap-hint-sentences sentences
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-sentences {
							code sentences
						}
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-words {
							code words
						}
					}
					td {
						a href="#autocap-hint-words" id=autocapitalization:autocap-hint-words words
					}
				}
				tr {
					td {
						dfn data-dfn-for="html-global/autocapitalize" data-dfn-type=attr-value id=attr-autocapitalize-characters {
							code characters
						}
					}
					td {
						a href="#autocap-hint-characters" id=autocapitalization:autocap-hint-characters characters
					}
				}
			}
		}
		p {
			- "The attribute's "
			i id=autocapitalization:missing-value-default {
				a href="#missing-value-default" "missing value default"
			}
			- " is the "
			a href="#autocap-hint-default" id=autocapitalization:autocap-hint-default default
			- " state, and its "
			i id=autocapitalization:invalid-value-default {
				a href="#invalid-value-default" "invalid value default"
			}
			- " is the "
			a href="#autocap-hint-sentences" id=autocapitalization:autocap-hint-sentences-2 sentences
			- " state. "
		}
		dl class=domintro {
			dt {
				code {
					var element
					- .
					a href="#dom-autocapitalize" id=dom-autocapitalize-dev autocapitalize
					- " [ = "
					var value
					- " ]"
				}
			}
			dd {
				p {
					- "Returns the current autocapitalization state for the element, or an empty string if it hasn't been set. Note that for "
					code id=autocapitalization:the-input-element-3 {
						a href="#the-input-element" input
					}
					- " and "
					code id=autocapitalization:the-textarea-element-2 {
						a href="#the-textarea-element" textarea
					}
					- " elements that inherit their state from a "
					code id=autocapitalization:the-form-element-3 {
						a href="#the-form-element" form
					}
					- " element, this will return the autocapitalization state of the "
					code id=autocapitalization:the-form-element-4 {
						a href="#the-form-element" form
					}
					- " element, but for an element in an editable region, this will not return the autocapitalization state of the editing host (unless this element is, in fact, the "
					a href="#editing-host" id=autocapitalization:editing-host-2 "editing host"
					- ")."
				}
				p {
					- "Can be set, to set the "
					code id=autocapitalization:attr-autocapitalize-5 {
						a href="#attr-autocapitalize" autocapitalize
					}
					- " content attribute (and thereby change the autocapitalization behavior for the element)."
				}
			}
		}
		p {
			- "To compute the "
			dfn id=own-autocapitalization-hint "own autocapitalization hint"
			- " of an element "
			var element
			- ", run the following steps:"
		}
		ol {
			li {
				p {
					- "If the "
					code id=autocapitalization:attr-autocapitalize-6 {
						a href="#attr-autocapitalize" autocapitalize
					}
					- " content attribute is present on "
					var element
					- ", and its value is not the empty string, return the state of the attribute."
				}
			}
			li {
				p {
					- "If "
					var element
					- " is an "
					a href="#category-autocapitalize" id=autocapitalization:category-autocapitalize-2 "autocapitalize-and-autocorrect inheriting element"
					- " and has a non-null "
					a href="#form-owner" id=autocapitalization:form-owner "form owner"
					- ", return the "
					a href="#own-autocapitalization-hint" id=autocapitalization:own-autocapitalization-hint "own autocapitalization hint"
					- " of "
					var element
					- "'s "
					a href="#form-owner" id=autocapitalization:form-owner-2 "form owner"
					- .
				}
			}
			li {
				p {
					- "Return "
					a href="#autocap-hint-default" id=autocapitalization:autocap-hint-default-2 default
					- .
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLElement data-dfn-type=attribute id=dom-autocapitalize {
				code autocapitalize
			}
			- " getter steps are to:"
		}
		ol {
			li {
				p {
					- "Let "
					var state
					- " be the "
					a href="#own-autocapitalization-hint" id=autocapitalization:own-autocapitalization-hint-2 "own autocapitalization hint"
					- " of "
					a data-x-internal=this href="https://webidl.spec.whatwg.org/#this" id=autocapitalization:this this
					- .
				}
			}
			li {
				p {
					- "If "
					var state
					- " is "
					a href="#autocap-hint-default" id=autocapitalization:autocap-hint-default-3 default
					- ", then return the empty string."
				}
			}
			li {
				p {
					- "If "
					var state
					- " is "
					a href="#autocap-hint-none" id=autocapitalization:autocap-hint-none-2 none
					- ", then return \""
					code id=autocapitalization:attr-autocapitalize-none {
						a href="#attr-autocapitalize-none" none
					}
					- "\"."
				}
			}
			li {
				p {
					- "If "
					var state
					- " is "
					a href="#autocap-hint-sentences" id=autocapitalization:autocap-hint-sentences-3 sentences
					- ", then return \""
					code id=autocapitalization:attr-autocapitalize-sentences {
						a href="#attr-autocapitalize-sentences" sentences
					}
					- "\"."
				}
			}
			li {
				p {
					- "Return the keyword value corresponding to "
					var state
					- .
				}
			}
		}
		p {
			- "The "
			code id=autocapitalization:dom-autocapitalize {
				a href="#dom-autocapitalize" autocapitalize
			}
			- " setter steps are to set the "
			code id=autocapitalization:attr-autocapitalize-7 {
				a href="#attr-autocapitalize" autocapitalize
			}
			- " content attribute to the given value."
		}
		hr
		p {
			- "User agents that support customizable autocapitalization behavior for a text input method and wish to allow web developers to control this functionality should, during text input into an element, compute the "
			dfn id=used-autocapitalization-hint "used autocapitalization hint"
			- " for the element. This will be an "
			a href="#autocapitalization-hint" id=autocapitalization:autocapitalization-hint-3 "autocapitalization hint"
			- " that describes the recommended autocapitalization behavior for text input into the element."
		}
		p {
			- "User agents or input methods may choose to ignore or override the "
			a href="#used-autocapitalization-hint" id=autocapitalization:used-autocapitalization-hint-3 "used autocapitalization hint"
			- " in certain circumstances."
		}
		p {
			- "The "
			a href="#used-autocapitalization-hint" id=autocapitalization:used-autocapitalization-hint-4 "used autocapitalization hint"
			- " for an element "
			var element
			- " is computed using the following algorithm:"
		}
		ol {
			li {
				p {
					- "If "
					var element
					- " is an "
					code id=autocapitalization:the-input-element-4 {
						a href="#the-input-element" input
					}
					- " element whose "
					code id=autocapitalization:attr-input-type-2 {
						a href="#attr-input-type" type
					}
					- " attribute is in one of the "
					a href="#url-state-(type=url)" id="autocapitalization:url-state-(type=url)-2" URL
					- ", "
					a href="#email-state-(type=email)" id="autocapitalization:email-state-(type=email)-2" Email
					- ", or "
					a href="#password-state-(type=password)" id="autocapitalization:password-state-(type=password)-2" Password
					- " states, then return "
					a href="#autocap-hint-default" id=autocapitalization:autocap-hint-default-4 default
					- .
				}
			}
			li {
				p {
					- "If "
					var element
					- " is an "
					code id=autocapitalization:the-input-element-5 {
						a href="#the-input-element" input
					}
					- " element or a "
					code id=autocapitalization:the-textarea-element-3 {
						a href="#the-textarea-element" textarea
					}
					- " element, then return "
					var element
					- "'s "
					a href="#own-autocapitalization-hint" id=autocapitalization:own-autocapitalization-hint-3 "own autocapitalization hint"
					- .
				}
			}
			li {
				p {
					- "If "
					var element
					- " is an "
					a href="#editing-host" id=autocapitalization:editing-host-3 "editing host"
					- " or an "
					a data-x-internal=editable href="https://w3c.github.io/editing/docs/execCommand/#editable" id=autocapitalization:editable editable
					- " element, then return the "
					a href="#own-autocapitalization-hint" id=autocapitalization:own-autocapitalization-hint-4 "own autocapitalization hint"
					- " of the "
					a data-x-internal=editing-host-of href="https://w3c.github.io/editing/docs/execCommand/#editing-host-of" id=autocapitalization:editing-host-of "editing host of"
					var element
					- .
				}
			}
			li {
				p {
					a data-x-internal=assert href="https://infra.spec.whatwg.org/#assert" id=autocapitalization:assert Assert
					- ": this step is never reached, since text input only occurs in elements that meet one of the above criteria."
				}
			}
		}
		h4 id=autocorrection {
			span class=secno "6.8.8"
			- " Autocorrection"
			a class=self-link href="#autocorrection"
		}
		p {
			- "Some methods of entering text assist users by automatically correcting misspelled words while typing, a process also known as autocorrection. User agents can support autocorrection of editable text, either in form controls (such as the value of "
			code id=autocorrection:the-textarea-element {
				a href="#the-textarea-element" textarea
			}
			- " elements), or in elements in an "
			a href="#editing-host" id=autocorrection:editing-host "editing host"
			- " (e.g., using "
			code id=autocorrection:attr-contenteditable {
				a href="#attr-contenteditable" contenteditable
			}
			- "). Autocorrection may be accompanied by user interfaces indicating that text is about to be autocorrected or has been autocorrected, and is commonly performed when inserting punctuation characters, spaces, or new paragraphs after misspelled words. The "
			code id=autocorrection:attr-autocorrect {
				a href="#attr-autocorrect" autocorrect
			}
			- " attribute allows authors to control such behavior."
		}
		p {
			- "The "
			code id=autocorrection:attr-autocorrect-2 {
				a href="#attr-autocorrect" autocorrect
			}
			- " attribute can be used on an editing host to control autocorrection behavior for the hosted editable region, on an "
			code id=autocorrection:the-input-element {
				a href="#the-input-element" input
			}
			- " or "
			code id=autocorrection:the-textarea-element-2 {
				a href="#the-textarea-element" textarea
			}
			- " element to control the behavior when inserting text into that element, or on a "
			code id=autocorrection:the-form-element {
				a href="#the-form-element" form
			}
			- " element to control the default behavior for all "
			a href="#category-autocapitalize" id=autocorrection:category-autocapitalize "autocapitalize-and-autocorrect inheriting elements"
			- " associated with the "
			code id=autocorrection:the-form-element-2 {
				a href="#the-form-element" form
			}
			- " element."
		}
		p {
			- "The "
			code id=autocorrection:attr-autocorrect-3 {
				a href="#attr-autocorrect" autocorrect
			}
			- " attribute never causes autocorrection to be enabled for "
			code id=autocorrection:the-input-element-2 {
				a href="#the-input-element" input
			}
			- " elements whose "
			code id=autocorrection:attr-input-type {
				a href="#attr-input-type" type
			}
			- " attribute is in one of the "
			a href="#url-state-(type=url)" id="autocorrection:url-state-(type=url)" URL
			- ", "
			a href="#email-state-(type=email)" id="autocorrection:email-state-(type=email)" E-mail
			- ", or "
			a href="#password-state-(type=password)" id="autocorrection:password-state-(type=password)" Password
			- " states. (This behavior is included in the "
			a href="#used-autocorrection-state" id=autocorrection:used-autocorrection-state "used autocorrection state"
			- " algorithm below.)"
		}
		p {
			- "The "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-autocorrect {
				code autocorrect
			}
			- " attribute is an enumerated attribute with the following keywords and states:"
