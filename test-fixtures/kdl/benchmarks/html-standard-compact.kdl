					c- t="" 'closed'
					c- p="" "});"
					- " shadowRoot"
					c- p="" .
					- "innerHTML "
					c- o="" "="
					c- sb="" `<style>
					c- sb="" " :host::before {"
					c- sb="" " content: '[ ]';"
					c- sb="" " white-space: pre;"
					c- sb="" " font-family: monospace;"
					c- sb="" " }"
					c- sb="" " :host(:state(checked))::before { content: '[x]' }"
					c- sb="" " </style>"
					c- sb="" " <slot>Label</slot>`"
					c- p="" ";"
					c- p="" "}"
					- " get checked"
					c- p="" "()"
					c- p="" "{"
					c- k="" return
					c- k="" this
					c- p="" .
					- _internals
					c- p="" .
					- states
					c- p="" .
					- has
					c- p="" "("
