			dd {
				a href="#reconsume" id=script-data-double-escaped-less-than-sign-state:reconsume Reconsume
				- " in the "
				a href="#script-data-double-escaped-state" id=script-data-double-escaped-less-than-sign-state:script-data-double-escaped-state "script data double escaped state"
				- .
