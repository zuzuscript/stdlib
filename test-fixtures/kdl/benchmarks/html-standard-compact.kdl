										p {
											a href="#insert-an-element-at-the-adjusted-insertion-location" id=parsing-main-inhead:insert-an-element-at-the-adjusted-insertion-location-2 "Insert an element at the adjusted insertion location"
											- " with "
											var template
											- .
										}
									}
									li {
										p "The user agent may report an error to the developer console."
									}
									li {
										p Return.
									}
								}
							}
							li {
								p {
									- "Let "
									var shadow
									- " be "
									var "declarative shadow host element"
									- "'s "
									a data-x-internal=concept-element-shadow-root href="https://dom.spec.whatwg.org/#concept-element-shadow-root" id=parsing-main-inhead:concept-element-shadow-root "shadow root"
									- .
								}
							}
							li {
								p {
									- "Set "
									var shadow
									- "'s "
									a data-x-internal=concept-shadow-root-declarative href="https://dom.spec.whatwg.org/#shadowroot-declarative" id=parsing-main-inhead:concept-shadow-root-declarative declarative
									- " to true."
								}
							}
							li {
								p {
									- "Set "
									a href="#the-template-element" id=parsing-main-inhead:the-template-element template
									- "'s "
									a href="#template-contents" id=parsing-main-inhead:template-contents "template contents"
									- " property to "
									var shadow
									- .
								}
							}
							li {
								p {
									- "Set "
									var shadow
									- "'s "
									a data-x-internal=available-to-element-internals href="https://dom.spec.whatwg.org/#shadowroot-available-to-element-internals" id=parsing-main-inhead:available-to-element-internals "available to element internals"
									- " to true."
