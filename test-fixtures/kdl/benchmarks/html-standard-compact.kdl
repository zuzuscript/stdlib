				- " element) containing an address with two street components:"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" address
					c- e="" itemscope
					c- e="" itemtype
					c- o="" "="
					c- s="" "\"http://microformats.org/profile/hcard\""
					c- p="" >
					c- p="" <
					c- f="" strong
					c- e="" itemprop
