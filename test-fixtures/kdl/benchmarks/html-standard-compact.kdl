			dt "Anything else"
			dd {
				- "This is an "
				a href="#parse-error-absence-of-digits-in-numeric-character-reference" id=decimal-character-reference-start-state:parse-error-absence-of-digits-in-numeric-character-reference absence-of-digits-in-numeric-character-reference
				a href="#parse-errors" id=decimal-character-reference-start-state:parse-errors "parse error"
				- ". "
