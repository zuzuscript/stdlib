		p class=note {
			- "To maintain compatibility with existing web content, user agents need to enumerate methods defined in "
			code id="2dcontext:canvasuserinterface-2" {
				a href="#canvasuserinterface" CanvasUserInterface
			}
			- " immediately after the "
			code id="2dcontext:dom-context-2d-stroke-2" {
				a href="#dom-context-2d-stroke" "stroke()"
			}
			- " method on "
			code id="2dcontext:canvasrenderingcontext2d-17" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " objects."
		}
		dl class=domintro {
			dt {
				code {
					var context
					- " = "
					var canvas
					- .
					a href="#dom-canvas-getcontext" id="2dcontext:dom-canvas-getcontext" getContext
					- "('2d' [, { [ "
					a href="#dom-canvasrenderingcontext2dsettings-alpha" id="2dcontext:dom-canvasrenderingcontext2dsettings-alpha-2" alpha
					- ": true ] [, "
					a href="#dom-canvasrenderingcontext2dsettings-desynchronized" id="2dcontext:dom-canvasrenderingcontext2dsettings-desynchronized-2" desynchronized
					- ": false ] [, "
					a href="#dom-canvasrenderingcontext2dsettings-colorspace" id="2dcontext:dom-canvasrenderingcontext2dsettings-colorspace-2" colorSpace
					- ": 'srgb'] [, "
					a href="#dom-canvasrenderingcontext2dsettings-willreadfrequently" id="2dcontext:dom-canvasrenderingcontext2dsettings-willreadfrequently-2" willReadFrequently
					- ": false ]} ])"
				}
			}
			dd {
				p {
					- "Returns a "
					code id="2dcontext:canvasrenderingcontext2d-18" {
						a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
					}
					- " object that is permanently bound to a particular "
					code id="2dcontext:the-canvas-element" {
						a href="#the-canvas-element" canvas
					}
					- " element."
				}
				p {
					- "If the "
					code id="2dcontext:dom-canvasrenderingcontext2dsettings-alpha-3" {
						a href="#dom-canvasrenderingcontext2dsettings-alpha" alpha
					}
					- " member is false, then the context is forced to always be opaque."
				}
				p {
					- "If the "
					code id="2dcontext:dom-canvasrenderingcontext2dsettings-desynchronized-3" {
						a href="#dom-canvasrenderingcontext2dsettings-desynchronized" desynchronized
					}
					- " member is true, then the context might be "
					a href="#concept-canvas-desynchronized" id="2dcontext:concept-canvas-desynchronized" desynchronized
					- .
				}
				p {
					- "The "
					code id="2dcontext:dom-canvasrenderingcontext2dsettings-colorspace-3" {
						a href="#dom-canvasrenderingcontext2dsettings-colorspace" colorSpace
					}
					- " member specifies the "
					a href="#concept-canvas-color-space" id="2dcontext:concept-canvas-color-space" "color space"
					- " of the rendering context."
				}
				p {
					- "If the "
					code id="2dcontext:dom-canvasrenderingcontext2dsettings-willreadfrequently-3" {
						a href="#dom-canvasrenderingcontext2dsettings-willreadfrequently" willReadFrequently
					}
					- " member is true, then the context is marked for "
					a href="#concept-canvas-will-read-frequently" id="2dcontext:concept-canvas-will-read-frequently" "readback optimization"
					- .
				}
			}
			dt {
				code {
					var context
					- .
					a href="#dom-context-2d-canvas" id=dom-context-2d-canvas-dev canvas
				}
				div class="mdn-anno wrapped before" {
					button class=mdn-anno-btn onclick="toggleStatus(this)" {
						b class=all-engines-flag title="Support in all current engines." ✔
						span MDN
					}
					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/CanvasRenderingContext2D/canvas" title="The CanvasRenderingContext2D.canvas property, part of the Canvas API, is a read-only reference to the HTMLCanvasElement object that is associated with a given context. It might be null if there is no associated <canvas> element." "CanvasRenderingContext2D/canvas"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "1.5+"
							}
							span class="safari yes" {
								span Safari
								span "3+"
							}
							span class="chrome yes" {
								span Chrome
								span "1+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "12.1+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "1+"
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android unknown" {
								span "WebView Android"
								span ?
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p {
					- "Returns the "
					code id="2dcontext:the-canvas-element-2" {
						a href="#the-canvas-element" canvas
					}
					- " element."
				}
			}
			dt {
				code {
					var attributes
					- " = "
					var context
					- .
					a href="#dom-context-2d-canvas-getcontextattributes" id="2dcontext:dom-context-2d-canvas-getcontextattributes-2" getContextAttributes
					- "()"
				}
			}
			dd {
				p "Returns an object whose:"
				ul {
					li {
						code id="2dcontext:concept-canvas-alpha" {
							a href="#concept-canvas-alpha" alpha
						}
						- " member is true if the context has an alpha channel, or false if it was forced to be opaque."
					}
					li {
						code id="2dcontext:dom-canvasrenderingcontext2dsettings-desynchronized-4" {
							a href="#dom-canvasrenderingcontext2dsettings-desynchronized" desynchronized
						}
						- " member is true if the context can be "
						a href="#concept-canvas-desynchronized" id="2dcontext:concept-canvas-desynchronized-2" desynchronized
						- .
					}
					li {
						code id="2dcontext:dom-canvasrenderingcontext2dsettings-colorspace-4" {
							a href="#dom-canvasrenderingcontext2dsettings-colorspace" colorSpace
						}
						- " member is a string indicating the context's "
						a href="#concept-canvas-color-space" id="2dcontext:concept-canvas-color-space-2" "color space"
						- .
					}
					li {
						code id="2dcontext:dom-canvasrenderingcontext2dsettings-willreadfrequently-4" {
							a href="#dom-canvasrenderingcontext2dsettings-willreadfrequently" willReadFrequently
						}
						- " member is true if the context is marked for "
						a href="#concept-canvas-will-read-frequently" id="2dcontext:concept-canvas-will-read-frequently-2" "readback optimization"
						- .
					}
				}
			}
		}
		p {
			- "A "
			code id="2dcontext:canvasrenderingcontext2d-19" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object has an "
			dfn id=output-bitmap "output bitmap"
			- " that is initialized when the object is created."
		}
		p {
			- "The "
			a href="#output-bitmap" id="2dcontext:output-bitmap" "output bitmap"
			- " has an "
			a href="#concept-canvas-origin-clean" id="2dcontext:concept-canvas-origin-clean" origin-clean
			- " flag, which can be set to true or false. Initially, when one of these bitmaps is created, its "
			a href="#concept-canvas-origin-clean" id="2dcontext:concept-canvas-origin-clean-2" origin-clean
			- " flag must be set to true."
		}
		p {
			- "The "
			code id="2dcontext:canvasrenderingcontext2d-20" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object also has an "
			dfn id=concept-canvas-alpha alpha
			- " boolean. When a "
			code id="2dcontext:canvasrenderingcontext2d-21" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object's "
			a href="#concept-canvas-alpha" id="2dcontext:concept-canvas-alpha-2" alpha
			- " is false, then its alpha channel must be fixed to 1.0 (fully opaque) for all pixels, and attempts to change the alpha component of any pixel must be silently ignored."
		}
		p class=note {
			- "Thus, the bitmap of such a context starts off as "
			a data-x-internal=opaque-black href="https://drafts.csswg.org/css-color/#opaque-black" id="2dcontext:opaque-black" "opaque black"
			- " instead of "
			a data-x-internal=transparent-black href="https://drafts.csswg.org/css-color/#transparent-black" id="2dcontext:transparent-black-2" "transparent black"
			- "; "
			code id="2dcontext:dom-context-2d-clearrect-2" {
				a href="#dom-context-2d-clearrect" "clearRect()"
			}
			- " always results in "
			a data-x-internal=opaque-black href="https://drafts.csswg.org/css-color/#opaque-black" id="2dcontext:opaque-black-2" "opaque black"
			- " pixels, every fourth byte from "
			code id="2dcontext:dom-context-2d-getimagedata-2" {
				a href="#dom-context-2d-getimagedata" "getImageData()"
			}
			- " is always 255, the "
			code id="2dcontext:dom-context-2d-putimagedata-3" {
				a href="#dom-context-2d-putimagedata" "putImageData()"
			}
			- " method effectively ignores every fourth byte in its input, and so on. However, the alpha component of styles and images drawn onto the canvas are still honoured up to the point where they would impact the "
			a href="#output-bitmap" id="2dcontext:output-bitmap-2" "output bitmap"
			- "'s alpha channel; for instance, drawing a 50% transparent white square on a freshly created "
			a href="#output-bitmap" id="2dcontext:output-bitmap-3" "output bitmap"
			- " with its "
			a href="#concept-canvas-alpha" id="2dcontext:concept-canvas-alpha-3" alpha
			- " set to false will result in a fully-opaque gray square."
		}
		p {
			- "The "
			code id="2dcontext:canvasrenderingcontext2d-22" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object also has a "
			dfn id=concept-canvas-desynchronized desynchronized
			- " boolean. When a "
			code id="2dcontext:canvasrenderingcontext2d-23" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object's "
			a href="#concept-canvas-desynchronized" id="2dcontext:concept-canvas-desynchronized-3" desynchronized
			- " is true, then the user agent may optimize the rendering of the canvas to reduce the latency, as measured from input events to rasterization, by desynchronizing the canvas paint cycle from the event loop, bypassing the ordinary user agent rendering algorithm, or both. Insofar as this mode involves bypassing the usual paint mechanisms, rasterization, or both, it might introduce visible tearing artifacts."
		}
		p class=note {
			- "The user agent usually renders on a buffer which is not being displayed, quickly swapping it and the one being scanned out for presentation; the former buffer is called back buffer and the latter "
			i "front buffer"
			- ". A popular technique for reducing latency is called front buffer rendering, also known as "
			i "single buffer"
			- " rendering, where rendering happens in parallel and racily with the scanning out process. This technique reduces the latency at the price of potentially introducing tearing artifacts and can be used to implement in total or part of the "
			a href="#concept-canvas-desynchronized" id="2dcontext:concept-canvas-desynchronized-4" desynchronized
			- " boolean. "
			a href="#refsMULTIPLEBUFFERING" "[MULTIPLEBUFFERING]"
		}
		p class=note {
			- "The "
			a href="#concept-canvas-desynchronized" id="2dcontext:concept-canvas-desynchronized-5" desynchronized
			- " boolean can be useful when implementing certain kinds of applications, such as drawing applications, where the latency between input and rasterization is critical."
		}
		p {
			- "The "
			code id="2dcontext:canvasrenderingcontext2d-24" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object also has a "
			dfn id=concept-canvas-will-read-frequently "will read frequently"
			- " boolean. When a "
			code id="2dcontext:canvasrenderingcontext2d-25" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object's "
			a href="#concept-canvas-will-read-frequently" id="2dcontext:concept-canvas-will-read-frequently-3" "will read frequently"
			- " is true, the user agent may optimize the canvas for readback operations."
		}
		p class=note {
			- "On most devices the user agent needs to decide whether to store the canvas's "
			a href="#output-bitmap" id="2dcontext:output-bitmap-4" "output bitmap"
			- " on the GPU (this is also called \"hardware accelerated\"), or on the CPU (also called \"software\"). Most rendering operations are more performant for accelerated canvases, with the major exception being readback with "
			code id="2dcontext:dom-context-2d-getimagedata-3" {
				a href="#dom-context-2d-getimagedata" "getImageData()"
			}
			- ", "
			code id="2dcontext:dom-canvas-todataurl" {
				a href="#dom-canvas-todataurl" "toDataURL()"
			}
			- ", or "
			code id="2dcontext:dom-canvas-toblob" {
				a href="#dom-canvas-toblob" "toBlob()"
			}
			- ". "
			code id="2dcontext:canvasrenderingcontext2d-26" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " objects with "
			a href="#concept-canvas-will-read-frequently" id="2dcontext:concept-canvas-will-read-frequently-4" "will read frequently"
			- " equal to true tell the user agent that the webpage is likely to perform many readback operations and that it is advantageous to use a software canvas."
		}
		p {
			- "The "
			code id="2dcontext:canvasrenderingcontext2d-27" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object also has a "
			dfn id=concept-canvas-color-space "color space"
			- " setting of type "
			code id="2dcontext:predefinedcolorspace-4" {
				a href="#predefinedcolorspace" PredefinedColorSpace
			}
			- ". The "
			code id="2dcontext:canvasrenderingcontext2d-28" {
				a href="#canvasrenderingcontext2d" CanvasRenderingContext2D
			}
			- " object's "
			a href="#concept-canvas-color-space" id="2dcontext:concept-canvas-color-space-3" "color space"
			- " indicates the color space for the "
			a href="#output-bitmap" id="2dcontext:output-bitmap-5" "output bitmap"
			- .
		}
		p {
			- "The "
			dfn data-dfn-for=CanvasRenderingContext2D data-dfn-type=method id=dom-context-2d-canvas-getcontextattributes {
				code "getContextAttributes()"
			}
			- " method steps are to return «[ \""
			code id="2dcontext:dom-canvasrenderingcontext2dsettings-alpha-4" {
				a href="#dom-canvasrenderingcontext2dsettings-alpha" alpha
			}
			- "\" → "
			a data-x-internal=this href="https://webidl.spec.whatwg.org/#this" id="2dcontext:this" this
			- "'s "
			a href="#concept-canvas-alpha" id="2dcontext:concept-canvas-alpha-4" alpha
			- ", \""
