					p {
						- "Users agents that support JavaScript must also implement the "
						cite "Dynamic Code Brand Checks"
						- " proposal. The following terms are defined there, and used in this specification: "
						a href="#refsJSDYNAMICCODEBRANDCHECKS" "[JSDYNAMICCODEBRANDCHECKS]"
					}
					ul class=brief {
						li {
							- "The "
							dfn id=js-hostensurecancompilestrings {
								a href="https://tc39.es/proposal-dynamic-code-brand-checks/#sec-hostensurecancompilestrings" HostEnsureCanCompileStrings
