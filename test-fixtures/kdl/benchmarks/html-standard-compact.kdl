					- "If "
					i "same-origin fallback flag"
					- " is set and "
					var mode
					- " is \""
					code no-cors
					- "\", set "
					var mode
					- " to \""
					code same-origin
					- "\"."
				}
			}
			li {
				p {
					- "Let "
					var credentialsMode
					- " be \""
					code include
					- "\"."
				}
			}
			li {
				p {
					- "If "
					var corsAttributeState
					- " is "
					a href="#attr-crossorigin-anonymous" id=terminology-3:attr-crossorigin-anonymous Anonymous
					- ", set "
					var credentialsMode
					- " to \""
					code same-origin
					- "\"."
				}
			}
			li {
				p {
					- "Let "
					var request
					- " be a new "
					a data-x-internal=concept-request href="https://fetch.spec.whatwg.org/#concept-request" id=terminology-3:concept-request request
					- " whose "
