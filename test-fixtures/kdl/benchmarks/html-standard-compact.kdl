			dd {
				p {
					- "Causes the element to reset and start selecting and loading a new "
					a href="#media-resource" id=loading-the-media-resource:media-resource "media resource"
					- " from scratch."
				}
			}
		}
		p {
			- "All "
			a href="#media-element" id=loading-the-media-resource:media-element "media elements"
			- " have a "
			dfn id=can-autoplay-flag "can autoplay flag"
			- ", which must begin in the true state, and a "
			dfn id=delaying-the-load-event-flag "delaying-the-load-event flag"
			- ", which must begin in the false state. While the "
			a href="#delaying-the-load-event-flag" id=loading-the-media-resource:delaying-the-load-event-flag "delaying-the-load-event flag"
			- " is true, the element must "
			a href="#delay-the-load-event" id=loading-the-media-resource:delay-the-load-event "delay the load event"
			- " of its document."
		}
		p {
			- "When the "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=method id=dom-media-load {
				code "load()"
			}
			- " method on a "
			a href="#media-element" id=loading-the-media-resource:media-element-2 "media element"
			- " is invoked, the user agent must run the "
			a href="#media-element-load-algorithm" id=loading-the-media-resource:media-element-load-algorithm "media element load algorithm"
			- .
		}
		p {
			- "A "
			a href="#media-element" id=loading-the-media-resource:media-element-3 "media element"
			- " has an associated boolean "
			dfn id=is-currently-stalled "is currently stalled"
			- ", which is initially false."
		}
		p {
			- "The "
			dfn id=media-element-load-algorithm "media element load algorithm"
			- " consists of the following steps."
		}
		ol {
			li {
				p {
					- "Set this element's "
					a href="#is-currently-stalled" id=loading-the-media-resource:is-currently-stalled "is currently stalled"
					- " to false."
				}
			}
			li {
				p {
					- "Abort any already-running instance of the "
					a href="#concept-media-load-algorithm" id=loading-the-media-resource:concept-media-load-algorithm "resource selection algorithm"
					- " for this element."
				}
			}
			li {
				p {
					- "Let "
					var "pending tasks"
					- " be a list of all "
					a href="#concept-task" id=loading-the-media-resource:concept-task tasks
					- " from the "
					a href="#media-element" id=loading-the-media-resource:media-element-4 "media element"
					- "'s "
					a href="#media-element-event-task-source" id=loading-the-media-resource:media-element-event-task-source "media element event task source"
					- " in one of the "
					a href="#task-queue" id=loading-the-media-resource:task-queue "task queues"
					- .
				}
			}
			li {
				p {
					- "For each task in "
					var "pending tasks"
					- " that would "
					a href="#resolve-pending-play-promises" id=loading-the-media-resource:resolve-pending-play-promises "resolve pending play promises"
					- " or "
					a href="#reject-pending-play-promises" id=loading-the-media-resource:reject-pending-play-promises "reject pending play promises"
					- ", immediately resolve or reject those promises in the order the corresponding tasks were queued."
				}
			}
			li {
				p {
					- "Remove each "
					a href="#concept-task" id=loading-the-media-resource:concept-task-2 task
					- " in "
					var "pending tasks"
					- " from its "
					a href="#task-queue" id=loading-the-media-resource:task-queue-2 "task queue"
					- .
				}
				p class=note "Basically, pending events and callbacks are discarded and promises in-flight to be resolved/rejected are resolved/rejected immediately when the media element starts loading a new resource."
			}
			li {
				p {
					- "If the "
					a href="#media-element" id=loading-the-media-resource:media-element-5 "media element"
					- "'s "
					code id=loading-the-media-resource:dom-media-networkstate {
						a href="#dom-media-networkstate" networkState
					}
					- " is set to "
					code id=loading-the-media-resource:dom-media-network_loading {
						a href="#dom-media-network_loading" NETWORK_LOADING
					}
					- " or "
					code id=loading-the-media-resource:dom-media-network_idle {
						a href="#dom-media-network_idle" NETWORK_IDLE
					}
					- ", "
					a href="#queue-a-media-element-task" id=loading-the-media-resource:queue-a-media-element-task "queue a media element task"
					- " given the "
					a href="#media-element" id=loading-the-media-resource:media-element-6 "media element"
					- " to "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=loading-the-media-resource:concept-event-fire "fire an event"
					- " named "
					code id=loading-the-media-resource:event-media-abort {
						a href="#event-media-abort" abort
					}
					- " at the "
					a href="#media-element" id=loading-the-media-resource:media-element-7 "media element"
					- .
				}
			}
			li {
				p {
					- "If the "
					a href="#media-element" id=loading-the-media-resource:media-element-8 "media element"
					- "'s "
					code id=loading-the-media-resource:dom-media-networkstate-2 {
						a href="#dom-media-networkstate" networkState
					}
					- " is not set to "
					code id=loading-the-media-resource:dom-media-network_empty {
						a href="#dom-media-network_empty" NETWORK_EMPTY
					}
					- ", then:"
				}
				ol {
					li {
						p {
							a href="#queue-a-media-element-task" id=loading-the-media-resource:queue-a-media-element-task-2 "Queue a media element task"
							- " given the "
							a href="#media-element" id=loading-the-media-resource:media-element-9 "media element"
							- " to "
							a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=loading-the-media-resource:concept-event-fire-2 "fire an event"
							- " named "
							code id=loading-the-media-resource:event-media-emptied {
								a href="#event-media-emptied" emptied
							}
							- " at the "
							a href="#media-element" id=loading-the-media-resource:media-element-10 "media element"
							- .
						}
					}
					li {
						p {
							- "If a fetching process is in progress for the "
							a href="#media-element" id=loading-the-media-resource:media-element-11 "media element"
							- ", the user agent should stop it."
						}
					}
					li {
						p {
							- "If the "
							a href="#media-element" id=loading-the-media-resource:media-element-12 "media element"
							- "'s "
							a href="#assigned-media-provider-object" id=loading-the-media-resource:assigned-media-provider-object "assigned media provider object"
							- " is a "
							code id=loading-the-media-resource:mediasource {
								a data-x-internal=mediasource href="https://w3c.github.io/media-source/#idl-def-mediasource" MediaSource
							}
							- " object, then "
							a data-x-internal=detaching-from-a-media-element href="https://w3c.github.io/media-source/#mediasource-detach" id=loading-the-media-resource:detaching-from-a-media-element detach
							- " it."
						}
					}
					li {
						p {
							a href="#forget-the-media-element's-media-resource-specific-tracks" id=loading-the-media-resource:forget-the-media-element's-media-resource-specific-tracks "Forget the media element's media-resource-specific tracks"
							- .
						}
					}
					li {
						p {
							- "If "
							code id=loading-the-media-resource:dom-media-readystate {
								a href="#dom-media-readystate" readyState
							}
							- " is not set to "
							code id=loading-the-media-resource:dom-media-have_nothing {
								a href="#dom-media-have_nothing" HAVE_NOTHING
							}
							- ", then set it to that state."
						}
					}
					li {
						p {
							- "If the "
							code id=loading-the-media-resource:dom-media-paused {
								a href="#dom-media-paused" paused
							}
							- " attribute is false, then:"
						}
						ol {
							li {
								p {
									- "Set the "
									code id=loading-the-media-resource:dom-media-paused-2 {
										a href="#dom-media-paused" paused
									}
									- " attribute to true."
								}
							}
							li {
								p {
									a href="#take-pending-play-promises" id=loading-the-media-resource:take-pending-play-promises "Take pending play promises"
									- " and "
									a href="#reject-pending-play-promises" id=loading-the-media-resource:reject-pending-play-promises-2 "reject pending play promises"
									- " with the result and an "
									a data-x-internal=aborterror href="https://webidl.spec.whatwg.org/#aborterror" id=loading-the-media-resource:aborterror {
										- "\""
										code AbortError
										- "\""
									}
									code id=loading-the-media-resource:domexception {
										a data-x-internal=domexception href="https://webidl.spec.whatwg.org/#dfn-DOMException" DOMException
									}
									- .
								}
							}
						}
					}
					li {
						p {
							- "If "
							code id=loading-the-media-resource:dom-media-seeking {
								a href="#dom-media-seeking" seeking
							}
							- " is true, set it to false."
						}
					}
					li {
						p {
							- "Set the "
							a href="#current-playback-position" id=loading-the-media-resource:current-playback-position "current playback position"
							- " to 0."
						}
						p {
							- "Set the "
							a href="#official-playback-position" id=loading-the-media-resource:official-playback-position "official playback position"
							- " to 0."
						}
						p {
							- "If this changed the "
