				}
			}
			dd {
				p {
					- "The value must be a short free-form string giving the name of the web application that the page represents. If the page is not a web application, the "
					code id=standard-metadata-names:meta-application-name {
						a href="#meta-application-name" application-name
					}
					- " metadata name must not be used. Translations of the web application's name may be given, using the "
					code id=standard-metadata-names:attr-lang {
