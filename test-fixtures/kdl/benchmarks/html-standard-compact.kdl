				}
			}
			figure {
				img alt="" src="/images/sample-not-bdi.png"
				figcaption {
					- "If the "
					code id=the-bdi-element:the-bdi-element-4 {
						a href="#the-bdi-element" bdi
					}
					- " element were to be replaced by a "
					code id=the-bdi-element:the-b-element {
						a href="#the-b-element" b
					}
					- " element, the username would confuse the bidirectional algorithm and the third bullet would end up saying \"User 3 :\", followed by the Arabic name (right-to-left), followed by \"posts\" and a period."
				}
			}
