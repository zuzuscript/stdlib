		p {
			- "When a "
			a href="#media-element" id=playing-the-media-resource:media-element-59 "media element"
			- " is "
			a href="#potentially-playing" id=playing-the-media-resource:potentially-playing-5 "potentially playing"
			- ", its audio data played must be synchronized with the "
			a href="#current-playback-position" id=playing-the-media-resource:current-playback-position-12 "current playback position"
