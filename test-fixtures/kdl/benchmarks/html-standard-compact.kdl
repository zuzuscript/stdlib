					a href="#original-insertion-mode" id=parsing-main-incdata:original-insertion-mode-3 "original insertion mode"
					- .
				}
			}
		}
		h6 id=parsing-main-intable {
			span class=secno "13.2.6.4.9"
			- " The \""
			dfn "in table"
			- "\" insertion mode"
			a class=self-link href="#parsing-main-intable"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-intable" id=parsing-main-intable:parsing-main-intable "in table"
			- "\" "
			a href="#insertion-mode" id=parsing-main-intable:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt {
				- "A character token, if the "
				a href="#current-node" id=parsing-main-intable:current-node "current node"
