		}
		p {
			- "To "
			dfn id=draw-focus-if-needed "draw focus if needed"
			- ", given an object implementing "
			code id=drawing-focus-rings-and-scrolling-paths-into-view:canvasuserinterface-2 {
				a href="#canvasuserinterface" CanvasUserInterface
			}
			var context
			- ", an element "
			var element
