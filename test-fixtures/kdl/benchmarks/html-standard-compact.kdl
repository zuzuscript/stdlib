		pre {
			code class=idl {
				- "["
				c- g="" Exposed
				- "="
				c- n="" Window
				- "] "
				c- b="" interface
				dfn data-dfn-type=interface id=htmlelement {
					c- g="" HTMLElement
				}
				- " : "
				a data-x-internal=element href="https://dom.spec.whatwg.org/#interface-element" id=elements-in-the-dom:element {
					c- n="" Element
				}
				- " { ["
				a href="#htmlconstructor" id=elements-in-the-dom:htmlconstructor {
					c- g="" HTMLConstructor
				}
				- "] "
				c- g="" constructor
				- "(); // metadata attributes ["
				a href="#cereactions" id=elements-in-the-dom:cereactions {
					c- g="" CEReactions
				}
