			li {
				- "its "
				a href="#concept-WorkerGlobalScope-owner-set" id=the-worker's-lifetime:concept-WorkerGlobalScope-owner-set-2 "owner set"
				- " has been "
				a data-x-internal=list-is-empty href="https://infra.spec.whatwg.org/#list-is-empty" id=the-worker's-lifetime:list-is-empty-2 empty
				- " for no more than a short "
