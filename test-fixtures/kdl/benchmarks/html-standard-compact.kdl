							}
						}
						p "In addition, the user agent may, as with anything, inform the user of any and all aspects of its operation, including the state of any timers, the destinations of any timed redirects, and so forth."
					}
				}
				p id=conformance-attr-meta-http-equiv-refresh {
					- "For "
					code id=pragma-directives:the-meta-element-12 {
						a href="#the-meta-element" meta
					}
					- " elements with an "
					code id=pragma-directives:attr-meta-http-equiv-6 {
						a href="#attr-meta-http-equiv" http-equiv
					}
					- " attribute in the "
					a href="#attr-meta-http-equiv-refresh" id=pragma-directives:attr-meta-http-equiv-refresh-2 "Refresh state"
					- ", the "
					code id=pragma-directives:attr-meta-content-9 {
						a href="#attr-meta-content" content
					}
					- " attribute must have a value consisting either of:"
				}
				ul {
					li {
						- "just a "
						a href="#valid-non-negative-integer" id=pragma-directives:valid-non-negative-integer "valid non-negative integer"
						- ", or"
					}
					li {
						- "a "
						a href="#valid-non-negative-integer" id=pragma-directives:valid-non-negative-integer-2 "valid non-negative integer"
						- ", followed by a U+003B SEMICOLON character (;), followed by one or more "
						a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=pragma-directives:space-characters-4 "ASCII whitespace"
						- ", followed by a substring that is an "
						a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=pragma-directives:ascii-case-insensitive-2 "ASCII case-insensitive"
						- " match for the string \""
						code URL
						- "\", followed by a U+003D EQUALS SIGN character (=), followed by a "
						a data-x-internal=valid-url-string href="https://url.spec.whatwg.org/#valid-url-string" id=pragma-directives:valid-url-string "valid URL string"
						- " that does not start with a literal U+0027 APOSTROPHE (') or U+0022 QUOTATION MARK (\") character."
					}
				}
				p {
					- "In the former case, the integer represents a number of seconds before the page is to be reloaded; in the latter case the integer represents a number of seconds before the page is to be replaced by the page at the given "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=pragma-directives:url URL
					- .
				}
				div class=example {
					p {
						- "A news organization's front page could include the following markup in the page's "
						code id=pragma-directives:the-head-element {
							a href="#the-head-element" head
						}
						- " element, to ensure that the page automatically reloads from the server every five minutes:"
					}
					pre {
						code class=html {
							c- p="" <
							c- f="" meta
							c- e="" http-equiv
							c- o="" "="
							c- s="" "\"Refresh\""
							c- e="" content
							c- o="" "="
							c- s="" "\"300\""
							c- p="" >
						}
					}
				}
				div class=example {
					p "A sequence of pages could be used as an automated slide show by making each page refresh to the next page in the sequence, using markup such as the following:"
					pre {
						code class=html {
							c- p="" <
							c- f="" meta
							c- e="" http-equiv
							c- o="" "="
							c- s="" "\"Refresh\""
							c- e="" content
							c- o="" "="
							c- s="" "\"20; URL=page4.html\""
							c- p="" >
						}
					}
				}
			}
			dt {
				dfn id=attr-meta-http-equiv-set-cookie "Set-Cookie state"
				- " ("
				code {
					- "http-equiv=\""
					code id=pragma-directives:attr-meta-http-equiv-keyword-set-cookie {
						a href="#attr-meta-http-equiv-keyword-set-cookie" set-cookie
					}
					- "\""
				}
				- ") "
			}
			dd {
				p "This pragma is non-conforming and has no effect."
				p "User agents are required to ignore this pragma."
			}
			dt {
				dfn id=attr-meta-http-equiv-x-ua-compatible "X-UA-Compatible state"
				- " ("
				code {
					- "http-equiv=\""
					code id=pragma-directives:attr-meta-http-equiv-keyword-x-ua-compatible {
						a href="#attr-meta-http-equiv-keyword-x-ua-compatible" x-ua-compatible
					}
					- "\""
				}
				- ") "
			}
			dd {
				p "In practice, this pragma encourages Internet Explorer to more closely follow the specifications."
				p {
					- "For "
					code id=pragma-directives:the-meta-element-13 {
						a href="#the-meta-element" meta
					}
					- " elements with an "
					code id=pragma-directives:attr-meta-http-equiv-7 {
						a href="#attr-meta-http-equiv" http-equiv
					}
					- " attribute in the "
					a href="#attr-meta-http-equiv-x-ua-compatible" id=pragma-directives:attr-meta-http-equiv-x-ua-compatible-2 "X-UA-Compatible state"
					- ", the "
					code id=pragma-directives:attr-meta-content-10 {
						a href="#attr-meta-content" content
					}
					- " attribute must have a value that is an "
					a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=pragma-directives:ascii-case-insensitive-3 "ASCII case-insensitive"
					- " match for the string \""
					code "IE=edge"
					- "\"."
				}
				p "User agents are required to ignore this pragma."
			}
			dt {
				dfn data-export="" id=attr-meta-http-equiv-content-security-policy "Content security policy state"
				- " ("
				code {
					- "http-equiv=\""
					code id=pragma-directives:attr-meta-http-equiv-keyword-content-security-policy {
						a href="#attr-meta-http-equiv-keyword-content-security-policy" content-security-policy
					}
					- "\""
				}
				- ") "
			}
			dd {
				p {
					- "This pragma "
					a data-x-internal=enforce-the-policy href="https://w3c.github.io/webappsec-csp/#enforced" id=pragma-directives:enforce-the-policy-2 enforces
					- " a "
					a data-x-internal=content-security-policy href="https://w3c.github.io/webappsec-csp/#content-security-policy-object" id=pragma-directives:content-security-policy-2 "Content Security Policy"
					- " on a "
					code id=pragma-directives:document-4 {
						a href="#document" Document
					}
					- ". "
					a href="#refsCSP" "[CSP]"
				}
				ol {
					li {
						p {
							- "If the "
							code id=pragma-directives:the-meta-element-14 {
								a href="#the-meta-element" meta
							}
							- " element is not a child of a "
							code id=pragma-directives:the-head-element-2 {
								a href="#the-head-element" head
							}
							- " element, return."
						}
					}
					li {
						p {
							- "If the "
							code id=pragma-directives:the-meta-element-15 {
								a href="#the-meta-element" meta
							}
							- " element has no "
							code id=pragma-directives:attr-meta-content-11 {
								a href="#attr-meta-content" content
							}
							- " attribute, or if that attribute's value is the empty string, then return."
						}
					}
					li {
						p {
							- "Let "
							var policy
							- " be the result of executing Content Security Policy's "
							a data-x-internal=parse-a-serialized-content-security-policy href="https://w3c.github.io/webappsec-csp/#parse-serialized-policy" id=pragma-directives:parse-a-serialized-content-security-policy "parse a serialized Content Security Policy"
							- " algorithm on the "
							code id=pragma-directives:the-meta-element-16 {
								a href="#the-meta-element" meta
							}
							- " element's "
							code id=pragma-directives:attr-meta-content-12 {
								a href="#attr-meta-content" content
							}
							- " attribute's value, with a source of \"meta\", and a disposition of \"enforce\"."
						}
					}
					li {
						p {
							- "Remove all occurrences of the "
							code id=pragma-directives:report-uri-directive {
								a data-x-internal=report-uri-directive href="https://w3c.github.io/webappsec-csp/#report-uri" report-uri
							}
							- ", "
							code id=pragma-directives:frame-ancestors-directive {
								a data-x-internal=frame-ancestors-directive href="https://w3c.github.io/webappsec-csp/#frame-ancestors" frame-ancestors
							}
							- ", and "
							code id=pragma-directives:sandbox-directive {
								a data-x-internal=sandbox-directive href="https://w3c.github.io/webappsec-csp/#sandbox" sandbox
							}
							a data-x-internal=content-security-policy-directive href="https://w3c.github.io/webappsec-csp/#directives" id=pragma-directives:content-security-policy-directive directives
							- " from "
							var policy
							- .
						}
					}
					li {
						p {
							a data-x-internal=enforce-the-policy href="https://w3c.github.io/webappsec-csp/#enforced" id=pragma-directives:enforce-the-policy-3 "Enforce the policy"
							var policy
							- .
						}
					}
				}
				p {
					- "For "
					code id=pragma-directives:the-meta-element-17 {
						a href="#the-meta-element" meta
					}
					- " elements with an "
					code id=pragma-directives:attr-meta-http-equiv-8 {
						a href="#attr-meta-http-equiv" http-equiv
					}
					- " attribute in the "
					a href="#attr-meta-http-equiv-content-security-policy" id=pragma-directives:attr-meta-http-equiv-content-security-policy-2 "Content security policy state"
					- ", the "
					code id=pragma-directives:attr-meta-content-13 {
						a href="#attr-meta-content" content
					}
					- " attribute must have a value consisting of a "
					a data-x-internal=content-security-policy-syntax href="https://w3c.github.io/webappsec-csp/#grammardef-serialized-policy" id=pragma-directives:content-security-policy-syntax "valid Content Security Policy"
					- ", but must not contain any "
					code id=pragma-directives:report-uri-directive-2 {
						a data-x-internal=report-uri-directive href="https://w3c.github.io/webappsec-csp/#report-uri" report-uri
					}
					- ", "
					code id=pragma-directives:frame-ancestors-directive-2 {
						a data-x-internal=frame-ancestors-directive href="https://w3c.github.io/webappsec-csp/#frame-ancestors" frame-ancestors
					}
					- ", or "
					code id=pragma-directives:sandbox-directive-2 {
						a data-x-internal=sandbox-directive href="https://w3c.github.io/webappsec-csp/#sandbox" sandbox
					}
					a data-x-internal=content-security-policy-directive href="https://w3c.github.io/webappsec-csp/#directives" id=pragma-directives:content-security-policy-directive-2 directives
					- ". The "
					a data-x-internal=content-security-policy href="https://w3c.github.io/webappsec-csp/#content-security-policy-object" id=pragma-directives:content-security-policy-3 "Content Security Policy"
					- " given in the "
					code id=pragma-directives:attr-meta-content-14 {
						a href="#attr-meta-content" content
					}
					- " attribute will be "
					a data-x-internal=enforce-the-policy href="https://w3c.github.io/webappsec-csp/#enforced" id=pragma-directives:enforce-the-policy-4 enforced
					- " upon the current document. "
					a href="#refsCSP" "[CSP]"
				}
				p class=note {
					- "At the time of inserting the "
					code id=pragma-directives:the-meta-element-18 {
						a href="#the-meta-element" meta
					}
					- " element to the document, it is possible that some resources have already been fetched. For example, images might be stored in the "
					a href="#list-of-available-images" id=pragma-directives:list-of-available-images "list of available images"
					- " prior to dynamically inserting a "
					code id=pragma-directives:the-meta-element-19 {
						a href="#the-meta-element" meta
					}
					- " element with an "
					code id=pragma-directives:attr-meta-http-equiv-9 {
						a href="#attr-meta-http-equiv" http-equiv
					}
					- " attribute in the "
					a href="#attr-meta-http-equiv-content-security-policy" id=pragma-directives:attr-meta-http-equiv-content-security-policy-3 "Content security policy state"
					- ". Resources that have already been fetched are not guaranteed to be blocked by a "
					a data-x-internal=content-security-policy href="https://w3c.github.io/webappsec-csp/#content-security-policy-object" id=pragma-directives:content-security-policy-4 "Content Security Policy"
					- " that's "
					a data-x-internal=enforce-the-policy href="https://w3c.github.io/webappsec-csp/#enforced" id=pragma-directives:enforce-the-policy-5 enforced
					- " late."
				}
				div class=example {
					p "A page might choose to mitigate the risk of cross-site scripting attacks by preventing the execution of inline JavaScript, as well as blocking all plugin content, using a policy such as the following: "
					pre {
						code class=html {
							c- p="" <
							c- f="" meta
							c- e="" http-equiv
							c- o="" "="
							c- s="" "\"Content-Security-Policy\""
							c- e="" content
							c- o="" "="
							c- s="" "\"script-src 'self'; object-src 'none'\""
							c- p="" >
						}
					}
				}
			}
		}
		p {
			- "There must not be more than one "
			code id=pragma-directives:the-meta-element-20 {
				a href="#the-meta-element" meta
			}
			- " element with any particular state in the document at a time."
		}
		h5 id=charset {
			span class=secno "4.2.5.4"
			- " Specifying the document's character encoding"
			a class=self-link href="#charset"
		}
		p {
			- "A "
			dfn id=character-encoding-declaration "character encoding declaration"
			- " is a mechanism by which the "
			a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=charset:encoding "character encoding"
			- " used to store or transmit a document is specified."
		}
		p {
			- "The Encoding standard requires use of the "
			a data-x-internal=utf-8 href="https://encoding.spec.whatwg.org/#utf-8" id=charset:utf-8 UTF-8
			a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=charset:encoding-2 "character encoding"
			- " and requires use of the \""
			code utf-8
			- "\" "
			a data-x-internal=encoding-label href="https://encoding.spec.whatwg.org/#label" id=charset:encoding-label "encoding label"
			- " to identify it. Those requirements necessitate that the document's "
			a href="#character-encoding-declaration" id=charset:character-encoding-declaration "character encoding declaration"
			- ", if it exists, specifies an "
			a data-x-internal=encoding-label href="https://encoding.spec.whatwg.org/#label" id=charset:encoding-label-2 "encoding label"
			- " using an "
			a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=charset:ascii-case-insensitive "ASCII case-insensitive"
			- " match for \""
			code utf-8
			- "\". Regardless of whether a "
			a href="#character-encoding-declaration" id=charset:character-encoding-declaration-2 "character encoding declaration"
			- " is present or not, the actual "
			a data-x-internal=document's-character-encoding href="https://dom.spec.whatwg.org/#concept-document-encoding" id=charset:document's-character-encoding "character encoding"
			- " used to encode the document must be "
			a data-x-internal=utf-8 href="https://encoding.spec.whatwg.org/#utf-8" id=charset:utf-8-2 UTF-8
			- ". "
			a href="#refsENCODING" "[ENCODING]"
		}
		p {
			- "To enforce the above rules, authoring tools must default to using "
			a data-x-internal=utf-8 href="https://encoding.spec.whatwg.org/#utf-8" id=charset:utf-8-3 UTF-8
			- " for newly-created documents."
		}
		p "The following restrictions also apply:"
		ul {
			li {
				- "The character encoding declaration must be serialized without the use of "
				a href="#syntax-charref" id=charset:syntax-charref "character references"
				- " or character escapes of any kind."
			}
			li id=charset1024 {
				span id=charset512 "The element containing the character encoding declaration must be serialized completely within the first 1024 bytes of the document."
			}
		}
		p {
			- "In addition, due to a number of restrictions on "
			code id=charset:the-meta-element {
				a href="#the-meta-element" meta
			}
			- " elements, there can only be one "
			code id=charset:the-meta-element-2 {
				a href="#the-meta-element" meta
			}
			- "-based character encoding declaration per document."
		}
		p {
			- "If an "
			a data-x-internal=html-documents href="https://dom.spec.whatwg.org/#html-document" id=charset:html-documents "HTML document"
			- " does not start with a BOM, and its "
			a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=charset:encoding-3 encoding
			- " is not explicitly given by "
			a href="#content-type" id=charset:content-type "Content-Type metadata"
			- ", and the document is not "
			a href="#an-iframe-srcdoc-document" id=charset:an-iframe-srcdoc-document {
				- "an "
				code iframe
				code srcdoc
				- " document"
			}
			- ", then the encoding must be specified using a "
			code id=charset:the-meta-element-3 {
				a href="#the-meta-element" meta
			}
			- " element with a "
			code id=charset:attr-meta-charset {
				a href="#attr-meta-charset" charset
			}
			- " attribute or a "
			code id=charset:the-meta-element-4 {
				a href="#the-meta-element" meta
			}
			- " element with an "
			code id=charset:attr-meta-http-equiv {
				a href="#attr-meta-http-equiv" http-equiv
			}
			- " attribute in the "
			a href="#attr-meta-http-equiv-content-type" id=charset:attr-meta-http-equiv-content-type "Encoding declaration state"
			- .
		}
		div class=note {
			p {
				- "A character encoding declaration is required (either in the "
				a href="#content-type" id=charset:content-type-2 "Content-Type metadata"
				- " or explicitly in the file) even when all characters are in the ASCII range, because a character encoding is needed to process non-ASCII characters entered by the user in forms, in URLs generated by scripts, and so forth."
			}
			p {
				- "Using non-UTF-8 encodings can have unexpected results on form submission and URL encodings, which use the "
				a data-x-internal=document's-character-encoding href="https://dom.spec.whatwg.org/#concept-document-encoding" id=charset:document's-character-encoding-2 "document's character encoding"
				- " by default."
			}
		}
		p {
			- "If the document is "
			a href="#an-iframe-srcdoc-document" id=charset:an-iframe-srcdoc-document-2 {
				- "an "
				code iframe
				code srcdoc
				- " document"
			}
			- ", the document must not have a "
			a href="#character-encoding-declaration" id=charset:character-encoding-declaration-3 "character encoding declaration"
			- ". (In this case, the source is already decoded, since it is part of the document that contained the "
			code id=charset:the-iframe-element {
				a href="#the-iframe-element" iframe
			}
			- ".)"
		}
		p "In XML, the XML declaration should be used for inline character encoding information, if necessary."
		div class=example {
			p {
				- "In HTML, to declare that the character encoding is "
				a data-x-internal=utf-8 href="https://encoding.spec.whatwg.org/#utf-8" id=charset:utf-8-4 UTF-8
				- ", the author could include the following markup near the top of the document (in the "
				code id=charset:the-head-element {
					a href="#the-head-element" head
				}
				- " element):"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" meta
					c- e="" charset
					c- o="" "="
					c- s="" "\"utf-8\""
					c- p="" >
				}
			}
			p "In XML, the XML declaration would be used instead, at the very top of the markup:"
			pre {
				code class=html {
					c- cp="" "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
				}
			}
		}
