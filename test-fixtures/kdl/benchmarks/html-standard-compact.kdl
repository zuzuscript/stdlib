					c- p="" >
					c- p="" "</"
					c- f="" section
					c- p="" >
				}
			}
			p "However, it would be better marked-up as:"
			pre {
				code class=html {
					c- p="" <
					c- f="" section
					c- p="" >
					c- c="" "<!-- ... -->"
					c- p="" <
					c- f="" footer
					c- p="" >
					- "Last modified: 2001-04-23"
					c- p="" "</"
					c- f="" footer
					c- p="" >
					c- p="" <
					c- f="" address
					c- p="" >
					- "Author: fred@example.com"
					c- p="" "</"
					c- f="" address
					c- p="" >
					c- p="" "</"
					c- f="" section
					c- p="" >
				}
			}
			p Or:
			pre {
				code class=html {
					c- p="" <
					c- f="" section
					c- p="" >
					c- c="" "<!-- ... -->"
					c- p="" <
					c- f="" footer
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
