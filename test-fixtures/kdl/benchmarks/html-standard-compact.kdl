					c- p="" >
					- "Advance to 6"
					c- p="" "</"
					c- f="" a
					c- p="" >
					- " or "
					c- p="" <
					c- f="" a
					c- e="" href
					c- o="" "="
					c- s="" "\"?x=4\""
					c- e="" onclick
					c- o="" "="
					c- s="" "\"go(-1); return false;\""
					c- p="" >
					- "retreat to 4"
					c- p="" "</"
					c- f="" a
					c- p="" >
					- "? "
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" script
					c- p="" >
					c- a="" var
					- " currentPage "
					c- o="" "="
