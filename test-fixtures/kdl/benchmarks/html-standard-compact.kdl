				p {
					- "For each token in "
					var "raw tokens"
					- ", run the following substeps:"
				}
				ol {
					li {
						p {
							- "Let "
							var input
							- " be the token."
						}
					}
					li {
						p {
							- "Let "
							var position
							- " be a pointer into "
