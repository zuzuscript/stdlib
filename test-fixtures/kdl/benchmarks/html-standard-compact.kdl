			i "This section is non-normative."
		}
		div class=example {
			p "Here is a long example vCard for a fictional character called \"Jack Bauer\":"
			pre {
				code class=html {
					c- p="" <
					c- f="" section
					c- e="" id
					c- o="" "="
					c- s="" "\"jack\""
					c- e="" itemscope
					c- e="" itemtype
					c- o="" "="
					c- s="" "\"http://microformats.org/profile/hcard\""
					c- p="" >
					c- p="" <
					c- f="" h1
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"fn\""
					c- p="" >
					c- p="" <
					c- f="" span
					c- e="" itemprop
					c- o="" "="
					c- s="" "\"n\""
					c- e="" itemscope
					c- p="" >
					c- p="" <
