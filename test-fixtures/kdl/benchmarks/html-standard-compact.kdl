		p class=note {
			- "Although not formally specified as such, "
			a data-x-internal=svg-image href="https://svgwg.org/svg2-draft/embedded.html#ImageElement" id=image-sources-for-2d-rendering-contexts:svg-image-2 {
				- "SVG "
				code image
			}
			- " elements are expected to be implemented nearly identical to "
			code id=image-sources-for-2d-rendering-contexts:the-img-element-2 {
				a href="#the-img-element" img
			}
			- " elements. That is, "
			a data-x-internal=svg-image href="https://svgwg.org/svg2-draft/embedded.html#ImageElement" id=image-sources-for-2d-rendering-contexts:svg-image-3 {
				- "SVG "
				code image
			}
			- " elements share the fundamental concepts and features of "
			code id=image-sources-for-2d-rendering-contexts:the-img-element-3 {
