				c- p="" :
				c- m="" "0.35"
				c- l="" em
				c- m="" "0.625"
				c- l="" em
				c- p="" ";"
				c- k="" padding-inline
				c- p="" :
				c- m="" "0.75"
				c- l="" em
				c- p="" ";"
				c- k="" min-inline-size
				c- p="" :
