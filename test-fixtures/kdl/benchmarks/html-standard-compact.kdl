		p {
			- "Each "
			code id=pdf-viewing-support:window {
				a href="#window" Window
			}
			- " object has a "
			dfn id=pdf-viewer-plugin-objects "PDF viewer plugin objects"
			- " list. If the user agent's "
			a href="#pdf-viewer-supported" id=pdf-viewing-support:pdf-viewer-supported "PDF viewer supported"
			- " is false, then it is the empty list. Otherwise, it is a list containing five "
			code id=pdf-viewing-support:dom-plugin {
				a href="#dom-plugin" Plugin
			}
			- " objects, whose "
			a href="#concept-plugin-name" id=pdf-viewing-support:concept-plugin-name names
			- " are, respectively:"
