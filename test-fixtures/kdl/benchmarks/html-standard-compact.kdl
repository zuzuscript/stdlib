						}
						p {
							- "Whenever new data for the "
							var "current media resource"
							- " becomes available, "
							a href="#queue-a-media-element-task" id=loading-the-media-resource:queue-a-media-element-task-17 "queue a media element task"
							- " given the "
							a href="#media-element" id=loading-the-media-resource:media-element-52 "media element"
