							- " named "
							var event
							- " at "
							var target
							- .
						}
					}
					li {
						p {
							- "Add the newly created "
							a href="#concept-task" id=playing-the-media-resource:concept-task-5 task
							- " to "
							var events
							- ", associated with the time "
							var time
							- ", the "
							a href="#text-track" id=playing-the-media-resource:text-track-11 "text track"
							var track
							- ", and the "
							a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-20 "text track cue"
							var target
							- .
						}
					}
					li {
						p {
							- "Add "
							var track
							- " to "
							var "affected tracks"
							- .
						}
					}
				}
			}
			li {
				p {
					- "For each "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-21 "text track cue"
					- " in "
					var "missed cues"
					- ", "
					a href="#prepare-an-event" id=playing-the-media-resource:prepare-an-event "prepare an event"
					- " named "
					code id=playing-the-media-resource:event-media-enter {
						a href="#event-media-enter" enter
					}
					- " for the "
					code id=playing-the-media-resource:texttrackcue {
						a href="#texttrackcue" TextTrackCue
					}
					- " object with the "
					a href="#text-track-cue-start-time" id=playing-the-media-resource:text-track-cue-start-time-4 "text track cue start time"
					- .
				}
			}
			li {
				p {
					- "For each "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-22 "text track cue"
					- " in "
					var "other cues"
					- " that either has its "
					a href="#text-track-cue-active-flag" id=playing-the-media-resource:text-track-cue-active-flag-4 "text track cue active flag"
					- " set or is in "
					var "missed cues"
					- ", "
					a href="#prepare-an-event" id=playing-the-media-resource:prepare-an-event-2 "prepare an event"
					- " named "
					code id=playing-the-media-resource:event-media-exit {
						a href="#event-media-exit" exit
					}
					- " for the "
					code id=playing-the-media-resource:texttrackcue-2 {
						a href="#texttrackcue" TextTrackCue
					}
					- " object with the later of the "
					a href="#text-track-cue-end-time" id=playing-the-media-resource:text-track-cue-end-time-4 "text track cue end time"
					- " and the "
					a href="#text-track-cue-start-time" id=playing-the-media-resource:text-track-cue-start-time-5 "text track cue start time"
					- .
				}
			}
			li {
				p {
					- "For each "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-23 "text track cue"
					- " in "
					var "current cues"
					- " that does not have its "
					a href="#text-track-cue-active-flag" id=playing-the-media-resource:text-track-cue-active-flag-5 "text track cue active flag"
					- " set, "
					a href="#prepare-an-event" id=playing-the-media-resource:prepare-an-event-3 "prepare an event"
					- " named "
					code id=playing-the-media-resource:event-media-enter-2 {
						a href="#event-media-enter" enter
					}
					- " for the "
					code id=playing-the-media-resource:texttrackcue-3 {
						a href="#texttrackcue" TextTrackCue
					}
					- " object with the "
					a href="#text-track-cue-start-time" id=playing-the-media-resource:text-track-cue-start-time-6 "text track cue start time"
					- .
				}
			}
			li {
				p {
					- "Sort the "
					a href="#concept-task" id=playing-the-media-resource:concept-task-6 tasks
					- " in "
					var events
					- " in ascending time order ("
					a href="#concept-task" id=playing-the-media-resource:concept-task-7 tasks
					- " with earlier times first)."
				}
				p {
					- "Further sort "
					a href="#concept-task" id=playing-the-media-resource:concept-task-8 tasks
					- " in "
					var events
					- " that have the same time by the relative "
					a href="#text-track-cue-order" id=playing-the-media-resource:text-track-cue-order "text track cue order"
					- " of the "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-24 "text track cues"
					- " associated with these "
					a href="#concept-task" id=playing-the-media-resource:concept-task-9 tasks
					- .
				}
				p {
					- "Finally, sort "
					a href="#concept-task" id=playing-the-media-resource:concept-task-10 tasks
					- " in "
					var events
					- " that have the same time and same "
					a href="#text-track-cue-order" id=playing-the-media-resource:text-track-cue-order-2 "text track cue order"
					- " by placing "
					a href="#concept-task" id=playing-the-media-resource:concept-task-11 tasks
					- " that fire "
					code id=playing-the-media-resource:event-media-enter-3 {
						a href="#event-media-enter" enter
					}
					- " events before those that fire "
					code id=playing-the-media-resource:event-media-exit-2 {
						a href="#event-media-exit" exit
					}
					- " events."
				}
			}
			li {
				p {
					a href="#queue-a-media-element-task" id=playing-the-media-resource:queue-a-media-element-task-12 "Queue a media element task"
					- " given the "
					a href="#media-element" id=playing-the-media-resource:media-element-79 "media element"
					- " for each "
					a href="#concept-task" id=playing-the-media-resource:concept-task-12 task
					- " in "
					var events
					- ", in list order."
				}
			}
			li {
				p {
					- "Sort "
					var "affected tracks"
					- " in the same order as the "
					a href="#text-track" id=playing-the-media-resource:text-track-12 "text tracks"
					- " appear in the "
					a href="#media-element" id=playing-the-media-resource:media-element-80 "media element"
					- "'s "
					a href="#list-of-text-tracks" id=playing-the-media-resource:list-of-text-tracks-5 "list of text tracks"
					- ", and remove duplicates."
				}
			}
			li {
				p {
					- "For each "
					a href="#text-track" id=playing-the-media-resource:text-track-13 "text track"
					- " in "
					var "affected tracks"
					- ", in the list order, "
					a href="#queue-a-media-element-task" id=playing-the-media-resource:queue-a-media-element-task-13 "queue a media element task"
					- " given the "
					a href="#media-element" id=playing-the-media-resource:media-element-81 "media element"
					- " to "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=playing-the-media-resource:concept-event-fire-15 "fire an event"
					- " named "
					code id=playing-the-media-resource:event-media-cuechange {
						a href="#event-media-cuechange" cuechange
					}
					- " at the "
					code id=playing-the-media-resource:texttrack {
						a href="#texttrack" TextTrack
					}
					- " object, and, if the "
					a href="#text-track" id=playing-the-media-resource:text-track-14 "text track"
					- " has a corresponding "
					code id=playing-the-media-resource:the-track-element {
						a href="#the-track-element" track
					}
					- " element, to then "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=playing-the-media-resource:concept-event-fire-16 "fire an event"
					- " named "
					code id=playing-the-media-resource:event-media-cuechange-2 {
						a href="#event-media-cuechange" cuechange
					}
					- " at the "
					code id=playing-the-media-resource:the-track-element-2 {
						a href="#the-track-element" track
					}
					- " element as well."
				}
			}
			li {
				p {
					- "Set the "
					a href="#text-track-cue-active-flag" id=playing-the-media-resource:text-track-cue-active-flag-6 "text track cue active flag"
					- " of all the "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-25 cues
					- " in the "
					var "current cues"
					- ", and unset the "
					a href="#text-track-cue-active-flag" id=playing-the-media-resource:text-track-cue-active-flag-7 "text track cue active flag"
					- " of all the "
					a href="#text-track-cue" id=playing-the-media-resource:text-track-cue-26 cues
					- " in the "
					var "other cues"
					- .
				}
			}
