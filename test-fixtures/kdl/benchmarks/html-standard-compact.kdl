				a href="#attr-input-multiple" multiple
			}
			- " attribute is specified or not."
		}
		dl class=switch {
			dt {
				- "When the "
				code id="email-state-(type=email):attr-input-multiple-2" {
					a href="#attr-input-multiple" multiple
				}
				- " attribute is not specified on the element"
			}
			dd {
				p {
					- "The "
					code id="email-state-(type=email):the-input-element-2" {
						a href="#the-input-element" input
					}
					- " element "
					a href="#represents" id="email-state-(type=email):represents" represents
					- " a control for editing an email address given in the element's "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value" value
					- .
				}
				p {
					- "If the element is "
					i id="email-state-(type=email):concept-fe-mutable" {
						a href="#concept-fe-mutable" mutable
					}
					- ", the user agent should allow the user to change the email address represented by its "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-2" value
					- ". User agents may allow the user to set the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-3" value
					- " to a string that is not a "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address" "valid email address"
					- ". The user agent should act in a manner consistent with expecting the user to provide a single email address. User agents should allow the user to set the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-4" value
					- " to the empty string. User agents must not allow users to insert U+000A LINE FEED (LF) or U+000D CARRIAGE RETURN (CR) characters into the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-5" value
					- ". User agents may transform the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-6" value
					- " for display and editing; in particular, user agents should convert punycode in the domain labels of the "
					a href="#concept-fe-value" id="email-state-(type=email):concept-fe-value-7" value
					- " to IDN in the display and vice versa."
				}
				p {
					strong "Constraint validation"
					- ": While the user interface is representing input that the user agent cannot convert to punycode, the control is "
					a href="#suffering-from-bad-input" id="email-state-(type=email):suffering-from-bad-input" "suffering from bad input"
					- .
				}
				p {
					- "The "
					code id="email-state-(type=email):attr-input-value" {
						a href="#attr-input-value" value
					}
					- " attribute, if specified and not empty, must have a value that is a single "
					a href="#valid-e-mail-address" id="email-state-(type=email):valid-e-mail-address-2" "valid email address"
					- .
				}
				p {
					strong {
						- "The "
						a href="#value-sanitization-algorithm" id="email-state-(type=email):value-sanitization-algorithm" "value sanitization algorithm"
						- " is as follows"
					}
					- ": "
					a data-x-internal=strip-newlines href="https://infra.spec.whatwg.org/#strip-newlines" id="email-state-(type=email):strip-newlines" "Strip newlines"
					- " from the "
