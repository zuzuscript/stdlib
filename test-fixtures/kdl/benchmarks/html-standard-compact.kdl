		h4 id=worker-event-loop {
			span class=secno "10.2.2"
			- " The event loop"
			a class=self-link href="#worker-event-loop"
		}
		p {
			- "A "
			a href="#worker-event-loop-2" id=worker-event-loop:worker-event-loop-2 "worker event loop"
			- "'s "
			a href="#task-queue" id=worker-event-loop:task-queue "task queues"
			- " only have events, callbacks, and networking activity as "
			a href="#concept-task" id=worker-event-loop:concept-task tasks
			- ". These "
			a href="#worker-event-loop-2" id=worker-event-loop:worker-event-loop-2-2 "worker event loops"
			- " are created by the "
			a href="#run-a-worker" id=worker-event-loop:run-a-worker "run a worker"
			- " algorithm."
		}
		p {
			- "Each "
			code id=worker-event-loop:workerglobalscope {
				a href="#workerglobalscope" WorkerGlobalScope
			}
			- " object has a "
			dfn data-dfn-for=WorkerGlobalScope data-export="" id=dom-workerglobalscope-closing closing
			- " flag, which must be initially false, but which can get set to true by the algorithms in the processing model section below."
		}
		p {
			- "Once the "
			code id=worker-event-loop:workerglobalscope-2 {
				a href="#workerglobalscope" WorkerGlobalScope
			}
			- "'s "
			a href="#dom-workerglobalscope-closing" id=worker-event-loop:dom-workerglobalscope-closing closing
			- " flag is set to true, the "
			a href="#event-loop" id=worker-event-loop:event-loop "event loop"
			- "'s "
			a href="#task-queue" id=worker-event-loop:task-queue-2 "task queues"
			- " must discard any further "
			a href="#concept-task" id=worker-event-loop:concept-task-2 tasks
			- " that would be added to them (tasks already on the queue are unaffected except where otherwise specified). Effectively, once the "
			a href="#dom-workerglobalscope-closing" id=worker-event-loop:dom-workerglobalscope-closing-2 closing
			- " flag is true, timers stop firing, notifications for all pending background operations are dropped, etc."
		}
		h4 id=the-worker's-lifetime {
