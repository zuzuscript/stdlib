					c- f="" title
					c- p="" >
					- "Line Game - 5"
					c- p="" "</"
					c- f="" title
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					- "You are at coordinate "
					c- p="" <
					c- f="" span
					c- e="" id
					c- o="" "="
					c- s="" "\"coord\""
					c- p="" >
					- "5"
					c- p="" "</"
					c- f="" span
					c- p="" >
					- " on the line."
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" p
					c- p="" >
					c- p="" <
					c- f="" a
					c- e="" href
					c- o="" "="
					c- s="" "\"?x=6\""
					c- e="" onclick
					c- o="" "="
