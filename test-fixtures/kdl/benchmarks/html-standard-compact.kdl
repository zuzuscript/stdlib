		h5 id=multipart-form-data {
			span class=secno "4.10.21.8"
			- " Multipart form data"
			a class=self-link href="#multipart-form-data"
		}
		p {
			- "The "
			dfn data-export="" id="multipart/form-data-encoding-algorithm" {
				code "multipart/form-data"
				- " encoding algorithm"
			}
			- ", given an "
			a href="#entry-list" id=multipart-form-data:entry-list "entry list"
			var "entry list"
			- " and an "
			a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=multipart-form-data:encoding encoding
			var encoding
			- ", is as follows:"
		}
		ol {
			li {
				p {
					a data-x-internal=list-iterate href="https://infra.spec.whatwg.org/#list-iterate" id=multipart-form-data:list-iterate "For each"
					var entry
					- " of "
					var "entry list"
					- :
				}
				ol {
					li {
						p {
							- "Replace every occurrence of U+000D (CR) not followed by U+000A (LF), and every occurrence of U+000A (LF) not preceded by U+000D (CR), in "
							var entry
							- "'s "
							a href="#form-entry-name" id=multipart-form-data:form-entry-name name
							- ", by a string consisting of a U+000D (CR) and U+000A (LF)."
						}
					}
					li {
						p {
							- "If "
							var entry
							- "'s "
							a href="#form-entry-value" id=multipart-form-data:form-entry-value value
							- " is not a "
							code id=multipart-form-data:file {
								a data-x-internal=file href="https://w3c.github.io/FileAPI/#dfn-file" File
							}
							- " object, then replace every occurrence of U+000D (CR) not followed by U+000A (LF), and every occurrence of U+000A (LF) not preceded by U+000D (CR), in "
							var entry
							- "'s "
							a href="#form-entry-value" id=multipart-form-data:form-entry-value-2 value
							- ", by a string consisting of a U+000D (CR) and U+000A (LF)."
						}
					}
				}
			}
			li {
				p {
					- "Return the byte sequence resulting from encoding the "
					var "entry list"
					- " using the rules described by RFC 7578, "
					cite {
						- "Returning Values from Forms: "
						code "multipart/form-data"
					}
					- ", given the following conditions: "
					a href="#refsRFC7578" "[RFC7578]"
				}
				ul {
					li {
						p {
							- "Each "
							a href="#form-entry" id=multipart-form-data:form-entry entry
							- " in "
							var "entry list"
							- " is a "
							i field
							- ", the "
							a href="#form-entry-name" id=multipart-form-data:form-entry-name-2 name
							- " of the entry is the "
							i "field name"
							- " and the "
							a href="#form-entry-value" id=multipart-form-data:form-entry-value-3 value
							- " of the entry is the "
							i "field value"
							- .
						}
					}
					li {
						p {
							- "The order of parts must be the same as the order of fields in "
							var "entry list"
							- ". Multiple entries with the same name must be treated as distinct fields."
						}
					}
					li {
						p {
							- "Field names, field values for non-file fields, and filenames for file fields, in the generated "
							code id="multipart-form-data:multipart/form-data" {
								a href="#multipart/form-data" "multipart/form-data"
							}
							- " resource must be set to the result of "
							a data-x-internal=encode href="https://encoding.spec.whatwg.org/#encode" id=multipart-form-data:encode encoding
							- " the corresponding entry's name or value with "
							var encoding
							- ", converted to a byte sequence."
