		h3 class=no-num id=attributes-3 {
			- Attributes
			a class=self-link href="#attributes-3"
		}
		p {
			i "This section is non-normative."
		}
		table id=attributes-1 {
			caption "List of attributes (excluding event handler content attributes)"
			thead {
				tr {
					th " Attribute "
					th " Element(s) "
					th " Description "
					th " Value "
				}
			}
			tbody {
				tr {
					th {
						code abbr
					}
					td {
						code id=attributes-3:attr-th-abbr {
							a href="#attr-th-abbr" th
						}
					}
					td " Alternative label to use for the header cell when referencing the cell in other contexts "
					td {
						a href="#attribute-text" Text
						- "* "
					}
				}
				tr {
					th {
						code accept
					}
					td {
						code id=attributes-3:attr-input-accept {
							a href="#attr-input-accept" input
						}
					}
					td {
						- " Hint for expected file type in "
						a href="#file-upload-state-(type=file)" id="attributes-3:file-upload-state-(type=file)" "file upload controls"
					}
					td {
						a href="#set-of-comma-separated-tokens" id=attributes-3:set-of-comma-separated-tokens "Set of comma-separated tokens"
						- "* consisting of "
						a data-x-internal=valid-mime-type-string-with-no-parameters href="https://mimesniff.spec.whatwg.org/#valid-mime-type-with-no-parameters" id=attributes-3:valid-mime-type-string-with-no-parameters "valid MIME type strings with no parameters"
						- " or "
						code "audio/*"
						- ", "
						code "video/*"
						- ", or "
						code "image/*"
					}
				}
				tr {
					th {
						code accept-charset
					}
					td {
						code id=attributes-3:attr-form-accept-charset {
							a href="#attr-form-accept-charset" form
						}
					}
					td {
						- " Character encodings to use for "
						a href="#form-submission-2" id=attributes-3:form-submission-2 "form submission"
					}
					td {
						a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=attributes-3:ascii-case-insensitive "ASCII case-insensitive"
						- " match for \""
						code UTF-8
						- "\" "
					}
				}
				tr {
					th {
						code accesskey
					}
					td {
						a href="#the-accesskey-attribute" id=attributes-3:the-accesskey-attribute "HTML elements"
					}
					td " Keyboard shortcut to activate or focus element "
					td {
						a href="#ordered-set-of-unique-space-separated-tokens" id=attributes-3:ordered-set-of-unique-space-separated-tokens "Ordered set of unique space-separated tokens"
						- ", none of which are "
						a data-x-internal=identical-to href="https://infra.spec.whatwg.org/#string-is" id=attributes-3:identical-to "identical to"
						- " another, each consisting of one code point in length "
					}
				}
				tr {
