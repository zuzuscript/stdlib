					}
				}
			}
			li {
				p {
					- "Append (what remains of) "
					var line
					- " to "
					var output
					- .
				}
			}
			li {
				p {
					- "Append a U+000D CARRIAGE RETURN character (CR) to "
					var output
					- .
				}
			}
			li {
				p {
					- "Append a U+000A LINE FEED character (LF) to "
					var output
					- .
