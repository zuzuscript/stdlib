		}
		p {
			- "Consume the "
			a href="#next-input-character" id=before-attribute-value-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+0009 CHARACTER TABULATION (tab)"
			dt "U+000A LINE FEED (LF)"
			dt "U+000C FORM FEED (FF)"
			dt "U+0020 SPACE"
			dd "Ignore the character."
			dt "U+0022 QUOTATION MARK (\")"
			dd {
				- "Switch to the "
				a href="#attribute-value-(double-quoted)-state" id="before-attribute-value-state:attribute-value-(double-quoted)-state" "attribute value (double-quoted) state"
				- .
			}
			dt "U+0027 APOSTROPHE (')"
			dd {
				- "Switch to the "
