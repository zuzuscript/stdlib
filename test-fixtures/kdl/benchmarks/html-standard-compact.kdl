				a href="#attr-input-type" type
			}
			- " attribute set to "
			code id="writing-a-form's-user-interface:telephone-state-(type=tel)" {
				a href="#telephone-state-(type=tel)" tel
			}
			- ") and email addresses ("
			code id=writing-a-form's-user-interface:the-input-element-5 {
