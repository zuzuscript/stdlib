		h5 id=groupings-of-browsing-contexts {
			span class=secno "7.3.2.3"
			- " Groupings of browsing contexts"
			a class=self-link href="#groupings-of-browsing-contexts"
		}
		p {
			- "A "
			a href="#top-level-browsing-context" id=groupings-of-browsing-contexts:top-level-browsing-context "top-level browsing context"
			- " has an associated "
			dfn id=tlbc-group group
			- " (null or a "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group "browsing context group"
			- "). It is initially null."
		}
		p {
			- "A user agent holds a "
			dfn id=browsing-context-group-set "browsing context group set"
			- " (a "
			a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=groupings-of-browsing-contexts:set set
			- " of "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-2 "browsing context groups"
			- ")."
		}
		p {
			- "A "
			dfn id=browsing-context-group "browsing context group"
			- " holds a "
			dfn id=browsing-context-set "browsing context set"
			- " (a "
			a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=groupings-of-browsing-contexts:set-2 set
			- " of "
			a href="#top-level-browsing-context" id=groupings-of-browsing-contexts:top-level-browsing-context-2 "top-level browsing contexts"
			- ")."
		}
		p class=note {
			- "A "
			a href="#top-level-browsing-context" id=groupings-of-browsing-contexts:top-level-browsing-context-3 "top-level browsing context"
			- " is added to the "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-3 group
			- " when the group is "
			a href="#creating-a-new-browsing-context-group-and-document" id=groupings-of-browsing-contexts:creating-a-new-browsing-context-group-and-document created
			- ". All subsequent "
			a href="#top-level-browsing-context" id=groupings-of-browsing-contexts:top-level-browsing-context-4 "top-level browsing contexts"
			- " added to the "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-4 group
			- " will be "
			a href="#auxiliary-browsing-context" id=groupings-of-browsing-contexts:auxiliary-browsing-context "auxiliary browsing contexts"
			- .
		}
		p {
			- "A "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-5 "browsing context group"
			- " has an associated "
			dfn id=agent-cluster-map "agent cluster map"
			- " (a weak "
			a data-x-internal=ordered-map href="https://infra.spec.whatwg.org/#ordered-map" id=groupings-of-browsing-contexts:ordered-map map
			- " of "
			a href="#agent-cluster-key" id=groupings-of-browsing-contexts:agent-cluster-key "agent cluster keys"
			- " to "
			a data-x-internal=agent-cluster href="https://tc39.es/ecma262/#sec-agent-clusters" id=groupings-of-browsing-contexts:agent-cluster "agent clusters"
			- "). User agents are responsible for collecting agent clusters when it is deemed that nothing can access them anymore."
		}
		p {
			- "A "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-6 "browsing context group"
			- " has an associated "
			dfn id=historical-agent-cluster-key-map "historical agent cluster key map"
			- ", which is a "
			a data-x-internal=ordered-map href="https://infra.spec.whatwg.org/#ordered-map" id=groupings-of-browsing-contexts:ordered-map-2 map
			- " of "
			a href="#concept-origin" id=groupings-of-browsing-contexts:concept-origin origins
			- " to "
			a href="#agent-cluster-key" id=groupings-of-browsing-contexts:agent-cluster-key-2 "agent cluster keys"
			- ". This map is used to ensure the consistency of the "
			a href="#origin-keyed-agent-clusters" "origin-keyed agent clusters"
			- " feature by recording what agent cluster keys were previously used for a given origin."
		}
		p class=note {
			- "The "
			a href="#historical-agent-cluster-key-map" id=groupings-of-browsing-contexts:historical-agent-cluster-key-map "historical agent cluster key map"
			- " only ever gains entries over the lifetime of the browsing context group."
		}
		p {
			- "A "
			a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-7 "browsing context group"
			- " has a "
			dfn id=bcg-cross-origin-isolation "cross-origin isolation mode"
			- ", which is a "
			a href="#cross-origin-isolation-mode" id=groupings-of-browsing-contexts:cross-origin-isolation-mode "cross-origin isolation mode"
			- ". It is initially \""
			code id=groupings-of-browsing-contexts:cross-origin-isolation-none {
				a href="#cross-origin-isolation-none" none
			}
			- "\"."
		}
		p {
			- "A "
			dfn id=cross-origin-isolation-mode "cross-origin isolation mode"
			- " is one of three possible values: \""
			dfn id=cross-origin-isolation-none {
				code none
			}
			- "\", \""
			dfn id=cross-origin-isolation-logical {
				code logical
			}
			- "\", or \""
			dfn id=cross-origin-isolation-concrete {
				code concrete
			}
			- "\"."
		}
		div class=note {
			p {
				- "\""
				code id=groupings-of-browsing-contexts:cross-origin-isolation-logical {
					a href="#cross-origin-isolation-logical" logical
				}
				- "\" and \""
				code id=groupings-of-browsing-contexts:cross-origin-isolation-concrete {
					a href="#cross-origin-isolation-concrete" concrete
				}
				- "\" are similar. They are both used for "
				a href="#browsing-context-group" id=groupings-of-browsing-contexts:browsing-context-group-8 "browsing context groups"
				- " where:"
			}
			ul {
				li {
					p {
						- "every top-level "
						code id=groupings-of-browsing-contexts:document {
							a href="#document" Document
						}
						- " has `"
						code {
							a href="#cross-origin-opener-policy-2" id=groupings-of-browsing-contexts:cross-origin-opener-policy-2 Cross-Origin-Opener-Policy
							- ": "
							a href="#coop-same-origin" id=groupings-of-browsing-contexts:coop-same-origin same-origin
						}
						- "`, and"
					}
				}
				li {
					p {
						- "every "
						code id=groupings-of-browsing-contexts:document-2 {
							a href="#document" Document
						}
						- " has a `"
						code id=groupings-of-browsing-contexts:cross-origin-embedder-policy {
							a href="#cross-origin-embedder-policy" Cross-Origin-Embedder-Policy
						}
						- "` header whose value is "
						a href="#compatible-with-cross-origin-isolation" id=groupings-of-browsing-contexts:compatible-with-cross-origin-isolation "compatible with cross-origin isolation"
						- .
					}
				}
			}
			p {
				- "On some platforms, it is difficult to provide the security properties required to grant safe access to the APIs gated by the "
				a href="#concept-settings-object-cross-origin-isolated-capability" id=groupings-of-browsing-contexts:concept-settings-object-cross-origin-isolated-capability "cross-origin isolated capability"
				- ". As a result, only \""
				code id=groupings-of-browsing-contexts:cross-origin-isolation-concrete-2 {
					a href="#cross-origin-isolation-concrete" concrete
				}
				- "\" can grant access that capability. \""
				code id=groupings-of-browsing-contexts:cross-origin-isolation-logical-2 {
					a href="#cross-origin-isolation-logical" logical
				}
				- "\" is used on platform not supporting this capability, where various restrictions imposed by cross-origin isolation will still apply, but the capability is not granted."
			}
		}
