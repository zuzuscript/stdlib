					- " be the values of the cells in the second and third columns of that row respectively."
				}
			}
			li {
				p {
					- "Return the pair ("
					var category
					- ", "
					var "maximum tokens"
					- ")."
				}
			}
		}
		hr
		p {
			- "For the purposes of autofill, a "
			dfn id=control's-data "control's data"
			- " depends on the kind of control:"
		}
		dl {
			dt {
				- "An "
