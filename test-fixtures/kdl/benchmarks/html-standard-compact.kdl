					- "; and"
				}
			}
			li {
				p {
					dfn id=concept-import-map-integrity integrity
					- ", a "
					a href="#module-integrity-map" id=import-map-processing-model:module-integrity-map "module integrity map"
					- .
				}
			}
		}
		p {
			- "A "
			dfn id=module-specifier-map "module specifier map"
			- " is an "
