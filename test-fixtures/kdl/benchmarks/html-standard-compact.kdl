					c- p="" >
					- .
					c- p="" "</"
					c- f="" p
					c- p="" >
					c- p="" "</"
					c- f="" footer
					c- p="" >
					c- p="" "</"
					c- f="" body
					c- p="" >
					c- p="" "</"
					c- f="" html
					c- p="" >
				}
			}
			p {
				- "The above results in two items with the type \""
				code "http://n.whatwg.org/work"
				- "\", one with:"
			}
			dl class=brief {
				dt "work "
				dd {
					code "images/house.jpeg"
				}
				dt "title "
				dd "The house I found. "
				dt "license "
				dd {
					code "http://www.opensource.org/licenses/mit-license.php"
				}
			}
			p "...and one with:"
			dl class=brief {
				dt "work "
				dd {
					code "images/mailbox.jpeg"
				}
				dt "title "
				dd "The mailbox. "
				dt "license "
				dd {
					code "http://www.opensource.org/licenses/mit-license.php"
				}
			}
		}
		h4 id=microdata-and-other-namespaces {
			span class=secno "5.2.6"
			- " Microdata and other namespaces"
			a class=self-link href="#microdata-and-other-namespaces"
		}
		p {
			- "Currently, the "
			code id=microdata-and-other-namespaces:attr-itemscope {
				a href="#attr-itemscope" itemscope
			}
			- ", "
			code id=microdata-and-other-namespaces:names:-the-itemprop-attribute {
				a href="#names:-the-itemprop-attribute" itemprop
			}
			- ", and other microdata attributes are only defined for "
			a href="#html-elements" id=microdata-and-other-namespaces:html-elements "HTML elements"
			- ". This means that attributes with the literal names \""
			code itemscope
			- "\", \""
			code itemprop
			- "\", etc, do not cause microdata processing to occur on elements in other namespaces, such as SVG."
		}
		div class=example {
			p "Thus, in the following example there is only one item, not two."
			pre class=bad {
				code class=html {
					c- p="" <
					c- f="" p
					c- e="" itemscope
					c- p="" "></"
					c- f="" p
					c- p="" >
					c- c="" "<!-- this is an item (with no properties and no type) -->"
					c- p="" <
					c- f="" svg
					c- e="" itemscope
					c- p="" "></"
					c- f="" svg
					c- p="" >
					c- c="" "<!-- this is not, it's just an "
					a data-x-internal=svg-svg href="https://svgwg.org/svg2-draft/struct.html#SVGElement" id=microdata-and-other-namespaces:svg-svg {
						c- c="" "SVG "
						code {
							c- c="" svg
						}
					}
					c- c="" " element with an invalid unknown attribute -->"
				}
			}
		}
		h3 id=mdvocabs {
			span class=secno "5.3"
			- " Sample microdata vocabularies"
			a class=self-link href="#mdvocabs"
		}
		p "The vocabularies in this section are primarily intended to demonstrate how a vocabulary is specified, though they are also usable in their own right."
		h4 id=vcard {
			span class=secno "5.3.1"
			- " vCard"
			a class=self-link href="#vcard"
		}
		p {
			- "An item with the "
			a href="#item-types" id=vcard:item-types "item type"
			dfn id=md-vcard {
				code "http://microformats.org/profile/hcard"
			}
			- " represents a person's or organization's contact information."
		}
		p {
			- "This vocabulary does not "
			a href="#support-global-identifiers-for-items" id=vcard:support-global-identifiers-for-items "support global identifiers for items"
			- .
		}
		p {
			- "The following are the type's "
			a href="#defined-property-name" id=vcard:defined-property-name "defined property names"
			- ". They are based on the vocabulary defined in "
			cite "vCard Format Specification"
			- " ("
			cite vCard
			- ") and its extensions, where more information on how to interpret the values can be found. "
			a href="#refsRFC6350" "[RFC6350]"
		}
		dl {
			dt {
				dfn id=md-vcard-kind {
					code kind
				}
			}
			dd {
				p "Describes what kind of contact the item represents."
				p {
					- "The "
					a href="#concept-property-value" id=vcard:concept-property-value value
					- " must be text that is "
					a data-x-internal=identical-to href="https://infra.spec.whatwg.org/#string-is" id=vcard:identical-to "identical to"
					- " one of the "
					a href="#kind-strings" id=vcard:kind-strings "kind strings"
					- .
				}
				p {
					- "A single property with the name "
					code id=vcard:md-vcard-kind {
						a href="#md-vcard-kind" kind
					}
					- " may be present within each "
					a href="#concept-item" id=vcard:concept-item item
					- " with the type "
					code id=vcard:md-vcard {
						a href="#md-vcard" "http://microformats.org/profile/hcard"
					}
					- .
				}
			}
			dt {
				dfn id=md-vcard-fn {
					code fn
				}
			}
			dd {
				p "Gives the formatted text corresponding to the name of the person or organization."
				p {
					- "The "
					a href="#concept-property-value" id=vcard:concept-property-value-2 value
					- " must be text."
				}
				p {
					- "Exactly one property with the name "
					code id=vcard:md-vcard-fn {
						a href="#md-vcard-fn" fn
					}
					- " must be present within each "
					a href="#concept-item" id=vcard:concept-item-2 item
					- " with the type "
					code id=vcard:md-vcard-2 {
						a href="#md-vcard" "http://microformats.org/profile/hcard"
					}
					- .
				}
			}
			dt {
				dfn id=md-vcard-n {
					code n
				}
			}
			dd {
				p "Gives the structured name of the person or organization."
				p {
					- "The "
					a href="#concept-property-value" id=vcard:concept-property-value-3 value
					- " must be an "
					a href="#concept-item" id=vcard:concept-item-3 item
					- " with zero or more of each of the "
					code id=vcard:md-vcard-n-family-name {
						a href="#md-vcard-n-family-name" family-name
					}
					- ", "
					code id=vcard:md-vcard-n-given-name {
						a href="#md-vcard-n-given-name" given-name
					}
					- ", "
					code id=vcard:md-vcard-n-additional-name {
						a href="#md-vcard-n-additional-name" additional-name
					}
					- ", "
					code id=vcard:md-vcard-n-honorific-prefix {
						a href="#md-vcard-n-honorific-prefix" honorific-prefix
					}
					- ", and "
					code id=vcard:md-vcard-n-honorific-suffix {
						a href="#md-vcard-n-honorific-suffix" honorific-suffix
					}
					- " properties."
				}
				p {
					- "Exactly one property with the name "
					code id=vcard:md-vcard-n {
						a href="#md-vcard-n" n
					}
					- " must be present within each "
					a href="#concept-item" id=vcard:concept-item-4 item
					- " with the type "
					code id=vcard:md-vcard-3 {
						a href="#md-vcard" "http://microformats.org/profile/hcard"
					}
					- .
				}
			}
			dt {
				dfn id=md-vcard-n-family-name {
					code family-name
				}
				- " (inside "
				code id=vcard:md-vcard-n-2 {
					a href="#md-vcard-n" n
				}
				- ")"
			}
			dd {
				p "Gives the family name of the person, or the full name of the organization."
				p {
					- "The "
					a href="#concept-property-value" id=vcard:concept-property-value-4 value
					- " must be text."
				}
				p {
					- "Any number of properties with the name "
					code id=vcard:md-vcard-n-family-name-2 {
						a href="#md-vcard-n-family-name" family-name
