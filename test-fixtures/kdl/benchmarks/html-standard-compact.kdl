					- ". (See below.)"
				}
				p {
					a href="#insert-an-html-element" id=parsing-main-intable:insert-an-html-element-5 "Insert an HTML element"
					- " for a \"tbody\" start tag token with no attributes, then switch the "
					a href="#insertion-mode" id=parsing-main-intable:insertion-mode-8 "insertion mode"
					- " to \""
