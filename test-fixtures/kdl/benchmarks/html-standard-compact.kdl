					- " onpopstate "
					c- o="" "="
					c- a="" function
					c- p="" "("
					- event
					c- p="" ")"
					c- p="" "{"
					- " setupPage"
					c- p="" "("
					- event
					c- p="" .
					- state
					c- p="" ");"
					c- p="" "}"
					c- a="" function
					- " setupPage"
					c- p="" "("
