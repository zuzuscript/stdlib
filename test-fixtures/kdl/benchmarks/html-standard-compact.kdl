			a href="#concept-current-everything" id=realms-settings-objects-global-objects:concept-current-everything-2 current
			- " is generally used as the default (e.g., in determining the "
			a data-x-internal=realm href="https://tc39.es/ecma262/#sec-code-realms" id=realms-settings-objects-global-objects:realm-9 realm
			- " whose "
			code Array
