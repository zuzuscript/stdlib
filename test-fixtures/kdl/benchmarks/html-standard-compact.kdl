			dfn data-dfn-for=Document data-dfn-type=attribute id=dom-document-lastmodified {
				code lastModified
			}
			- " attribute, on getting, must return the date and time of the "
			code id=resource-metadata-management:document-8 {
				a href="#document" Document
			}
			- "'s source file's last modification, in the user's local time zone, in the following format:"
		}
		ol {
			li {
				p "The month component of the date."
			}
			li {
				p "A U+002F SOLIDUS character (/)."
			}
			li {
				p "The day component of the date."
			}
			li {
				p "A U+002F SOLIDUS character (/)."
			}
			li {
				p "The year component of the date."
			}
			li {
