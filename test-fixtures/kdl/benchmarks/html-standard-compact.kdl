		}
		p {
			- "A "
			code id=script-processing-model:the-script-element-8 {
				a href="#the-script-element" script
			}
			- " element has a "
			dfn id=concept-script-external "from an external file"
			- " boolean, initially false. It is determined when the script is "
			a href="#prepare-the-script-element" id=script-processing-model:prepare-the-script-element-2 prepared
			- ", based on the "
			code id=script-processing-model:attr-script-src {
				a href="#attr-script-src" src
			}
			- " attribute of the element at that time."
		}
		p {
			- "A "
			code id=script-processing-model:the-script-element-9 {
				a href="#the-script-element" script
			}
			- " element has a "
