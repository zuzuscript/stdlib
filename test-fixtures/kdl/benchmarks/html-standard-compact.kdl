					code author
				}
			}
			dd {
				p "The value must be a free-form string giving the name of one of the page's authors."
			}
			dt {
				dfn data-dfn-for="meta/name" data-dfn-type=attr-value id=meta-description {
					code description
				}
			}
			dd {
				p {
					- "The value must be a free-form string that describes the page. The value must be appropriate for use in a directory of pages, e.g. in a search engine. There must not be more than one "
					code id=standard-metadata-names:the-meta-element-6 {
						a href="#the-meta-element" meta
					}
					- " element where the "
					code id=standard-metadata-names:attr-meta-name-5 {
						a href="#attr-meta-name" name
					}
					- " attribute value is an "
					a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=standard-metadata-names:ascii-case-insensitive-5 "ASCII case-insensitive"
					- " match for "
					code id=standard-metadata-names:meta-description {
						a href="#meta-description" description
					}
					- " per document."
				}
			}
			dt {
				dfn data-dfn-for="meta/name" data-dfn-type=attr-value id=meta-generator {
					code generator
				}
			}
			dd {
				p "The value must be a free-form string that identifies one of the software packages used to generate the document. This value must not be used on pages whose markup is not generated by software, e.g. pages whose markup was written by a user in a text editor."
				div class=example {
					p {
						- "Here is what a tool called \"Frontweaver\" could include in its output, in the page's "
						code id=standard-metadata-names:the-head-element {
							a href="#the-head-element" head
						}
						- " element, to identify itself as the tool used to generate the page:"
