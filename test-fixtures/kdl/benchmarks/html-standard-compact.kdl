					- " list as per the entry in the following list corresponding to the "
					code id=image-map-processing-model:attr-area-shape-2 {
						a href="#attr-area-shape" shape
					}
					- " attribute's state:"
				}
				dl class=switch {
					dt {
						a href="#attr-area-shape-circle" id=image-map-processing-model:attr-area-shape-circle-2 "Circle state"
					}
					dd "Drop any items in the list beyond the third."
					dt {
						a href="#attr-area-shape-default" id=image-map-processing-model:attr-area-shape-default-2 "Default state"
					}
					dd "Drop all items in the list."
					dt {
