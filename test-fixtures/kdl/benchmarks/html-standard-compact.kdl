			p {
				- "MIME type checking for module scripts is strict. In order for the fetch of the "
				a href="#json-module-script" id=the-script-element:json-module-script-3 "JSON module script"
				- " to succeed, the HTTP response must have a "
				a data-x-internal=json-mime-type href="https://mimesniff.spec.whatwg.org/#json-mime-type" id=the-script-element:json-mime-type "JSON MIME type"
				- ", for example "
				code "Content-Type: text/json"
				- ". On the other hand, if the "
				code "with { type: \"json\" }"
				- " part of the statement is omitted, it is assumed that the intent is to import a "
				a href="#javascript-module-script" id=the-script-element:javascript-module-script-11 "JavaScript module script"
				- ", and the fetch will fail if the HTTP response has a MIME type that is not a "
				a data-x-internal=javascript-mime-type href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id=the-script-element:javascript-mime-type "JavaScript MIME type"
				- .
			}
		}
		h5 id=script-processing-model {
			span class=secno "4.12.1.1"
			- " Processing model"
			a class=self-link href="#script-processing-model"
		}
		p {
			- "A "
			code id=script-processing-model:the-script-element {
				a href="#the-script-element" script
			}
			- " element has several associated pieces of state."
		}
		p {
			- "A "
			code id=script-processing-model:the-script-element-2 {
				a href="#the-script-element" script
			}
			- " element has a "
			dfn id=parser-document "parser document"
			- ", which is either null or a "
			code id=script-processing-model:document {
				a href="#document" Document
			}
			- ", initially null. It is set by the "
			a href="#html-parser" id=script-processing-model:html-parser "HTML parser"
			- " and the "
			a href="#xml-parser" id=script-processing-model:xml-parser "XML parser"
			- " on "
			code id=script-processing-model:the-script-element-3 {
				a href="#the-script-element" script
			}
			- " elements they insert, and affects the processing of those elements. "
			code id=script-processing-model:the-script-element-4 {
				a href="#the-script-element" script
			}
			- " elements with non-null "
			a href="#parser-document" id=script-processing-model:parser-document "parser documents"
			- " are known as "
			dfn data-dfn-for=script data-export="" id=parser-inserted parser-inserted
			- .
		}
		p {
			- "A "
			code id=script-processing-model:the-script-element-5 {
				a href="#the-script-element" script
			}
			- " element has a "
			dfn id=preparation-time-document "preparation-time document"
			- ", which is either null or a "
			code id=script-processing-model:document-2 {
				a href="#document" Document
			}
			- ", initially null. It is used to prevent scripts that move between documents during "
			a href="#prepare-the-script-element" id=script-processing-model:prepare-the-script-element preparation
			- " from "
			a href="#execute-the-script-element" id=script-processing-model:execute-the-script-element executing
			- .
		}
		p id=non-blocking {
			- "A "
			code id=script-processing-model:the-script-element-6 {
				a href="#the-script-element" script
			}
			- " element has a "
			dfn id=script-force-async "force async"
			- " boolean, initially true. It is set to false by the "
			a href="#html-parser" id=script-processing-model:html-parser-2 "HTML parser"
			- " and the "
			a href="#xml-parser" id=script-processing-model:xml-parser-2 "XML parser"
			- " on "
			code id=script-processing-model:the-script-element-7 {
				a href="#the-script-element" script
			}
