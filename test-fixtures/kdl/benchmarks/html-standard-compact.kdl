					}
					td class=no "No "
				}
				tr {
					td {
						dfn id=attr-area-shape-keyword-rect {
							code rect
						}
					}
					td {					}
					td rowspan="2" {
						a href="#attr-area-shape-rect" id=the-area-element:attr-area-shape-rect "Rectangle state"
					}
					td rowspan="2" {
						- "Designates a rectangle, using exactly four integers in the "
						code id=the-area-element:attr-area-coords-6 {
							a href="#attr-area-coords" coords
						}
						- " attribute. "
					}
				}
				tr {
