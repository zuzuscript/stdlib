					- " be the result of "
					a href="#encoding-parsing-a-url" id=custom-handlers:encoding-parsing-a-url "encoding-parsing a URL"
					- " given "
					var url
					- ", relative to "
					var environment
					- .
				}
			}
			li {
				p {
					- "If "
					var urlRecord
					- " is failure, then throw a "
					a data-x-internal=syntaxerror href="https://webidl.spec.whatwg.org/#syntaxerror" id=custom-handlers:syntaxerror-4 {
						- "\""
						code SyntaxError
						- "\""
					}
					code id=custom-handlers:domexception-7 {
						a data-x-internal=domexception href="https://webidl.spec.whatwg.org/#dfn-DOMException" DOMException
