					- ". Ignore the token."
				}
			}
			dt "A start tag whose tag name is \"html\""
			dd {
				p {
					- "Process the token "
					a href="#using-the-rules-for" id=parsing-main-inhead:using-the-rules-for "using the rules for"
					- " the \""
					a href="#parsing-main-inbody" id=parsing-main-inhead:parsing-main-inbody "in body"
					- "\" "
					a href="#insertion-mode" id=parsing-main-inhead:insertion-mode-2 "insertion mode"
					- .
				}
			}
			dt "A start tag whose tag name is one of: \"base\", \"basefont\", \"bgsound\", \"link\""
			dd {
				p {
					a href="#insert-an-html-element" id=parsing-main-inhead:insert-an-html-element "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inhead:current-node "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inhead:stack-of-open-elements "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inhead:acknowledge-self-closing-flag {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
			}
			dt "A start tag whose tag name is \"meta\""
			dd {
				p {
					a href="#insert-an-html-element" id=parsing-main-inhead:insert-an-html-element-2 "Insert an HTML element"
					- " for the token. Immediately pop the "
					a href="#current-node" id=parsing-main-inhead:current-node-2 "current node"
					- " off the "
					a href="#stack-of-open-elements" id=parsing-main-inhead:stack-of-open-elements-2 "stack of open elements"
					- .
				}
				p {
					a href="#acknowledge-self-closing-flag" id=parsing-main-inhead:acknowledge-self-closing-flag-2 {
						- "Acknowledge the token's "
						i "self-closing flag"
					}
					- ", if it is set."
				}
				p {
					- "If the "
					a href="#active-speculative-html-parser" id=parsing-main-inhead:active-speculative-html-parser "active speculative HTML parser"
					- " is null, then:"
				}
				ol {
					li {
						p id=meta-charset-during-parse {
							- "If the element has a "
							code id=parsing-main-inhead:attr-meta-charset {
								a href="#attr-meta-charset" charset
							}
							- " attribute, and "
							a data-x-internal=getting-an-encoding href="https://encoding.spec.whatwg.org/#concept-encoding-get" id=parsing-main-inhead:getting-an-encoding "getting an encoding"
							- " from its value results in an "
							a data-x-internal=encoding href="https://encoding.spec.whatwg.org/#encoding" id=parsing-main-inhead:encoding encoding
							- ", and the "
							a href="#concept-encoding-confidence" id=parsing-main-inhead:concept-encoding-confidence confidence
							- " is currently "
							i tentative
							- ", then "
							a href="#change-the-encoding" id=parsing-main-inhead:change-the-encoding "change the encoding"
							- " to the resulting encoding."
						}
					}
					li {
						p {
							- "Otherwise, if the element has an "
							code id=parsing-main-inhead:attr-meta-http-equiv {
								a href="#attr-meta-http-equiv" http-equiv
							}
							- " attribute whose value is an "
							a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=parsing-main-inhead:ascii-case-insensitive "ASCII case-insensitive"
							- " match for the string \""
							code Content-Type
							- "\", and the element has a "
							code id=parsing-main-inhead:attr-meta-content {
								a href="#attr-meta-content" content
							}
							- " attribute, and applying the "
							a href="#algorithm-for-extracting-a-character-encoding-from-a-meta-element" id=parsing-main-inhead:algorithm-for-extracting-a-character-encoding-from-a-meta-element {
								- "algorithm for extracting a character encoding from a "
								code meta
								- " element"
