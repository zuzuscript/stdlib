											code xmlns:
											- "\" followed by the attribute's local name."
										}
									}
									dt {
										- "If the attribute is in the "
										a data-x-internal=xlink-namespace href="https://infra.spec.whatwg.org/#xlink-namespace" id=serialising-html-fragments:xlink-namespace "XLink namespace"
									}
									dd {
										p {
											- "The attribute's serialized name is the string \""
											code xlink:
											- "\" followed by the attribute's local name."
										}
									}
									dt "If the attribute is in some other namespace"
									dd {
										p "The attribute's serialized name is the attribute's qualified name."
									}
