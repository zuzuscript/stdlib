			}
			dt {
				code id="mime-types-2:text/html" {
					a href="#text/html" "text/html"
				}
			}
			dd HTML
			dt {
				code id="mime-types-2:text/ping" {
					a href="#text/ping" "text/ping"
				}
			}
			dd "Hyperlink auditing"
			dt {
				dfn id="text/uri-list" {
					code "text/uri-list"
				}
			}
			dd {
				- "List of URLs "
				a href="#refsRFC2483" "[RFC2483]"
			}
			dt {
				dfn id="text/vcard" {
					code "text/vcard"
				}
			}
			dd {
				- "vCard "
				a href="#refsRFC6350" "[RFC6350]"
			}
			dt {
				dfn id="text/vtt" {
					code "text/vtt"
				}
			}
			dd {
				- "WebVTT "
				a href="#refsWEBVTT" "[WEBVTT]"
			}
			dt {
				dfn id="text/xml" {
					code "text/xml"
				}
			}
			dd {
				- "XML "
				a href="#refsXML" "[XML]"
				a href="#refsRFC7303" "[RFC7303]"
			}
			dt {
				dfn id="video/mp4" {
