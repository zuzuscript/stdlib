				c- s="" "\"The pear is juicy.\""
				c- p="" >
				c- p="" "</"
				c- f="" picture
				c- p="" >
			}
		}
		hr
		p {
			- "Above the "
			code max-width
			- " media feature is used, giving the maximum ("
			a data-x-internal=viewport href="https://drafts.csswg.org/css2/#viewport" id=adaptive-images:viewport-2 viewport
			- ") dimensions that an image is intended for. It is also possible to use "
			code min-width
			- " instead."
		}
		pre {
			code class=html {
				c- p="" <
				c- f="" picture
				c- p="" >
				c- p="" <
				c- f="" source
