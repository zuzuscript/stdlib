			a href="#module-specifier-map" id=the-resolution-algorithm:module-specifier-map-2 "module specifier maps"
			- ", "
			a href="#resolve-a-module-specifier" id=the-resolution-algorithm:resolve-a-module-specifier-5 "resolve a module specifier"
			- " will throw an exception. Thus the result is always either a "
			a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=the-resolution-algorithm:url-3 URL
			- " or a thrown exception."
		}
