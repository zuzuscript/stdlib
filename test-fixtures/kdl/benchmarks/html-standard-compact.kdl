							- ".[[ArrayBufferData]], whose [[ArrayBufferByteLength]] internal slot value is "
							var transferDataHolder
							- ".[[ArrayBufferByteLength]], and whose [[ArrayBufferMaxByteLength]] internal slot value is "
							var transferDataHolder
							- ".[[ArrayBufferMaxByteLength]]."
