					td {
						dfn data-dfn-for="html-global/dir" data-dfn-type=attr-value id=attr-dir-auto {
							code auto
						}
					}
					td {
						dfn id=attr-dir-auto-state auto
					}
					td "The contents of the element are explicitly directionally isolated text, but the direction is to be determined programmatically using the contents of the element (as described below). "
