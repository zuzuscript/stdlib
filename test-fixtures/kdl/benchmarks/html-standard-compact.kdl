					- " given "
					var urlRecord
					- " is \""
					code "Potentially Trustworthy"
					- "\"."
				}
				p class=note {
					- "Because "
					a href="#normalize-protocol-handler-parameters" id=custom-handlers:normalize-protocol-handler-parameters-3 "normalize protocol handler parameters"
					- " is run within a "
					a href="#secure-context" id=custom-handlers:secure-context "secure context"
					- ", this is implied by the "
					a href="#same-origin" id=custom-handlers:same-origin-2 "same origin"
					- " condition."
