					c- p="" "</"
					c- f="" a
					c- p="" >
					- "? "
					c- p="" "</"
					c- f="" p
					c- p="" >
				}
			}
			p "The problem with such a system is that each time the user clicks, the whole page has to be reloaded. Here instead is another way of doing it, using script:"
			pre {
				code class=html {
					c- cp="" "<!DOCTYPE HTML>"
					c- c="" "<!-- this starts off as https://example.com/line?x=5 -->"
					c- p="" <
					c- f="" html
					c- e="" lang
					c- o="" "="
					c- s="" "\"en\""
					c- p="" >
