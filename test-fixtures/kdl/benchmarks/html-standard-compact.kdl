			pre {
				code class=js {
					- window
					c- p="" .
					- "onload "
					c- o="" "="
					c- p="" "()"
					c- p="" "=>"
					c- p="" "{"
					c- c1="" "// This will work as normal: it is the first close watcher created without user activation."
					c- p="" "("
					c- k="" new
