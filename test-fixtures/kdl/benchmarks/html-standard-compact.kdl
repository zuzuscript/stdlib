							- ", "
							a data-x-internal=collect-a-sequence-of-code-points href="https://infra.spec.whatwg.org/#collect-a-sequence-of-code-points" id=lists-of-dimensions:collect-a-sequence-of-code-points "collect a sequence of code points"
							- " that are "
							a data-x-internal=ascii-digits href="https://infra.spec.whatwg.org/#ascii-digit" id=lists-of-dimensions:ascii-digits-2 "ASCII digits"
							- " from "
							var input
							- " given "
							var position
							- ", interpret the resulting sequence as an integer in base ten, and increment "
