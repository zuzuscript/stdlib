					- " property."
				}
			}
		}
		p {
			- "The "
			dfn id=text-preparation-algorithm "text preparation algorithm"
			- " is as follows. It takes as input a string "
			var text
			- ", a "
			code id=text-styles:canvastextdrawingstyles-12 {
				a href="#canvastextdrawingstyles" CanvasTextDrawingStyles
			}
			- " object "
			var target
			- ", and an optional length "
			var maxWidth
			- ". It returns an array of glyph shapes, each positioned on a common coordinate space, a "
			var "physical alignment"
			- " whose value is one of "
			i left
			- ", "
			i right
			- ", and "
			i center
			- ", and an "
			a data-x-internal=inline-box href="https://drafts.csswg.org/css2/#inline-box" id=text-styles:inline-box "inline box"
			- ". (Most callers of this algorithm ignore the "
			var "physical alignment"
			- " and the "
			a data-x-internal=inline-box href="https://drafts.csswg.org/css2/#inline-box" id=text-styles:inline-box-2 "inline box"
			- ".)"
		}
		ol {
			li {
				p {
					- "If "
					var maxWidth
					- " was provided but is less than or equal to zero or equal to NaN, then return an empty array."
				}
			}
			li {
				p {
					- "Replace all "
					a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=text-styles:space-characters "ASCII whitespace"
					- " in "
					var text
					- " with U+0020 SPACE characters."
				}
			}
			li {
				p {
					- "Let "
					var font
					- " be the current font of "
					var target
					- ", as given by that object's "
					code id=text-styles:dom-context-2d-font-3 {
						a href="#dom-context-2d-font" font
					}
