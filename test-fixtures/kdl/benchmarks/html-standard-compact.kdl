			li {
				p {
					- "If any value in "
					var segments
					- " is not finite (e.g. an Infinity or a NaN value), or if any value is negative (less than zero), then return (without throwing an exception; user agents could show a message on a developer console, though, as that would be helpful for debugging)."
				}
			}
			li {
				p {
					- "If the number of elements in "
					var segments
					- " is odd, then let "
					var segments
					- " be the concatenation of two copies of "
					var segments
					- .
				}
			}
			li {
				p {
					- "Let the object's "
					a href="#dash-list" id=line-styles:dash-list-2 "dash list"
					- " be "
