		}
		p {
			- "The "
			code id=the-step-attribute:attr-input-step-2 {
				a href="#attr-input-step" step
			}
			- " attribute, if specified, must either have a value that is a "
			a href="#valid-floating-point-number" id=the-step-attribute:valid-floating-point-number "valid floating-point number"
			- " that "
			a href="#rules-for-parsing-floating-point-number-values" id=the-step-attribute:rules-for-parsing-floating-point-number-values parses
			- " to a number that is greater than zero, or must have a value that is an "
			a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=the-step-attribute:ascii-case-insensitive "ASCII case-insensitive"
			- " match for the string \""
			code any
			- "\"."
		}
		p {
			- "The attribute provides the "
			dfn id=concept-input-step "allowed value step"
			- " for the element, as follows:"
		}
		ol {
			li {
				p {
					- "If the attribute does not "
					a href="#concept-input-apply" id=the-step-attribute:concept-input-apply apply
					- ", then there is no "
					a href="#concept-input-step" id=the-step-attribute:concept-input-step "allowed value step"
					- .
				}
			}
			li {
				p {
					- "Otherwise, if the attribute is absent, then the "
					a href="#concept-input-step" id=the-step-attribute:concept-input-step-2 "allowed value step"
					- " is the "
					a href="#concept-input-step-default" id=the-step-attribute:concept-input-step-default "default step"
					- " multiplied by the "
					a href="#concept-input-step-scale" id=the-step-attribute:concept-input-step-scale "step scale factor"
					- .
				}
			}
			li {
				p {
					- "Otherwise, if the attribute's value is an "
					a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=the-step-attribute:ascii-case-insensitive-2 "ASCII case-insensitive"
					- " match for the string \""
					code any
					- "\", then there is no "
					a href="#concept-input-step" id=the-step-attribute:concept-input-step-3 "allowed value step"
					- .
				}
			}
			li {
				p {
					- "Otherwise, if the "
					a href="#rules-for-parsing-floating-point-number-values" id=the-step-attribute:rules-for-parsing-floating-point-number-values-2 "rules for parsing floating-point number values"
					- ", when they are applied to the attribute's value, return an error, zero, or a number less than zero, then the "
					a href="#concept-input-step" id=the-step-attribute:concept-input-step-4 "allowed value step"
					- " is the "
					a href="#concept-input-step-default" id=the-step-attribute:concept-input-step-default-2 "default step"
					- " multiplied by the "
					a href="#concept-input-step-scale" id=the-step-attribute:concept-input-step-scale-2 "step scale factor"
					- .
				}
			}
			li {
				p {
					- "Otherwise, the "
					a href="#concept-input-step" id=the-step-attribute:concept-input-step-5 "allowed value step"
					- " is the number returned by the "
					a href="#rules-for-parsing-floating-point-number-values" id=the-step-attribute:rules-for-parsing-floating-point-number-values-3 "rules for parsing floating-point number values"
					- " when they are applied to the attribute's value, multiplied by the "
					a href="#concept-input-step-scale" id=the-step-attribute:concept-input-step-scale-3 "step scale factor"
					- .
				}
			}
		}
		p {
			- "The "
			dfn id=concept-input-min-zero "step base"
			- " is the value returned by the following algorithm:"
		}
		ol {
			li {
				p {
					- "If the element has a "
					code id=the-step-attribute:attr-input-min {
						a href="#attr-input-min" min
					}
					- " content attribute, and the result of applying the "
					a href="#concept-input-value-string-number" id=the-step-attribute:concept-input-value-string-number "algorithm to convert a string to a number"
					- " to the value of the "
					code id=the-step-attribute:attr-input-min-2 {
						a href="#attr-input-min" min
					}
					- " content attribute is not an error, then return that result."
				}
			}
			li {
				p {
					- "If the element has a "
					code id=the-step-attribute:attr-input-value {
						a href="#attr-input-value" value
					}
					- " content attribute, and the result of applying the "
					a href="#concept-input-value-string-number" id=the-step-attribute:concept-input-value-string-number-2 "algorithm to convert a string to a number"
					- " to the value of the "
					code id=the-step-attribute:attr-input-value-2 {
						a href="#attr-input-value" value
					}
					- " content attribute is not an error, then return that result."
				}
			}
			li {
				p {
					- "If a "
					a href="#concept-input-step-default-base" id=the-step-attribute:concept-input-step-default-base "default step base"
					- " is defined for this element given its "
					code id=the-step-attribute:attr-input-type-2 {
						a href="#attr-input-type" type
					}
					- " attribute's state, then return it."
				}
			}
			li {
				p "Return zero."
			}
		}
		p {
			strong "Constraint validation"
			- ": When the element has an "
			a href="#concept-input-step" id=the-step-attribute:concept-input-step-6 "allowed value step"
			- ", and the result of applying the "
			a href="#concept-input-value-string-number" id=the-step-attribute:concept-input-value-string-number-3 "algorithm to convert a string to a number"
			- " to the string given by the element's "
			a href="#concept-fe-value" id=the-step-attribute:concept-fe-value-2 value
			- " is a number, and that number subtracted from the "
			a href="#concept-input-min-zero" id=the-step-attribute:concept-input-min-zero "step base"
			- " is not an integral multiple of the "
			a href="#concept-input-step" id=the-step-attribute:concept-input-step-7 "allowed value step"
			- ", the element is "
			a href="#suffering-from-a-step-mismatch" id=the-step-attribute:suffering-from-a-step-mismatch "suffering from a step mismatch"
			- .
		}
		div class=example {
			p "The following range control only accepts values in the range 0..1, and allows 256 steps in that range:"
			pre {
				code class=html {
					c- p="" <
					c- f="" input
					c- e="" name
					c- o="" "="
					c- s="" opacity
					c- e="" type
					c- o="" "="
