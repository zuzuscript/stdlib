				c- p="" ");"
				c- p="" "}"
			}
		}
		p {
			- "The "
			code id=navigation-api-intro:dom-navigation-entries {
				a href="#dom-navigation-entries" "navigation.entries()"
			}
			- " array contains "
			code id=navigation-api-intro:navigationhistoryentry {
				a href="#navigationhistoryentry" NavigationHistoryEntry
			}
			- " instances, which have other useful properties in addition to the "
			code id=navigation-api-intro:dom-navigationhistoryentry-url {
				a href="#dom-navigationhistoryentry-url" url
			}
			- " and "
			code id=navigation-api-intro:dom-navigationhistoryentry-index {
				a href="#dom-navigationhistoryentry-index" index
			}
			- " properties shown here. Note that the array only contains "
			code id=navigation-api-intro:navigationhistoryentry-2 {
				a href="#navigationhistoryentry" NavigationHistoryEntry
			}
			- " objects that represent the current "
			a href="#navigable" id=navigation-api-intro:navigable navigable
			- ", and thus its contents are not impacted by navigations inside "
			a href="#navigable-container" id=navigation-api-intro:navigable-container "navigable containers"
			- " such as "
			code id=navigation-api-intro:the-iframe-element {
				a href="#the-iframe-element" iframe
			}
			- "s, or by navigations of the "
			a href="#nav-parent" id=navigation-api-intro:nav-parent "parent navigable"
			- " in cases where the navigation API is itself being used inside an "
			code id=navigation-api-intro:the-iframe-element-2 {
				a href="#the-iframe-element" iframe
			}
			- ". Additionally, it only contains "
			code id=navigation-api-intro:navigationhistoryentry-3 {
				a href="#navigationhistoryentry" NavigationHistoryEntry
			}
			- " objects representing same-"
			a href="#concept-origin" id=navigation-api-intro:concept-origin origin
			a href="#session-history-entry" id=navigation-api-intro:session-history-entry-2 "session history entries"
			- ", meaning that if the user has visited other origins before or after the current one, there will not be corresponding "
			code id=navigation-api-intro:navigationhistoryentry-4 {
				a href="#navigationhistoryentry" NavigationHistoryEntry
			}
			- s.
		}
		hr
		p "The navigation API can also be used to navigate, reload, or traverse through the history:"
		pre {
			code class=html {
				c- p="" <
				c- f="" button
