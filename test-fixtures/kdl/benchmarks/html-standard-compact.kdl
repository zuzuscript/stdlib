							var completion
							- " be null."
						}
					}
					li {
						p {
							- "If "
							var moduleScript
							- " is null, then set "
							var completion
							- " to "
							a data-x-internal=completion-record href="https://tc39.es/ecma262/#sec-completion-record-specification-type" id=hostloadimportedmodule:completion-record-6 "Completion Record"
							- " { [[Type]]: throw, [[Value]]: a new "
							code id=hostloadimportedmodule:typeerror-3 {
								a data-x-internal=typeerror href="https://tc39.es/ecma262/#sec-native-error-types-used-in-this-standard-typeerror" TypeError
							}
							- ", [[Target]]: empty }."
						}
					}
					li {
						p {
							- "Otherwise, if "
							var moduleScript
							- "'s "
							a href="#concept-script-parse-error" id=hostloadimportedmodule:concept-script-parse-error "parse error"
							- " is not null, then:"
						}
						ol {
							li {
								p {
									- "Let "
									var parseError
									- " be "
									var moduleScript
									- "'s "
									a href="#concept-script-parse-error" id=hostloadimportedmodule:concept-script-parse-error-2 "parse error"
									- .
								}
							}
							li {
								p {
									- "Set "
									var completion
									- " to "
									a data-x-internal=completion-record href="https://tc39.es/ecma262/#sec-completion-record-specification-type" id=hostloadimportedmodule:completion-record-7 "Completion Record"
									- " { [[Type]]: throw, [[Value]]: "
									var parseError
									- ", [[Target]]: empty }."
								}
							}
							li {
								p {
									- "If "
									var loadState
									- " is not undefined and "
									var loadState
									- ".[[ParseError]] is null, set "
									var loadState
									- ".[[ParseError]] to "
									var parseError
									- .
								}
							}
						}
					}
					li {
						p {
							- "Otherwise, set "
							var completion
							- " to "
							a data-x-internal=completion-record href="https://tc39.es/ecma262/#sec-completion-record-specification-type" id=hostloadimportedmodule:completion-record-8 "Completion Record"
							- " { [[Type]]: normal, [[Value]]: "
							var moduleScript
							- "'s "
							a href="#concept-script-record" id=hostloadimportedmodule:concept-script-record record
							- ", [[Target]]: empty }."
						}
					}
					li {
						p {
							- "Perform "
							a data-x-internal=finishloadingimportedmodule href="https://tc39.es/ecma262/#sec-FinishLoadingImportedModule" id=hostloadimportedmodule:finishloadingimportedmodule-6 FinishLoadingImportedModule
							- "("
							var referrer
							- ", "
							var moduleRequest
							- ", "
							var payload
							- ", "
							var completion
							- ")."
						}
					}
				}
			}
		}
		h4 id=event-loops {
			span class=secno "8.1.7"
			- " Event loops"
			a class=self-link href="#event-loops"
		}
		h5 id=definitions-3 {
			span class=secno "8.1.7.1"
			- " Definitions"
			a class=self-link href="#definitions-3"
		}
		p {
			- "To coordinate events, user interaction, scripts, rendering, networking, and so forth, user agents must use "
			dfn data-export="" data-lt="event loop" id=event-loop "event loops"
			- " as described in this section. Each "
			a data-x-internal=agent href="https://tc39.es/ecma262/#sec-agents" id=definitions-3:agent agent
			- " has an associated "
			dfn data-dfn-for=agent data-export="" id=concept-agent-event-loop "event loop"
			- ", which is unique to that agent."
		}
		p {
			- "The "
			a href="#concept-agent-event-loop" id=definitions-3:concept-agent-event-loop "event loop"
			- " of a "
			a href="#similar-origin-window-agent" id=definitions-3:similar-origin-window-agent "similar-origin window agent"
			- " is known as a "
			dfn id=window-event-loop "window event loop"
			- ". The "
			a href="#concept-agent-event-loop" id=definitions-3:concept-agent-event-loop-2 "event loop"
			- " of a "
			a href="#dedicated-worker-agent" id=definitions-3:dedicated-worker-agent "dedicated worker agent"
			- ", "
			a href="#shared-worker-agent" id=definitions-3:shared-worker-agent "shared worker agent"
			- ", or "
			a href="#service-worker-agent" id=definitions-3:service-worker-agent "service worker agent"
			- " is known as a "
			dfn id=worker-event-loop-2 "worker event loop"
			- ". And the "
			a href="#concept-agent-event-loop" id=definitions-3:concept-agent-event-loop-3 "event loop"
			- " of a "
			a href="#worklet-agent" id=definitions-3:worklet-agent "worklet agent"
			- " is known as a "
			dfn id=worklet-event-loop "worklet event loop"
			- .
		}
		div class=note {
			p {
				a href="#event-loop" id=definitions-3:event-loop "Event loops"
				- " do not necessarily correspond to implementation threads. For example, multiple "
				a href="#window-event-loop" id=definitions-3:window-event-loop "window event loops"
				- " could be cooperatively scheduled in a single thread."
			}
			p {
				- "However, for the various worker "
				a data-x-internal=agent href="https://tc39.es/ecma262/#sec-agents" id=definitions-3:agent-2 agents
				- " that are allocated with [[CanBlock]] set to true, the JavaScript specification does place requirements on them regarding "
				a data-x-internal=forward-progress href="https://tc39.es/ecma262/#sec-forward-progress" id=definitions-3:forward-progress "forward progress"
				- ", which effectively amount to requiring dedicated per-agent threads in those cases."
			}
		}
		hr
		p {
			- "An "
			a href="#event-loop" id=definitions-3:event-loop-2 "event loop"
			- " has one or more "
			dfn id=task-queue "task queues"
			- ". A "
			a href="#task-queue" id=definitions-3:task-queue "task queue"
			- " is a "
			a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=definitions-3:set set
			- " of "
			a href="#concept-task" id=definitions-3:concept-task tasks
			- .
		}
		p class=note {
			a href="#task-queue" id=definitions-3:task-queue-2 "Task queues"
			- " are "
			a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=definitions-3:set-2 sets
			- ", not "
			a data-x-internal=queue href="https://infra.spec.whatwg.org/#queue" id=definitions-3:queue queues
			- ", because the "
			a href="#event-loop-processing-model" "event loop processing model"
			- " grabs the first "
			a href="#concept-task-runnable" id=definitions-3:concept-task-runnable {
				em runnable
			}
			a href="#concept-task" id=definitions-3:concept-task-2 task
			- " from the chosen queue, instead of "
			a data-x-internal=dequeue href="https://infra.spec.whatwg.org/#queue-dequeue" id=definitions-3:dequeue dequeuing
			- " the first task."
		}
		p class=note {
			- "The "
			a href="#microtask-queue" id=definitions-3:microtask-queue "microtask queue"
			- " is not a "
			a href="#task-queue" id=definitions-3:task-queue-3 "task queue"
			- .
		}
		p "Tasks encapsulate algorithms that are responsible for such work as:"
		dl {
			dt Events
			dd {
				p {
					- "Dispatching an "
					code id=definitions-3:event {
						a data-x-internal=event href="https://dom.spec.whatwg.org/#interface-event" Event
					}
					- " object at a particular "
					code id=definitions-3:eventtarget {
						a data-x-internal=eventtarget href="https://dom.spec.whatwg.org/#interface-eventtarget" EventTarget
					}
					- " object is often done by a dedicated task."
				}
				p class=note {
					- "Not all events are dispatched using the "
					a href="#task-queue" id=definitions-3:task-queue-4 "task queue"
					- "; many are dispatched during other tasks."
				}
			}
			dt Parsing
			dd {
				p {
					- "The "
					a href="#html-parser" id=definitions-3:html-parser "HTML parser"
					- " tokenizing one or more bytes, and then processing any resulting tokens, is typically a task."
				}
			}
			dt Callbacks
			dd {
				p "Calling a callback is often done by a dedicated task."
			}
			dt "Using a resource"
			dd {
				p {
					- "When an algorithm "
					a data-x-internal=concept-fetch href="https://fetch.spec.whatwg.org/#concept-fetch" id=definitions-3:concept-fetch fetches
					- " a resource, if the fetching occurs in a non-blocking fashion then the processing of the resource once some or all of the resource is available is performed by a task."
				}
			}
			dt "Reacting to DOM manipulation"
			dd {
				p {
					- "Some elements have tasks that trigger in response to DOM manipulation, e.g. when that element is "
					a href="#insert-an-element-into-a-document" id=definitions-3:insert-an-element-into-a-document "inserted into the document"
					- .
				}
			}
		}
		p {
			- "Formally, a "
			dfn data-export="" data-lt=task id=concept-task task
			- " is a "
			a data-x-internal=struct href="https://infra.spec.whatwg.org/#struct" id=definitions-3:struct struct
			- " which has:"
		}
		dl {
			dt {
				dfn id=concept-task-steps Steps
			}
			dd "A series of steps specifying the work to be done by the task."
			dt {
				- "A "
				dfn id=concept-task-source source
			}
			dd {
				- "One of the "
				a href="#task-source" id=definitions-3:task-source "task sources"
				- ", used to group and serialize related tasks."
			}
			dt {
				- "A "
				dfn id=concept-task-document document
			}
			dd {
				- "A "
				code id=definitions-3:document {
					a href="#document" Document
				}
				- " associated with the task, or null for tasks that are not in a "
				a href="#window-event-loop" id=definitions-3:window-event-loop-2 "window event loop"
				- .
			}
			dt {
				- "A "
				dfn data-export="" id=script-evaluation-environment-settings-object-set "script evaluation environment settings object set"
			}
			dd {
				- "A "
				a data-x-internal=set href="https://infra.spec.whatwg.org/#ordered-set" id=definitions-3:set-3 set
				- " of "
				a href="#environment-settings-object" id=definitions-3:environment-settings-object "environment settings objects"
				- " used for tracking script evaluation during the task."
			}
		}
		p {
			- "A "
			a href="#concept-task" id=definitions-3:concept-task-3 task
			- " is "
			dfn id=concept-task-runnable runnable
			- " if its "
			a href="#concept-task-document" id=definitions-3:concept-task-document document
			- " is either null or "
			a href="#fully-active" id=definitions-3:fully-active "fully active"
			- .
		}
		p {
			- "Per its "
			a href="#concept-task-source" id=definitions-3:concept-task-source source
			- " field, each "
			a href="#concept-task" id=definitions-3:concept-task-4 task
			- " is defined as coming from a specific "
			dfn data-export="" id=task-source "task source"
			- ". For each "
			a href="#event-loop" id=definitions-3:event-loop-3 "event loop"
			- ", every "
			a href="#task-source" id=definitions-3:task-source-2 "task source"
			- " must be associated with a specific "
			a href="#task-queue" id=definitions-3:task-queue-5 "task queue"
			- .
		}
		p class=note {
			- "Essentially, "
			a href="#task-source" id=definitions-3:task-source-3 "task sources"
			- " are used within standards to separate logically-different types of tasks, which a user agent might wish to distinguish between. "
			a href="#task-queue" id=definitions-3:task-queue-6 "Task queues"
			- " are used by user agents to coalesce task sources within a given "
			a href="#event-loop" id=definitions-3:event-loop-4 "event loop"
			- .
		}
		p class=example {
			- "For example, a user agent could have one "
			a href="#task-queue" id=definitions-3:task-queue-7 "task queue"
			- " for mouse and key events (to which the "
			a href="#user-interaction-task-source" id=definitions-3:user-interaction-task-source "user interaction task source"
			- " is associated), and another to which all other "
			a href="#task-source" id=definitions-3:task-source-4 "task sources"
			- " are associated. Then, using the freedom granted in the initial step of the "
			a href="#event-loop-processing-model" "event loop processing model"
			- ", it could give keyboard and mouse events preference over other tasks three-quarters of the time, keeping the interface responsive but not starving other task queues. Note that in this setup, the processing model still enforces that the user agent would never process events from any one "
			a href="#task-source" id=definitions-3:task-source-5 "task source"
			- " out of order."
		}
		hr
		p {
			- "Each "
			a href="#event-loop" id=definitions-3:event-loop-5 "event loop"
			- " has a "
			dfn id=currently-running-task "currently running task"
			- ", which is either a "
			a href="#concept-task" id=definitions-3:concept-task-5 task
			- " or null. Initially, this is null. It is used to handle reentrancy."
		}
		p {
			- "Each "
			a href="#event-loop" id=definitions-3:event-loop-6 "event loop"
			- " has a "
			dfn id=microtask-queue "microtask queue"
			- ", which is a "
			a data-x-internal=queue href="https://infra.spec.whatwg.org/#queue" id=definitions-3:queue-2 queue
			- " of "
			a href="#microtask" id=definitions-3:microtask microtasks
			- ", initially empty. A "
			dfn data-export="" id=microtask microtask
			- " is a colloquial way of referring to a "
			a href="#concept-task" id=definitions-3:concept-task-6 task
			- " that was created via the "
			a href="#queue-a-microtask" id=definitions-3:queue-a-microtask "queue a microtask"
			- " algorithm."
		}
		p {
			- "Each "
			a href="#event-loop" id=definitions-3:event-loop-7 "event loop"
			- " has a "
			dfn id=performing-a-microtask-checkpoint "performing a microtask checkpoint"
			- " boolean, which is initially false. It is used to prevent reentrant invocation of the "
			a href="#perform-a-microtask-checkpoint" id=definitions-3:perform-a-microtask-checkpoint "perform a microtask checkpoint"
			- " algorithm."
		}
		p {
			- "Each "
			a href="#window-event-loop" id=definitions-3:window-event-loop-3 "window event loop"
			- " has a "
			code id=definitions-3:domhighrestimestamp {
				a data-x-internal=domhighrestimestamp href="https://w3c.github.io/hr-time/#dom-domhighrestimestamp" DOMHighResTimeStamp
			}
			dfn id=last-render-opportunity-time "last render opportunity time"
			- ", initially set to zero."
		}
		p {
			- "Each "
			a href="#window-event-loop" id=definitions-3:window-event-loop-4 "window event loop"
			- " has a "
			code id=definitions-3:domhighrestimestamp-2 {
				a data-x-internal=domhighrestimestamp href="https://w3c.github.io/hr-time/#dom-domhighrestimestamp" DOMHighResTimeStamp
			}
			dfn id=last-idle-period-start-time "last idle period start time"
			- ", initially set to zero."
		}
		p {
			- "To get the "
			dfn id=same-loop-windows "same-loop windows"
			- " for a "
			a href="#window-event-loop" id=definitions-3:window-event-loop-5 "window event loop"
			var loop
			- ", return all "
			code id=definitions-3:window {
				a href="#window" Window
			}
			- " objects whose "
			a href="#relevant-agent" id=definitions-3:relevant-agent "relevant agent"
			- "'s "
			a href="#concept-agent-event-loop" id=definitions-3:concept-agent-event-loop-4 "event loop"
			- " is "
			var loop
			- .
		}
		h5 id=queuing-tasks {
			span class=secno "8.1.7.2"
			- " Queuing tasks"
			a class=self-link href="#queuing-tasks"
		}
		p {
