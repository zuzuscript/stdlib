					li {
						p {
							- "Let "
							var "declarative shadow host element"
							- " be "
							a href="#adjusted-current-node" id=parsing-main-inhead:adjusted-current-node-2 "adjusted current node"
							- .
						}
					}
					li {
						p {
							- "Let "
							var template
							- " be the result of "
