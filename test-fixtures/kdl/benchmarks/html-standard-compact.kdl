		h5 id=bogus-comment-state {
			span class=secno "13.2.5.41"
			dfn "Bogus comment state"
			a class=self-link href="#bogus-comment-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=bogus-comment-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "Switch to the "
				a href="#data-state" id=bogus-comment-state:data-state "data state"
				- ". Emit the current comment token."
			}
			dt EOF
			dd "Emit the comment. Emit an end-of-file token."
			dt "U+0000 NULL"
			dd {
				- "This is an "
				a href="#parse-error-unexpected-null-character" id=bogus-comment-state:parse-error-unexpected-null-character unexpected-null-character
				a href="#parse-errors" id=bogus-comment-state:parse-errors "parse error"
				- ". Append a U+FFFD REPLACEMENT CHARACTER character to the comment token's data."
			}
			dt "Anything else"
			dd {
				- "Append the "
				a href="#current-input-character" id=bogus-comment-state:current-input-character "current input character"
				- " to the comment token's data."
			}
		}
		h5 id=markup-declaration-open-state {
			span class=secno "13.2.5.42"
			dfn "Markup declaration open state"
			a class=self-link href="#markup-declaration-open-state"
		}
		p "If the next few characters are:"
		dl class=switch {
			dt "Two U+002D HYPHEN-MINUS characters (-)"
			dd {
				- "Consume those two characters, create a comment token whose data is the empty string, and switch to the "
				a href="#comment-start-state" id=markup-declaration-open-state:comment-start-state "comment start state"
				- .
			}
			dt {
				a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=markup-declaration-open-state:ascii-case-insensitive "ASCII case-insensitive"
				- " match for the word \"DOCTYPE\""
			}
			dd {
				- "Consume those characters and switch to the "
				a href="#doctype-state" id=markup-declaration-open-state:doctype-state "DOCTYPE state"
				- .
			}
			dt "The string \"[CDATA[\" (the five uppercase letters \"CDATA\" with a U+005B LEFT SQUARE BRACKET character before and after)"
			dd {
				- "Consume those characters. If there is an "
				a href="#adjusted-current-node" id=markup-declaration-open-state:adjusted-current-node "adjusted current node"
				- " and it is not an element in the "
				a data-x-internal=html-namespace-2 href="https://infra.spec.whatwg.org/#html-namespace" id=markup-declaration-open-state:html-namespace-2 "HTML namespace"
				- ", then switch to the "
				a href="#cdata-section-state" id=markup-declaration-open-state:cdata-section-state "CDATA section state"
				- ". Otherwise, this is a "
				a href="#parse-error-cdata-in-html-content" id=markup-declaration-open-state:parse-error-cdata-in-html-content cdata-in-html-content
				a href="#parse-errors" id=markup-declaration-open-state:parse-errors "parse error"
				- ". Create a comment token whose data is the \"[CDATA[\" string. Switch to the "
				a href="#bogus-comment-state" id=markup-declaration-open-state:bogus-comment-state "bogus comment state"
				- .
			}
			dt "Anything else"
			dd {
				- "This is an "
				a href="#parse-error-incorrectly-opened-comment" id=markup-declaration-open-state:parse-error-incorrectly-opened-comment incorrectly-opened-comment
				a href="#parse-errors" id=markup-declaration-open-state:parse-errors-2 "parse error"
				- ". Create a comment token whose data is the empty string. Switch to the "
				a href="#bogus-comment-state" id=markup-declaration-open-state:bogus-comment-state-2 "bogus comment state"
				- " (don't consume anything in the current state)."
			}
		}
		h5 id=comment-start-state {
			span class=secno "13.2.5.43"
			dfn "Comment start state"
			a class=self-link href="#comment-start-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=comment-start-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+002D HYPHEN-MINUS (-)"
			dd {
				- "Switch to the "
				a href="#comment-start-dash-state" id=comment-start-state:comment-start-dash-state "comment start dash state"
				- .
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is an "
				a href="#parse-error-abrupt-closing-of-empty-comment" id=comment-start-state:parse-error-abrupt-closing-of-empty-comment abrupt-closing-of-empty-comment
				a href="#parse-errors" id=comment-start-state:parse-errors "parse error"
				- ". Switch to the "
				a href="#data-state" id=comment-start-state:data-state "data state"
				- ". Emit the current comment token."
			}
			dt "Anything else"
			dd {
				a href="#reconsume" id=comment-start-state:reconsume Reconsume
				- " in the "
				a href="#comment-state" id=comment-start-state:comment-state "comment state"
				- .
			}
		}
		h5 id=comment-start-dash-state {
			span class=secno "13.2.5.44"
			dfn "Comment start dash state"
			a class=self-link href="#comment-start-dash-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=comment-start-dash-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+002D HYPHEN-MINUS (-)"
			dd {
				- "Switch to the "
				a href="#comment-end-state" id=comment-start-dash-state:comment-end-state "comment end state"
				- .
			}
			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is an "
				a href="#parse-error-abrupt-closing-of-empty-comment" id=comment-start-dash-state:parse-error-abrupt-closing-of-empty-comment abrupt-closing-of-empty-comment
				a href="#parse-errors" id=comment-start-dash-state:parse-errors "parse error"
				- ". Switch to the "
				a href="#data-state" id=comment-start-dash-state:data-state "data state"
				- ". Emit the current comment token."
			}
			dt EOF
			dd {
				- "This is an "
				a href="#parse-error-eof-in-comment" id=comment-start-dash-state:parse-error-eof-in-comment eof-in-comment
				a href="#parse-errors" id=comment-start-dash-state:parse-errors-2 "parse error"
				- ". Emit the current comment token. Emit an end-of-file token."
			}
			dt "Anything else"
			dd {
				- "Append a U+002D HYPHEN-MINUS character (-) to the comment token's data. "
				a href="#reconsume" id=comment-start-dash-state:reconsume Reconsume
				- " in the "
				a href="#comment-state" id=comment-start-dash-state:comment-state "comment state"
				- .
			}
		}
		h5 id=comment-state {
			span class=secno "13.2.5.45"
			dfn id=comment "Comment state"
			a class=self-link href="#comment-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=comment-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+003C LESS-THAN SIGN (<)"
			dd {
				- "Append the "
				a href="#current-input-character" id=comment-state:current-input-character "current input character"
				- " to the comment token's data. Switch to the "
				a href="#comment-less-than-sign-state" id=comment-state:comment-less-than-sign-state "comment less-than sign state"
				- .
			}
			dt "U+002D HYPHEN-MINUS (-)"
			dd {
				- "Switch to the "
