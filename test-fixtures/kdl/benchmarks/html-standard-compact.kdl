				- .
			}
			dt "Anything else"
			dd {
				- "This is a "
				a href="#parse-error-nested-comment" id=comment-less-than-sign-bang-dash-dash-state:parse-error-nested-comment nested-comment
				a href="#parse-errors" id=comment-less-than-sign-bang-dash-dash-state:parse-errors "parse error"
				- ". "
				a href="#reconsume" id=comment-less-than-sign-bang-dash-dash-state:reconsume-2 Reconsume
				- " in the "
				a href="#comment-end-state" id=comment-less-than-sign-bang-dash-dash-state:comment-end-state-2 "comment end state"
				- .
			}
		}
		h5 id=comment-end-dash-state {
			span class=secno "13.2.5.50"
			dfn "Comment end dash state"
			a class=self-link href="#comment-end-dash-state"
		}
		p {
			- "Consume the "
			a href="#next-input-character" id=comment-end-dash-state:next-input-character "next input character"
			- :
		}
		dl class=switch {
			dt "U+002D HYPHEN-MINUS (-)"
			dd {
				- "Switch to the "
				a href="#comment-end-state" id=comment-end-dash-state:comment-end-state "comment end state"
				- .
			}
			dt EOF
			dd {
				- "This is an "
