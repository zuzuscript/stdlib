									- "A token that is an "
									a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=autofilling-form-controls:-the-autocomplete-attribute:ascii-case-insensitive-7 "ASCII case-insensitive"
									- " match for one of the following "
									a href="#autofill-field" id=autofilling-form-controls:-the-autocomplete-attribute:autofill-field-2 "autofill field"
									- " names, excluding those that are "
									a href="#inappropriate-for-the-control" id=autofilling-form-controls:-the-autocomplete-attribute:inappropriate-for-the-control-2 "inappropriate for the control"
									- :
								}
								ul class=brief {
									li {
										- "\""
										code id=autofilling-form-controls:-the-autocomplete-attribute:attr-fe-autocomplete-tel {
											a href="#attr-fe-autocomplete-tel" tel
										}
										- "\" "
									}
									li {
