					span class="opera_android unknown" {
						span "Opera Android"
						span ?
					}
				}
			}
		}
		p {
			cite DOM
			- " defines the user agent requirements for the "
			dfn data-dfn-for=global data-dfn-type=element-attr id=classes {
				code class
			}
			- ", "
			dfn data-dfn-for=global data-dfn-type=element-attr id=the-id-attribute {
				code id
			}
			- ", and "
			dfn data-dfn-for=global data-dfn-type=element-attr id=attr-slot {
				code slot
			}
			- " attributes for any element in any namespace. "
			a href="#refsDOM" "[DOM]"
		}
		p {
			- "The "
			code id=global-attributes:classes {
				a href="#classes" class
			}
			- ", "
			code id=global-attributes:the-id-attribute {
				a href="#the-id-attribute" id
			}
			- ", and "
			code id=global-attributes:attr-slot {
				a href="#attr-slot" slot
			}
			- " attributes may be specified on all "
			a href="#html-elements" id=global-attributes:html-elements-3 "HTML elements"
			- .
		}
		p {
			- "When specified on "
			a href="#html-elements" id=global-attributes:html-elements-4 "HTML elements"
			- ", the "
			code id=global-attributes:classes-2 {
				a href="#classes" class
			}
			- " attribute must have a value that is a "
			a href="#set-of-space-separated-tokens" id=global-attributes:set-of-space-separated-tokens "set of space-separated tokens"
			- " representing the various classes that the element belongs to."
		}
		div class=note {
			p {
				- "Assigning classes to an element affects class matching in selectors in CSS, the "
				code id=global-attributes:dom-document-getelementsbyclassname {
					a data-x-internal=dom-document-getelementsbyclassname href="https://dom.spec.whatwg.org/#dom-document-getelementsbyclassname" "getElementsByClassName()"
				}
				- " method in the DOM, and other such features."
			}
			p {
				- "There are no additional restrictions on the tokens authors can use in the "
				code id=global-attributes:classes-3 {
					a href="#classes" class
				}
				- " attribute, but authors are encouraged to use values that describe the nature of the content, rather than values that describe the desired presentation of the content."
			}
		}
		p {
			- "When specified on "
			a href="#html-elements" id=global-attributes:html-elements-5 "HTML elements"
			- ", the "
			code id=global-attributes:the-id-attribute-2 {
				a href="#the-id-attribute" id
			}
			- " attribute value must be unique amongst all the "
			a data-x-internal=concept-id href="https://dom.spec.whatwg.org/#concept-id" id=global-attributes:concept-id IDs
			- " in the element's "
			a data-x-internal=tree href="https://dom.spec.whatwg.org/#concept-tree" id=global-attributes:tree tree
			- " and must contain at least one character. The value must not contain any "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=global-attributes:space-characters "ASCII whitespace"
			- .
		}
		div class=note {
			p {
				- "The "
				code id=global-attributes:the-id-attribute-3 {
					a href="#the-id-attribute" id
				}
				- " attribute specifies its element's "
				a data-x-internal=concept-id href="https://dom.spec.whatwg.org/#concept-id" id=global-attributes:concept-id-2 "unique identifier (ID)"
				- .
			}
			p "There are no other restrictions on what form an ID can take; in particular, IDs can consist of just digits, start with a digit, start with an underscore, consist of just punctuation, etc."
			p {
				- "An element's "
				a data-x-internal=concept-id href="https://dom.spec.whatwg.org/#concept-id" id=global-attributes:concept-id-3 "unique identifier"
				- " can be used for a variety of purposes, most notably as a way to link to specific parts of a document using "
				a data-x-internal=concept-url-fragment href="https://url.spec.whatwg.org/#concept-url-fragment" id=global-attributes:concept-url-fragment fragments
				- ", as a way to target an element when scripting, and as a way to style a specific element from CSS."
			}
		}
		p {
			- "Identifiers are opaque strings. Particular meanings should not be derived from the value of the "
			code id=global-attributes:the-id-attribute-4 {
				a href="#the-id-attribute" id
			}
			- " attribute."
		}
		p {
			- "There are no conformance requirements for the "
			code id=global-attributes:attr-slot-2 {
				a href="#attr-slot" slot
			}
			- " attribute specific to "
			a href="#html-elements" id=global-attributes:html-elements-6 "HTML elements"
			- .
		}
		p class=note {
			- "The "
			code id=global-attributes:attr-slot-3 {
				a href="#attr-slot" slot
			}
			- " attribute is used to "
			a data-x-internal=assign-a-slot href="https://dom.spec.whatwg.org/#assign-a-slot" id=global-attributes:assign-a-slot "assign a slot"
			- " to an element: an element with a "
			code id=global-attributes:attr-slot-4 {
				a href="#attr-slot" slot
			}
			- " attribute is "
			a data-x-internal=assign-a-slot href="https://dom.spec.whatwg.org/#assign-a-slot" id=global-attributes:assign-a-slot-2 assigned
			- " to the "
			a data-x-internal=concept-slot href="https://dom.spec.whatwg.org/#concept-slot" id=global-attributes:concept-slot slot
			- " created by the "
			code id=global-attributes:the-slot-element {
				a href="#the-slot-element" slot
			}
			- " element whose "
			a href="#attr-slot-name" id=global-attributes:attr-slot-name name
			- " attribute's value matches that "
			code id=global-attributes:attr-slot-5 {
				a href="#attr-slot" slot
			}
			- " attribute's value — but only if that "
			code id=global-attributes:the-slot-element-2 {
				a href="#the-slot-element" slot
			}
			- " element finds itself in the "
			a data-x-internal=shadow-tree href="https://dom.spec.whatwg.org/#concept-shadow-tree" id=global-attributes:shadow-tree "shadow tree"
			- " whose "
			a data-x-internal=root href="https://dom.spec.whatwg.org/#concept-tree-root" id=global-attributes:root root
			- "'s "
			a data-x-internal=concept-documentfragment-host href="https://dom.spec.whatwg.org/#concept-documentfragment-host" id=global-attributes:concept-documentfragment-host host
			- " has the corresponding "
			code id=global-attributes:attr-slot-6 {
				a href="#attr-slot" slot
			}
			- " attribute value."
		}
