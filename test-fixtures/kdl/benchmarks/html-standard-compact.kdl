			}
			dt {
				code {
					- "{ "
					a href="#dom-navigationresult-committed" id=navigation-api-initiating-navigations:dom-navigationresult-committed-2 committed
					- ", "
					a href="#dom-navigationresult-finished" id=navigation-api-initiating-navigations:dom-navigationresult-finished-2 finished
					- " } = "
					a href="#dom-navigation" id=navigation-api-initiating-navigations:dom-navigation-2 navigation
					- .
					a href="#dom-navigation-navigate" id=navigation-api-initiating-navigations:dom-navigation-navigate navigate
					- "("
					var url
					- ", "
					var options
					- ")"
				}
			}
			dd {
				p {
					a href="#navigate" id=navigation-api-initiating-navigations:navigate Navigates
					- " the current page to the given "
					var url
					- ". "
					var options
					- " can contain the following values:"
				}
				ul {
					li {
						p {
							code id=dom-navigationnavigateoptions-history-dev {
								a href="#dom-navigationnavigateoptions-history" history
							}
							- " can be set to \""
							code id=navigationhistorybehavior-replace-dev {
								a href="#navigationhistorybehavior-replace" replace
							}
							- "\" to replace the current session history entry, instead of pushing a new one."
						}
					}
					li {
						p {
							code id=dom-navigationoptions-info-dev {
								a href="#dom-navigationoptions-info" info
							}
							- " can be set to any value; it will populate the "
							code id=navigation-api-initiating-navigations:dom-navigateevent-info {
								a href="#dom-navigateevent-info" info
							}
							- " property of the corresponding "
							code id=navigation-api-initiating-navigations:navigateevent {
								a href="#navigateevent" NavigateEvent
							}
							- .
						}
					}
					li {
						p {
							code id=dom-navigationnavigateoptions-state-dev {
								a href="#dom-navigationnavigateoptions-state" state
							}
							- " can be set to any "
							a href="#serializable-objects" id=navigation-api-initiating-navigations:serializable-objects serializable
							- " value; it will populate the state retrieved by "
							code id=navigation-api-initiating-navigations:dom-navigationhistoryentry-getstate {
								a href="#dom-navigationhistoryentry-getstate" "navigation.currentEntry.getState()"
							}
							- " once the navigation completes, for same-document navigations. (It will be ignored for navigations that end up cross-document.)"
						}
					}
				}
				p {
					- "By default this will perform a full navigation (i.e., a cross-document navigation, unless the given URL differs only in a "
					a data-x-internal=concept-url-fragment href="https://url.spec.whatwg.org/#concept-url-fragment" id=navigation-api-initiating-navigations:concept-url-fragment fragment
					- " from the current one). The "
					code id=navigation-api-initiating-navigations:dom-navigateevent-intercept {
						a href="#dom-navigateevent-intercept" "navigateEvent.intercept()"
					}
					- " method can be used to convert it into a same-document navigation."
				}
				p "The returned promises will behave as follows:"
				ul {
					li {
						p {
							- "For navigations that get aborted, both promises will reject with an "
							a data-x-internal=aborterror href="https://webidl.spec.whatwg.org/#aborterror" id=navigation-api-initiating-navigations:aborterror {
								- "\""
								code AbortError
								- "\""
							}
