					a data-x-internal=rules-for-updating-the-display-of-webvtt-text-tracks href="https://w3c.github.io/webvtt/#rules-for-updating-the-display-of-webvtt-text-tracks" id=playing-the-media-resource:rules-for-updating-the-display-of-webvtt-text-tracks "rules for updating the display of WebVTT text tracks"
