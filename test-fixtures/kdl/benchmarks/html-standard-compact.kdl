					a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=event-handler-attributes:node-document "node document"
					- " is not an "
					a href="#active-document" id=event-handler-attributes:active-document "active document"
					- ", then return null."
				}
				p class=note {
					- "This could happen if this object is a "
					code id=event-handler-attributes:the-body-element-3 {
						a href="#the-body-element" body
					}
					- " element without a corresponding "
					code id=event-handler-attributes:window-3 {
						a href="#window" Window
					}
					- " object, for example."
				}
				p class=note {
					- "This check does not necessarily prevent "
					code id=event-handler-attributes:the-body-element-4 {
						a href="#the-body-element" body
					}
					- " and "
					code id=event-handler-attributes:frameset-3 {
						a href="#frameset" frameset
					}
					- " elements that are not "
