			dt "U+003E GREATER-THAN SIGN (>)"
			dd {
				- "This is a "
				a href="#parse-error-missing-attribute-value" id=before-attribute-value-state:parse-error-missing-attribute-value missing-attribute-value
				a href="#parse-errors" id=before-attribute-value-state:parse-errors "parse error"
				- ". Switch to the "
				a href="#data-state" id=before-attribute-value-state:data-state "data state"
				- ". Emit the current tag token."
			}
			dt "Anything else"
