		h4 id=windows {
			span class=secno "7.3.2"
			- " Browsing contexts"
			a class=self-link href="#windows"
		}
		p {
			- "A "
			dfn data-export="" id=browsing-context "browsing context"
			- " is a programmatic representation of a series of documents, multiple of which can live within a single "
			a href="#navigable" id=windows:navigable navigable
			- ". Each "
			a href="#browsing-context" id=windows:browsing-context "browsing context"
			- " has a corresponding "
			code id=windows:windowproxy {
				a href="#windowproxy" WindowProxy
			}
			- " object, as well as the following:"
		}
		ul {
			li {
				p {
					- "An "
					dfn data-export="" id=opener-browsing-context "opener browsing context"
					- ", a "
					a href="#browsing-context" id=windows:browsing-context-2 "browsing context"
					- " or null, initially null."
				}
			}
			li {
				p {
					- "An "
					dfn id=opener-origin-at-creation "opener origin at creation"
					- ", an "
					a href="#concept-origin" id=windows:concept-origin origin
					- " or null, initially null."
				}
			}
			li {
				p {
					- "An "
					dfn id=is-popup "is popup"
					- " boolean, initially false."
				}
				p class=note {
					- "The only mandatory impact in this specification of "
					a href="#is-popup" id=windows:is-popup "is popup"
					- " is on the "
					code id=windows:dom-barprop-visible {
						a href="#dom-barprop-visible" visible
					}
					- " getter of the relevant "
					code id=windows:barprop {
						a href="#barprop" BarProp
					}
					- " objects. However, user agents might also use it for "
					a href="#nav-traversal-ui" "user interface considerations"
					- .
				}
			}
			li {
				p {
					- "An "
					dfn id=is-auxiliary "is auxiliary"
					- " boolean, initially false."
				}
			}
			li {
				p {
					- "An "
					dfn id=browsing-context-initial-url "initial URL"
					- ", a "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=windows:url URL
					- " or null, initially null."
				}
			}
			li {
				p {
					- "A "
					dfn id=virtual-browsing-context-group-id "virtual browsing context group ID"
					- " integer, initially 0. This is used by "
					a href="#coop-struct-report-only-value" id=windows:coop-struct-report-only-value "opener policy reporting"
					- ", to keep track of the browsing context group switches that would have happened if the report-only policy had been enforced."
				}
			}
		}
		p {
			- "A "
			a href="#browsing-context" id=windows:browsing-context-3 "browsing context"
			- "'s "
			dfn id=active-window "active window"
			- " is its "
			code id=windows:windowproxy-2 {
				a href="#windowproxy" WindowProxy
			}
			- " object's "
			a href="#concept-windowproxy-window" id=windows:concept-windowproxy-window "[[Window]]"
			- " internal slot value. A "
			a href="#browsing-context" id=windows:browsing-context-4 "browsing context"
			- "'s "
			dfn id=active-document "active document"
			- " is its "
			a href="#active-window" id=windows:active-window "active window"
			- "'s "
			a href="#concept-document-window" id=windows:concept-document-window {
				- "associated "
				code Document
			}
			- .
		}
		p {
			- "A "
			a href="#browsing-context" id=windows:browsing-context-5 "browsing context"
			- "'s "
			dfn data-dfn-for="browsing context" data-export="" id=bc-traversable "top-level traversable"
			- " is its "
			a href="#active-document" id=windows:active-document "active document"
			- "'s "
			a href="#node-navigable" id=windows:node-navigable "node navigable"
