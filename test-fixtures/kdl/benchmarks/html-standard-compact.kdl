						dfn data-dfn-for="html-global/inputmode" data-dfn-type=attr-value id=attr-inputmode-keyword-none {
							code none
						}
					}
					td "The user agent should not display a virtual keyboard. This keyword is useful for content that renders its own keyboard control. "
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" data-dfn-type=attr-value id=attr-inputmode-keyword-text {
							code text
						}
					}
					td "The user agent should display a virtual keyboard capable of text input in the user's locale. "
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" data-dfn-type=attr-value id=attr-inputmode-keyword-tel {
							code tel
						}
					}
					td " The user agent should display a virtual keyboard capable of telephone number input. This should including keys for the digits 0 to 9, the \"#\" character, and the \"*\" character. In some locales, this can also include alphabetic mnemonic labels (e.g., in the US, the key labeled \"2\" is historically also labeled with the letters A, B, and C). "
				}
				tr {
					td {
						dfn data-dfn-for="html-global/inputmode" data-dfn-type=attr-value id=attr-inputmode-keyword-url {
							code url
						}
					}
					td {
						- "The user agent should display a virtual keyboard capable of text input in the user's locale, with keys for aiding in the input of "
