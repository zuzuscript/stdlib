					c- p="" .
					- isConnected
					c- p="" ");"
					c- p="" "}"
					c- p="" "}"
					- " customElements"
					c- p="" .
					- define
					c- p="" "("
					c- u="" "\"c-child\""
					c- p="" ,
					- " CChild"
					c- p="" ");"
					c- a="" const
					- " parent "
					c- o="" "="
					c- k="" new
					- " CParent"
					c- p="" "(),"
					- " child "
					c- o="" "="
					c- k="" new
					- " CChild"
					c- p="" "();"
					- " parent"
					c- p="" .
