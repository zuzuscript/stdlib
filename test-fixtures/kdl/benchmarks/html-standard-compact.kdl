									a data-x-internal=assert href="https://infra.spec.whatwg.org/#assert" id=script-processing-model:assert-3 Assert
									- ": "
									var document
									- "'s "
									code id=script-processing-model:dom-document-currentscript-5 {
										a href="#dom-document-currentscript" currentScript
									}
									- " attribute is null."
								}
							}
							li {
								p {
									a href="#run-a-module-script" id=script-processing-model:run-a-module-script "Run the module script"
									- " given by "
									var el
									- "'s "
									a href="#concept-script-result" id=script-processing-model:concept-script-result-7 result
									- .
								}
							}
						}
					}
					dt {
						- "\""
						code importmap
						- "\""
					}
					dd {
						ol {
							li {
								p {
									a href="#register-an-import-map" id=script-processing-model:register-an-import-map "Register an import map"
									- " given "
									var el
									- "'s "
									a href="#concept-relevant-global" id=script-processing-model:concept-relevant-global "relevant global object"
									- " and "
									var el
									- "'s "
									a href="#concept-script-result" id=script-processing-model:concept-script-result-8 result
									- .
								}
							}
						}
					}
				}
			}
			li {
				p {
					- "Decrement the "
					a href="#ignore-destructive-writes-counter" id=script-processing-model:ignore-destructive-writes-counter-2 "ignore-destructive-writes counter"
					- " of "
					var document
					- ", if it was incremented in the earlier step."
				}
			}
			li {
				p {
					- "If "
					var el
					- "'s "
					a href="#concept-script-external" id=script-processing-model:concept-script-external-3 "from an external file"
					- " is true, then "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=script-processing-model:concept-event-fire-5 "fire an event"
					- " named "
					code id=script-processing-model:event-load {
						a href="#event-load" load
					}
					- " at "
					var el
					- .
				}
			}
		}
		h5 id=scriptingLanguages {
			span class=secno "4.12.1.2"
			- " Scripting languages"
			a class=self-link href="#scriptingLanguages"
		}
		p {
			- "User agents are not required to support JavaScript. This standard needs to be updated if a language other than JavaScript comes along and gets similar wide adoption by web browsers. Until such a time, implementing other languages is in conflict with this standard, given the processing model defined for the "
			code id=scriptingLanguages:the-script-element {
				a href="#the-script-element" script
			}
			- " element."
		}
		p {
			- "Servers should use "
			code id="scriptingLanguages:text/javascript" {
				a href="#text/javascript" "text/javascript"
			}
			- " for JavaScript resources, in accordance with "
			cite "Updates to ECMAScript Media Types"
			- ". Servers should not use other "
			a data-x-internal=javascript-mime-type href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id=scriptingLanguages:javascript-mime-type "JavaScript MIME types"
			- " for JavaScript resources, and must not use non-"
			a data-x-internal=javascript-mime-type href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id=scriptingLanguages:javascript-mime-type-2 "JavaScript MIME types"
			- ". "
			a href="#refsRFC9239" "[RFC9239]"
		}
		p {
			- "For external JavaScript resources, MIME type parameters in `"
			code id=scriptingLanguages:content-type {
				a href="#content-type" Content-Type
			}
			- "` headers are generally ignored. (In some cases the `"
			code charset
			- "` parameter has an effect.) However, for the "
			code id=scriptingLanguages:the-script-element-2 {
				a href="#the-script-element" script
			}
			- " element's "
			code id=scriptingLanguages:attr-script-type {
				a href="#attr-script-type" type
			}
			- " attribute they are significant; it uses the "
			a data-x-internal=javascript-mime-type-essence-match href="https://mimesniff.spec.whatwg.org/#javascript-mime-type-essence-match" id=scriptingLanguages:javascript-mime-type-essence-match "JavaScript MIME type essence match"
			- " concept."
		}
		p class=note {
			- "For example, scripts with their "
			code id=scriptingLanguages:attr-script-type-2 {
				a href="#attr-script-type" type
			}
			- " attribute set to \""
			code "text/javascript; charset=utf-8"
			- "\" will not be evaluated, even though that is a valid "
			a data-x-internal=javascript-mime-type href="https://mimesniff.spec.whatwg.org/#javascript-mime-type" id=scriptingLanguages:javascript-mime-type-3 "JavaScript MIME type"
			- " when parsed."
		}
		p {
			- "Furthermore, again for external JavaScript resources, special considerations apply around `"
			code id=scriptingLanguages:content-type-2 {
				a href="#content-type" Content-Type
			}
			- "` header processing as detailed in the "
			a href="#prepare-the-script-element" id=scriptingLanguages:prepare-the-script-element "prepare the script element"
			- " algorithm and "
			cite Fetch
			- ". "
			a href="#refsFETCH" "[FETCH]"
		}
		h5 id=restrictions-for-contents-of-script-elements {
			span class=secno "4.12.1.3"
			dfn {
				- "Restrictions for contents of "
				code script
				- " elements"
			}
			a class=self-link href="#restrictions-for-contents-of-script-elements"
		}
		p class=note {
			- "The easiest and safest way to avoid the rather strange restrictions described in this section is to always escape an ASCII case-insensitive match for \""
			code <!--
			- "\" as \""
			code "\\x3C!--"
			- "\", \""
			code <script
			- "\" as \""
			code "\\x3Cscript"
			- "\", and \""
			code "</script"
			- "\" as \""
			code "\\x3C/script"
			- "\" when these sequences appear in literals in scripts (e.g. in strings, regular expressions, or comments), and to avoid writing code that uses such constructs in expressions. Doing so avoids the pitfalls that the restrictions in this section are prone to triggering: namely, that, for historical reasons, parsing of "
			code id=restrictions-for-contents-of-script-elements:the-script-element {
				a href="#the-script-element" script
			}
			- " blocks in HTML is a strange and exotic practice that acts unintuitively in the face of these sequences."
		}
		p {
			- "The "
			code id=restrictions-for-contents-of-script-elements:the-script-element-2 {
				a href="#the-script-element" script
			}
			- " element's "
			a data-x-internal=descendant-text-content href="https://dom.spec.whatwg.org/#concept-descendant-text-content" id=restrictions-for-contents-of-script-elements:descendant-text-content "descendant text content"
			- " must match the "
			code script
			- " production in the following ABNF, the character set for which is Unicode. "
			a href="#refsABNF" "[ABNF]"
		}
		pre {
			code class=abnf {
				c- nc="" script
				c- o="" "="
				c- nc="" outer
				c- o="" *
				c- p="" "("
				c- nc="" comment-open
				c- nc="" inner
				c- nc="" comment-close
				c- nc="" outer
				c- p="" ")"
				c- nc="" outer
				c- o="" "="
				- " < "
				c- nc="" any
				c- nc="" string
				c- nc="" that
				c- nc="" doesn
				- "'t "
				c- nc="" contain
				- " a "
				c- nc="" substring
				c- nc="" that
				c- nc="" matches
				c- nc="" not-in-outer
				- " > "
				c- nc="" not-in-outer
				c- o="" "="
				c- nc="" comment-open
				c- nc="" inner
				c- o="" "="
				- " < "
				c- nc="" any
				c- nc="" string
				c- nc="" that
				c- nc="" doesn
				- "'t "
				c- nc="" contain
				- " a "
				c- nc="" substring
				c- nc="" that
				c- nc="" matches
				c- nc="" not-in-inner
				- " > "
				c- nc="" not-in-inner
				c- o="" "="
				c- nc="" comment-close
				c- o="" "/"
				c- nc="" script-open
				c- nc="" comment-open
				c- o="" "="
				c- l="" "\"<!--\""
				c- nc="" comment-close
				c- o="" "="
				c- l="" "\"-->\""
				c- nc="" script-open
				c- o="" "="
				c- l="" "\"<\""
				- " s c r i p t "
				c- nc="" tag-end
				- " s "
				c- o="" "="
				c- l="" %x0053
				c- c1="" "; U+0053 LATIN CAPITAL LETTER S"
				- " s "
				c- o="" "=/"
				c- l="" %x0073
				c- c1="" "; U+0073 LATIN SMALL LETTER S"
				- " c "
				c- o="" "="
				c- l="" %x0043
				c- c1="" "; U+0043 LATIN CAPITAL LETTER C"
				- " c "
				c- o="" "=/"
				c- l="" %x0063
				c- c1="" "; U+0063 LATIN SMALL LETTER C"
				- " r "
				c- o="" "="
				c- l="" %x0052
				c- c1="" "; U+0052 LATIN CAPITAL LETTER R"
				- " r "
				c- o="" "=/"
				c- l="" %x0072
				c- c1="" "; U+0072 LATIN SMALL LETTER R"
				- " i "
				c- o="" "="
				c- l="" %x0049
				c- c1="" "; U+0049 LATIN CAPITAL LETTER I"
				- " i "
				c- o="" "=/"
				c- l="" %x0069
				c- c1="" "; U+0069 LATIN SMALL LETTER I"
				- " p "
				c- o="" "="
				c- l="" %x0050
				c- c1="" "; U+0050 LATIN CAPITAL LETTER P"
				- " p "
				c- o="" "=/"
				c- l="" %x0070
				c- c1="" "; U+0070 LATIN SMALL LETTER P"
				- " t "
				c- o="" "="
				c- l="" %x0054
				c- c1="" "; U+0054 LATIN CAPITAL LETTER T"
				- " t "
				c- o="" "=/"
				c- l="" %x0074
				c- c1="" "; U+0074 LATIN SMALL LETTER T"
				c- nc="" tag-end
				c- o="" "="
				c- l="" %x0009
				c- c1="" "; U+0009 CHARACTER TABULATION (tab)"
				c- nc="" tag-end
				c- o="" "=/"
				c- l="" %x000A
				c- c1="" "; U+000A LINE FEED (LF)"
				c- nc="" tag-end
				c- o="" "=/"
				c- l="" %x000C
				c- c1="" "; U+000C FORM FEED (FF)"
				c- nc="" tag-end
				c- o="" "=/"
				c- l="" %x0020
				c- c1="" "; U+0020 SPACE"
				c- nc="" tag-end
				c- o="" "=/"
				c- l="" %x002F
				c- c1="" "; U+002F SOLIDUS (/)"
				c- nc="" tag-end
				c- o="" "=/"
				c- l="" %x003E
				c- c1="" "; U+003E GREATER-THAN SIGN (>)"
			}
		}
		p {
			- "When a "
			code id=restrictions-for-contents-of-script-elements:the-script-element-3 {
				a href="#the-script-element" script
			}
			- " element contains "
			a href="#inline-documentation-for-external-scripts" id=restrictions-for-contents-of-script-elements:inline-documentation-for-external-scripts "script documentation"
			- ", there are further restrictions on the contents of the element, as described in the section below."
		}
		div class=example {
			p "The following script illustrates this issue. Suppose you have a script that contains a string, as in:"
			pre {
				code class=js {
					c- a="" const
					- " example "
					c- o="" "="
					c- t="" "'Consider this string: <!-- <script>'"
					c- p="" ";"
					- " console"
					c- p="" .
					- log
					c- p="" "("
					- example
					c- p="" ");"
				}
			}
			p {
				- "If one were to put this string directly in a "
				code id=restrictions-for-contents-of-script-elements:the-script-element-4 {
					a href="#the-script-element" script
				}
				- " block, it would violate the restrictions above:"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" script
					c- p="" >
					c- a="" const
					- " example "
					c- o="" "="
					c- t="" "'Consider this string: <!-- <script>'"
					c- p="" ";"
					- " console"
					c- p="" .
					- log
					c- p="" "("
					- example
					c- p="" ");"
					c- p="" "</"
					c- f="" script
					c- p="" >
				}
			}
			p {
				- "The bigger problem, though, and the reason why it would violate those restrictions, is that actually the script would get parsed weirdly: "
				em "the script block above is not terminated"
				- ". That is, what looks like a \""
				code "</script>"
				- "\" end tag in this snippet is actually still part of the "
				code id=restrictions-for-contents-of-script-elements:the-script-element-5 {
					a href="#the-script-element" script
				}
				- " block. The script doesn't execute (since it's not terminated); if it somehow were to execute, as it might if the markup looked as follows, it would fail because the script (highlighted here) is not valid JavaScript:"
			}
			pre {
				code class=html {
					c- p="" <
					c- f="" script
					c- p="" >
					mark {
						c- a="" const
						- " example "
						c- o="" "="
						c- t="" "'Consider this string: <!-- <script>'"
						c- p="" ";"
						- " console"
						c- p="" .
						- log
						c- p="" "("
						- example
						c- p="" ");"
						c- p="" "</"
						c- f="" script
						c- p="" >
						c- c="" "<!-- despite appearances, this is actually part of the script still! -->"
						c- p="" <
						c- f="" script
						c- p="" >
						c- p="" ...
						c- c1="" "// this is the same script block still..."
					}
					c- p="" "</"
					c- f="" script
					c- p="" >
				}
			}
			p {
				- "What is going on here is that for legacy reasons, \""
				code <!--
				- "\" and \""
				code <script
				- "\" strings in "
				code id=restrictions-for-contents-of-script-elements:the-script-element-6 {
					a href="#the-script-element" script
				}
				- " elements in HTML need to be balanced in order for the parser to consider closing the block."
			}
			p "By escaping the problematic strings as mentioned at the top of this section, the problem is avoided entirely:"
			pre {
				code class=html {
					c- p="" <
					c- f="" script
					c- p="" >
					mark {
						c- c1="" "// Note: `\\x3C` is an escape sequence for `<`."
						c- a="" const
						- " example "
						c- o="" "="
						c- t="" "'Consider this string: \\x3C!-- \\x3Cscript>'"
						c- p="" ";"
						- " console"
						c- p="" .
						- log
						c- p="" "("
						- example
						c- p="" ");"
					}
					c- p="" "</"
					c- f="" script
					c- p="" >
					c- c="" "<!-- this is just a comment between script blocks -->"
					c- p="" <
					c- f="" script
					c- p="" >
					mark {
						c- p="" ...
						c- c1="" "// this is a new script block"
					}
					c- p="" "</"
					c- f="" script
					c- p="" >
				}
			}
			p "It is possible for these sequences to naturally occur in script expressions, as in the following examples:"
			pre {
				code class=js {
					c- k="" if
					c- p="" "("
					- x
					c- c="" <!--
					- y
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
					c- k="" if
					c- p="" "("
					- " player"
					c- o="" <
					- "script "
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
				}
			}
			p "In such cases the characters cannot be escaped, but the expressions can be rewritten so that the sequences don't occur, as in:"
			pre {
				code class=js {
					c- k="" if
					c- p="" "("
					- "x "
					c- o="" <
					c- o="" !--
					- y
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
					c- k="" if
					c- p="" "("
					c- o="" !--
					- "y "
					c- o="" >
					- " x"
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
					c- k="" if
					c- p="" "("
					c- o="" !
					c- p="" "("
					c- o="" --
					- y
					c- p="" ")"
					c- o="" >
					- " x"
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
					c- k="" if
					c- p="" "("
					- "player "
					c- o="" <
					- " script"
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
					c- k="" if
					c- p="" "("
					- "script "
					c- o="" >
					- " player"
					c- p="" ")"
					c- p="" "{"
					c- p="" ...
					c- p="" "}"
				}
			}
			p {
				- "Doing this also avoids a different pitfall as well: for related historical reasons, the string \"<!--\" in "
				a href="#classic-script" id=restrictions-for-contents-of-script-elements:classic-script "classic scripts"
				- " is actually treated as a line comment start, just like \"//\"."
			}
		}
		h5 id=inline-documentation-for-external-scripts {
			span class=secno "4.12.1.4"
			dfn "Inline documentation for external scripts"
			a class=self-link href="#inline-documentation-for-external-scripts"
		}
		p {
			- "If a "
			code id=inline-documentation-for-external-scripts:the-script-element {
				a href="#the-script-element" script
			}
			- " element's "
			code id=inline-documentation-for-external-scripts:attr-script-src {
				a href="#attr-script-src" src
			}
			- " attribute is specified, then the contents of the "
			code id=inline-documentation-for-external-scripts:the-script-element-2 {
				a href="#the-script-element" script
			}
			- " element, if any, must be such that the value of the "
			code id=inline-documentation-for-external-scripts:dom-script-text {
				a href="#dom-script-text" text
			}
			- " IDL attribute, which is derived from the element's contents, matches the "
			code documentation
			- " production in the following ABNF, the character set for which is Unicode. "
			a href="#refsABNF" "[ABNF]"
		}
		pre {
			code class=abnf {
				c- nc="" documentation
				c- o="" "="
				c- o="" *
				c- p="" "("
				c- o="" *
				c- p="" "("
				c- nc="" space
				c- o="" "/"
				c- nc="" tab
				c- o="" "/"
				c- nc="" comment
				c- p="" ")"
				c- p="" "["
				c- nc="" line-comment
				c- p="" "]"
				c- nc="" newline
				c- p="" ")"
				c- nc="" comment
				c- o="" "="
				c- nc="" slash
				c- nc="" star
				c- o="" *
				c- p="" "("
				c- nc="" not-star
				c- o="" "/"
				c- nc="" star
				c- nc="" not-slash
				c- p="" ")"
				c- o="" "1*"
				c- nc="" star
				c- nc="" slash
				c- nc="" line-comment
				c- o="" "="
				c- nc="" slash
				c- nc="" slash
				c- o="" *
				c- nc="" not-newline
				c- c1="" "; characters"
				c- nc="" tab
				c- o="" "="
				c- l="" %x0009
				c- c1="" "; U+0009 CHARACTER TABULATION (tab)"
				c- nc="" newline
				c- o="" "="
				c- l="" %x000A
				c- c1="" "; U+000A LINE FEED (LF)"
				c- nc="" space
				c- o="" "="
				c- l="" %x0020
				c- c1="" "; U+0020 SPACE"
				c- nc="" star
				c- o="" "="
				c- l="" %x002A
				c- c1="" "; U+002A ASTERISK (*)"
				c- nc="" slash
				c- o="" "="
				c- l="" %x002F
				c- c1="" "; U+002F SOLIDUS (/)"
				c- nc="" not-newline
				c- o="" "="
				c- l="" %x0000-0009
				c- o="" "/"
				c- l="" %x000B-10FFFF
				c- c1="" "; a "
				a data-x-internal=scalar-value href="https://infra.spec.whatwg.org/#scalar-value" id=inline-documentation-for-external-scripts:scalar-value {
					c- c1="" "scalar value"
				}
				c- c1="" " other than U+000A LINE FEED (LF)"
				c- nc="" not-star
				c- o="" "="
				c- l="" %x0000-0029
				c- o="" "/"
				c- l="" %x002B-10FFFF
				c- c1="" "; a "
				a data-x-internal=scalar-value href="https://infra.spec.whatwg.org/#scalar-value" id=inline-documentation-for-external-scripts:scalar-value-2 {
					c- c1="" "scalar value"
				}
				c- c1="" " other than U+002A ASTERISK (*)"
				c- nc="" not-slash
				c- o="" "="
				c- l="" %x0000-002E
				c- o="" "/"
				c- l="" %x0030-10FFFF
				c- c1="" "; a "
				a data-x-internal=scalar-value href="https://infra.spec.whatwg.org/#scalar-value" id=inline-documentation-for-external-scripts:scalar-value-3 {
					c- c1="" "scalar value"
				}
				c- c1="" " other than U+002F SOLIDUS (/)"
			}
		}
		p class=note "This corresponds to putting the contents of the element in JavaScript comments."
		p class=note {
			- "This requirement is in addition to the earlier restrictions on the syntax of contents of "
			code id=inline-documentation-for-external-scripts:the-script-element-3 {
				a href="#the-script-element" script
			}
			- " elements."
		}
		div class=example {
			p {
