				a href="#the-html-element" html
			}
			- " element's "
			a href="#syntax-start-tag" id=optional-tags:syntax-start-tag-2 "start tag"
			- " may be omitted if the first thing inside the "
			code id=optional-tags:the-html-element-3 {
				a href="#the-html-element" html
			}
			- " element is not a "
			a href="#syntax-comments" id=optional-tags:syntax-comments comment
