		p {
			- "The "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-inputmode {
				code inputmode
			}
			- " content attribute is an "
			a href="#enumerated-attribute" id=input-modalities:-the-inputmode-attribute:enumerated-attribute "enumerated attribute"
			- " that specifies what kind of input mechanism would be most helpful for users entering content."
		}
		table {
			thead {
				tr {
					th " Keyword "
					th " Description "
				}
			}
			tbody {
				tr {
