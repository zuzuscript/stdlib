			dt {
				dfn id=md-vcard-n-honorific-suffix {
					code honorific-suffix
				}
				- " (inside "
				code id=vcard:md-vcard-n-10 {
					a href="#md-vcard-n" n
				}
				- ")"
			}
			dd {
				p "Gives the honorific suffix of the person."
				p {
