					code id=sourcing-out-of-band-text-tracks:the-track-element-15 {
						a href="#the-track-element" track
					}
					- " element does not have a "
					a href="#media-element" id=sourcing-out-of-band-text-tracks:media-element-16 "media element"
					- " as a parent, return."
				}
			}
			li {
				p {
					- "Run the remainder of these steps "
					a href="#in-parallel" id=sourcing-out-of-band-text-tracks:in-parallel "in parallel"
					- ", allowing whatever caused these steps to run to continue."
				}
			}
			li {
				p {
					i Top
					- ": "
					a href="#await-a-stable-state" id=sourcing-out-of-band-text-tracks:await-a-stable-state "Await a stable state"
					- ". The "
					a href="#synchronous-section" id=sourcing-out-of-band-text-tracks:synchronous-section-2 "synchronous section"
					- " consists of the following steps. (The steps in the "
					a href="#synchronous-section" id=sourcing-out-of-band-text-tracks:synchronous-section-3 "synchronous section"
					- " are marked with ⌛.)"
				}
			}
			li {
				p {
					- "⌛ Set the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-2 "text track readiness state"
					- " to "
					a href="#text-track-loading" id=sourcing-out-of-band-text-tracks:text-track-loading loading
					- .
				}
			}
			li {
				p {
					- "⌛ Let "
					var URL
					- " be the "
					a href="#track-url" id=sourcing-out-of-band-text-tracks:track-url-2 "track URL"
					- " of the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-16 {
						a href="#the-track-element" track
					}
					- " element."
				}
			}
			li {
				p {
					- "⌛ If the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-17 {
						a href="#the-track-element" track
					}
					- " element's parent is a "
					a href="#media-element" id=sourcing-out-of-band-text-tracks:media-element-17 "media element"
					- " then let "
					var corsAttributeState
					- " be the state of the parent "
					a href="#media-element" id=sourcing-out-of-band-text-tracks:media-element-18 "media element"
					- "'s "
					code id=sourcing-out-of-band-text-tracks:attr-media-crossorigin {
						a href="#attr-media-crossorigin" crossorigin
					}
					- " content attribute. Otherwise, let "
					var corsAttributeState
					- " be "
					a href="#attr-crossorigin-none" id=sourcing-out-of-band-text-tracks:attr-crossorigin-none "No CORS"
					- .
				}
			}
			li {
				p {
					- "End the "
					a href="#synchronous-section" id=sourcing-out-of-band-text-tracks:synchronous-section-4 "synchronous section"
					- ", continuing the remaining steps "
					a href="#in-parallel" id=sourcing-out-of-band-text-tracks:in-parallel-2 "in parallel"
					- .
				}
			}
			li {
				p {
					- "If "
					var URL
					- " is not the empty string, then: "
				}
				ol {
					li {
						p {
							- "Let "
							var request
							- " be the result of "
							a href="#create-a-potential-cors-request" id=sourcing-out-of-band-text-tracks:create-a-potential-cors-request "creating a potential-CORS request"
							- " given "
							var URL
							- ", \""
							code track
							- "\", and "
							var corsAttributeState
							- ", and with the "
							i "same-origin fallback flag"
							- " set."
						}
					}
					li {
						p {
							- "Set "
							var request
							- "'s "
							a data-x-internal=concept-request-client href="https://fetch.spec.whatwg.org/#concept-request-client" id=sourcing-out-of-band-text-tracks:concept-request-client client
							- " to the "
							code id=sourcing-out-of-band-text-tracks:the-track-element-18 {
								a href="#the-track-element" track
							}
							- " element's "
							a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=sourcing-out-of-band-text-tracks:node-document "node document"
							- "'s "
							a href="#relevant-settings-object" id=sourcing-out-of-band-text-tracks:relevant-settings-object "relevant settings object"
							- .
						}
					}
					li {
						p {
							- "Set "
							var request
							- "'s "
							a data-x-internal=concept-request-initiator-type href="https://fetch.spec.whatwg.org/#request-initiator-type" id=sourcing-out-of-band-text-tracks:concept-request-initiator-type "initiator type"
							- " to \""
							code track
							- "\"."
						}
					}
					li {
						p {
							a data-x-internal=concept-fetch href="https://fetch.spec.whatwg.org/#concept-fetch" id=sourcing-out-of-band-text-tracks:concept-fetch Fetch
							var request
							- .
						}
					}
				}
				p {
					- "The "
					a href="#concept-task" id=sourcing-out-of-band-text-tracks:concept-task tasks
					a href="#queue-a-task" id=sourcing-out-of-band-text-tracks:queue-a-task queued
					- " by the fetching algorithm on the "
					a href="#networking-task-source" id=sourcing-out-of-band-text-tracks:networking-task-source "networking task source"
					- " to process the data as it is being fetched must determine the type of the resource. If the type of the resource is not a supported text track format, the load will fail, as described below. Otherwise, the resource's data must be passed to the appropriate parser (e.g., the "
					a data-x-internal=webvtt-parser href="https://w3c.github.io/webvtt/#webvtt-parser" id=sourcing-out-of-band-text-tracks:webvtt-parser "WebVTT parser"
					- ") as it is received, with the "
					a href="#text-track-list-of-cues" id=sourcing-out-of-band-text-tracks:text-track-list-of-cues-2 "text track list of cues"
					- " being used for that parser's output. "
					a href="#refsWEBVTT" "[WEBVTT]"
				}
				p class=note {
					- "The appropriate parser will incrementally update the "
					a href="#text-track-list-of-cues" id=sourcing-out-of-band-text-tracks:text-track-list-of-cues-3 "text track list of cues"
					- " during these "
					a href="#networking-task-source" id=sourcing-out-of-band-text-tracks:networking-task-source-2 "networking task source"
					a href="#concept-task" id=sourcing-out-of-band-text-tracks:concept-task-2 tasks
					- ", as each such task is run with whatever data has been received from the network)."
				}
				p class=critical "This specification does not currently say whether or how to check the MIME types of text tracks, or whether or how to perform file type sniffing using the actual file data. Implementers differ in their intentions on this matter and it is therefore unclear what the right solution is. In the absence of any requirement here, the HTTP specifications' strict requirement to follow the Content-Type header prevails (\"Content-Type specifies the media type of the underlying data.\" ... \"If and only if the media type is not given by a Content-Type field, the recipient MAY attempt to guess the media type via inspection of its content and/or the name extension(s) of the URI used to identify the resource.\")."
				p {
					- "If fetching fails for any reason (network error, the server returns an error code, CORS fails, etc.), or if "
					var URL
					- " is the empty string, then "
					a href="#queue-an-element-task" id=sourcing-out-of-band-text-tracks:queue-an-element-task "queue an element task"
					- " on the "
					a href="#dom-manipulation-task-source" id=sourcing-out-of-band-text-tracks:dom-manipulation-task-source "DOM manipulation task source"
					- " given the "
					a href="#media-element" id=sourcing-out-of-band-text-tracks:media-element-19 "media element"
					- " to first change the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-3 "text track readiness state"
					- " to "
					a href="#text-track-failed-to-load" id=sourcing-out-of-band-text-tracks:text-track-failed-to-load "failed to load"
					- " and then "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=sourcing-out-of-band-text-tracks:concept-event-fire-3 "fire an event"
					- " named "
					code id=sourcing-out-of-band-text-tracks:event-track-error {
						a href="#event-track-error" error
					}
					- " at the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-19 {
						a href="#the-track-element" track
					}
					- " element."
				}
				p {
					- "If fetching does not fail, but the type of the resource is not a supported text track format, or the file was not successfully processed (e.g., the format in question is an XML format and the file contained a well-formedness error that "
					cite XML
					- " requires be detected and reported to the application), then the "
					a href="#concept-task" id=sourcing-out-of-band-text-tracks:concept-task-3 task
					- " that is "
					a href="#queue-an-element-task" id=sourcing-out-of-band-text-tracks:queue-an-element-task-2 queued
					- " on the "
					a href="#networking-task-source" id=sourcing-out-of-band-text-tracks:networking-task-source-3 "networking task source"
					- " in which the aforementioned problem is found must change the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-4 "text track readiness state"
					- " to "
					a href="#text-track-failed-to-load" id=sourcing-out-of-band-text-tracks:text-track-failed-to-load-2 "failed to load"
					- " and "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=sourcing-out-of-band-text-tracks:concept-event-fire-4 "fire an event"
					- " named "
					code id=sourcing-out-of-band-text-tracks:event-track-error-2 {
						a href="#event-track-error" error
					}
					- " at the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-20 {
						a href="#the-track-element" track
					}
					- " element."
				}
				p {
					- "If fetching does not fail, and the file was successfully processed, then the final "
					a href="#concept-task" id=sourcing-out-of-band-text-tracks:concept-task-4 task
					- " that is "
					a href="#queue-an-element-task" id=sourcing-out-of-band-text-tracks:queue-an-element-task-3 queued
					- " by the "
					a href="#networking-task-source" id=sourcing-out-of-band-text-tracks:networking-task-source-4 "networking task source"
					- ", after it has finished parsing the data, must change the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-5 "text track readiness state"
					- " to "
					a href="#text-track-loaded" id=sourcing-out-of-band-text-tracks:text-track-loaded loaded
					- ", and "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=sourcing-out-of-band-text-tracks:concept-event-fire-5 "fire an event"
					- " named "
					code id=sourcing-out-of-band-text-tracks:event-track-load {
						a href="#event-track-load" load
					}
					- " at the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-21 {
						a href="#the-track-element" track
					}
					- " element."
				}
				p "If, while fetching is ongoing, either:"
				ul {
					li {
						- "the "
						a href="#track-url" id=sourcing-out-of-band-text-tracks:track-url-3 "track URL"
						- " changes so that it is no longer equal to "
						var URL
						- ", while the "
						a href="#text-track-mode" id=sourcing-out-of-band-text-tracks:text-track-mode-10 "text track mode"
						- " is set to "
						a href="#text-track-hidden" id=sourcing-out-of-band-text-tracks:text-track-hidden-3 hidden
						- " or "
						a href="#text-track-showing" id=sourcing-out-of-band-text-tracks:text-track-showing-5 showing
						- "; or"
					}
					li {
						- "the "
						a href="#text-track-mode" id=sourcing-out-of-band-text-tracks:text-track-mode-11 "text track mode"
						- " changes to "
						a href="#text-track-hidden" id=sourcing-out-of-band-text-tracks:text-track-hidden-4 hidden
						- " or "
						a href="#text-track-showing" id=sourcing-out-of-band-text-tracks:text-track-showing-6 showing
						- ", while the "
						a href="#track-url" id=sourcing-out-of-band-text-tracks:track-url-4 "track URL"
						- " is not equal to "
						var URL
					}
				}
				p {
					- "...then the user agent must abort "
					a data-x-internal=concept-fetch href="https://fetch.spec.whatwg.org/#concept-fetch" id=sourcing-out-of-band-text-tracks:concept-fetch-2 fetching
					- ", discarding any pending "
					a href="#concept-task" id=sourcing-out-of-band-text-tracks:concept-task-5 tasks
					- " generated by that algorithm (and in particular, not adding any cues to the "
					a href="#text-track-list-of-cues" id=sourcing-out-of-band-text-tracks:text-track-list-of-cues-4 "text track list of cues"
					- " after the moment the URL changed), and then "
					a href="#queue-an-element-task" id=sourcing-out-of-band-text-tracks:queue-an-element-task-4 "queue an element task"
					- " on the "
					a href="#dom-manipulation-task-source" id=sourcing-out-of-band-text-tracks:dom-manipulation-task-source-2 "DOM manipulation task source"
					- " given the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-22 {
						a href="#the-track-element" track
					}
					- " element that first changes the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-6 "text track readiness state"
					- " to "
					a href="#text-track-failed-to-load" id=sourcing-out-of-band-text-tracks:text-track-failed-to-load-3 "failed to load"
					- " and then "
					a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=sourcing-out-of-band-text-tracks:concept-event-fire-6 "fires an event"
					- " named "
					code id=sourcing-out-of-band-text-tracks:event-track-error-3 {
						a href="#event-track-error" error
					}
					- " at the "
					code id=sourcing-out-of-band-text-tracks:the-track-element-23 {
						a href="#the-track-element" track
					}
					- " element. "
				}
			}
			li {
				p {
					- "Wait until the "
					a href="#text-track-readiness-state" id=sourcing-out-of-band-text-tracks:text-track-readiness-state-7 "text track readiness state"
					- " is no longer set to "
					a href="#text-track-loading" id=sourcing-out-of-band-text-tracks:text-track-loading-2 loading
					- .
				}
			}
			li {
				p {
					- "Wait until the "
					a href="#track-url" id=sourcing-out-of-band-text-tracks:track-url-5 "track URL"
					- " is no longer equal to "
					var URL
					- ", at the same time as the "
					a href="#text-track-mode" id=sourcing-out-of-band-text-tracks:text-track-mode-12 "text track mode"
					- " is set to "
					a href="#text-track-hidden" id=sourcing-out-of-band-text-tracks:text-track-hidden-5 hidden
					- " or "
					a href="#text-track-showing" id=sourcing-out-of-band-text-tracks:text-track-showing-7 showing
					- .
				}
			}
			li {
				p {
					- "Jump to the step labeled "
					i top
					- .
				}
			}
		}
		p {
			- "Whenever a "
			code id=sourcing-out-of-band-text-tracks:the-track-element-24 {
				a href="#the-track-element" track
			}
			- " element has its "
			code id=sourcing-out-of-band-text-tracks:attr-track-src {
				a href="#attr-track-src" src
			}
			- " attribute set, changed, or removed, the user agent must "
			a href="#immediately" id=sourcing-out-of-band-text-tracks:immediately immediately
			- " empty the element's "
			a href="#text-track" id=sourcing-out-of-band-text-tracks:text-track-19 "text track"
			- "'s "
			a href="#text-track-list-of-cues" id=sourcing-out-of-band-text-tracks:text-track-list-of-cues-5 "text track list of cues"
			- ". (This also causes the algorithm above to stop adding cues from the resource being obtained using the previously given URL, if any.)"
		}
		h6 id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues {
			span class=secno "4.8.11.11.4"
			dfn "Guidelines for exposing cues"
			- " in various formats as "
			a href="#text-track-cue" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue "text track cues"
			a class=self-link href="#guidelines-for-exposing-cues-in-various-formats-as-text-track-cues"
		}
		p "How a specific format's text track cues are to be interpreted for the purposes of processing by an HTML user agent is defined by that format. In the absence of such a specification, this section provides some constraints within which implementations can attempt to consistently expose such formats."
		p {
			- "To support the "
			a href="#text-track" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track "text track"
			- " model of HTML, each unit of timed data is converted to a "
			a href="#text-track-cue" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-2 "text track cue"
			- ". Where the mapping of the format's features to the aspects of a "
			a href="#text-track-cue" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-3 "text track cue"
			- " as defined in this specification are not defined, implementations must ensure that the mapping is consistent with the definitions of the aspects of a "
			a href="#text-track-cue" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-4 "text track cue"
			- " as defined above, as well as with the following constraints:"
		}
		dl {
			dt {
				- "The "
				a href="#text-track-cue-identifier" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-identifier "text track cue identifier"
			}
			dd {
				p "Should be set to the empty string if the format has no obvious analogue to a per-cue identifier."
			}
			dt {
				- "The "
				a href="#text-track-cue-pause-on-exit-flag" id=guidelines-for-exposing-cues-in-various-formats-as-text-track-cues:text-track-cue-pause-on-exit-flag "text track cue pause-on-exit flag"
			}
			dd {
				p "Should be set to false."
			}
		}
		h6 id=text-track-api {
			span class=secno "4.8.11.11.5"
			- " Text track API"
			a class=self-link href="#text-track-api"
		}
		div class="mdn-anno wrapped" {
			button class=mdn-anno-btn onclick="toggleStatus(this)" {
				b class=all-engines-flag title="Support in all current engines." ✔
				span MDN
			}
			div class=feature {
				p {
					a href="https://developer.mozilla.org/en-US/docs/Web/API/TextTrackList" title="The TextTrackList interface is used to represent a list of the text tracks defined by the <track> element, with each track represented by a separate textTrack object in the list." TextTrackList
				}
				p class=all-engines-text "Support in all current engines."
				div class=support {
					span class="firefox yes" {
						span Firefox
						span "31+"
					}
					span class="safari yes" {
						span Safari
						span "6+"
					}
					span class="chrome yes" {
						span Chrome
						span "23+"
					}
					hr
					span class="opera yes" {
						span Opera
						span "12.1+"
					}
					span class="edge_blink yes" {
						span Edge
						span "79+"
					}
					hr
					span class="edge yes" {
						span "Edge (Legacy)"
						span "12+"
					}
					span class="ie yes" {
						span "Internet Explorer"
						span "10+"
					}
					hr
					span class="firefox_android unknown" {
						span "Firefox Android"
						span ?
					}
					span class="safari_ios yes" {
						span "Safari iOS"
						span "7+"
					}
					span class="chrome_android unknown" {
						span "Chrome Android"
						span ?
					}
					span class="webview_android unknown" {
						span "WebView Android"
						span ?
					}
					span class="samsunginternet_android unknown" {
						span "Samsung Internet"
						span ?
					}
					span class="opera_android yes" {
						span "Opera Android"
						span "12.1+"
					}
				}
			}
		}
		pre {
			code class=idl {
				- "["
				c- g="" Exposed
				- "="
				c- n="" Window
				- "] "
				c- b="" interface
				dfn data-dfn-type=interface id=texttracklist {
					c- g="" TextTrackList
				}
				- " : "
				a data-x-internal=eventtarget href="https://dom.spec.whatwg.org/#interface-eventtarget" id=text-track-api:eventtarget {
					c- n="" EventTarget
				}
				- " { "
				c- b="" readonly
				c- b="" attribute
				c- b="" unsigned
				c- b="" long
				a href="#dom-texttracklist-length" id=text-track-api:dom-texttracklist-length {
					c- g="" length
				}
				- "; "
				a href="#dom-texttracklist-item" {
					c- b="" getter
				}
				a href="#texttrack" id=text-track-api:texttrack {
					c- n="" TextTrack
				}
				- " ("
				c- b="" unsigned
				c- b="" long
				c- g="" index
				- "); "
				a href="#texttrack" id=text-track-api:texttrack-2 {
					c- n="" TextTrack
				}
				- "? "
				a href="#dom-texttracklist-gettrackbyid" id=text-track-api:dom-texttracklist-gettrackbyid {
					c- g="" getTrackById
				}
				- "("
				c- b="" DOMString
				c- g="" id
				- "); "
				c- b="" attribute
				a href="#eventhandler" id=text-track-api:eventhandler {
					c- n="" EventHandler
				}
				a href="#handler-texttracklist-onchange" id=text-track-api:handler-texttracklist-onchange {
					c- g="" onchange
				}
				- "; "
				c- b="" attribute
				a href="#eventhandler" id=text-track-api:eventhandler-2 {
