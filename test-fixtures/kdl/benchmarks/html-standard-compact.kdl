									li {
										- "\""
										code id=autofilling-form-controls:-the-autocomplete-attribute:attr-fe-autocomplete-tel-local-suffix {
											a href="#attr-fe-autocomplete-tel-local-suffix" tel-local-suffix
										}
										- "\" "
