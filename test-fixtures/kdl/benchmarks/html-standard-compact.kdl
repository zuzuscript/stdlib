					c- p="" "("
					c- u="" "\"./foo4.mjs\""
					c- p="" ,
					c- p="" "{"
					c- a="" with
					c- o="" :
					c- p="" "{"
					- " type"
					c- o="" :
					c- kc="" "null"
					c- p="" "}"
					c- p="" "});"
					c- k="" await
					c- k="" import
					c- p="" "("
