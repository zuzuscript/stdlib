			- ") or start with the string \""
			code auto,
			- "\" ("
			a data-x-internal=ascii-case-insensitive href="https://infra.spec.whatwg.org/#ascii-case-insensitive" id=sizes-attributes:ascii-case-insensitive-2 "ASCII case-insensitive"
			- ")."
		}
		p class=note {
			- "If the "
			code id=sizes-attributes:the-img-element {
				a href="#the-img-element" img
			}
