					- "{ "
					a href="#dom-navigationresult-committed" id=navigation-api-initiating-navigations:dom-navigationresult-committed committed
					- ", "
					a href="#dom-navigationresult-finished" id=navigation-api-initiating-navigations:dom-navigationresult-finished finished
					- " } = "
					a href="#dom-navigation" id=navigation-api-initiating-navigations:dom-navigation navigation
					- .
					a href="#dom-navigation-navigate" id=dom-navigation-navigate-dev navigate
					- "("
					var url
					- ")"
