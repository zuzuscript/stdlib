					a data-x-internal=composed-flag href="https://dom.spec.whatwg.org/#composed-flag" id=event-firing:composed-flag "composed flag"
					- .
				}
			}
			li {
				p {
					- "If the "
					var "not trusted flag"
					- " is set, initialize "
					var event
