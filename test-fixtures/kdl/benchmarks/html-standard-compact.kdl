				a data-x-internal=em-over-baseline href="https://drafts.csswg.org/css-inline/#em-over-baseline" id=text-styles:em-over-baseline-2 "em-over baseline"
				- " and the "
				a data-x-internal=em-under-baseline href="https://drafts.csswg.org/css-inline/#em-under-baseline" id=text-styles:em-under-baseline "em-under baseline"
			}
			dt {
				dfn data-dfn-for=CanvasTextBaseline data-dfn-type=enum-value id=dom-context-2d-textbaseline-alphabetic {
					code alphabetic
				}
			}
