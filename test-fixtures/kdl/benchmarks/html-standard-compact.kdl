			- " whose "
			a data-x-internal=concept-response-type href="https://fetch.spec.whatwg.org/#concept-response-type" id=terminology-3:concept-response-type type
			- " is \""
			code basic
			- "\", \""
			code cors
			- "\", or \""
			code default
			- "\" is "
			dfn data-export="" id=cors-same-origin CORS-same-origin
			- ". "
			a href="#refsFETCH" "[FETCH]"
		}
		p {
			- "A "
			a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=terminology-3:concept-response-2 response
			- " whose "
			a data-x-internal=concept-response-type href="https://fetch.spec.whatwg.org/#concept-response-type" id=terminology-3:concept-response-type-2 type
			- " is \""
			code opaque
			- "\" or \""
			code opaqueredirect
			- "\" is "
			dfn id=cors-cross-origin CORS-cross-origin
			- .
		}
		p {
			- "A "
			a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=terminology-3:concept-response-3 response
			- "'s "
			dfn data-export="" id=unsafe-response "unsafe response"
			- " is its "
			a data-x-internal=concept-internal-response href="https://fetch.spec.whatwg.org/#concept-internal-response" id=terminology-3:concept-internal-response "internal response"
			- " if it has one, and the "
			a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=terminology-3:concept-response-4 response
			- " itself otherwise."
		}
		p {
			- "To "
			dfn id=create-a-potential-cors-request "create a potential-CORS request"
			- ", given a "
			var url
			- ", "
			var destination
			- ", "
			var corsAttributeState
			- ", and an optional "
			i "same-origin fallback flag"
			- ", run these steps:"
		}
		ol {
			li {
				p {
					- "Let "
					var mode
					- " be \""
					code no-cors
					- "\" if "
					var corsAttributeState
					- " is "
					a href="#attr-crossorigin-none" id=terminology-3:attr-crossorigin-none "No CORS"
					- ", and \""
					code cors
					- "\" otherwise."
				}
			}
			li {
