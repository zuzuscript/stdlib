						code id=parsing-main-inhead:attr-template-shadowrootmode {
							a href="#attr-template-shadowrootmode" shadowrootmode
						}
						- " is not in the "
						a href="#attr-shadowrootmode-none-state" id=parsing-main-inhead:attr-shadowrootmode-none-state none
						- " state;"
					}
					li {
						var document
						- "'s "
						a data-x-internal=concept-document-allow-declarative-shadow-roots href="https://dom.spec.whatwg.org/#concept-document-allow-declarative-shadow-roots" id=parsing-main-inhead:concept-document-allow-declarative-shadow-roots "allow declarative shadow roots"
						- " is true; or"
					}
					li {
						- "the "
						a href="#adjusted-current-node" id=parsing-main-inhead:adjusted-current-node "adjusted current node"
						- " is not the topmost element in the "
						a href="#stack-of-open-elements" id=parsing-main-inhead:stack-of-open-elements-5 "stack of open elements"
						- ,
