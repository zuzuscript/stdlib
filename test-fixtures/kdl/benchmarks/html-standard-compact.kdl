				}
				tr {
					td {
						dfn id=attr-area-shape-keyword-default {
							code default
						}
					}
					td {					}
					td {
						a href="#attr-area-shape-default" id=the-area-element:attr-area-shape-default "Default state"
					}
					td {
						- "This area is the whole image. (The "
						code id=the-area-element:attr-area-coords-4 {
							a href="#attr-area-coords" coords
						}
						- " attribute is not used.) "
					}
				}
				tr {
					td {
						dfn id=attr-area-shape-keyword-poly {
							code poly
						}
					}
					td {					}
					td rowspan="2" {
						a href="#attr-area-shape-poly" id=the-area-element:attr-area-shape-poly "Polygon state"
					}
					td rowspan="2" {
						- "Designates a polygon, using at-least six integers in the "
						code id=the-area-element:attr-area-coords-5 {
							a href="#attr-area-coords" coords
						}
						- " attribute. "
					}
				}
