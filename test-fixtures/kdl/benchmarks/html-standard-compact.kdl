			- " element has a "
			code id=image-map-processing-model:attr-hyperlink-usemap {
				a href="#attr-hyperlink-usemap" usemap
			}
			- " attribute specified, user agents must process it as follows:"
		}
		ol {
			li {
				p {
					- "Parse the attribute's value using the "
					a href="#rules-for-parsing-a-hash-name-reference" id=image-map-processing-model:rules-for-parsing-a-hash-name-reference "rules for parsing a hash-name reference"
					- " to a "
					code id=image-map-processing-model:the-map-element {
						a href="#the-map-element" map
