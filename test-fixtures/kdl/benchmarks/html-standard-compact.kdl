						tr {
							td disposition
							td {
								var disposition
							}
						}
					}
				}
			}
			li {
				p {
					a data-x-internal=queue-a-report href="https://w3c.github.io/reporting/#queue-report" id=embedder-policy-checks:queue-a-report Queue
					var body
					- " as the "
					a href="#coep-report-type" id=embedder-policy-checks:coep-report-type {
						- "\""
						code coep
						- "\" report type"
					}
					- " for "
					var endpoint
					- " on "
					var settings
					- ". "
				}
			}
		}
		h4 id=sandboxing {
			span class=secno "7.1.5"
			- " Sandboxing"
			a class=self-link href="#sandboxing"
		}
		p {
			- "A "
			dfn data-export="" id=sandboxing-flag-set "sandboxing flag set"
			- " is a set of zero or more of the following flags, which are used to restrict the abilities that potentially untrusted resources have:"
		}
		dl {
			dt {
				- "The "
				dfn data-export="" id=sandboxed-navigation-browsing-context-flag "sandboxed navigation browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxLinks" "prevents content from navigating browsing contexts other than the sandboxed browsing context itself"
					- " (or browsing contexts further nested inside it), "
					a href="#auxiliary-browsing-context" id=sandboxing:auxiliary-browsing-context "auxiliary browsing contexts"
					- " (which are protected by the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id=sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag "sandboxed auxiliary navigation browsing context flag"
					- " defined next), and the "
					a href="#top-level-browsing-context" id=sandboxing:top-level-browsing-context "top-level browsing context"
					- " (which is protected by the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag "sandboxed top-level navigation without user activation browsing context flag"
					- " and "
					a href="#sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-with-user-activation-browsing-context-flag "sandboxed top-level navigation with user activation browsing context flag"
					- " defined below)."
				}
				p {
					- "If the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id=sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-2 "sandboxed auxiliary navigation browsing context flag"
					- " is not set, then in certain cases the restrictions nonetheless allow popups (new "
					a href="#top-level-browsing-context" id=sandboxing:top-level-browsing-context-2 "top-level browsing contexts"
					- ") to be opened. These "
					a href="#browsing-context" id=sandboxing:browsing-context "browsing contexts"
					- " always have "
					dfn id=one-permitted-sandboxed-navigator "one permitted sandboxed navigator"
					- ", set when the browsing context is created, which allows the "
					a href="#browsing-context" id=sandboxing:browsing-context-2 "browsing context"
					- " that created them to actually navigate them. (Otherwise, the "
					a href="#sandboxed-navigation-browsing-context-flag" id=sandboxing:sandboxed-navigation-browsing-context-flag "sandboxed navigation browsing context flag"
					- " would prevent them from being navigated even if they were opened.)"
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-auxiliary-navigation-browsing-context-flag "sandboxed auxiliary navigation browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxWindowOpen" "prevents content from creating new auxiliary browsing contexts"
					- ", e.g. using the "
					code id=sandboxing:attr-hyperlink-target {
						a href="#attr-hyperlink-target" target
					}
					- " attribute or the "
					code id=sandboxing:dom-open {
						a href="#dom-open" "window.open()"
					}
					- " method."
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-top-level-navigation-without-user-activation-browsing-context-flag "sandboxed top-level navigation without user activation browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxLinks" {
						- "prevents content from navigating their "
						span "top-level browsing context"
					}
					- " and "
					a href="#sandboxClose" {
						- "prevents content from closing their "
						span "top-level browsing context"
					}
					- ". It is consulted only when the sandboxed browsing context's "
					a href="#active-window" id=sandboxing:active-window "active window"
					- " does not have "
					a href="#transient-activation" id=sandboxing:transient-activation "transient activation"
					- .
				}
				p {
					- "When the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-2 "sandboxed top-level navigation without user activation browsing context flag"
					- " is "
					em not
					- " set, content can navigate its "
					a href="#top-level-browsing-context" id=sandboxing:top-level-browsing-context-3 "top-level browsing context"
					- ", but other "
					a href="#browsing-context" id=sandboxing:browsing-context-3 "browsing contexts"
					- " are still protected by the "
					a href="#sandboxed-navigation-browsing-context-flag" id=sandboxing:sandboxed-navigation-browsing-context-flag-2 "sandboxed navigation browsing context flag"
					- " and possibly the "
					a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id=sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-3 "sandboxed auxiliary navigation browsing context flag"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-top-level-navigation-with-user-activation-browsing-context-flag "sandboxed top-level navigation with user activation browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxLinks" {
						- "prevents content from navigating their "
						span "top-level browsing context"
					}
					- " and "
					a href="#sandboxClose" {
						- "prevents content from closing their "
						span "top-level browsing context"
					}
					- ". It is consulted only when the sandboxed browsing context's "
					a href="#active-window" id=sandboxing:active-window-2 "active window"
					- " has "
					a href="#transient-activation" id=sandboxing:transient-activation-2 "transient activation"
					- .
				}
				p {
					- "As with the "
					a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-3 "sandboxed top-level navigation without user activation browsing context flag"
					- ", this flag only affects the "
					a href="#top-level-browsing-context" id=sandboxing:top-level-browsing-context-4 "top-level browsing context"
					- "; if it is not set, other "
					a href="#browsing-context" id=sandboxing:browsing-context-4 "browsing contexts"
					- " might still be protected by other flags."
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-origin-browsing-context-flag "sandboxed origin browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxOrigin" "forces content into an opaque origin"
					- ", thus preventing it from accessing other content from the same "
					a href="#concept-origin" id=sandboxing:concept-origin origin
					- .
				}
				p {
					- "This flag also "
					a href="#sandboxCookies" {
						- "prevents script from reading from or writing to the "
						code document.cookie
						- " IDL attribute"
					}
					- ", and blocks access to "
					code id=sandboxing:dom-localstorage {
						a href="#dom-localstorage" localStorage
					}
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-forms-browsing-context-flag "sandboxed forms browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxSubmitBlocked" "blocks form submission"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-pointer-lock-browsing-context-flag "sandboxed pointer lock browsing context flag"
			}
			dd {
				p {
					- "This flag disables the Pointer Lock API. "
					a href="#refsPOINTERLOCK" "[POINTERLOCK]"
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-scripts-browsing-context-flag "sandboxed scripts browsing context flag"
			}
			dd {
				p {
					- "This flag "
					a href="#sandboxScriptBlocked" "blocks script execution"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-automatic-features-browsing-context-flag "sandboxed automatic features browsing context flag"
			}
			dd {
				p {
					- "This flag blocks features that trigger automatically, such as "
					a href="#attr-media-autoplay" id=sandboxing:attr-media-autoplay "automatically playing a video"
					- " or "
					a href="#attr-fe-autofocus" id=sandboxing:attr-fe-autofocus "automatically focusing a form control"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-document.domain-browsing-context-flag {
					- "sandboxed "
					code document.domain
					- " browsing context flag"
				}
			}
			dd {
				p {
					- "This flag prevents content from using the "
					code id=sandboxing:dom-document-domain {
						a href="#dom-document-domain" document.domain
					}
					- " setter."
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandbox-propagates-to-auxiliary-browsing-contexts-flag "sandbox propagates to auxiliary browsing contexts flag"
			}
			dd {
				p {
					- "This flag prevents content from escaping the sandbox by ensuring that any "
					a href="#auxiliary-browsing-context" id=sandboxing:auxiliary-browsing-context-2 "auxiliary browsing context"
					- " it creates inherits the content's "
					a href="#active-sandboxing-flag-set" id=sandboxing:active-sandboxing-flag-set "active sandboxing flag set"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-modals-flag "sandboxed modals flag"
			}
			dd {
				p "This flag prevents content from using any of the following features to produce modal dialogs:"
				ul {
					li {
						code id=sandboxing:dom-alert {
							a href="#dom-alert" "window.alert()"
						}
					}
					li {
						code id=sandboxing:dom-confirm {
							a href="#dom-confirm" "window.confirm()"
						}
					}
					li {
						code id=sandboxing:dom-print {
							a href="#dom-print" "window.print()"
						}
					}
					li {
						code id=sandboxing:dom-prompt {
							a href="#dom-prompt" "window.prompt()"
						}
					}
					li {
						- "the "
						code id=sandboxing:event-beforeunload {
							a href="#event-beforeunload" beforeunload
						}
						- " event"
					}
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-orientation-lock-browsing-context-flag "sandboxed orientation lock browsing context flag"
			}
			dd {
				p {
					- "This flag disables the ability to lock the screen orientation. "
					a href="#refsSCREENORIENTATION" "[SCREENORIENTATION]"
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-presentation-browsing-context-flag "sandboxed presentation browsing context flag"
			}
			dd {
				p {
					- "This flag disables the Presentation API. "
					a href="#refsPRESENTATION" "[PRESENTATION]"
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-downloads-browsing-context-flag "sandboxed downloads browsing context flag"
			}
			dd {
				p {
					- "This flag prevents content from initiating or instantiating downloads, whether through "
					a href="#downloading-hyperlinks" id=sandboxing:downloading-hyperlinks "downloading hyperlinks"
					- " or through "
					a href="#navigation-as-a-download" navigation
					- " that gets handled "
					a href="#as-a-download" id=sandboxing:as-a-download "as a download"
					- .
				}
			}
			dt {
				- "The "
				dfn data-export="" id=sandboxed-custom-protocols-navigation-browsing-context-flag "sandboxed custom protocols navigation browsing context flag"
			}
			dd {
				p {
					- "This flag prevents navigations toward non "
					a data-x-internal=fetch-scheme href="https://fetch.spec.whatwg.org/#fetch-scheme" id=sandboxing:fetch-scheme "fetch schemes"
					- " from being "
					a href="#hand-off-to-external-software" id=sandboxing:hand-off-to-external-software "handed off to external software"
					- .
				}
			}
		}
		p {
			- "When the user agent is to "
			dfn data-export="" id=parse-a-sandboxing-directive "parse a sandboxing directive"
			- ", given a string "
			var input
			- ", a "
			a href="#sandboxing-flag-set" id=sandboxing:sandboxing-flag-set "sandboxing flag set"
			var output
			- ", it must run the following steps:"
		}
		ol {
			li {
				p {
					a data-x-internal=split-a-string-on-spaces href="https://infra.spec.whatwg.org/#split-on-ascii-whitespace" id=sandboxing:split-a-string-on-spaces {
						- "Split "
						var input
						- " on ASCII whitespace"
					}
					- ", to obtain "
					var tokens
					- .
				}
			}
			li {
				p {
					- "Let "
					var output
					- " be empty."
				}
			}
			li {
				p {
					- "Add the following flags to "
					var output
					- :
				}
				ul {
					li {
						p {
							- "The "
							a href="#sandboxed-navigation-browsing-context-flag" id=sandboxing:sandboxed-navigation-browsing-context-flag-3 "sandboxed navigation browsing context flag"
							- .
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-auxiliary-navigation-browsing-context-flag" id=sandboxing:sandboxed-auxiliary-navigation-browsing-context-flag-4 "sandboxed auxiliary navigation browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-popups {
								code allow-popups
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-top-level-navigation-without-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-without-user-activation-browsing-context-flag-4 "sandboxed top-level navigation without user activation browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-top-navigation {
								code allow-top-navigation
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-top-level-navigation-with-user-activation-browsing-context-flag" id=sandboxing:sandboxed-top-level-navigation-with-user-activation-browsing-context-flag-2 "sandboxed top-level navigation with user activation browsing context flag"
							- ", unless "
							var tokens
							- " contains either the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-top-navigation-by-user-activation {
								code allow-top-navigation-by-user-activation
							}
							- " keyword or the "
							code id=sandboxing:attr-iframe-sandbox-allow-top-navigation {
								a href="#attr-iframe-sandbox-allow-top-navigation" allow-top-navigation
							}
							- " keyword."
						}
						p class=note {
							- "This means that if the "
							code id=sandboxing:attr-iframe-sandbox-allow-top-navigation-2 {
								a href="#attr-iframe-sandbox-allow-top-navigation" allow-top-navigation
							}
							- " is present, the "
							code id=sandboxing:attr-iframe-sandbox-allow-top-navigation-by-user-activation {
								a href="#attr-iframe-sandbox-allow-top-navigation-by-user-activation" allow-top-navigation-by-user-activation
							}
							- " keyword will have no effect. For this reason, specifying both is a document conformance error."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-origin-browsing-context-flag" id=sandboxing:sandboxed-origin-browsing-context-flag "sandboxed origin browsing context flag"
							- ", unless the "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-same-origin {
								code allow-same-origin
							}
							- " keyword."
						}
						div class=note {
							p {
								- "The "
								code id=sandboxing:attr-iframe-sandbox-allow-same-origin {
									a href="#attr-iframe-sandbox-allow-same-origin" allow-same-origin
								}
								- " keyword is intended for two cases."
							}
							p "First, it can be used to allow content from the same site to be sandboxed to disable scripting, while still allowing access to the DOM of the sandboxed content."
							p "Second, it can be used to embed content from a third-party site, sandboxed to prevent that site from opening popups, etc, without preventing the embedded page from communicating back to its originating site, using the database APIs to store data, etc."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-forms-browsing-context-flag" id=sandboxing:sandboxed-forms-browsing-context-flag "sandboxed forms browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-forms {
								code allow-forms
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-pointer-lock-browsing-context-flag" id=sandboxing:sandboxed-pointer-lock-browsing-context-flag "sandboxed pointer lock browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-pointer-lock {
								code allow-pointer-lock
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-scripts-browsing-context-flag" id=sandboxing:sandboxed-scripts-browsing-context-flag "sandboxed scripts browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-scripts {
								code allow-scripts
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-automatic-features-browsing-context-flag" id=sandboxing:sandboxed-automatic-features-browsing-context-flag "sandboxed automatic features browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							code id=sandboxing:attr-iframe-sandbox-allow-scripts {
								a href="#attr-iframe-sandbox-allow-scripts" allow-scripts
							}
							- " keyword (defined above)."
						}
						p class=note "This flag is relaxed by the same keyword as scripts, because when scripts are enabled these features are trivially possible anyway, and it would be unfortunate to force authors to use script to do them when sandboxed rather than allowing them to use the declarative features."
					}
					li {
						p {
							- "The "
							a href="#sandboxed-document.domain-browsing-context-flag" id=sandboxing:sandboxed-document.domain-browsing-context-flag {
								- "sandboxed "
								code document.domain
								- " browsing context flag"
							}
							- .
						}
					}
					li {
						p {
							- "The "
							a href="#sandbox-propagates-to-auxiliary-browsing-contexts-flag" id=sandboxing:sandbox-propagates-to-auxiliary-browsing-contexts-flag "sandbox propagates to auxiliary browsing contexts flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-popups-to-escape-sandbox {
								code allow-popups-to-escape-sandbox
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-modals-flag" id=sandboxing:sandboxed-modals-flag "sandboxed modals flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-modals {
								code allow-modals
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-orientation-lock-browsing-context-flag" id=sandboxing:sandboxed-orientation-lock-browsing-context-flag "sandboxed orientation lock browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-orientation-lock {
								code allow-orientation-lock
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-presentation-browsing-context-flag" id=sandboxing:sandboxed-presentation-browsing-context-flag "sandboxed presentation browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-presentation {
								code allow-presentation
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-downloads-browsing-context-flag" id=sandboxing:sandboxed-downloads-browsing-context-flag "sandboxed downloads browsing context flag"
							- ", unless "
							var tokens
							- " contains the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-downloads {
								code allow-downloads
							}
							- " keyword."
						}
					}
					li {
						p {
							- "The "
							a href="#sandboxed-custom-protocols-navigation-browsing-context-flag" id=sandboxing:sandboxed-custom-protocols-navigation-browsing-context-flag "sandboxed custom protocols navigation browsing context flag"
							- ", unless "
							var tokens
							- " contains either the "
							dfn data-dfn-for="iframe/sandbox" data-dfn-type=attr-value id=attr-iframe-sandbox-allow-top-navigation-to-custom-protocols {
								code allow-top-navigation-to-custom-protocols
							}
							- " keyword, the "
							code id=sandboxing:attr-iframe-sandbox-allow-popups {
