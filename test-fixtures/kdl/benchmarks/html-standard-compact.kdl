			}
			- " are both the "
			dfn id=attr-draggable-auto-state auto
			- " state. The auto state uses the default behavior of the user agent."
		}
		p {
			- "An element with a "
			code id=the-draggable-attribute:attr-draggable-3 {
				a href="#attr-draggable" draggable
			}
			- " attribute should also have a "
			code id=the-draggable-attribute:attr-title {
				a href="#attr-title" title
