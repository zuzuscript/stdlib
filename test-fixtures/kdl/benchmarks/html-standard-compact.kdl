					span class="chrome_android unknown" {
						span "Chrome Android"
						span ?
					}
					span class="webview_android unknown" {
						span "WebView Android"
						span ?
					}
					span class="samsunginternet_android unknown" {
						span "Samsung Internet"
						span ?
					}
					span class="opera_android unknown" {
						span "Opera Android"
						span ?
					}
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=html-global data-dfn-type=element-attr id=attr-translate {
				code translate
			}
			- " attribute is used to specify whether an element's attribute values and the values of its "
			code id=the-translate-attribute:text {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " node children are to be translated when the page is localized, or whether to leave them unchanged. It is an attribute is an "
			a href="#enumerated-attribute" id=the-translate-attribute:enumerated-attribute "enumerated attribute"
			- " with the following keywords and states:"
		}
		table {
			thead {
				tr {
					th "Keyword "
					th "State "
					th "Brief description "
				}
			}
			tbody {
				tr {
					td {
						dfn data-dfn-for="html-global/translate" data-dfn-type=attr-value id=attr-translate-yes-keyword {
							code yes
						}
					}
					td rowspan="2" {
						dfn id=attr-translate-yes-state yes
					}
					td rowspan="2" {
						- "Sets "
						a href="#translation-mode" id=the-translate-attribute:translation-mode "translation mode"
						- " to "
						a href="#translate-enabled" id=the-translate-attribute:translate-enabled translate-enabled
						- ". "
					}
				}
				tr {
					td "(the empty string) "
				}
				tr {
					td {
						dfn data-dfn-for="html-global/translate" data-dfn-type=attr-value id=attr-translate-no-keyword {
							code no
						}
					}
					td {
						dfn id=attr-translate-no-state no
					}
					td {
						- "Sets "
						a href="#translation-mode" id=the-translate-attribute:translation-mode-2 "translation mode"
						- " to "
						a href="#no-translate" id=the-translate-attribute:no-translate no-translate
						- ". "
					}
				}
			}
		}
		p {
			- "The attribute's "
			i id=the-translate-attribute:missing-value-default {
				a href="#missing-value-default" "missing value default"
			}
			- " and "
			i id=the-translate-attribute:invalid-value-default {
				a href="#invalid-value-default" "invalid value default"
			}
			- " are both the "
			dfn id=attr-translate-inherit-state inherit
			- " state."
		}
		p {
			- "Each element (even non-HTML elements) has a "
			dfn id=translation-mode "translation mode"
			- ", which is in either the "
			a href="#translate-enabled" id=the-translate-attribute:translate-enabled-2 translate-enabled
			- " state or the "
			a href="#no-translate" id=the-translate-attribute:no-translate-2 no-translate
			- " state. If an "
			a href="#html-elements" id=the-translate-attribute:html-elements "HTML element"
			- "'s "
			code id=the-translate-attribute:attr-translate-2 {
				a href="#attr-translate" translate
			}
			- " attribute is in the "
			a href="#attr-translate-yes-state" id=the-translate-attribute:attr-translate-yes-state yes
			- " state, then the element's "
			a href="#translation-mode" id=the-translate-attribute:translation-mode-3 "translation mode"
			- " is in the "
			a href="#translate-enabled" id=the-translate-attribute:translate-enabled-3 translate-enabled
			- " state; otherwise, if the element's "
			code id=the-translate-attribute:attr-translate-3 {
				a href="#attr-translate" translate
			}
			- " attribute is in the "
			a href="#attr-translate-no-state" id=the-translate-attribute:attr-translate-no-state no
			- " state, then the element's "
			a href="#translation-mode" id=the-translate-attribute:translation-mode-4 "translation mode"
			- " is in the "
			a href="#no-translate" id=the-translate-attribute:no-translate-3 no-translate
			- " state. Otherwise, either the element's "
			code id=the-translate-attribute:attr-translate-4 {
				a href="#attr-translate" translate
			}
			- " attribute is in the "
			a href="#attr-translate-inherit-state" id=the-translate-attribute:attr-translate-inherit-state inherit
			- " state, or the element is not an "
			a href="#html-elements" id=the-translate-attribute:html-elements-2 "HTML element"
			- " and thus does not have a "
			code id=the-translate-attribute:attr-translate-5 {
				a href="#attr-translate" translate
			}
			- " attribute; in either case, the element's "
			a href="#translation-mode" id=the-translate-attribute:translation-mode-5 "translation mode"
			- " is in the same state as its "
			a data-x-internal=parent-element href="https://dom.spec.whatwg.org/#parent-element" id=the-translate-attribute:parent-element "parent element"
			- "'s, if any, or in the "
			a href="#translate-enabled" id=the-translate-attribute:translate-enabled-4 translate-enabled
			- " state, if the element's "
			a data-x-internal=parent-element href="https://dom.spec.whatwg.org/#parent-element" id=the-translate-attribute:parent-element-2 "parent element"
			- " is null."
		}
		p {
			- "When an element is in the "
			dfn id=translate-enabled translate-enabled
			- " state, the element's "
			a href="#translatable-attributes" id=the-translate-attribute:translatable-attributes "translatable attributes"
			- " and the values of its "
			code id=the-translate-attribute:text-2 {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " node children are to be translated when the page is localized."
		}
		p {
			- "When an element is in the "
			dfn id=no-translate no-translate
			- " state, the element's attribute values and the values of its "
			code id=the-translate-attribute:text-3 {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " node children are to be left as-is when the page is localized, e.g. because the element contains a person's name or a name of a computer program."
		}
		p {
			- "The following attributes are "
			dfn id=translatable-attributes "translatable attributes"
			- :
