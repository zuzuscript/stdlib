			- " state."
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLElement data-dfn-type=attribute id=dom-autocorrect {
				code autocorrect
			}
			- " getter steps are: return true if the element's "
			a href="#used-autocorrection-state" id=autocorrection:used-autocorrection-state-2 "used autocorrection state"
			- " is "
			a href="#concept-autocorrection-on" id=autocorrection:concept-autocorrection-on-2 on
			- " and false if the element's "
			a href="#used-autocorrection-state" id=autocorrection:used-autocorrection-state-3 "used autocorrection state"
			- " is "
			a href="#concept-autocorrection-off" id=autocorrection:concept-autocorrection-off off
			- ". The setter steps are: if the given value is true, then the element's "
			code id=autocorrection:attr-autocorrect-4 {
				a href="#attr-autocorrect" autocorrect
			}
			- " attribute must be set to \""
			code on
			- "\"; otherwise it must be set to \""
			code off
			- "\"."
		}
		p {
