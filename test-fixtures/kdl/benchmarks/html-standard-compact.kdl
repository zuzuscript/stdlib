		p class=note "Most elements that are categorized as phrasing content can only contain elements that are themselves categorized as phrasing content, not any flow content."
		p {
			dfn id=text-content Text
			- ", in the context of content models, means either nothing, or "
			code id=phrasing-content:text {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " nodes. "
			a href="#text-content" id=phrasing-content:text-content-2 Text
			- " is sometimes used as a content model on its own, but is also "
			a href="#phrasing-content-2" id=phrasing-content:phrasing-content-2-2 "phrasing content"
			- ", and can be "
			a href="#inter-element-whitespace" id=phrasing-content:inter-element-whitespace "inter-element whitespace"
			- " (if the "
			code id=phrasing-content:text-2 {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " nodes are empty or contain just "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=phrasing-content:space-characters "ASCII whitespace"
			- ")."
		}
		p {
			code id=phrasing-content:text-3 {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " nodes and attribute values must consist of "
			a data-x-internal=scalar-value href="https://infra.spec.whatwg.org/#scalar-value" id=phrasing-content:scalar-value "scalar values"
			- ", excluding "
			a data-x-internal=noncharacter href="https://infra.spec.whatwg.org/#noncharacter" id=phrasing-content:noncharacter noncharacters
			- ", and "
			a data-x-internal=control href="https://infra.spec.whatwg.org/#control" id=phrasing-content:control controls
			- " other than "
			a data-x-internal=space-characters href="https://infra.spec.whatwg.org/#ascii-whitespace" id=phrasing-content:space-characters-2 "ASCII whitespace"
			- ". This specification includes extra constraints on the exact value of "
			code id=phrasing-content:text-4 {
				a data-x-internal=text href="https://dom.spec.whatwg.org/#interface-text" Text
			}
			- " nodes and attribute values depending on their precise context. "
		}
