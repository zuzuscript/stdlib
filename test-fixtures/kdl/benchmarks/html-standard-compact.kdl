		}
		hr
		p {
			- "A worker is said to be a "
			dfn id=permissible-worker "permissible worker"
			- " if its "
			code id=the-worker's-lifetime:workerglobalscope-3 {
				a href="#workerglobalscope" WorkerGlobalScope
