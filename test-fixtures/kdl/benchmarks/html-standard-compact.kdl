					- " to \""
					a href="#parsing-main-inhead" id=the-before-head-insertion-mode:parsing-main-inhead-2 "in head"
					- "\"."
				}
				p "Reprocess the current token."
			}
		}
		h6 id=parsing-main-inhead {
			span class=secno "13.2.6.4.4"
			- " The \""
			dfn "in head"
			- "\" insertion mode"
			a class=self-link href="#parsing-main-inhead"
		}
		p {
			- "When the user agent is to apply the rules for the \""
			a href="#parsing-main-inhead" id=parsing-main-inhead:parsing-main-inhead "in head"
			- "\" "
			a href="#insertion-mode" id=parsing-main-inhead:insertion-mode "insertion mode"
			- ", the user agent must handle the token as follows:"
		}
		dl class=switch {
			dt "A character token that is one of U+0009 CHARACTER TABULATION, U+000A LINE FEED (LF), U+000C FORM FEED (FF), U+000D CARRIAGE RETURN (CR), or U+0020 SPACE"
