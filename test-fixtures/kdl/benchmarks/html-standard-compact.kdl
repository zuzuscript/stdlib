					c- a="" class
					- " CParent "
					c- k="" extends
					- " HTMLElement "
					c- p="" "{"
					- " connectedCallback"
					c- p="" "()"
					c- p="" "{"
					c- k="" this
					c- p="" .
					- firstChild
					c- p="" .
					- remove
					c- p="" "();"
					c- p="" "}"
					c- p="" "}"
					- " customElements"
					c- p="" .
					- define
					c- p="" "("
					c- u="" "\"c-parent\""
					c- p="" ,
					- " CParent"
					c- p="" ");"
					c- a="" class
					- " CChild "
					c- k="" extends
					- " HTMLElement "
					c- p="" "{"
					- " connectedCallback"
					c- p="" "()"
					c- p="" "{"
					- " console"
