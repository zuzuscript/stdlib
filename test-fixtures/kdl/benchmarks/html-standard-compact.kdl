			li {
				p {
					- "Return ("
					var scheme
					- ", "
					var urlRecord
					- ")."
				}
				p class=note {
					- "The "
					a data-x-internal=concept-url-serializer href="https://url.spec.whatwg.org/#concept-url-serializer" id=custom-handlers:concept-url-serializer-2 serialization
					- " of "
					var urlRecord
					- " will by definition not be a "
					a data-x-internal=valid-url-string href="https://url.spec.whatwg.org/#valid-url-string" id=custom-handlers:valid-url-string "valid URL string"
					- " as it includes the string \""
