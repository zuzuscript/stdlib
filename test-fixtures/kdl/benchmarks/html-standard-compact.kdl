					a data-x-internal=valid-url-string href="https://url.spec.whatwg.org/#valid-url-string" id=import-maps:valid-url-string "valid URL strings"
					- " and whose values are "
					a href="#valid-module-specifier-map" id=import-maps:valid-module-specifier-map-2 "valid module specifier maps"
					- .
				}
			}
			li {
				p {
					- "The value corresponding to the \""
					code integrity
					- "\" key, if present, must be a JSON object, whose keys are "
					a data-x-internal=valid-url-string href="https://url.spec.whatwg.org/#valid-url-string" id=import-maps:valid-url-string-2 "valid URL strings"
					- " and whose values fit "
					a data-x-internal=the-requirements-of-the-integrity-attribute href="https://w3c.github.io/webappsec-subresource-integrity/#the-integrity-attribute" id=import-maps:the-requirements-of-the-integrity-attribute "the requirements of the integrity attribute"
					- .
				}
			}
		}
		p {
			- "A "
			dfn id=valid-module-specifier-map "valid module specifier map"
			- " is a JSON object that meets the following requirements:"
		}
		ul {
			li {
				p "All of its keys must be nonempty."
			}
			li {
				p "All of its values must be strings."
			}
			li {
				p {
					- "Each value must be either a "
					a data-x-internal=absolute-url href="https://url.spec.whatwg.org/#syntax-url-absolute" id=import-maps:absolute-url "valid absolute URL"
					- " or a "
					a data-x-internal=valid-url-string href="https://url.spec.whatwg.org/#valid-url-string" id=import-maps:valid-url-string-3 "valid URL string"
					- " that "
					a data-x-internal=starts-with href="https://infra.spec.whatwg.org/#string-starts-with" id=import-maps:starts-with "starts with"
					- " \""
					code "/"
					- "\", \""
					code "./"
					- "\", or \""
					code "../"
					- "\"."
				}
			}
			li {
				p {
					- "If a given key "
					a data-x-internal=ends-with href="https://infra.spec.whatwg.org/#string-ends-with" id=import-maps:ends-with "ends with"
					- " \""
					code "/"
					- "\", then the corresponding value must also."
				}
			}
		}
		h5 id=import-map-processing-model {
			span class=secno "8.1.5.3"
			- " Import map processing model"
			a class=self-link href="#import-map-processing-model"
		}
		p {
			- "Formally, an "
			dfn id=import-map "import map"
			- " is a "
