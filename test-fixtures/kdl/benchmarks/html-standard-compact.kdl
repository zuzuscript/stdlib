								span Opera
								span "12.1+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "3+"
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android yes" {
								span "WebView Android"
								span "37+"
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p {
					- "Returns a "
					code id=loading-the-media-resource:timeranges {
						a href="#timeranges" TimeRanges
					}
					- " object that represents the ranges of the "
					a href="#media-resource" id=loading-the-media-resource:media-resource-21 "media resource"
					- " that the user agent has buffered."
				}
			}
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=attribute id=dom-media-buffered {
				code buffered
			}
			- " attribute must return a new static "
			a href="#normalised-timeranges-object" id=loading-the-media-resource:normalised-timeranges-object {
				- "normalized "
				code TimeRanges
				- " object"
			}
			- " that represents the ranges of the "
			a href="#media-resource" id=loading-the-media-resource:media-resource-22 "media resource"
			- ", if any, that the user agent has buffered, at the time the attribute is evaluated. Users agents must accurately determine the ranges available, even for media streams where this can only be determined by tedious inspection."
		}
		p class=note "Typically this will be a single range anchored at the zero point, but if, e.g. the user agent uses HTTP range requests in response to seeking, then there could be multiple ranges."
		p "User agents may discard previously buffered data."
		p class=note {
			- "Thus, a time position included within a range of the objects return by the "
			code id=loading-the-media-resource:dom-media-buffered {
				a href="#dom-media-buffered" buffered
			}
			- " attribute at one time can end up being not included in the range(s) of objects returned by the same attribute at later times."
		}
		p class=warning "Returning a new object each time is a bad pattern for attribute getters and is only enshrined here as it would be costly to change it. It is not to be copied to new APIs."
		h5 id=offsets-into-the-media-resource {
			span class=secno "4.8.11.6"
			- " Offsets into the media resource"
			a class=self-link href="#offsets-into-the-media-resource"
		}
		dl class=domintro {
			dt {
				code {
					var media
					- .
					a href="#dom-media-duration" id=dom-media-duration-dev duration
				}
				div class="mdn-anno wrapped before" {
					button class=mdn-anno-btn onclick="toggleStatus(this)" {
						b class=all-engines-flag title="Support in all current engines." ✔
						span MDN
					}
					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLMediaElement/duration" title="The read-only HTMLMediaElement property duration indicates the length of the element's media in seconds." "HTMLMediaElement/duration"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "3.5+"
							}
							span class="safari yes" {
								span Safari
								span "3.1+"
							}
							span class="chrome yes" {
								span Chrome
								span "3+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "12.1+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "3+"
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android yes" {
								span "WebView Android"
								span "37+"
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p {
					- "Returns the length of the "
					a href="#media-resource" id=offsets-into-the-media-resource:media-resource "media resource"
					- ", in seconds, assuming that the start of the "
					a href="#media-resource" id=offsets-into-the-media-resource:media-resource-2 "media resource"
					- " is at time zero."
				}
				p "Returns NaN if the duration isn't available."
				p "Returns Infinity for unbounded streams."
			}
			dt {
				code {
					var media
					- .
					a href="#dom-media-currenttime" id=dom-media-currenttime-dev currentTime
					- " [ = "
					var value
					- " ]"
				}
				div class="mdn-anno wrapped before" {
					button class=mdn-anno-btn onclick="toggleStatus(this)" {
						b class=all-engines-flag title="Support in all current engines." ✔
						span MDN
					}
					div class=feature {
						p {
							a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLMediaElement/currentTime" title="The HTMLMediaElement interface's currentTime property specifies the current playback time in seconds." "HTMLMediaElement/currentTime"
						}
						p class=all-engines-text "Support in all current engines."
						div class=support {
							span class="firefox yes" {
								span Firefox
								span "3.5+"
							}
							span class="safari yes" {
								span Safari
								span "3.1+"
							}
							span class="chrome yes" {
								span Chrome
								span "3+"
							}
							hr
							span class="opera yes" {
								span Opera
								span "12.1+"
							}
							span class="edge_blink yes" {
								span Edge
								span "79+"
							}
							hr
							span class="edge yes" {
								span "Edge (Legacy)"
								span "12+"
							}
							span class="ie yes" {
								span "Internet Explorer"
								span "9+"
							}
							hr
							span class="firefox_android unknown" {
								span "Firefox Android"
								span ?
							}
							span class="safari_ios yes" {
								span "Safari iOS"
								span "3+"
							}
							span class="chrome_android unknown" {
								span "Chrome Android"
								span ?
							}
							span class="webview_android yes" {
								span "WebView Android"
								span "37+"
							}
							span class="samsunginternet_android unknown" {
								span "Samsung Internet"
								span ?
							}
							span class="opera_android yes" {
								span "Opera Android"
								span "12.1+"
							}
						}
					}
				}
			}
			dd {
				p {
					- "Returns the "
					a href="#official-playback-position" id=offsets-into-the-media-resource:official-playback-position "official playback position"
					- ", in seconds."
				}
				p "Can be set, to seek to the given time."
			}
		}
		p {
			- "A "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-3 "media resource"
			- " has a "
			dfn id=media-timeline "media timeline"
			- " that maps times (in seconds) to positions in the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-4 "media resource"
			- ". The origin of a timeline is its earliest defined position. The duration of a timeline is its last defined position."
		}
		p {
			dfn id=defineTimeline "Establishing the media timeline"
			- ": if the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-5 "media resource"
			- " somehow specifies an explicit timeline whose origin is not negative (i.e. gives each frame a specific time offset and gives the first frame a zero or positive offset), then the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline "media timeline"
			- " should be that timeline. (Whether the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-6 "media resource"
			- " can specify a timeline or not depends on the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-7 "media resource's"
			- " format.) If the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-8 "media resource"
			- " specifies an explicit start time "
			em "and date"
			- ", then that time and date should be considered the zero point in the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-2 "media timeline"
			- "; the "
			a href="#timeline-offset" id=offsets-into-the-media-resource:timeline-offset "timeline offset"
			- " will be the time and date, exposed using the "
			code id=offsets-into-the-media-resource:dom-media-getstartdate {
				a href="#dom-media-getstartdate" "getStartDate()"
			}
			- " method."
		}
		p {
			- "If the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-9 "media resource"
			- " has a discontinuous timeline, the user agent must extend the timeline used at the start of the resource across the entire resource, so that the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-3 "media timeline"
			- " of the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-10 "media resource"
			- " increases linearly starting from the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position "earliest possible position"
			- " (as defined below), even if the underlying "
			a href="#media-data" id=offsets-into-the-media-resource:media-data "media data"
			- " has out-of-order or even overlapping time codes."
		}
		p class=example "For example, if two clips have been concatenated into one video file, but the video format exposes the original times for the two clips, the video data might expose a timeline that goes, say, 00:15..00:29 and then 00:05..00:38. However, the user agent would not expose those times; it would instead expose the times as 00:15..00:29 and 00:29..01:02, as a single video."
		p {
			a class=tracking-vector data-x-internal=tracking-vector href="https://infra.spec.whatwg.org/#tracking-vector" id=offsets-into-the-media-resource:tracking-vector title="There is a tracking vector here." {
				img alt="(This is a tracking vector.)" crossorigin="" height="64" src="https://resources.whatwg.org/tracking-vector.svg" width="46"
			}
			- " In the rare case of a "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-11 "media resource"
			- " that does not have an explicit timeline, the zero time on the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-4 "media timeline"
			- " should correspond to the first frame of the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-12 "media resource"
			- ". In the even rarer case of a "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-13 "media resource"
			- " with no explicit timings of any kind, not even frame durations, the user agent must itself determine the time for each frame in an "
			a data-x-internal=implementation-defined href="https://infra.spec.whatwg.org/#implementation-defined" id=offsets-into-the-media-resource:implementation-defined implementation-defined
			- " manner."
		}
		p class=note {
			- "An example of a file format with no explicit timeline but with explicit frame durations is the Animated GIF format. An example of a file format with no explicit timings at all is the JPEG-push format ("
			code id="offsets-into-the-media-resource:multipart/x-mixed-replace" {
				a href="#multipart/x-mixed-replace" "multipart/x-mixed-replace"
			}
			- " with JPEG frames, often used as the format for MJPEG streams)."
		}
		p {
			- "If, in the case of a resource with no timing information, the user agent will nonetheless be able to seek to an earlier point than the first frame originally provided by the server, then the zero time should correspond to the earliest seekable time of the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-14 "media resource"
			- "; otherwise, it should correspond to the first frame received from the server (the point in the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-15 "media resource"
			- " at which the user agent began receiving the stream)."
		}
		p class=note "At the time of writing, there is no known format that lacks explicit frame time offsets yet still supports seeking to a frame before the first frame sent by the server."
		div class=example {
			p {
				- "Consider a stream from a TV broadcaster, which begins streaming on a sunny Friday afternoon in October, and always sends connecting user agents the media data on the same media timeline, with its zero time set to the start of this stream. Months later, user agents connecting to this stream will find that the first frame they receive has a time with millions of seconds. The "
				code id=offsets-into-the-media-resource:dom-media-getstartdate-2 {
					a href="#dom-media-getstartdate" "getStartDate()"
				}
				- " method would always return the date that the broadcast started; this would allow controllers to display real times in their scrubber (e.g. \"2:30pm\") rather than a time relative to when the broadcast began (\"8 months, 4 hours, 12 minutes, and 23 seconds\")."
			}
			p {
				- "Consider a stream that carries a video with several concatenated fragments, broadcast by a server that does not allow user agents to request specific times but instead just streams the video data in a predetermined order, with the first frame delivered always being identified as the frame with time zero. If a user agent connects to this stream and receives fragments defined as covering timestamps 2010-03-20 23:15:00 UTC to 2010-03-21 00:05:00 UTC and 2010-02-12 14:25:00 UTC to 2010-02-12 14:35:00 UTC, it would expose this with a "
				a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-5 "media timeline"
				- " starting at 0s and extending to 3,600s (one hour). Assuming the streaming server disconnected at the end of the second clip, the "
				code id=offsets-into-the-media-resource:dom-media-duration {
					a href="#dom-media-duration" duration
				}
				- " attribute would then return 3,600. The "
				code id=offsets-into-the-media-resource:dom-media-getstartdate-3 {
					a href="#dom-media-getstartdate" "getStartDate()"
				}
				- " method would return a "
				code id=offsets-into-the-media-resource:date {
					a data-x-internal=date href="https://tc39.es/ecma262/#sec-date-objects" Date
				}
				- " object with a time corresponding to 2010-03-20 23:15:00 UTC. However, if a different user agent connected five minutes later, "
				em it
				- " would (presumably) receive fragments covering timestamps 2010-03-20 23:20:00 UTC to 2010-03-21 00:05:00 UTC and 2010-02-12 14:25:00 UTC to 2010-02-12 14:35:00 UTC, and would expose this with a "
				a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-6 "media timeline"
				- " starting at 0s and extending to 3,300s (fifty five minutes). In this case, the "
				code id=offsets-into-the-media-resource:dom-media-getstartdate-4 {
					a href="#dom-media-getstartdate" "getStartDate()"
				}
				- " method would return a "
				code id=offsets-into-the-media-resource:date-2 {
					a data-x-internal=date href="https://tc39.es/ecma262/#sec-date-objects" Date
				}
				- " object with a time corresponding to 2010-03-20 23:20:00 UTC."
			}
			p {
				- "In both of these examples, the "
				code id=offsets-into-the-media-resource:dom-media-seekable {
					a href="#dom-media-seekable" seekable
				}
				- " attribute would give the ranges that the controller would want to actually display in its UI; typically, if the servers don't support seeking to arbitrary times, this would be the range of time from the moment the user agent connected to the stream up to the latest frame that the user agent has obtained; however, if the user agent starts discarding earlier information, the actual range might be shorter."
			}
		}
		p {
			- "In any case, the user agent must ensure that the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-2 "earliest possible position"
			- " (as defined below) using the established "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-7 "media timeline"
			- ", is greater than or equal to zero."
		}
		p {
			- "The "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-8 "media timeline"
			- " also has an associated clock. Which clock is used is user-agent defined, and may be "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-16 "media resource"
			- "-dependent, but it should approximate the user's wall clock."
		}
		p {
			a href="#media-element" id=offsets-into-the-media-resource:media-element "Media elements"
			- " have a "
			dfn id=current-playback-position "current playback position"
			- ", which must initially (i.e. in the absence of "
			a href="#media-data" id=offsets-into-the-media-resource:media-data-2 "media data"
			- ") be zero seconds. The "
			a href="#current-playback-position" id=offsets-into-the-media-resource:current-playback-position "current playback position"
			- " is a time on the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-9 "media timeline"
			- .
		}
		p {
			a href="#media-element" id=offsets-into-the-media-resource:media-element-2 "Media elements"
			- " also have an "
			dfn id=official-playback-position "official playback position"
			- ", which must initially be set to zero seconds. The "
			a href="#official-playback-position" id=offsets-into-the-media-resource:official-playback-position-2 "official playback position"
			- " is an approximation of the "
			a href="#current-playback-position" id=offsets-into-the-media-resource:current-playback-position-2 "current playback position"
			- " that is kept stable while scripts are running."
		}
		p {
			a href="#media-element" id=offsets-into-the-media-resource:media-element-3 "Media elements"
			- " also have a "
			dfn id=default-playback-start-position "default playback start position"
			- ", which must initially be set to zero seconds. This time is used to allow the element to be seeked even before the media is loaded."
		}
		p {
			- "Each "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-4 "media element"
			- " has a "
			dfn id=show-poster-flag "show poster flag"
			- ". When a "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-5 "media element"
			- " is created, this flag must be set to true. This flag is used to control when the user agent is to show a poster frame for a "
			code id=offsets-into-the-media-resource:the-video-element {
				a href="#the-video-element" video
			}
			- " element instead of showing the video contents."
		}
		p {
			- "The "
			dfn data-dfn-for=HTMLMediaElement data-dfn-type=attribute id=dom-media-currenttime {
				code currentTime
			}
			- " attribute must, on getting, return the "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-6 "media element"
			- "'s "
			a href="#default-playback-start-position" id=offsets-into-the-media-resource:default-playback-start-position "default playback start position"
			- ", unless that is zero, in which case it must return the element's "
			a href="#official-playback-position" id=offsets-into-the-media-resource:official-playback-position-3 "official playback position"
			- ". The returned value must be expressed in seconds. On setting, if the "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-7 "media element"
			- "'s "
			code id=offsets-into-the-media-resource:dom-media-readystate {
				a href="#dom-media-readystate" readyState
			}
			- " is "
			code id=offsets-into-the-media-resource:dom-media-have_nothing {
				a href="#dom-media-have_nothing" HAVE_NOTHING
			}
			- ", then it must set the "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-8 "media element"
			- "'s "
			a href="#default-playback-start-position" id=offsets-into-the-media-resource:default-playback-start-position-2 "default playback start position"
			- " to the new value; otherwise, it must set the "
			a href="#official-playback-position" id=offsets-into-the-media-resource:official-playback-position-4 "official playback position"
			- " to the new value and then "
			a href="#dom-media-seek" id=offsets-into-the-media-resource:dom-media-seek seek
			- " to the new value. The new value must be interpreted as being in seconds."
		}
		p {
			- "If the "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-17 "media resource"
			- " is a streaming resource, then the user agent might be unable to obtain certain parts of the resource after it has expired from its buffer. Similarly, some "
			a href="#media-resource" id=offsets-into-the-media-resource:media-resource-18 "media resources"
			- " might have a "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-10 "media timeline"
			- " that doesn't start at zero. The "
			dfn id=earliest-possible-position "earliest possible position"
			- " is the earliest position in the stream or resource that the user agent can ever obtain again. It is also a time on the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-11 "media timeline"
			- .
		}
		p class=note {
			- "The "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-3 "earliest possible position"
			- " is not explicitly exposed in the API; it corresponds to the start time of the first range in the "
			code id=offsets-into-the-media-resource:dom-media-seekable-2 {
				a href="#dom-media-seekable" seekable
			}
			- " attribute's "
			code id=offsets-into-the-media-resource:timeranges {
				a href="#timeranges" TimeRanges
			}
			- " object, if any, or the "
			a href="#current-playback-position" id=offsets-into-the-media-resource:current-playback-position-3 "current playback position"
			- " otherwise."
		}
		p {
			- "When the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-4 "earliest possible position"
			- " changes, then: if the "
			a href="#current-playback-position" id=offsets-into-the-media-resource:current-playback-position-4 "current playback position"
			- " is before the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-5 "earliest possible position"
			- ", the user agent must "
			a href="#dom-media-seek" id=offsets-into-the-media-resource:dom-media-seek-2 seek
			- " to the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-6 "earliest possible position"
			- "; otherwise, if the user agent has not fired a "
			code id=offsets-into-the-media-resource:event-media-timeupdate {
				a href="#event-media-timeupdate" timeupdate
			}
			- " event at the element in the past 15 to 250ms and is not still running event handlers for such an event, then the user agent must "
			a href="#queue-a-media-element-task" id=offsets-into-the-media-resource:queue-a-media-element-task "queue a media element task"
			- " given the "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-9 "media element"
			- " to "
			a data-x-internal=concept-event-fire href="https://dom.spec.whatwg.org/#concept-event-fire" id=offsets-into-the-media-resource:concept-event-fire "fire an event"
			- " named "
			code id=offsets-into-the-media-resource:event-media-timeupdate-2 {
				a href="#event-media-timeupdate" timeupdate
			}
			- " at the element."
		}
		p class=note {
			- "Because of the above requirement and the requirement in the "
			a href="#concept-media-load-resource" id=offsets-into-the-media-resource:concept-media-load-resource "resource fetch algorithm"
			- " that kicks in "
			a href="#getting-media-metadata" "when the metadata of the clip becomes known"
			- ", the "
			a href="#current-playback-position" id=offsets-into-the-media-resource:current-playback-position-5 "current playback position"
			- " can never be less than the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-7 "earliest possible position"
			- .
		}
		p {
			- "If at any time the user agent learns that an audio or video track has ended and all "
			a href="#media-data" id=offsets-into-the-media-resource:media-data-3 "media data"
			- " relating to that track corresponds to parts of the "
			a href="#media-timeline" id=offsets-into-the-media-resource:media-timeline-12 "media timeline"
			- " that are "
			em before
			- " the "
			a href="#earliest-possible-position" id=offsets-into-the-media-resource:earliest-possible-position-8 "earliest possible position"
			- ", the user agent may "
			a href="#queue-a-media-element-task" id=offsets-into-the-media-resource:queue-a-media-element-task-2 "queue a media element task"
			- " given the "
			a href="#media-element" id=offsets-into-the-media-resource:media-element-10 "media element"
			- " to run these steps:"
		}
		ol {
			li {
				p {
					- "Remove the track from the "
					code id=offsets-into-the-media-resource:dom-media-audiotracks {
						a href="#dom-media-audiotracks" audioTracks
					}
					- " attribute's "
					code id=offsets-into-the-media-resource:audiotracklist {
						a href="#audiotracklist" AudioTrackList
					}
					- " object or the "
					code id=offsets-into-the-media-resource:dom-media-videotracks {
						a href="#dom-media-videotracks" videoTracks
					}
					- " attribute's "
					code id=offsets-into-the-media-resource:videotracklist {
						a href="#videotracklist" VideoTrackList
					}
					- " object as appropriate."
