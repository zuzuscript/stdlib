				c- p="" .
				- body
				c- p="" .
				- appendChild
				c- p="" "("
				- outOfDocument
				c- p="" ");"
				c- c1="" "// Now that we've moved the element into the document, it too was upgraded:"
				- " console"
				c- p="" .
				- assert
				c- p="" "("
				- "outOfDocument "
