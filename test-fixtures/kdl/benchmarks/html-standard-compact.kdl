		dl class=switch {
			dt {
				a data-x-internal=ascii-hex-digits href="https://infra.spec.whatwg.org/#ascii-hex-digit" id=hexadecimal-character-reference-start-state:ascii-hex-digits "ASCII hex digit"
			}
