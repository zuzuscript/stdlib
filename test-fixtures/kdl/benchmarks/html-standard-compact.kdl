			var node
			- "'s "
			a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=enabling-and-disabling-scripting:node-document "node document"
			- "'s "
			a href="#concept-document-bc" id=enabling-and-disabling-scripting:concept-document-bc "browsing context"
			- " is non-null, and "
			a href="#concept-environment-script" id=enabling-and-disabling-scripting:concept-environment-script-2 "scripting is enabled"
			- " for "
			var node
			- "'s "
			a href="#relevant-settings-object" id=enabling-and-disabling-scripting:relevant-settings-object "relevant settings object"
			- .
		}
		p {
			dfn id=concept-n-noscript "Scripting is disabled"
			- " for a node when scripting is not "
			a href="#concept-n-script" id=enabling-and-disabling-scripting:concept-n-script enabled
			- ", i.e., when its "
			a data-x-internal=node-document href="https://dom.spec.whatwg.org/#concept-node-document" id=enabling-and-disabling-scripting:node-document-2 "node document"
			- "'s "
			a href="#concept-document-bc" id=enabling-and-disabling-scripting:concept-document-bc-2 "browsing context"
			- " is null or when "
			a href="#concept-environment-noscript" id=enabling-and-disabling-scripting:concept-environment-noscript "scripting is disabled"
			- " for its "
			a href="#relevant-settings-object" id=enabling-and-disabling-scripting:relevant-settings-object-2 "relevant settings object"
			- .
		}
		h5 id=secure-contexts {
			span class=secno "8.1.3.5"
			- " Secure contexts"
			a class=self-link href="#secure-contexts"
		}
		p {
			- "An "
			a href="#environment" id=secure-contexts:environment environment
			var environment
			- " is a "
			dfn data-export="" data-lt="secure context|Is\n  an environment settings object contextually secure?" id=secure-context "secure context"
			- " if the following algorithm returns true:"
		}
		ol {
			li {
				p {
					- "If "
					var environment
					- " is an "
					a href="#environment-settings-object" id=secure-contexts:environment-settings-object "environment settings object"
					- ", then:"
				}
				ol {
					li {
						p {
							- "Let "
							var global
							- " be "
							var environment
							- "'s "
							a href="#concept-settings-object-global" id=secure-contexts:concept-settings-object-global "global object"
							- .
						}
					}
					li {
						p {
							- "If "
							var global
							- " is a "
							code id=secure-contexts:workerglobalscope {
								a href="#workerglobalscope" WorkerGlobalScope
							}
							- ", then: "
						}
						ol {
							li {
								p {
									- "If "
									var global
									- "'s "
									a href="#concept-WorkerGlobalScope-owner-set" id=secure-contexts:concept-WorkerGlobalScope-owner-set "owner set"
									- "[0]'s "
									a href="#relevant-settings-object" id=secure-contexts:relevant-settings-object "relevant settings object"
									- " is a "
									a href="#secure-context" id=secure-contexts:secure-context "secure context"
									- ", then return true."
								}
								p class=note "We only need to check the 0th item since they will necessarily all be consistent."
							}
							li {
								p "Return false."
							}
						}
					}
					li {
						p {
							- "If "
							var global
							- " is a "
							code id=secure-contexts:workletglobalscope {
								a href="#workletglobalscope" WorkletGlobalScope
							}
							- ", then return true."
						}
						p class=note "Worklets can only be created in secure contexts."
					}
				}
			}
			li {
				p {
					- "If the result of "
					a data-x-internal=is-url-potentially-trustworthy href="https://w3c.github.io/webappsec-secure-contexts/#potentially-trustworthy-url" id=secure-contexts:is-url-potentially-trustworthy "Is url potentially trustworthy?"
					- " given "
					var environment
					- "'s "
					a href="#concept-environment-top-level-creation-url" id=secure-contexts:concept-environment-top-level-creation-url "top-level creation URL"
					- " is \""
					code "Potentially Trustworthy"
					- "\", then return true."
				}
			}
			li {
				p "Return false."
			}
		}
		p {
			- "An "
			a href="#environment" id=secure-contexts:environment-2 environment
			- " is a "
			dfn data-export="" id=non-secure-context "non-secure context"
			- " if it is not a "
			a href="#secure-context" id=secure-contexts:secure-context-2 "secure context"
			- .
		}
		h4 id=scripting-processing-model {
			span class=secno "8.1.4"
			span id=processing-model-7
			- "Script processing model"
			a class=self-link href="#scripting-processing-model"
		}
		h5 id=script-structs {
			span class=secno "8.1.4.1"
			span id=definitions-2
			- Scripts
			a class=self-link href="#script-structs"
		}
		p {
			- "A "
			dfn data-export="" id=concept-script script
			- " is one of two possible "
			a data-x-internal=struct href="https://infra.spec.whatwg.org/#struct" id=script-structs:struct structs
			- " (namely, a "
			a href="#classic-script" id=script-structs:classic-script "classic script"
			- " or a "
			a href="#module-script" id=script-structs:module-script "module script"
			- "). All scripts have:"
		}
		dl {
			dt {
				- "A "
				dfn data-dfn-for=script data-export="" id=settings-object "settings object"
			}
			dd {
				p {
					- "An "
					a href="#environment-settings-object" id=script-structs:environment-settings-object "environment settings object"
					- ", containing various settings that are shared with other "
					a href="#concept-script" id=script-structs:concept-script scripts
					- " in the same context."
				}
			}
			dt {
				- "A "
				dfn data-dfn-for=script data-export="" id=concept-script-record record
			}
			dd {
				p "One of the following:"
				ul {
					li {
						p {
							- "a "
							a data-x-internal=script-record href="https://tc39.es/ecma262/#sec-script-records" id=script-structs:script-record "script record"
							- ", for "
							a href="#classic-script" id=script-structs:classic-script-2 "classic scripts"
							- ";"
						}
					}
					li {
						p {
							- "a "
							a data-x-internal=source-text-module-record href="https://tc39.es/ecma262/#sec-source-text-module-records" id=script-structs:source-text-module-record "Source Text Module Record"
							- ", for "
							a href="#javascript-module-script" id=script-structs:javascript-module-script "JavaScript module scripts"
							- ";"
						}
					}
					li {
						p {
							- "a "
							a data-x-internal=synthetic-module-record href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" id=script-structs:synthetic-module-record "Synthetic Module Record"
							- ", for "
							a href="#css-module-script" id=script-structs:css-module-script "CSS module scripts"
							- " and "
							a href="#json-module-script" id=script-structs:json-module-script "JSON module scripts"
							- ";"
						}
					}
					li {
						p {
							- "a "
							a data-x-internal=webassembly-module-record href="https://webassembly.github.io/esm-integration/js-api/index.html#webassembly-module-record" id=script-structs:webassembly-module-record "WebAssembly Module Record"
							- ", for "
							a href="#webassembly-module-script" id=script-structs:webassembly-module-script "WebAssembly module scripts"
							- "; or"
						}
					}
					li {
						p "null, representing a parsing failure."
					}
				}
			}
			dt {
				- "A "
				dfn data-dfn-for=script id=concept-script-parse-error "parse error"
			}
			dd {
				p {
					- "A JavaScript value, which has meaning only if the "
					a href="#concept-script-record" id=script-structs:concept-script-record record
					- " is null, indicating that the corresponding script source text could not be parsed."
				}
				p class=note {
					- "This value is used for internal tracking of immediate parse errors when "
					a href="#creating-scripts" "creating scripts"
					- ", and is not to be used directly. Instead, consult the "
					a href="#concept-script-error-to-rethrow" id=script-structs:concept-script-error-to-rethrow "error to rethrow"
					- " when determining \"what went wrong\" for this script."
				}
			}
			dt {
				- "An "
				dfn data-dfn-for=script data-export="" id=concept-script-error-to-rethrow "error to rethrow"
			}
			dd {
				p {
					- "A JavaScript value representing an error that will prevent evaluation from succeeding. It will be re-thrown by any attempts to "
					a href="#calling-scripts" run
					- " the script."
				}
				p class=note {
					- "This could be the script's "
					a href="#concept-script-parse-error" id=script-structs:concept-script-parse-error "parse error"
					- ", but in the case of a "
					a href="#module-script" id=script-structs:module-script-2 "module script"
					- " it could instead be the "
					a href="#concept-script-parse-error" id=script-structs:concept-script-parse-error-2 "parse error"
					- " from one of its dependencies, or an error from "
					a href="#resolve-a-module-specifier" id=script-structs:resolve-a-module-specifier "resolve a module specifier"
					- .
				}
				p class=note "Since this exception value is provided by the JavaScript specification, we know that it is never null, so we use null to signal that no error has occurred."
			}
			dt {
				dfn data-dfn-for=script data-export="" id=concept-script-script-fetch-options "Fetch options"
			}
			dd {
				- "Null or a "
				a href="#script-fetch-options" id=script-structs:script-fetch-options "script fetch options"
				- ", containing various options related to fetching this script or "
				a href="#module-script" id=script-structs:module-script-3 "module scripts"
				- " that it imports."
			}
			dt {
				- "A "
				dfn data-dfn-for=script data-export="" id=concept-script-base-url "base URL"
			}
			dd {
				p {
					- "Null or a base "
					a data-x-internal=url href="https://url.spec.whatwg.org/#concept-url" id=script-structs:url URL
					- " used for "
					a href="#resolve-a-module-specifier" id=script-structs:resolve-a-module-specifier-2 "resolving module specifiers"
					- ". When non-null, this will either be the URL from which the script was obtained, for external scripts, or the "
					a href="#document-base-url" id=script-structs:document-base-url "document base URL"
					- " of the containing document, for inline scripts."
				}
			}
		}
		p {
			- "A "
			dfn data-export="" id=classic-script "classic script"
			- " is a type of "
			a href="#concept-script" id=script-structs:concept-script-2 script
			- " that has the following additional "
			a data-x-internal=struct-item href="https://infra.spec.whatwg.org/#struct-item" id=script-structs:struct-item item
			- :
		}
		dl {
			dt {
				- "A "
				dfn id=muted-errors "muted errors"
				- " boolean"
			}
			dd {
				p "A boolean which, if true, means that error information will not be provided for errors in this script. This is used to mute errors for cross-origin scripts, since that can leak private information."
			}
		}
		p {
			- "A "
			dfn data-export="" id=module-script "module script"
			- " is another type of "
			a href="#concept-script" id=script-structs:concept-script-3 script
			- ". It has no additional "
			a data-x-internal=struct-item href="https://infra.spec.whatwg.org/#struct-item" id=script-structs:struct-item-2 items
			- .
		}
		p {
			a href="#module-script" id=script-structs:module-script-4 "Module scripts"
			- " can be classified into four types:"
		}
		ul {
			li {
				p {
					- "A "
					a href="#module-script" id=script-structs:module-script-5 "module script"
					- " is a "
					dfn data-export="" id=javascript-module-script "JavaScript module script"
					- " if its "
					a href="#concept-script-record" id=script-structs:concept-script-record-2 record
					- " is a "
					a data-x-internal=source-text-module-record href="https://tc39.es/ecma262/#sec-source-text-module-records" id=script-structs:source-text-module-record-2 "Source Text Module Record"
					- .
				}
			}
			li {
				p {
					- "A "
					a href="#module-script" id=script-structs:module-script-6 "module script"
					- " is a "
					dfn data-export="" id=css-module-script "CSS module script"
					- " if its "
					a href="#concept-script-record" id=script-structs:concept-script-record-3 record
					- " is a "
					a data-x-internal=synthetic-module-record href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" id=script-structs:synthetic-module-record-2 "Synthetic Module Record"
					- ", and it was created via the "
					a href="#creating-a-css-module-script" id=script-structs:creating-a-css-module-script "create a CSS module script"
					- " algorithm. CSS module scripts represent a parsed CSS stylesheet."
				}
			}
			li {
				p {
					- "A "
					a href="#module-script" id=script-structs:module-script-7 "module script"
					- " is a "
					dfn data-export="" id=json-module-script "JSON module script"
					- " if its "
					a href="#concept-script-record" id=script-structs:concept-script-record-4 record
					- " is a "
					a data-x-internal=synthetic-module-record href="https://tc39.es/proposal-json-modules/#sec-synthetic-module-records" id=script-structs:synthetic-module-record-3 "Synthetic Module Record"
					- ", and it was created via the "
					a href="#creating-a-json-module-script" id=script-structs:creating-a-json-module-script "create a JSON module script"
					- " algorithm. JSON module scripts represent a parsed JSON document."
				}
			}
			li {
				p {
					- "A "
					a href="#module-script" id=script-structs:module-script-8 "module script"
					- " is a "
					dfn data-export="" id=webassembly-module-script "WebAssembly module script"
					- " if its "
					a href="#concept-script-record" id=script-structs:concept-script-record-5 record
					- " is a "
					a data-x-internal=webassembly-module-record href="https://webassembly.github.io/esm-integration/js-api/index.html#webassembly-module-record" id=script-structs:webassembly-module-record-2 "WebAssembly Module Record"
					- .
				}
			}
		}
		p class=note {
			- "As CSS stylesheets and JSON documents do not import dependent modules, and do not throw exceptions on evaluation, the "
			a href="#concept-script-script-fetch-options" id=script-structs:concept-script-script-fetch-options "fetch options"
			- " and "
			a href="#concept-script-base-url" id=script-structs:concept-script-base-url "base URL"
			- " of "
			a href="#css-module-script" id=script-structs:css-module-script-2 "CSS module scripts"
			- " and "
			a href="#json-module-script" id=script-structs:json-module-script-2 "JSON module scripts"
			- " and are always null."
		}
		p {
			- "The "
			dfn id=active-script "active script"
			- " is determined by the following algorithm:"
		}
		ol {
			li {
				p {
					- "Let "
					var record
					- " be "
					a data-x-internal=getactivescriptormodule href="https://tc39.es/ecma262/#sec-getactivescriptormodule" id=script-structs:getactivescriptormodule GetActiveScriptOrModule
					- "()."
				}
			}
			li {
				p {
					- "If "
					var record
					- " is null, return null."
				}
			}
			li {
				p {
					- "Return "
					var record
					- ".[[HostDefined]]."
				}
			}
		}
		p class=note {
			- "The "
			a href="#active-script" id=script-structs:active-script "active script"
			- " concept is so far only used by the "
			code id="script-structs:import()" {
				a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" "import()"
			}
			- " feature, to determine the "
			a href="#concept-script-base-url" id=script-structs:concept-script-base-url-2 "base URL"
			- " to use for resolving relative module specifiers."
		}
		h5 id=fetching-scripts {
			span class=secno "8.1.4.2"
			- " Fetching scripts"
			a class=self-link href="#fetching-scripts"
		}
		p {
			- "This section introduces a number of algorithms for fetching scripts, taking various necessary inputs and resulting in "
			a href="#classic-script" id=fetching-scripts:classic-script classic
			- " or "
			a href="#module-script" id=fetching-scripts:module-script "module scripts"
			- .
		}
		hr
		p {
			dfn id=script-fetch-options "Script fetch options"
			- " is a "
			a data-x-internal=struct href="https://infra.spec.whatwg.org/#struct" id=fetching-scripts:struct struct
			- " with the following "
			a data-x-internal=struct-item href="https://infra.spec.whatwg.org/#struct-item" id=fetching-scripts:struct-item items
			- :
		}
		dl {
			dt {
				dfn id=concept-script-fetch-options-nonce "cryptographic nonce"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-nonce-metadata href="https://fetch.spec.whatwg.org/#concept-request-nonce-metadata" id=fetching-scripts:concept-request-nonce-metadata "cryptographic nonce metadata"
					- " used for the initial fetch and for fetching any imported modules"
				}
			}
			dt {
				dfn id=concept-script-fetch-options-integrity "integrity metadata"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-integrity-metadata href="https://fetch.spec.whatwg.org/#concept-request-integrity-metadata" id=fetching-scripts:concept-request-integrity-metadata "integrity metadata"
					- " used for the initial fetch"
				}
			}
			dt {
				dfn id=concept-script-fetch-options-parser "parser metadata"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-parser-metadata href="https://fetch.spec.whatwg.org/#concept-request-parser-metadata" id=fetching-scripts:concept-request-parser-metadata "parser metadata"
					- " used for the initial fetch and for fetching any imported modules"
				}
			}
			dt {
				dfn id=concept-script-fetch-options-credentials "credentials mode"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-credentials-mode href="https://fetch.spec.whatwg.org/#concept-request-credentials-mode" id=fetching-scripts:concept-request-credentials-mode "credentials mode"
					- " used for the initial fetch (for "
					a href="#module-script" id=fetching-scripts:module-script-2 "module scripts"
					- ") and for fetching any imported modules (for both "
					a href="#module-script" id=fetching-scripts:module-script-3 "module scripts"
					- " and "
					a href="#classic-script" id=fetching-scripts:classic-script-2 "classic scripts"
					- ")"
				}
			}
			dt {
				dfn id=concept-script-fetch-options-referrer-policy "referrer policy"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-referrer-policy href="https://fetch.spec.whatwg.org/#concept-request-referrer-policy" id=fetching-scripts:concept-request-referrer-policy "referrer policy"
					- " used for the initial fetch and for fetching any imported modules"
				}
				p class=note {
					- "This policy can mutate after a "
					a href="#module-script" id=fetching-scripts:module-script-4 "module script"
					- "'s "
					a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=fetching-scripts:concept-response response
					- " is received, to be the "
					a data-x-internal=referrer-policy href="https://w3c.github.io/webappsec-referrer-policy/#referrer-policy" id=fetching-scripts:referrer-policy "referrer policy"
					a data-x-internal=parse-referrer-policy-header href="https://w3c.github.io/webappsec-referrer-policy/#parse-referrer-policy-from-header" id=fetching-scripts:parse-referrer-policy-header parsed
					- " from the "
					a data-x-internal=concept-response href="https://fetch.spec.whatwg.org/#concept-response" id=fetching-scripts:concept-response-2 response
					- ", and used when fetching any module dependencies."
				}
			}
			dt {
				dfn id=concept-script-fetch-options-render-blocking render-blocking
			}
			dd {
				p {
					- "The boolean value of "
					a data-x-internal=concept-request-render-blocking href="https://fetch.spec.whatwg.org/#request-render-blocking" id=fetching-scripts:concept-request-render-blocking render-blocking
					- " used for the initial fetch and for fetching any imported modules. Unless otherwise stated, its value is false."
				}
			}
			dt {
				dfn id=concept-script-fetch-options-fetch-priority "fetch priority"
			}
			dd {
				p {
					- "The "
					a data-x-internal=concept-request-priority href="https://fetch.spec.whatwg.org/#request-priority" id=fetching-scripts:concept-request-priority priority
					- " used for the initial fetch"
				}
			}
		}
		p class=note {
			- "Recall that via the "
			code id="fetching-scripts:import()" {
				a data-x-internal="import()" href="https://tc39.es/ecma262/#sec-import-calls" "import()"
			}
			- " feature, "
			a href="#classic-script" id=fetching-scripts:classic-script-3 "classic scripts"
			- " can import "
			a href="#module-script" id=fetching-scripts:module-script-5 "module scripts"
			- .
		}
		p {
			- "The "
			dfn id=default-script-fetch-options "default script fetch options"
			- " are a "
			a href="#script-fetch-options" id=fetching-scripts:script-fetch-options "script fetch options"
			- " whose "
			a href="#concept-script-fetch-options-nonce" id=fetching-scripts:concept-script-fetch-options-nonce "cryptographic nonce"
			- " is the empty string, "
			a href="#concept-script-fetch-options-integrity" id=fetching-scripts:concept-script-fetch-options-integrity "integrity metadata"
			- " is the empty string, "
			a href="#concept-script-fetch-options-parser" id=fetching-scripts:concept-script-fetch-options-parser "parser metadata"
			- " is \""
			code not-parser-inserted
			- "\", "
			a href="#concept-script-fetch-options-credentials" id=fetching-scripts:concept-script-fetch-options-credentials "credentials mode"
			- " is \""
			code same-origin
			- "\", "
