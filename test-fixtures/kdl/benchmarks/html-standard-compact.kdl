		}
		h5 id=communicating-with-a-dedicated-worker {
			span class=secno "10.1.3.2"
			- " Communicating with a dedicated worker"
			a class=self-link href="#communicating-with-a-dedicated-worker"
		}
		p {
			i "This section is non-normative."
		}
		p {
			- "Dedicated workers use "
			code id=communicating-with-a-dedicated-worker:messageport {
				a href="#messageport" MessagePort
			}
			- " objects behind the scenes, and thus support all the same features, such as sending structured data, transferring binary data, and transferring other ports."
		}
		p {
			- "To receive messages from a dedicated worker, use the "
			code id=communicating-with-a-dedicated-worker:handler-messageeventtarget-onmessage {
				a href="#handler-messageeventtarget-onmessage" onmessage
			}
			a href="#event-handler-idl-attributes" id=communicating-with-a-dedicated-worker:event-handler-idl-attributes "event handler IDL attribute"
			- " on the "
			code id=communicating-with-a-dedicated-worker:worker {
				a href="#worker" Worker
			}
			- " object:"
		}
		pre {
			code class=js {
				- worker
				c- p="" .
				- "onmessage "
				c- o="" "="
				c- a="" function
				c- p="" "("
				- event
				c- p="" ")"
				c- p="" "{"
				c- p="" ...
				c- p="" "};"
			}
		}
		p {
			- "You can also use the "
			code id=communicating-with-a-dedicated-worker:dom-eventtarget-addeventlistener {
				a data-x-internal=dom-eventtarget-addeventlistener href="https://dom.spec.whatwg.org/#dom-eventtarget-addeventlistener" "addEventListener()"
			}
			- " method."
		}
		p class=note {
			- "The implicit "
			code id=communicating-with-a-dedicated-worker:messageport-2 {
				a href="#messageport" MessagePort
			}
			- " used by dedicated workers has its "
			a href="#port-message-queue" id=communicating-with-a-dedicated-worker:port-message-queue "port message queue"
			- " implicitly enabled when it is created, so there is no equivalent to the "
			code id=communicating-with-a-dedicated-worker:messageport-3 {
				a href="#messageport" MessagePort
			}
			- " interface's "
			code id=communicating-with-a-dedicated-worker:dom-messageport-start {
				a href="#dom-messageport-start" "start()"
			}
			- " method on the "
			code id=communicating-with-a-dedicated-worker:worker-2 {
				a href="#worker" Worker
			}
			- " interface."
		}
		p {
			- "To "
			em send
			- " data to a worker, use the "
			code id=communicating-with-a-dedicated-worker:dom-worker-postmessage {
				a href="#dom-worker-postmessage" "postMessage()"
			}
			- " method. Structured data can be sent over this communication channel. To send "
			code id=communicating-with-a-dedicated-worker:idl-arraybuffer {
				a data-x-internal=idl-arraybuffer href="https://webidl.spec.whatwg.org/#idl-ArrayBuffer" ArrayBuffer
			}
			- " objects efficiently (by transferring them rather than cloning them), list them in an array in the second argument."
		}
		pre {
			code class=js {
