from test/more import *;
requires_capability( "fs" );

from std/data/kdl import KDL;
from std/io import Path;
from std/string import split;

function _ztest_path_separator () {
	let platform := "platform" in __system__
		? lc( "" _ __system__.get("platform") )
		: "";
	return platform eq "mswin32" or platform eq "win32" or platform eq "windows"
		? ";"
		: ":";
}

function _stdlib_fixtures_root ( String module_name ) {
	let inc := "inc" in __system__ ? "" _ __system__.get("inc") : "";
	let module_file := module_name _ ".zzm";

	for ( let root in split( inc, _ztest_path_separator() ) ) {
		next if root eq "";

		let lib := ( new Path(root) ).absolute();
		let marker := lib.child(module_file);
		if ( marker.exists() and marker.is_file() ) {
			let fixtures := lib.parent().child("test-fixtures");
			return fixtures if fixtures.exists() and fixtures.is_dir();
		}
	}

	let fallback := ( new Path("stdlib/test-fixtures") ).absolute();
	return fallback if fallback.exists() and fallback.is_dir();

	die `Could not locate stdlib test-fixtures for ${module_name}`;
}

let fixture_root := _stdlib_fixtures_root("std/data/kdl");
let input_root := fixture_root.child("kdl").child("test_cases").child("input");
let expected_root := fixture_root.child("kdl").child("test_cases").child("expected_kdl");
let files := Path.glob( input_root.to_String() _ "/*.kdl", { nocheck: false } );

files := files.sort( function ( a, b ) {
	return a.basename() cmp b.basename();
} );

ok( files.length() > 0, "KDL fixture files found" );

let canonical := new KDL( canonical: true );
let parser := new KDL();

for ( let file in files ) {
	let name := file.basename();
	let input := file.slurp_utf8();
	let should_fail := name ~ /_fail\.kdl$/;
	let expected := expected_root.child(name);

	if ( should_fail ) {
		let e := exception( function () {
			parser.decode(input);
		} );
		isnt( e, null, name _ " throws" );
		next;
	}

	let doc;
	let e := exception( function () {
		doc := parser.decode(input);
	} );
	is( e, null, name _ " parses" );
	next if e;

	if ( expected.exists() ) {
		is(
			canonical.encode(doc),
			expected.slurp_utf8(),
			name _ " canonical serialization",
		);
	}
}

done_testing();
